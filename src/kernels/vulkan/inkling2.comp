    const float delta = (qh & 0x8000u) != 0u ? -0.125 : 0.125;
    const uint qs = pack32(I2U16x2(b + 2u + 4u * ib).v[0]);
    float s0 = 0.0, s1 = 0.0, s2 = 0.0, s3 = 0.0;
    float xs0 = 0.0, xs1 = 0.0, xs2 = 0.0, xs3 = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint idx = ((qs >> (8u * l)) & 0xffu) | (((qh >> (3u * l)) & 7u) << 8u);
        const uint p = (gum4_iq1s_p[idx >> 1u] >> (16u * (idx & 1u))) & 0xffffu;
        const uvec2 ulo = gum4_iq1_4lut[p & 0xffu], uhi = gum4_iq1_4lut[p >> 8u];
        const vec4 wlo = vec4(unpackHalf2x16(ulo.x), unpackHalf2x16(ulo.y));
        const vec4 whi = vec4(unpackHalf2x16(uhi.x), unpackHalf2x16(uhi.y));
        const uint64_t loff = toff + 32u * l;
        const vec4 a0v = F32x4(x0 + loff).v[0], b0v = F32x4(x0 + loff + 16u).v[0];
        xs0 += ((a0v.x + a0v.y) + (a0v.z + a0v.w)) + ((b0v.x + b0v.y) + (b0v.z + b0v.w));
        s0 += dot(wlo, a0v) + dot(whi, b0v);
        const vec4 a1v = F32x4(x1 + loff).v[0], b1v = F32x4(x1 + loff + 16u).v[0];
        xs1 += ((a1v.x + a1v.y) + (a1v.z + a1v.w)) + ((b1v.x + b1v.y) + (b1v.z + b1v.w));
        s1 += dot(wlo, a1v) + dot(whi, b1v);
        if (cnt > 2u) {
            const vec4 a2v = F32x4(x2 + loff).v[0], b2v = F32x4(x2 + loff + 16u).v[0];
            xs2 += ((a2v.x + a2v.y) + (a2v.z + a2v.w)) + ((b2v.x + b2v.y) + (b2v.z + b2v.w));
            s2 += dot(wlo, a2v) + dot(whi, b2v);
        }
        if (cnt > 3u) {
            const vec4 a3v = F32x4(x3 + loff).v[0], b3v = F32x4(x3 + loff + 16u).v[0];
            xs3 += ((a3v.x + a3v.y) + (a3v.z + a3v.w)) + ((b3v.x + b3v.y) + (b3v.z + b3v.w));
            s3 += dot(wlo, a3v) + dot(whi, b3v);
