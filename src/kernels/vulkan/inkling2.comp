    const u16vec4 qv0 = I2U16x4(b0 + qoff).v[0];
    const u16vec4 qv1 = I2U16x4(b1 + qoff).v[0];
    float s0 = 0.0, s1 = 0.0;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const vec4 xa = F32x4(xt + 32u * i).v[0];
        const vec4 xb = F32x4(xt + 32u * i + 16u).v[0];
