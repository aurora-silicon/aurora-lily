            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                const uint pair = uint(qv[i]);
                const uvec2 ulo = dm4_q2_lut[pair & 0xffu], uhi = dm4_q2_lut[pair >> 8u];
                const vec4 w0 = vec4(unpackHalf2x16(ulo.x), unpackHalf2x16(ulo.y));
                const vec4 w1 = vec4(unpackHalf2x16(uhi.x), unpackHalf2x16(uhi.y));
                const uint64_t loff = toff + 32u * i;
                s0 += dot(w0, F32x4(xr0 + loff).v[0]) + dot(w1, F32x4(xr0 + loff + 16u).v[0]);
                if (cnt > 1u) s1 += dot(w0, F32x4(xr1 + loff).v[0]) + dot(w1, F32x4(xr1 + loff + 16u).v[0]);
                if (cnt > 2u) s2 += dot(w0, F32x4(xr2 + loff).v[0]) + dot(w1, F32x4(xr2 + loff + 16u).v[0]);
                if (cnt > 3u) s3 += dot(w0, F32x4(xr3 + loff).v[0]) + dot(w1, F32x4(xr3 + loff + 16u).v[0]);
