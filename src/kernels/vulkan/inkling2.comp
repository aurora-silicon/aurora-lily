// ---------------------------------------------------------------------------
// 14. Routed MoE expert projection for any GGML type:
// y[rk, n] = W[exp_ids[rk], n] . x[x_is_rk ? rk : rk / K]
// Grid: (ceil(N / 8), rows * K, 1), 256 threads (8 subgroups, 1 subgroup/row).
// Buffers: 0 x, 1 W, 2 exp_ids, 3 y.
// Params: 4 N, 5 KK, 6 row_bytes, 7 K_exp (0 if x is indexed by rk directly).
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_moe_q8_0)
#define MOE_TYPE GLM53_Q8_0
#elif defined(KERNEL_inkling2_moe_q4_k)
#define MOE_TYPE GLM53_Q4_K
#elif defined(KERNEL_inkling2_moe_q2_k)
#define MOE_TYPE GLM53_Q2_K
#elif defined(KERNEL_inkling2_moe_iq2_xxs)
#define MOE_TYPE GLM53_IQ2_XXS
#elif defined(KERNEL_inkling2_moe_bf16)
#define MOE_TYPE GLM53_BF16
#elif defined(KERNEL_inkling2_moe_f32)
#define MOE_TYPE GLM53_F32
#elif defined(KERNEL_inkling2_moe_f16)
#define MOE_TYPE GLM53_F16
#elif defined(KERNEL_inkling2_moe_q4_0)
#define MOE_TYPE GLM53_Q4_0
#elif defined(KERNEL_inkling2_moe_q5_k)
#define MOE_TYPE GLM53_Q5_K
#elif defined(KERNEL_inkling2_moe_q6_k)
#define MOE_TYPE GLM53_Q6_K
#elif defined(KERNEL_inkling2_moe_iq4_nl)
#define MOE_TYPE GLM53_IQ4_NL
#elif defined(KERNEL_inkling2_moe_iq2_s)
#define MOE_TYPE GLM53_IQ2_S
#elif defined(KERNEL_inkling2_moe_mxfp4)
#define MOE_TYPE GLM53_MXFP4
#elif defined(KERNEL_inkling2_moe_nvfp4)
#define MOE_TYPE GLM53_NVFP4
#elif defined(KERNEL_inkling2_moe_q2_0)
#define MOE_TYPE GLM53_Q2_0
#elif defined(KERNEL_inkling2_moe_iq2_xs)
#define MOE_TYPE GLM53_IQ2_XS
#elif defined(KERNEL_inkling2_moe_iq3_xxs)
#define MOE_TYPE GLM53_IQ3_XXS
#elif defined(KERNEL_inkling2_moe_iq1_s)
#define MOE_TYPE GLM53_IQ1_S
#elif defined(KERNEL_inkling2_moe_iq4_xs)
#define MOE_TYPE GLM53_IQ4_XS
#endif

#ifdef MOE_TYPE
void main() {
    const uint n = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    const uint rk = gl_WorkGroupID.y;
    const uint N = arg_u32(4);
    if (n >= N) return;
    const uint KK = arg_u32(5);
    const uint row_bytes = arg_u32(6);
    const uint K_exp = arg_u32(7);
    const uint x_idx = K_exp > 0u ? (rk / K_exp) : rk;
    const uint e = U32(arg(2)).v[rk];
    const uint64_t w_row = arg(1) + (uint64_t(e) * uint64_t(N) + uint64_t(n)) * uint64_t(row_bytes);
    const uint64_t x_row = arg(0) + uint64_t(x_idx) * uint64_t(KK) * 4u;
    const uint tasks = KK >> 5u;

    float acc = 0.0;
    for (uint t = gl_SubgroupInvocationID; t < tasks; t += 32u) {
        float w[32];
        glm53_decode(MOE_TYPE, w_row, t, w);
        acc += glm53_task_dot(w, x_row + uint64_t(t) * 128u);
    }
    acc = subgroupAdd(acc);
    if (gl_SubgroupInvocationID == 0u) {
        F32(arg(3)).v[rk * N + n] = acc;
    }
}
#endif

// ---------------------------------------------------------------------------
// 15. Relative-position bias projection:
//     out[r, e] = sum_{d=0..D} x[r, d] * bias[e, d]
// Tiles n_rows in blocks of 32 (when D <= 16) with 32 threads (1 subgroup) per
// WG: for ext=1024 launches 32 WGs/tile (8x more parallelism on decode, 32x
// less bias bandwidth on prefill) and fuses R L2 clip + tau for ALL row counts.
// x: [n_rows, D] f32, bias: [ext, D] (ty: 0=F32, 1=F16, 2=BF16), out: [n_rows, ext] f32.
// Grid: (ceil(ext / 32), D <= 16 ? ceil(n_rows / 32) : n_rows, 1), 32 threads.
// Buffers: 0 x, 1 bias, 2 out, 3 r_clip (optional).
// Params: 4 D, 5 ext, 6 ty, 7 n_rows, 8 has_r_clip, 9 rel_clip, 10 pos0,
//         11 log_floor, 12 log_alpha, 13 nh.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_rel_bias
shared float rb_x[512];     // up to 32 * 16 floats = 2 KB
shared float rb_b[32 * 17]; // padded stride 17 for D == 16 -> zero 16-way bank conflicts!

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint D = arg_u32(4);
    const uint ext = arg_u32(5);
    const uint ty = arg_u32(6);
    const uint n_rows = arg_u32(7);
    const uint has_r_clip = arg_u32(8);

    if (D <= 16u) {
        const uint tile_r0 = gl_WorkGroupID.y * 32u;
        const uint tile_cnt = min(32u, n_rows - tile_r0);
        const uint e0 = gl_WorkGroupID.x * 32u;
        const uint e_cnt = min(32u, ext - e0);
        const uint total_x = tile_cnt * D;
        const uint total_b = e_cnt * D;
        const uint64_t x_base = arg(0) + uint64_t(tile_r0) * uint64_t(D) * 4u;
        if (D == 16u) {
            const uint lr = tid >> 2u;
            const uint ld = (tid & 3u) << 2u;
            if (lr < tile_cnt) {
                vec4 xv = F32x4(x_base + (uint64_t(lr) * 16u + uint64_t(ld)) * 4u).v[0];
                if (has_r_clip != 0u) {
                    const uint r_global = tile_r0 + lr;
                    const uint nh = arg_u32(13);
                    const uint head_h = r_global % nh;
                    const uint tok_r = r_global / nh;
                    const vec4 sc = F32x4(arg(3) + (uint64_t(head_h) * 16u + uint64_t(ld)) * 4u).v[0];
                    xv *= sc;
                    float sq = dot(xv, xv);
                    sq += subgroupShuffleXor(sq, 2u);
                    sq += subgroupShuffleXor(sq, 1u);
                    float factor = clamp(arg_f32(9) / (sqrt(sq) + 1e-6), 0.0, 1.0);
                    const uint log_floor = arg_u32(11);
                    const float log_alpha = arg_f32(12);
                    if (log_alpha > 0.0 && log_floor > 0u) {
                        const float ratio = float(arg_u32(10) + tok_r + 1u) / float(log_floor);
                        if (ratio > 1.0) factor *= (1.0 + log_alpha * log(ratio));
                    }
                    xv *= factor;
                }
                const uint xb = lr * 16u + ld;
                rb_x[xb] = xv.x;
                rb_x[xb + 1u] = xv.y;
                rb_x[xb + 2u] = xv.z;
                rb_x[xb + 3u] = xv.w;
            }
            // Coalesced bias tile load into padded shared memory (stride 17 -> zero bank conflicts!).
            const uint be = tid >> 2u;
            const uint bd = (tid & 3u) << 2u;
            if (be < e_cnt) {
                vec4 v;
                if (ty == 0u) {
                    v = F32x4(arg(1) + (uint64_t(e0 + be) * 16u + uint64_t(bd)) * 4u).v[0];
                } else if (ty == 1u) {
                    const uvec2 u = U32x2(arg(1) + (uint64_t(e0 + be) * 16u + uint64_t(bd)) * 2u).v[0];
                    v = vec4(unpackHalf2x16(u.x), unpackHalf2x16(u.y));
                } else {
                    const uvec2 u = U32x2(arg(1) + (uint64_t(e0 + be) * 16u + uint64_t(bd)) * 2u).v[0];
                    v = vec4(
                        uintBitsToFloat(u.x << 16u), uintBitsToFloat(u.x & 0xffff0000u),
                        uintBitsToFloat(u.y << 16u), uintBitsToFloat(u.y & 0xffff0000u)
                    );
                }
                const uint bb = be * 17u + bd;
                rb_b[bb] = v.x;
                rb_b[bb + 1u] = v.y;
                rb_b[bb + 2u] = v.z;
                rb_b[bb + 3u] = v.w;
            }
            barrier();
            if (lane >= e_cnt) return;
            const uint e = e0 + lane;
            const uint bb = lane * 17u;
            const vec4 b0 = vec4(rb_b[bb], rb_b[bb + 1u], rb_b[bb + 2u], rb_b[bb + 3u]);
            const vec4 b1 = vec4(rb_b[bb + 4u], rb_b[bb + 5u], rb_b[bb + 6u], rb_b[bb + 7u]);
            const vec4 b2 = vec4(rb_b[bb + 8u], rb_b[bb + 9u], rb_b[bb + 10u], rb_b[bb + 11u]);
            const vec4 b3 = vec4(rb_b[bb + 12u], rb_b[bb + 13u], rb_b[bb + 14u], rb_b[bb + 15u]);
            for (uint lr = sg; lr < tile_cnt; lr += 4u) {
                const uint base = lr * 16u;
                const float acc =
                    dot(vec4(rb_x[base], rb_x[base + 1u], rb_x[base + 2u], rb_x[base + 3u]), b0)
                  + dot(vec4(rb_x[base + 4u], rb_x[base + 5u], rb_x[base + 6u], rb_x[base + 7u]), b1)
                  + dot(vec4(rb_x[base + 8u], rb_x[base + 9u], rb_x[base + 10u], rb_x[base + 11u]), b2)
                  + dot(vec4(rb_x[base + 12u], rb_x[base + 13u], rb_x[base + 14u], rb_x[base + 15u]), b3);
                F32(arg(2)).v[(tile_r0 + lr) * ext + e] = acc;
            }
            return;
        }
        for (uint i = tid; i < total_x; i += 128u) {
            rb_x[i] = F32(x_base).v[i];
        }
        if (ty == 0u) {
            const uint64_t b_base = arg(1) + uint64_t(e0) * uint64_t(D) * 4u;
            for (uint i = tid; i < total_b; i += 128u) rb_b[i] = F32(b_base).v[i];
        } else if (ty == 1u) {
            const uint64_t b_base = arg(1) + uint64_t(e0) * uint64_t(D) * 2u;
            for (uint i = tid; i < total_b; i += 128u) rb_b[i] = float(F16(b_base).v[i]);
        } else {
            const uint64_t b_base = arg(1) + uint64_t(e0) * uint64_t(D) * 2u;
            for (uint i = tid; i < total_b; i += 128u) rb_b[i] = uintBitsToFloat(uint(U16(b_base).v[i]) << 16u);
        }
        barrier();

        if (has_r_clip != 0u && tid < tile_cnt) {
            const uint lr = tid;
            const uint r_global = tile_r0 + lr;
            const uint nh = arg_u32(13);
            const uint head_h = r_global % nh;
            const uint tok_r = r_global / nh;
            const uint base = lr * D;
            const uint64_t sc_ptr = arg(3) + uint64_t(head_h) * uint64_t(D) * 4u;
            float sq = 0.0;
            for (uint d = 0u; d < D; d++) {
                const float v = rb_x[base + d] * F32(sc_ptr).v[d];
                rb_x[base + d] = v;
                sq += v * v;
            }
            const float norm = sqrt(sq) + 1e-6;
            float factor = clamp(arg_f32(9) / norm, 0.0, 1.0);
            const uint log_floor = arg_u32(11);
            const float log_alpha = arg_f32(12);
            if (log_alpha > 0.0 && log_floor > 0u) {
                const float ratio = float(arg_u32(10) + tok_r + 1u) / float(log_floor);
                if (ratio > 1.0) factor *= (1.0 + log_alpha * log(ratio));
            }
            for (uint d = 0u; d < D; d++) rb_x[base + d] *= factor;
        }
        barrier();

        if (lane >= e_cnt) return;
        const uint e = e0 + lane;
        float bv[16];
        const uint bb = lane * D;
        for (uint d = 0u; d < D; d++) bv[d] = rb_b[bb + d];
        for (uint lr = sg; lr < tile_cnt; lr += 4u) {
            float acc = 0.0;
            const uint base = lr * D;
            for (uint d = 0u; d < D; d++) acc += rb_x[base + d] * bv[d];
            F32(arg(2)).v[(tile_r0 + lr) * ext + e] = acc;
        }
        return;
    }

    const uint r = gl_WorkGroupID.y;
    const uint e = gl_WorkGroupID.x * 128u + tid;
    if (e >= ext) return;
    const uint64_t x_row = arg(0) + uint64_t(r) * uint64_t(D) * 4u;
    float acc = 0.0;
    if (ty == 0u) {
        const uint64_t b_row = arg(1) + uint64_t(e) * uint64_t(D) * 4u;
        for (uint d = 0u; d < D; d++) acc += F32(x_row).v[d] * F32(b_row).v[d];
    } else if (ty == 1u) {
        const uint64_t b_row = arg(1) + uint64_t(e) * uint64_t(D) * 2u;
        for (uint d = 0u; d < D; d++) acc += F32(x_row).v[d] * float(F16(b_row).v[d]);
    } else {
        const uint64_t b_row = arg(1) + uint64_t(e) * uint64_t(D) * 2u;
        for (uint d = 0u; d < D; d++) {
            acc += F32(x_row).v[d] * uintBitsToFloat(uint(U16(b_row).v[d]) << 16u);
        }
    }
    F32(arg(2)).v[r * ext + e] = acc;
}
#endif

// ---------------------------------------------------------------------------
// 16. Device-to-device f32 copy: dst[i] = src[i] for i in 0..n.
// Grid: (ceil(n / 256), 1, 1), 256 threads.
// Buffers: 0 src, 1 dst. Params: 2 n.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_copy_f32
void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint n = arg_u32(2);
    if (i < n) {
        F32(arg(1)).v[i] = F32(arg(0)).v[i];
    }
}
#endif

// ---------------------------------------------------------------------------
// 17. Fused MoE gate+up projection + SITU activation + optional per-expert scale.
// Loads x[rk / K_exp] once into shared memory (up to 2304 floats = 9.2 KB),
// each subgroup computes both gate (2*j) and up (2*j+1) rows and writes
// situ_out[rk, j] directly (eliminates gate_up intermediate + situ dispatch).
// Grid: (ceil(ff / 8), rows * K, 1), 256 threads (8 subgroups).
// Buffers: 0 x, 1 W, 2 exp_ids, 3 exp_scale, 4 y.
// Params: 5 ff, 6 KK, 7 row_bytes, 8 K_exp, 9 has_scale, 10 beta, 11 linear_beta.
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_moe_gu_situ_q8_0)
#define GU_TYPE GLM53_Q8_0
#elif defined(KERNEL_inkling2_moe_gu_situ_q4_k)
#define GU_TYPE GLM53_Q4_K
#elif defined(KERNEL_inkling2_moe_gu_situ_q2_k)
#define GU_TYPE GLM53_Q2_K
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_xxs)
#define GU_TYPE GLM53_IQ2_XXS
#elif defined(KERNEL_inkling2_moe_gu_situ_bf16)
#define GU_TYPE GLM53_BF16
#elif defined(KERNEL_inkling2_moe_gu_situ_f32)
#define GU_TYPE GLM53_F32
#elif defined(KERNEL_inkling2_moe_gu_situ_f16)
#define GU_TYPE GLM53_F16
#elif defined(KERNEL_inkling2_moe_gu_situ_q4_0)
#define GU_TYPE GLM53_Q4_0
#elif defined(KERNEL_inkling2_moe_gu_situ_q5_k)
#define GU_TYPE GLM53_Q5_K
#elif defined(KERNEL_inkling2_moe_gu_situ_q6_k)
#define GU_TYPE GLM53_Q6_K
#elif defined(KERNEL_inkling2_moe_gu_situ_iq4_nl)
#define GU_TYPE GLM53_IQ4_NL
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_s)
#define GU_TYPE GLM53_IQ2_S
#elif defined(KERNEL_inkling2_moe_gu_situ_mxfp4)
#define GU_TYPE GLM53_MXFP4
#elif defined(KERNEL_inkling2_moe_gu_situ_nvfp4)
#define GU_TYPE GLM53_NVFP4
#elif defined(KERNEL_inkling2_moe_gu_situ_q2_0)
#define GU_TYPE GLM53_Q2_0
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_xs)
#define GU_TYPE GLM53_IQ2_XS
#elif defined(KERNEL_inkling2_moe_gu_situ_iq3_xxs)
#define GU_TYPE GLM53_IQ3_XXS
#elif defined(KERNEL_inkling2_moe_gu_situ_iq1_s)
#define GU_TYPE GLM53_IQ1_S
#elif defined(KERNEL_inkling2_moe_gu_situ_iq4_xs)
#define GU_TYPE GLM53_IQ4_XS
#endif

#ifdef GU_TYPE
#if defined(KERNEL_inkling2_moe_gu_situ_iq2_xxs)
shared uvec4 gu_iq2xxs_grid[256];
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_xs)
shared uint gu_iq2xs_p[256];
shared uvec2 gu_iq2_4lut[256];
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_s)
shared uint gu_iq2s_p[512];
shared uvec2 gu_iq2_4lut[256];
#elif defined(KERNEL_inkling2_moe_gu_situ_iq1_s)
shared uint gu_iq1s_p[1024];
shared uvec2 gu_iq1_4lut[256];
#endif
float gu_group_sum8(float v) {
    v += subgroupShuffleXor(v, 4u);
    v += subgroupShuffleXor(v, 2u);
    v += subgroupShuffleXor(v, 1u);
    return v;
}

#if defined(KERNEL_inkling2_moe_gu_situ_iq2_xxs) || defined(KERNEL_inkling2_moe_gu_situ_iq2_xs) || \
    defined(KERNEL_inkling2_moe_gu_situ_iq2_s) || defined(KERNEL_inkling2_moe_gu_situ_iq1_s)
// Pure-F32 streaming-X fused gate+up dot over 32 elements: loads 8 floats at a time
// and reuses them across gate and up, with shared-memory LUTs and zero FP16 x rounding.
void gu_dot_iq_pair_f32(uint64_t row_g, uint64_t row_u, uint t, uint64_t xt, out float out_g, out float out_u) {
#if defined(KERNEL_inkling2_moe_gu_situ_iq2_xxs)
    const uint64_t bg = row_g + uint64_t(t >> 3u) * 66u;
    const uint64_t bu = row_u + uint64_t(t >> 3u) * 66u;
    const uint ib = t & 7u;
    const float dg = glm53_h2f(uint(U16(bg).v[0]));
    const float du = glm53_h2f(uint(U16(bu).v[0]));
    const u16vec4 qvg = I2U16x4(bg + 2u + 8u * ib).v[0];
    const u16vec4 qvu = I2U16x4(bu + 2u + 8u * ib).v[0];
    const uint q01g = pack32(qvg.xy), auxg = pack32(qvg.zw);
    const uint q01u = pack32(qvu.xy), auxu = pack32(qvu.zw);
    const float dbg = dg * float(2u * (auxg >> 28u) + 1u);
    const float dbu = du * float(2u * (auxu >> 28u) + 1u);
    float sg = 0.0, su = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const vec4 xa = F32x4(xt + 32u * l).v[0];
        const vec4 xb = F32x4(xt + 32u * l + 16u).v[0];
        {
            const uint si = (auxg >> (7u * l)) & 0x7fu;
            const uint qb = si + (si << 12u) + ((bitCount(si) & 1u) << 19u);
            const uvec4 sh = gu_iq2xxs_grid[(q01g >> (8u * l)) & 0xffu]
                ^ ((uvec4(qb) << uvec4(15u, 14u, 13u, 12u)) & 0x80008000u);
            const vec2 p0 = unpackHalf2x16(sh.x), p1 = unpackHalf2x16(sh.y);
            const vec2 p2 = unpackHalf2x16(sh.z), p3 = unpackHalf2x16(sh.w);
            sg = fma(p0.x, xa.x, sg); sg = fma(p0.y, xb.x, sg);
            sg = fma(p1.x, xa.y, sg); sg = fma(p1.y, xb.y, sg);
            sg = fma(p2.x, xa.z, sg); sg = fma(p2.y, xb.z, sg);
            sg = fma(p3.x, xa.w, sg); sg = fma(p3.y, xb.w, sg);
        }
        {
            const uint si = (auxu >> (7u * l)) & 0x7fu;
            const uint qb = si + (si << 12u) + ((bitCount(si) & 1u) << 19u);
            const uvec4 sh = gu_iq2xxs_grid[(q01u >> (8u * l)) & 0xffu]
                ^ ((uvec4(qb) << uvec4(15u, 14u, 13u, 12u)) & 0x80008000u);
            const vec2 p0 = unpackHalf2x16(sh.x), p1 = unpackHalf2x16(sh.y);
            const vec2 p2 = unpackHalf2x16(sh.z), p3 = unpackHalf2x16(sh.w);
            su = fma(p0.x, xa.x, su); su = fma(p0.y, xb.x, su);
            su = fma(p1.x, xa.y, su); su = fma(p1.y, xb.y, su);
            su = fma(p2.x, xa.z, su); su = fma(p2.y, xb.z, su);
            su = fma(p3.x, xa.w, su); su = fma(p3.y, xb.w, su);
