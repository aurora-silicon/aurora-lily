float gum4_dot_single(uint64_t row, uint t, in vec4 xv[8]) {
#if defined(KERNEL_inkling2_moe_gu_m4_q8_0)
    return i2_q8_dot_xv(row, t, xv);
#elif defined(KERNEL_inkling2_moe_gu_m4_nvfp4)
    return i2_nvfp4_dot_xv(row, t, xv);
#elif defined(KERNEL_inkling2_moe_gu_m4_iq2_xxs)
    return glm53_dot_iq2_xxs(row, t, xv);
#elif defined(KERNEL_inkling2_moe_gu_m4_iq2_xs)
    const uint64_t b = row + uint64_t(t >> 3u) * 74u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint scb = (uint(U16(b + 66u).v[ib >> 1u]) >> (8u * (ib & 1u))) & 0xffu;
    const float db0 = d * (0.5 + float(scb & 0xfu)) * 0.25;
    const float db1 = d * (0.5 + float(scb >> 4u)) * 0.25;
    float s0 = 0.0, s1 = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint q = uint(U16(b + 2u).v[4u * ib + l]);
        const uint g = q & 511u;
        const uint s7 = q >> 9u;
        const uint signs = s7 | ((bitCount(s7) & 1u) << 7u);
        const uint lo = glm53_iq2xs_grid[2u * g];
        const uint hi = glm53_iq2xs_grid[2u * g + 1u];
        const vec4 a = xv[2u * l];
        const vec4 c = xv[2u * l + 1u];
        float e = 0.0;
        e += ((signs & 1u) != 0u ? -float(lo & 0xffu) : float(lo & 0xffu)) * a.x;
        e += ((signs & 2u) != 0u ? -float((lo >> 8u) & 0xffu) : float((lo >> 8u) & 0xffu)) * a.y;
        e += ((signs & 4u) != 0u ? -float((lo >> 16u) & 0xffu) : float((lo >> 16u) & 0xffu)) * a.z;
        e += ((signs & 8u) != 0u ? -float(lo >> 24u) : float(lo >> 24u)) * a.w;
        e += ((signs & 16u) != 0u ? -float(hi & 0xffu) : float(hi & 0xffu)) * c.x;
        e += ((signs & 32u) != 0u ? -float((hi >> 8u) & 0xffu) : float((hi >> 8u) & 0xffu)) * c.y;
        e += ((signs & 64u) != 0u ? -float((hi >> 16u) & 0xffu) : float((hi >> 16u) & 0xffu)) * c.z;
        e += ((signs & 128u) != 0u ? -float(hi >> 24u) : float(hi >> 24u)) * c.w;
        if (l < 2u) s0 += e; else s1 += e;
    }
    return db0 * s0 + db1 * s1;
#elif defined(KERNEL_inkling2_moe_gu_m4_iq2_s)
    const uint64_t b = row + uint64_t(t >> 3u) * 82u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint qs = uint(U16(b + 2u).v[2u * ib]) | (uint(U16(b + 2u).v[2u * ib + 1u]) << 16u);
    const uint sg = uint(U16(b + 34u).v[2u * ib]) | (uint(U16(b + 34u).v[2u * ib + 1u]) << 16u);
    const uint hs = uint(U16(b + 66u).v[ib >> 1u]) >> (8u * (ib & 1u));
    const uint scb = uint(U16(b + 74u).v[ib >> 1u]) >> (8u * (ib & 1u));
    const float db0 = d * (0.5 + float(scb & 0xfu)) * 0.25;
    const float db1 = d * (0.5 + float((scb >> 4u) & 0xfu)) * 0.25;
    float s0 = 0.0, s1 = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint g = ((qs >> (8u * l)) & 0xffu) | (((hs & 0xffu) << (8u - 2u * l)) & 0x300u);
        const uint signs = (sg >> (8u * l)) & 0xffu;
        const uint lo = glm53_iq2s_grid[2u * g];
        const uint hi = glm53_iq2s_grid[2u * g + 1u];
        const vec4 a = xv[2u * l];
        const vec4 c = xv[2u * l + 1u];
        float e = 0.0;
        e += ((signs & 1u) != 0u ? -float(lo & 0xffu) : float(lo & 0xffu)) * a.x;
        e += ((signs & 2u) != 0u ? -float((lo >> 8u) & 0xffu) : float((lo >> 8u) & 0xffu)) * a.y;
        e += ((signs & 4u) != 0u ? -float((lo >> 16u) & 0xffu) : float((lo >> 16u) & 0xffu)) * a.z;
        e += ((signs & 8u) != 0u ? -float(lo >> 24u) : float(lo >> 24u)) * a.w;
        e += ((signs & 16u) != 0u ? -float(hi & 0xffu) : float(hi & 0xffu)) * c.x;
        e += ((signs & 32u) != 0u ? -float((hi >> 8u) & 0xffu) : float((hi >> 8u) & 0xffu)) * c.y;
        e += ((signs & 64u) != 0u ? -float((hi >> 16u) & 0xffu) : float((hi >> 16u) & 0xffu)) * c.z;
        e += ((signs & 128u) != 0u ? -float(hi >> 24u) : float(hi >> 24u)) * c.w;
        if (l < 2u) s0 += e; else s1 += e;
    }
    return db0 * s0 + db1 * s1;
#elif defined(KERNEL_inkling2_moe_gu_m4_iq1_s)
    const uint64_t b = row + uint64_t(t >> 3u) * 50u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint qh = uint(U16(b + 34u).v[ib]);
    const float dl = d * float(2u * ((qh >> 12u) & 7u) + 1u);
    const float delta = (qh & 0x8000u) != 0u ? -0.125 : 0.125;
    const uint qs = uint(U16(b + 2u).v[2u * ib]) | (uint(U16(b + 2u).v[2u * ib + 1u]) << 16u);
    float s = 0.0;
    float xsum = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint idx = ((qs >> (8u * l)) & 0xffu) | (((qh >> (3u * l)) & 7u) << 8u);
        const uint lo = glm53_iq1s_grid[2u * idx];
        const uint hi = glm53_iq1s_grid[2u * idx + 1u];
        const vec4 a = xv[2u * l];
        const vec4 c = xv[2u * l + 1u];
        xsum += (a.x + a.y + a.z + a.w) + (c.x + c.y + c.z + c.w);
        s += float(bitfieldExtract(int(lo), 0, 8)) * a.x
           + float(bitfieldExtract(int(lo), 8, 8)) * a.y
           + float(bitfieldExtract(int(lo), 16, 8)) * a.z
           + float(bitfieldExtract(int(lo), 24, 8)) * a.w
           + float(bitfieldExtract(int(hi), 0, 8)) * c.x
           + float(bitfieldExtract(int(hi), 8, 8)) * c.y
           + float(bitfieldExtract(int(hi), 16, 8)) * c.z
           + float(bitfieldExtract(int(hi), 24, 8)) * c.w;
    }
    return dl * (s + delta * xsum);
#else
    float w[32];
    glm53_decode(GUM4_TYPE, row, t, w);
    float acc = 0.0;
    [[unroll]] for (uint q = 0u; q < 8u; q++) {
        acc += dot(vec4(w[4u * q], w[4u * q + 1u], w[4u * q + 2u], w[4u * q + 3u]), xv[q]);
    }
    return acc;
#endif
}

void main() {
    const uint tile_id = gl_WorkGroupID.y;
    if (tile_id >= U32(arg(4)).v[0]) return;
    // 4 (gate, up) pairs per subgroup (8 lanes/pair): 72/8 = 9.0 exact waves, 100% SIMD util!
    const uint pair_in_sg = gl_SubgroupInvocationID >> 3u;
    const uint lane_t = gl_SubgroupInvocationID & 7u;
    const uint j = gl_WorkGroupID.x * 32u + gl_SubgroupID * 4u + pair_in_sg;
    const uint ff = arg_u32(7);
    if (j >= ff) return;

    const uvec4 tile = U32x4(arg(3)).v[tile_id];
    const uint e = tile.x;
    const uint start = tile.y;
    const uint cnt = tile.z;
    const uint KK = arg_u32(8);
    const uint row_bytes = arg_u32(9);
    const uint K_exp = arg_u32(10);

    uint rks[4];
    uint64_t x_rows[4];
    for (uint m = 0u; m < cnt; m++) {
        const uint rk = U32(arg(2)).v[start + m];
        rks[m] = rk;
        x_rows[m] = arg(0) + uint64_t(rk / K_exp) * uint64_t(KK) * 4u;
    }

    const uint64_t w_exp = arg(1) + uint64_t(e) * uint64_t(2u * ff) * uint64_t(row_bytes);
    const uint64_t w_gate = w_exp + uint64_t(j) * uint64_t(row_bytes);
    const uint64_t w_up = w_exp + uint64_t(ff + j) * uint64_t(row_bytes);
    const uint tasks = KK >> 5u;

    float ag[4] = float[4](0.0, 0.0, 0.0, 0.0);
    float au[4] = float[4](0.0, 0.0, 0.0, 0.0);
    if (cnt == 1u) {
        // Fast scalar path (~70% of verify(4) tiles): zero array indexing, loads x ONCE for gate+up!
        const uint64_t xr0 = x_rows[0];
        float g0 = 0.0;
        float u0 = 0.0;
        for (uint t = lane_t; t < tasks; t += 8u) {
            const uint64_t xt = xr0 + uint64_t(t) * 128u;
            vec4 xv[8];
            [[unroll]] for (uint q = 0u; q < 8u; q++) xv[q] = F32x4(xt + 16u * q).v[0];
            g0 += gum4_dot_single(w_gate, t, xv);
            u0 += gum4_dot_single(w_up, t, xv);
        }
        ag[0] = g0;
        au[0] = u0;
#if defined(KERNEL_inkling2_moe_gu_m4_nvfp4)
    } else if (cnt == 2u) {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1];
        float g0 = 0.0, g1 = 0.0, u0 = 0.0, u1 = 0.0;
        for (uint t = lane_t; t < tasks; t += 8u) {
            const uint64_t bo = uint64_t(t >> 1u) * 36u;
            const uint half_idx = t & 1u;
            const uint swg = U32(w_gate + bo).v[0];
            const uint swu = U32(w_up + bo).v[0];
            const uint64_t toff = uint64_t(t) * 128u;
            [[unroll]] for (uint sb = 0u; sb < 2u; sb++) {
                const uint s = 2u * half_idx + sb;
                const uint64_t xo = toff + 64u * sb;
                const vec4 x0a = F32x4(xr0 + xo).v[0], x0b = F32x4(xr0 + xo + 16u).v[0];
                const vec4 x0c = F32x4(xr0 + xo + 32u).v[0], x0d = F32x4(xr0 + xo + 48u).v[0];
                const vec4 x1a = F32x4(xr1 + xo).v[0], x1b = F32x4(xr1 + xo + 16u).v[0];
                const vec4 x1c = F32x4(xr1 + xo + 32u).v[0], x1d = F32x4(xr1 + xo + 48u).v[0];
                {
                    const float dg = i2_ue4m3_lut[(swg >> (8u * s)) & 0xffu];
                    vec4 w0, w1, w2, w3;
                    i2_nvfp4_decode_sb(w_gate + bo + 4u + 8u * s, w0, w1, w2, w3);
                    g0 += dg * (dot(w0, x0a) + dot(w1, x0b) + dot(w2, x0c) + dot(w3, x0d));
                    g1 += dg * (dot(w0, x1a) + dot(w1, x1b) + dot(w2, x1c) + dot(w3, x1d));
                }
                {
                    const float du = i2_ue4m3_lut[(swu >> (8u * s)) & 0xffu];
                    vec4 w0, w1, w2, w3;
                    i2_nvfp4_decode_sb(w_up + bo + 4u + 8u * s, w0, w1, w2, w3);
                    u0 += du * (dot(w0, x0a) + dot(w1, x0b) + dot(w2, x0c) + dot(w3, x0d));
                    u1 += du * (dot(w0, x1a) + dot(w1, x1b) + dot(w2, x1c) + dot(w3, x1d));
                }
            }
        }
        ag[0] = g0; ag[1] = g1;
        au[0] = u0; au[1] = u1;
    } else if (cnt == 3u) {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1], xr2 = x_rows[2];
        float g0 = 0.0, g1 = 0.0, g2 = 0.0;
        float u0 = 0.0, u1 = 0.0, u2 = 0.0;
        for (uint t = lane_t; t < tasks; t += 8u) {
            const uint64_t bo = uint64_t(t >> 1u) * 36u;
            const uint half_idx = t & 1u;
            const uint swg = U32(w_gate + bo).v[0];
            const uint swu = U32(w_up + bo).v[0];
            const uint64_t toff = uint64_t(t) * 128u;
            [[unroll]] for (uint sb = 0u; sb < 2u; sb++) {
                const uint s = 2u * half_idx + sb;
                const float dg = i2_ue4m3_lut[(swg >> (8u * s)) & 0xffu];
                const float du = i2_ue4m3_lut[(swu >> (8u * s)) & 0xffu];
                vec4 wg0, wg1, wg2, wg3, wu0, wu1, wu2, wu3;
                i2_nvfp4_decode_sb(w_gate + bo + 4u + 8u * s, wg0, wg1, wg2, wg3);
                i2_nvfp4_decode_sb(w_up + bo + 4u + 8u * s, wu0, wu1, wu2, wu3);
                const uint64_t xo = toff + 64u * sb;
                {
                    const vec4 xa = F32x4(xr0 + xo).v[0], xb = F32x4(xr0 + xo + 16u).v[0];
                    const vec4 xc = F32x4(xr0 + xo + 32u).v[0], xd = F32x4(xr0 + xo + 48u).v[0];
                    g0 += dg * (dot(wg0, xa) + dot(wg1, xb) + dot(wg2, xc) + dot(wg3, xd));
                    u0 += du * (dot(wu0, xa) + dot(wu1, xb) + dot(wu2, xc) + dot(wu3, xd));
                }
                {
                    const vec4 xa = F32x4(xr1 + xo).v[0], xb = F32x4(xr1 + xo + 16u).v[0];
                    const vec4 xc = F32x4(xr1 + xo + 32u).v[0], xd = F32x4(xr1 + xo + 48u).v[0];
                    g1 += dg * (dot(wg0, xa) + dot(wg1, xb) + dot(wg2, xc) + dot(wg3, xd));
                    u1 += du * (dot(wu0, xa) + dot(wu1, xb) + dot(wu2, xc) + dot(wu3, xd));
                }
                {
                    const vec4 xa = F32x4(xr2 + xo).v[0], xb = F32x4(xr2 + xo + 16u).v[0];
                    const vec4 xc = F32x4(xr2 + xo + 32u).v[0], xd = F32x4(xr2 + xo + 48u).v[0];
                    g2 += dg * (dot(wg0, xa) + dot(wg1, xb) + dot(wg2, xc) + dot(wg3, xd));
                    u2 += du * (dot(wu0, xa) + dot(wu1, xb) + dot(wu2, xc) + dot(wu3, xd));
                }
            }
        }
        ag[0] = g0; ag[1] = g1; ag[2] = g2;
        au[0] = u0; au[1] = u1; au[2] = u2;
    } else {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1], xr2 = x_rows[2], xr3 = x_rows[3];
        float g0 = 0.0, g1 = 0.0, g2 = 0.0, g3 = 0.0;
        float u0 = 0.0, u1 = 0.0, u2 = 0.0, u3 = 0.0;
        for (uint t = lane_t; t < tasks; t += 8u) {
            const uint64_t bo = uint64_t(t >> 1u) * 36u;
            const uint half_idx = t & 1u;
            const uint swg = U32(w_gate + bo).v[0];
            const uint swu = U32(w_up + bo).v[0];
            const uint64_t toff = uint64_t(t) * 128u;
            [[unroll]] for (uint sb = 0u; sb < 2u; sb++) {
                const uint s = 2u * half_idx + sb;
                const float dg = i2_ue4m3_lut[(swg >> (8u * s)) & 0xffu];
                const float du = i2_ue4m3_lut[(swu >> (8u * s)) & 0xffu];
                vec4 wg0, wg1, wg2, wg3, wu0, wu1, wu2, wu3;
                i2_nvfp4_decode_sb(w_gate + bo + 4u + 8u * s, wg0, wg1, wg2, wg3);
                i2_nvfp4_decode_sb(w_up + bo + 4u + 8u * s, wu0, wu1, wu2, wu3);
                const uint64_t xo = toff + 64u * sb;
                {
                    const vec4 xa = F32x4(xr0 + xo).v[0], xb = F32x4(xr0 + xo + 16u).v[0];
                    const vec4 xc = F32x4(xr0 + xo + 32u).v[0], xd = F32x4(xr0 + xo + 48u).v[0];
                    g0 += dg * (dot(wg0, xa) + dot(wg1, xb) + dot(wg2, xc) + dot(wg3, xd));
                    u0 += du * (dot(wu0, xa) + dot(wu1, xb) + dot(wu2, xc) + dot(wu3, xd));
                }
                {
                    const vec4 xa = F32x4(xr1 + xo).v[0], xb = F32x4(xr1 + xo + 16u).v[0];
                    const vec4 xc = F32x4(xr1 + xo + 32u).v[0], xd = F32x4(xr1 + xo + 48u).v[0];
                    g1 += dg * (dot(wg0, xa) + dot(wg1, xb) + dot(wg2, xc) + dot(wg3, xd));
                    u1 += du * (dot(wu0, xa) + dot(wu1, xb) + dot(wu2, xc) + dot(wu3, xd));
                }
                {
                    const vec4 xa = F32x4(xr2 + xo).v[0], xb = F32x4(xr2 + xo + 16u).v[0];
                    const vec4 xc = F32x4(xr2 + xo + 32u).v[0], xd = F32x4(xr2 + xo + 48u).v[0];
                    g2 += dg * (dot(wg0, xa) + dot(wg1, xb) + dot(wg2, xc) + dot(wg3, xd));
                    u2 += du * (dot(wu0, xa) + dot(wu1, xb) + dot(wu2, xc) + dot(wu3, xd));
                }
                {
                    const vec4 xa = F32x4(xr3 + xo).v[0], xb = F32x4(xr3 + xo + 16u).v[0];
                    const vec4 xc = F32x4(xr3 + xo + 32u).v[0], xd = F32x4(xr3 + xo + 48u).v[0];
                    g3 += dg * (dot(wg0, xa) + dot(wg1, xb) + dot(wg2, xc) + dot(wg3, xd));
                    u3 += du * (dot(wu0, xa) + dot(wu1, xb) + dot(wu2, xc) + dot(wu3, xd));
                }
            }
        }
        ag[0] = g0; ag[1] = g1; ag[2] = g2; ag[3] = g3;
        au[0] = u0; au[1] = u1; au[2] = u2; au[3] = u3;
#elif defined(KERNEL_inkling2_moe_gu_m4_q8_0)
    } else if (cnt == 2u) {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1];
        float g0 = 0.0, g1 = 0.0, u0 = 0.0, u1 = 0.0;
        for (uint t = lane_t; t < tasks; t += 8u) {
            const uint64_t toff = uint64_t(t) * 128u;
            vec4 x0[8], x1[8];
            [[unroll]] for (uint q = 0u; q < 8u; q++) {
                x0[q] = F32x4(xr0 + toff + 16u * q).v[0];
                x1[q] = F32x4(xr1 + toff + 16u * q).v[0];
            }
            {
                float d; vec4 w[8];
                i2_q8_decode_raw(w_gate, t, d, w);
                float s0 = 0.0, s1 = 0.0;
                [[unroll]] for (uint q = 0u; q < 8u; q++) {
                    s0 += dot(w[q], x0[q]);
                    s1 += dot(w[q], x1[q]);
                }
                g0 += d * s0; g1 += d * s1;
            }
            {
                float d; vec4 w[8];
                i2_q8_decode_raw(w_up, t, d, w);
                float s0 = 0.0, s1 = 0.0;
                [[unroll]] for (uint q = 0u; q < 8u; q++) {
                    s0 += dot(w[q], x0[q]);
                    s1 += dot(w[q], x1[q]);
                }
                u0 += d * s0; u1 += d * s1;
            }
        }
        ag[0] = g0; ag[1] = g1;
        au[0] = u0; au[1] = u1;
    } else if (cnt == 3u) {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1], xr2 = x_rows[2];
        float g0 = 0.0, g1 = 0.0, g2 = 0.0;
        float u0 = 0.0, u1 = 0.0, u2 = 0.0;
        for (uint t = lane_t; t < tasks; t += 8u) {
            const uint64_t toff = uint64_t(t) * 128u;
            float dg, du; vec4 wg[8], wu[8];
            i2_q8_decode_raw(w_gate, t, dg, wg);
            i2_q8_decode_raw(w_up, t, du, wu);
            float gs0 = 0.0, gs1 = 0.0, gs2 = 0.0;
            float us0 = 0.0, us1 = 0.0, us2 = 0.0;
            [[unroll]] for (uint q = 0u; q < 8u; q++) {
                const vec4 v0 = F32x4(xr0 + toff + 16u * q).v[0];
                gs0 += dot(wg[q], v0); us0 += dot(wu[q], v0);
                const vec4 v1 = F32x4(xr1 + toff + 16u * q).v[0];
                gs1 += dot(wg[q], v1); us1 += dot(wu[q], v1);
                const vec4 v2 = F32x4(xr2 + toff + 16u * q).v[0];
                gs2 += dot(wg[q], v2); us2 += dot(wu[q], v2);
            }
            g0 += dg * gs0; g1 += dg * gs1; g2 += dg * gs2;
            u0 += du * us0; u1 += du * us1; u2 += du * us2;
        }
        ag[0] = g0; ag[1] = g1; ag[2] = g2;
        au[0] = u0; au[1] = u1; au[2] = u2;
    } else {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1], xr2 = x_rows[2], xr3 = x_rows[3];
        float g0 = 0.0, g1 = 0.0, g2 = 0.0, g3 = 0.0;
        float u0 = 0.0, u1 = 0.0, u2 = 0.0, u3 = 0.0;
        for (uint t = lane_t; t < tasks; t += 8u) {
            const uint64_t toff = uint64_t(t) * 128u;
            float dg, du; vec4 wg[8], wu[8];
            i2_q8_decode_raw(w_gate, t, dg, wg);
            i2_q8_decode_raw(w_up, t, du, wu);
            float gs0 = 0.0, gs1 = 0.0, gs2 = 0.0, gs3 = 0.0;
            float us0 = 0.0, us1 = 0.0, us2 = 0.0, us3 = 0.0;
            [[unroll]] for (uint q = 0u; q < 8u; q++) {
                const vec4 v0 = F32x4(xr0 + toff + 16u * q).v[0];
                gs0 += dot(wg[q], v0); us0 += dot(wu[q], v0);
                const vec4 v1 = F32x4(xr1 + toff + 16u * q).v[0];
                gs1 += dot(wg[q], v1); us1 += dot(wu[q], v1);
                const vec4 v2 = F32x4(xr2 + toff + 16u * q).v[0];
                gs2 += dot(wg[q], v2); us2 += dot(wu[q], v2);
                const vec4 v3 = F32x4(xr3 + toff + 16u * q).v[0];
                gs3 += dot(wg[q], v3); us3 += dot(wu[q], v3);
            }
            g0 += dg * gs0; g1 += dg * gs1; g2 += dg * gs2; g3 += dg * gs3;
            u0 += du * us0; u1 += du * us1; u2 += du * us2; u3 += du * us3;
        }
        ag[0] = g0; ag[1] = g1; ag[2] = g2; ag[3] = g3;
        au[0] = u0; au[1] = u1; au[2] = u2; au[3] = u3;
#else
    } else {
        for (uint t = lane_t; t < tasks; t += 8u) {
            gum4_dot_task(w_gate, t, cnt, x_rows, ag);
            gum4_dot_task(w_up, t, cnt, x_rows, au);
        }
#endif
    }

    for (uint m = 0u; m < cnt; m++) {
        ag[m] = gum4_sum8(ag[m]);
        au[m] = gum4_sum8(au[m]);
    }

    if (lane_t == 0u) {
        const float beta = arg_f32(12);
        const float lb = arg_f32(13);
        const float sc = arg_u32(11) != 0u ? F32(arg(5)).v[e] : 1.0;
        for (uint m = 0u; m < cnt; m++) {
            const float gate = ag[m] * sc;
            const float up = au[m] * sc;
            const float act = beta * tanh(gate / beta) / (1.0 + exp(-gate));
            const float lin = lb > 0.0 ? lb * tanh(up / lb) : up;
            F32(arg(6)).v[rks[m] * ff + j] = act * lin;
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// 21. Grouped multi-row (up to 4 tokens/tile) MoE down projection.
// Decodes W_down[e, n] ONCE per up to 4 tokens -> up to 4x less weight bandwidth!
// Grid: (ceil(H / 8), max_tiles, 1), 256 threads (8 subgroups).
// Buffers: 0 situ_out, 1 W, 2 sorted_rk, 3 tiles, 4 n_tiles, 5 down_out.
// Params: 6 H, 7 KK, 8 row_bytes.
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_moe_down_m4_q8_0)
#define DM4_TYPE GLM53_Q8_0
#elif defined(KERNEL_inkling2_moe_down_m4_q4_k)
#define DM4_TYPE GLM53_Q4_K
#elif defined(KERNEL_inkling2_moe_down_m4_q2_k)
#define DM4_TYPE GLM53_Q2_K
#elif defined(KERNEL_inkling2_moe_down_m4_iq2_xxs)
#define DM4_TYPE GLM53_IQ2_XXS
#elif defined(KERNEL_inkling2_moe_down_m4_bf16)
#define DM4_TYPE GLM53_BF16
#elif defined(KERNEL_inkling2_moe_down_m4_f32)
#define DM4_TYPE GLM53_F32
#elif defined(KERNEL_inkling2_moe_down_m4_f16)
#define DM4_TYPE GLM53_F16
#elif defined(KERNEL_inkling2_moe_down_m4_q4_0)
#define DM4_TYPE GLM53_Q4_0
#elif defined(KERNEL_inkling2_moe_down_m4_q5_k)
#define DM4_TYPE GLM53_Q5_K
#elif defined(KERNEL_inkling2_moe_down_m4_q6_k)
#define DM4_TYPE GLM53_Q6_K
#elif defined(KERNEL_inkling2_moe_down_m4_iq4_nl)
#define DM4_TYPE GLM53_IQ4_NL
#elif defined(KERNEL_inkling2_moe_down_m4_iq2_s)
#define DM4_TYPE GLM53_IQ2_S
#elif defined(KERNEL_inkling2_moe_down_m4_mxfp4)
#define DM4_TYPE GLM53_MXFP4
#elif defined(KERNEL_inkling2_moe_down_m4_nvfp4)
#define DM4_TYPE GLM53_NVFP4
#elif defined(KERNEL_inkling2_moe_down_m4_q2_0)
#define DM4_TYPE GLM53_Q2_0
#elif defined(KERNEL_inkling2_moe_down_m4_iq2_xs)
#define DM4_TYPE GLM53_IQ2_XS
#elif defined(KERNEL_inkling2_moe_down_m4_iq3_xxs)
#define DM4_TYPE GLM53_IQ3_XXS
#elif defined(KERNEL_inkling2_moe_down_m4_iq1_s)
#define DM4_TYPE GLM53_IQ1_S
#elif defined(KERNEL_inkling2_moe_down_m4_iq4_xs)
#define DM4_TYPE GLM53_IQ4_XS
#endif

#ifdef DM4_TYPE
float dm4_sum4(float v) {
    v += subgroupShuffleXor(v, 2u);
    v += subgroupShuffleXor(v, 1u);
    return v;
}

void main() {
    const uint tile_id = gl_WorkGroupID.y;
    if (tile_id >= U32(arg(4)).v[0]) return;
    // 8 rows per subgroup (4 lanes/row): for KK=1152 (tasks=36), 36/4 = 9.0 exact waves!
    const uint row_in_sg = gl_SubgroupInvocationID >> 2u;
    const uint lane_t = gl_SubgroupInvocationID & 3u;
    const uint n = gl_WorkGroupID.x * 64u + gl_SubgroupID * 8u + row_in_sg;
    const uint H = arg_u32(6);
    if (n >= H) return;

    const uvec4 tile = U32x4(arg(3)).v[tile_id];
    const uint e = tile.x;
    const uint start = tile.y;
    const uint cnt = tile.z;
    const uint KK = arg_u32(7);
    const uint row_bytes = arg_u32(8);

    uint rks[4];
    uint64_t x_rows[4];
    for (uint m = 0u; m < cnt; m++) {
        const uint rk = U32(arg(2)).v[start + m];
        rks[m] = rk;
        x_rows[m] = arg(0) + uint64_t(rk) * uint64_t(KK) * 4u;
    }

    const uint64_t w_row = arg(1) + (uint64_t(e) * uint64_t(H) + uint64_t(n)) * uint64_t(row_bytes);
    const uint tasks = KK >> 5u;

    float a[4] = float[4](0.0, 0.0, 0.0, 0.0);
#if defined(KERNEL_inkling2_moe_down_m4_q8_0)
    if (cnt == 1u) {
        const uint64_t xr0 = x_rows[0];
        float a0 = 0.0;
        for (uint t = lane_t; t < tasks; t += 4u) {
            a0 += i2_q8_dot_ptr(w_row, t, xr0 + uint64_t(t) * 128u);
        }
        a[0] = a0;
    } else if (cnt == 2u) {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1];
        float a0 = 0.0, a1 = 0.0;
        for (uint t = lane_t; t < tasks; t += 4u) {
            float d;
            vec4 w[8];
            i2_q8_decode_raw(w_row, t, d, w);
            float s0 = 0.0, s1 = 0.0;
            const uint64_t toff = uint64_t(t) * 128u;
            [[unroll]] for (uint q = 0u; q < 8u; q++) {
                s0 += dot(w[q], F32x4(xr0 + toff + 16u * q).v[0]);
                s1 += dot(w[q], F32x4(xr1 + toff + 16u * q).v[0]);
            }
            a0 += d * s0;
            a1 += d * s1;
        }
        a[0] = a0; a[1] = a1;
    } else if (cnt == 3u) {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1], xr2 = x_rows[2];
        float a0 = 0.0, a1 = 0.0, a2 = 0.0;
        for (uint t = lane_t; t < tasks; t += 4u) {
            float d;
            vec4 w[8];
            i2_q8_decode_raw(w_row, t, d, w);
            float s0 = 0.0, s1 = 0.0, s2 = 0.0;
            const uint64_t toff = uint64_t(t) * 128u;
            [[unroll]] for (uint q = 0u; q < 8u; q++) {
                s0 += dot(w[q], F32x4(xr0 + toff + 16u * q).v[0]);
                s1 += dot(w[q], F32x4(xr1 + toff + 16u * q).v[0]);
                s2 += dot(w[q], F32x4(xr2 + toff + 16u * q).v[0]);
            }
            a0 += d * s0;
            a1 += d * s1;
            a2 += d * s2;
        }
        a[0] = a0; a[1] = a1; a[2] = a2;
    } else {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1], xr2 = x_rows[2], xr3 = x_rows[3];
        float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
        for (uint t = lane_t; t < tasks; t += 4u) {
            float d;
            vec4 w[8];
            i2_q8_decode_raw(w_row, t, d, w);
            float s0 = 0.0, s1 = 0.0, s2 = 0.0, s3 = 0.0;
            const uint64_t toff = uint64_t(t) * 128u;
            [[unroll]] for (uint q = 0u; q < 8u; q++) {
                s0 += dot(w[q], F32x4(xr0 + toff + 16u * q).v[0]);
                s1 += dot(w[q], F32x4(xr1 + toff + 16u * q).v[0]);
                s2 += dot(w[q], F32x4(xr2 + toff + 16u * q).v[0]);
                s3 += dot(w[q], F32x4(xr3 + toff + 16u * q).v[0]);
            }
            a0 += d * s0;
            a1 += d * s1;
            a2 += d * s2;
            a3 += d * s3;
        }
        a[0] = a0; a[1] = a1; a[2] = a2; a[3] = a3;
    }
#elif defined(KERNEL_inkling2_moe_down_m4_nvfp4)
    if (cnt == 1u) {
        const uint64_t xr0 = x_rows[0];
        float a0 = 0.0;
        for (uint t = lane_t; t < tasks; t += 4u) {
            const uint64_t xt = xr0 + uint64_t(t) * 128u;
            vec4 xv[8];
            [[unroll]] for (uint q = 0u; q < 8u; q++) xv[q] = F32x4(xt + 16u * q).v[0];
            a0 += i2_nvfp4_dot_xv(w_row, t, xv);
        }
        a[0] = a0;
    } else if (cnt == 2u) {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1];
        float a0 = 0.0, a1 = 0.0;
        for (uint t = lane_t; t < tasks; t += 4u) {
            const uint64_t b = w_row + uint64_t(t >> 1u) * 36u;
            const uint half_idx = t & 1u;
            const uint sw = U32(b).v[0];
            const uint64_t toff = uint64_t(t) * 128u;
            [[unroll]] for (uint sb = 0u; sb < 2u; sb++) {
                const uint s = 2u * half_idx + sb;
                const float d = i2_ue4m3_lut[(sw >> (8u * s)) & 0xffu];
                vec4 w0, w1, w2, w3;
                i2_nvfp4_decode_sb(b + 4u + 8u * s, w0, w1, w2, w3);
                const uint64_t xo = toff + 64u * sb;
                a0 += d * (dot(w0, F32x4(xr0 + xo).v[0]) + dot(w1, F32x4(xr0 + xo + 16u).v[0])
                         + dot(w2, F32x4(xr0 + xo + 32u).v[0]) + dot(w3, F32x4(xr0 + xo + 48u).v[0]));
                a1 += d * (dot(w0, F32x4(xr1 + xo).v[0]) + dot(w1, F32x4(xr1 + xo + 16u).v[0])
                         + dot(w2, F32x4(xr1 + xo + 32u).v[0]) + dot(w3, F32x4(xr1 + xo + 48u).v[0]));
            }
        }
        a[0] = a0; a[1] = a1;
    } else if (cnt == 3u) {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1], xr2 = x_rows[2];
        float a0 = 0.0, a1 = 0.0, a2 = 0.0;
        for (uint t = lane_t; t < tasks; t += 4u) {
            const uint64_t b = w_row + uint64_t(t >> 1u) * 36u;
            const uint half_idx = t & 1u;
            const uint sw = U32(b).v[0];
            const uint64_t toff = uint64_t(t) * 128u;
            [[unroll]] for (uint sb = 0u; sb < 2u; sb++) {
                const uint s = 2u * half_idx + sb;
                const float d = i2_ue4m3_lut[(sw >> (8u * s)) & 0xffu];
                vec4 w0, w1, w2, w3;
                i2_nvfp4_decode_sb(b + 4u + 8u * s, w0, w1, w2, w3);
                const uint64_t xo = toff + 64u * sb;
                a0 += d * (dot(w0, F32x4(xr0 + xo).v[0]) + dot(w1, F32x4(xr0 + xo + 16u).v[0])
                         + dot(w2, F32x4(xr0 + xo + 32u).v[0]) + dot(w3, F32x4(xr0 + xo + 48u).v[0]));
                a1 += d * (dot(w0, F32x4(xr1 + xo).v[0]) + dot(w1, F32x4(xr1 + xo + 16u).v[0])
                         + dot(w2, F32x4(xr1 + xo + 32u).v[0]) + dot(w3, F32x4(xr1 + xo + 48u).v[0]));
                a2 += d * (dot(w0, F32x4(xr2 + xo).v[0]) + dot(w1, F32x4(xr2 + xo + 16u).v[0])
                         + dot(w2, F32x4(xr2 + xo + 32u).v[0]) + dot(w3, F32x4(xr2 + xo + 48u).v[0]));
            }
        }
        a[0] = a0; a[1] = a1; a[2] = a2;
    } else {
        const uint64_t xr0 = x_rows[0], xr1 = x_rows[1], xr2 = x_rows[2], xr3 = x_rows[3];
        float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
        for (uint t = lane_t; t < tasks; t += 4u) {
            const uint64_t b = w_row + uint64_t(t >> 1u) * 36u;
            const uint half_idx = t & 1u;
            const uint sw = U32(b).v[0];
            const uint64_t toff = uint64_t(t) * 128u;
            [[unroll]] for (uint sb = 0u; sb < 2u; sb++) {
                const uint s = 2u * half_idx + sb;
                const float d = i2_ue4m3_lut[(sw >> (8u * s)) & 0xffu];
                vec4 w0, w1, w2, w3;
                i2_nvfp4_decode_sb(b + 4u + 8u * s, w0, w1, w2, w3);
                const uint64_t xo = toff + 64u * sb;
                a0 += d * (dot(w0, F32x4(xr0 + xo).v[0]) + dot(w1, F32x4(xr0 + xo + 16u).v[0])
                         + dot(w2, F32x4(xr0 + xo + 32u).v[0]) + dot(w3, F32x4(xr0 + xo + 48u).v[0]));
                a1 += d * (dot(w0, F32x4(xr1 + xo).v[0]) + dot(w1, F32x4(xr1 + xo + 16u).v[0])
                         + dot(w2, F32x4(xr1 + xo + 32u).v[0]) + dot(w3, F32x4(xr1 + xo + 48u).v[0]));
                a2 += d * (dot(w0, F32x4(xr2 + xo).v[0]) + dot(w1, F32x4(xr2 + xo + 16u).v[0])
                         + dot(w2, F32x4(xr2 + xo + 32u).v[0]) + dot(w3, F32x4(xr2 + xo + 48u).v[0]));
                a3 += d * (dot(w0, F32x4(xr3 + xo).v[0]) + dot(w1, F32x4(xr3 + xo + 16u).v[0])
                         + dot(w2, F32x4(xr3 + xo + 32u).v[0]) + dot(w3, F32x4(xr3 + xo + 48u).v[0]));
            }
        }
        a[0] = a0; a[1] = a1; a[2] = a2; a[3] = a3;
    }
#else
    for (uint t = lane_t; t < tasks; t += 4u) {
        const uint64_t toff = uint64_t(t) * 128u;
#if defined(KERNEL_inkling2_moe_down_m4_q2_0)
        const uint64_t b = w_row + uint64_t(t >> 1u) * 18u;
        const float d = glm53_h2f(uint(U16(b).v[0]));
        const uint64_t qs = b + 2u + 8u * (t & 1u);
        float s[4] = float[4](0.0, 0.0, 0.0, 0.0);
        [[unroll]] for (uint i = 0u; i < 4u; i++) {
            const uint pair = uint(U16(qs).v[i]);
            const vec4 w0 = vec4(
                float(int((pair >> 0u) & 3u) - 1),
                float(int((pair >> 2u) & 3u) - 1),
                float(int((pair >> 4u) & 3u) - 1),
                float(int((pair >> 6u) & 3u) - 1)
            );
            const vec4 w1 = vec4(
                float(int((pair >> 8u) & 3u) - 1),
                float(int((pair >> 10u) & 3u) - 1),
                float(int((pair >> 12u) & 3u) - 1),
                float(int((pair >> 14u) & 3u) - 1)
            );
            for (uint m = 0u; m < cnt; m++) {
                const uint64_t xp = x_rows[m] + toff + 32u * i;
                s[m] += dot(w0, F32x4(xp).v[0]) + dot(w1, F32x4(xp + 16u).v[0]);
            }
        }
        for (uint m = 0u; m < cnt; m++) a[m] += d * s[m];
#elif defined(KERNEL_inkling2_moe_down_m4_mxfp4)
        const uint64_t b = w_row + uint64_t(t) * 17u;
        const uint ex = uint(U8(b).v[0]);
        const float d = ex < 2u ? uintBitsToFloat(0x00200000u << ex) : uintBitsToFloat((ex - 1u) << 23u);
        float s[4] = float[4](0.0, 0.0, 0.0, 0.0);
        [[unroll]] for (uint q = 0u; q < 4u; q++) {
            const uint b0 = uint(U8(b + 1u).v[4u * q]);
            const uint b1 = uint(U8(b + 1u).v[4u * q + 1u]);
            const uint b2 = uint(U8(b + 1u).v[4u * q + 2u]);
            const uint b3 = uint(U8(b + 1u).v[4u * q + 3u]);
            const vec4 wlo = vec4(glm53_fp4_value(b0 & 15u), glm53_fp4_value(b1 & 15u),
                                  glm53_fp4_value(b2 & 15u), glm53_fp4_value(b3 & 15u));
            const vec4 whi = vec4(glm53_fp4_value(b0 >> 4u), glm53_fp4_value(b1 >> 4u),
                                  glm53_fp4_value(b2 >> 4u), glm53_fp4_value(b3 >> 4u));
            for (uint m = 0u; m < cnt; m++) {
                const uint64_t xp = x_rows[m] + toff + 16u * q;
                s[m] += dot(wlo, F32x4(xp).v[0]) + dot(whi, F32x4(xp + 64u).v[0]);
            }
        }
        for (uint m = 0u; m < cnt; m++) a[m] += d * s[m];
#elif defined(KERNEL_inkling2_moe_down_m4_nvfp4)
        const uint64_t b = w_row + uint64_t(t >> 1u) * 36u;
        const uint half_idx = t & 1u;
        const uint sw = U32(b).v[0];
        [[unroll]] for (uint sb = 0u; sb < 2u; sb++) {
            const uint si = 2u * half_idx + sb;
            const float d = glm53_ue4m3_to_f32((sw >> (8u * si)) & 0xffu);
            const uint64_t qs = b + 4u + 8u * si;
            float s[4] = float[4](0.0, 0.0, 0.0, 0.0);
            [[unroll]] for (uint q = 0u; q < 2u; q++) {
                const uint word = U32(qs).v[q];
                const uint b0 = word & 0xffu;
                const uint b1 = (word >> 8u) & 0xffu;
                const uint b2 = (word >> 16u) & 0xffu;
                const uint b3 = (word >> 24u) & 0xffu;
                const vec4 wlo = vec4(glm53_fp4_value(b0 & 15u), glm53_fp4_value(b1 & 15u),
                                      glm53_fp4_value(b2 & 15u), glm53_fp4_value(b3 & 15u));
                const vec4 whi = vec4(glm53_fp4_value(b0 >> 4u), glm53_fp4_value(b1 >> 4u),
                                      glm53_fp4_value(b2 >> 4u), glm53_fp4_value(b3 >> 4u));
                for (uint m = 0u; m < cnt; m++) {
                    const uint64_t xp = x_rows[m] + toff + 64u * sb + 16u * q;
                    s[m] += dot(wlo, F32x4(xp).v[0]) + dot(whi, F32x4(xp + 32u).v[0]);
                }
            }
            for (uint m = 0u; m < cnt; m++) a[m] += d * s[m];
        }
#else
        float w[32];
        glm53_decode(DM4_TYPE, w_row, t, w);
        for (uint m = 0u; m < cnt; m++) a[m] += glm53_task_dot(w, x_rows[m] + toff);
#endif
    }
#endif

    for (uint m = 0u; m < cnt; m++) a[m] = dm4_sum4(a[m]);

    if (lane_t == 0u) {
        for (uint m = 0u; m < cnt; m++) {
            F32(arg(5)).v[rks[m] * H + n] = a[m];
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// 22. DSpark helpers: silu_mul (silu(gate) * up), dspark_gru, and add3_bias.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_silu_mul
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= arg_u32(3)) return;
    const float g = F32(arg(0)).v[i];
    const float u = F32(arg(1)).v[i];
    F32(arg(2)).v[i] = (g / (1.0 + exp(-g))) * u;
}
#endif

// Updates rnn_state[j] in place and writes latent[j] from joint_out[3*rank] + bias[3*rank].
// Buffers: 0 joint_out, 1 bias, 2 rnn_state, 3 latent. Params: 4 rank.
#ifdef KERNEL_inkling2_dspark_gru
void main() {
    const uint j = gl_GlobalInvocationID.x;
    const uint rank = arg_u32(4);
    if (j >= rank) return;
    const float j0 = F32(arg(0)).v[j] + F32(arg(1)).v[j];
    const float j1 = F32(arg(0)).v[rank + j] + F32(arg(1)).v[rank + j];
    const float j2 = F32(arg(0)).v[2u * rank + j] + F32(arg(1)).v[2u * rank + j];
    const float g = 1.0 / (1.0 + exp(-j0));
    const float s = F32(arg(2)).v[j];
    F32(arg(2)).v[j] = g * s + (1.0 - g) * tanh(j1);
    F32(arg(3)).v[j] = tanh(j2);
}
#endif

// out[i] = a[i] + b[i] + c[i] (for combined = h_slot + corr + hidden_out_b).
// Buffers: 0 a, 1 b, 2 c, 3 out. Params: 4 n.
#ifdef KERNEL_inkling2_add3
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= arg_u32(4)) return;
    F32(arg(3)).v[i] = F32(arg(0)).v[i] + F32(arg(1)).v[i] + F32(arg(2)).v[i];
}
#endif

// ---------------------------------------------------------------------------
// 23. Fused loop controller down-projection (F32):
//     mid[r, o] = W_down[o, 0..H] . rms(cur[r]) + W_down[o, H..2*H] . rms(msg[r])
// Eliminates ctrl_concat_norm dispatch + ctrl_cat buffer!
// Grid: (ceil(rank / 8), rows, 1), 256 threads (8 subgroups).
// Buffers: 0 cur, 1 msg, 2 W_down (F32 [rank, 2*H]), 3 mid ([rows, rank]).
// Params: 4 H, 5 rank, 6 eps.
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_ctrl_down_f32) || defined(KERNEL_inkling2_ctrl_down_bf16)
shared float cd_sg0[8];
shared float cd_sg1[8];

vec4 cd_load_w4(uint64_t addr, uint i) {
#ifdef KERNEL_inkling2_ctrl_down_bf16
    const uvec2 u = U32x2(addr).v[i];
    return vec4(
        uintBitsToFloat(u.x << 16u),
        uintBitsToFloat(u.x & 0xffff0000u),
        uintBitsToFloat(u.y << 16u),
        uintBitsToFloat(u.y & 0xffff0000u)
    );
#else
    return F32x4(addr).v[i];
#endif
}

void main() {
    const uint o = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    const uint r = gl_WorkGroupID.y;
    const uint H = arg_u32(4);
    const uint rank = arg_u32(5);
    const float eps = arg_f32(6);
    const uint64_t cur_row = arg(0) + uint64_t(r) * uint64_t(H) * 4u;
    const uint64_t msg_row = arg(1) + uint64_t(r) * uint64_t(H) * 4u;

    float sq0 = 0.0;
    float sq1 = 0.0;
    const uint H4 = H >> 2u;
    for (uint i = gl_LocalInvocationIndex; i < H4; i += 256u) {
        const vec4 v0 = F32x4(cur_row).v[i];
        const vec4 v1 = F32x4(msg_row).v[i];
        sq0 += dot(v0, v0);
        sq1 += dot(v1, v1);
    }
    sq0 = subgroupAdd(sq0);
    sq1 = subgroupAdd(sq1);
    if (gl_SubgroupInvocationID == 0u) {
        cd_sg0[gl_SubgroupID] = sq0;
        cd_sg1[gl_SubgroupID] = sq1;
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        float t0 = 0.0, t1 = 0.0;
        for (uint g = 0u; g < 8u; g++) { t0 += cd_sg0[g]; t1 += cd_sg1[g]; }
        cd_sg0[0] = inversesqrt(t0 / float(H) + eps);
        cd_sg1[0] = inversesqrt(t1 / float(H) + eps);
    }
    barrier();
    if (o >= rank) return;

    const float inv0 = cd_sg0[0];
    const float inv1 = cd_sg1[0];
#ifdef KERNEL_inkling2_ctrl_down_bf16
    const uint64_t elem_b = 2u;
#else
    const uint64_t elem_b = 4u;
#endif
    const uint64_t w0 = arg(2) + uint64_t(o) * uint64_t(2u * H) * elem_b;
    const uint64_t w1 = w0 + uint64_t(H) * elem_b;
    float acc0 = 0.0;
    float acc1 = 0.0;
    for (uint i = gl_SubgroupInvocationID; i < H4; i += 32u) {
        acc0 += dot(cd_load_w4(w0, i), F32x4(cur_row).v[i]);
        acc1 += dot(cd_load_w4(w1, i), F32x4(msg_row).v[i]);
    }
    const float tot = subgroupAdd(acc0) * inv0 + subgroupAdd(acc1) * inv1;
    if (gl_SubgroupInvocationID == 0u) {
        F32(arg(3)).v[r * rank + o] = tot;
    }
}
#endif

// ---------------------------------------------------------------------------
// 24. Fused loop controller gain+forget+blend (F32 / BF16):
//     out[r, i] = (1 - tanh(W_forget[i] . mid[r])) * cur[r, i] + tanh(W_gain[i] . mid[r]) * msg[r, i]
// Eliminates ctrl_gain/ctrl_forget buffers + 2 dispatches + 2 barriers per controller!
// Grid: (ceil(H / 64), rows, 1), 256 threads.
// Buffers: 0 cur, 1 msg, 2 mid, 3 W_gain ([H, rank]), 4 W_forget ([H, rank]), 5 out.
// Params: 6 H, 7 rank (<= 128).
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_ctrl_blend_f32) || defined(KERNEL_inkling2_ctrl_blend_bf16)
shared float cb_mid[128];

vec4 cb_load_w4(uint64_t addr, uint k) {
#ifdef KERNEL_inkling2_ctrl_blend_bf16
    const uvec2 u = U32x2(addr).v[k];
    return vec4(
        uintBitsToFloat(u.x << 16u),
        uintBitsToFloat(u.x & 0xffff0000u),
        uintBitsToFloat(u.y << 16u),
        uintBitsToFloat(u.y & 0xffff0000u)
    );
#else
    return F32x4(addr).v[k];
#endif
}

void main() {
    // 4 lanes per output row i (64 rows per workgroup): adjacent lanes read
    // contiguous vec4s of W_gain[i] and W_forget[i] -> 100% coalesced bursts!
    const uint row_in_sg = gl_SubgroupInvocationID >> 2u;
    const uint lane = gl_SubgroupInvocationID & 3u;
    const uint i = gl_WorkGroupID.x * 64u + gl_SubgroupID * 8u + row_in_sg;
    const uint r = gl_WorkGroupID.y;
    const uint H = arg_u32(6);
    const uint rank = arg_u32(7);
    if (gl_LocalInvocationIndex < rank) {
        cb_mid[gl_LocalInvocationIndex] = F32(arg(2)).v[r * rank + gl_LocalInvocationIndex];
    }
    barrier();
    if (i >= H) return;

#ifdef KERNEL_inkling2_ctrl_blend_bf16
    const uint64_t elem_b = 2u;
#else
    const uint64_t elem_b = 4u;
#endif
    const uint64_t wg = arg(3) + uint64_t(i) * uint64_t(rank) * elem_b;
    const uint64_t wf = arg(4) + uint64_t(i) * uint64_t(rank) * elem_b;
    float g = 0.0;
    float f = 0.0;
    const uint r4 = rank >> 2u;
    for (uint k = lane; k < r4; k += 4u) {
        const vec4 m = vec4(cb_mid[4u * k], cb_mid[4u * k + 1u], cb_mid[4u * k + 2u], cb_mid[4u * k + 3u]);
        g += dot(cb_load_w4(wg, k), m);
        f += dot(cb_load_w4(wf, k), m);
    }
    g += subgroupShuffleXor(g, 2u);
    g += subgroupShuffleXor(g, 1u);
    f += subgroupShuffleXor(f, 2u);
    f += subgroupShuffleXor(f, 1u);
    if (lane == 0u) {
        const uint idx = r * H + i;
        const float cv = F32(arg(0)).v[idx];
        const float mv = F32(arg(1)).v[idx];
        F32(arg(5)).v[idx] = (1.0 - tanh(f)) * cv + tanh(g) * mv;
    }
}
#endif

// ---------------------------------------------------------------------------
// 25. Fused K/V short_conv + l2_clip(K) / rms_norm(V) + f16 kv_store.
// Eliminates 4 dispatches + 2 barriers + k_conv/v_conv global memory traffic!
// Grid: (n_head_kv, 2, 1), 128 threads (4 subgroups = 1 head of dim 128).
// workgroup.y == 0 -> K (sconv -> l2_clip -> f16 k_cache)
// workgroup.y == 1 -> V (sconv -> rms_norm -> f16 v_cache)
// Buffers: 0 k_raw, 1 v_raw, 2 k_conv_w, 3 v_conv_w, 4 k_dyn, 5 v_dyn,
//          6 k_hist, 7 v_hist, 8 k_cache, 9 v_cache, 10 k_trace, 11 v_trace.
// Params: 12 rows, 13 n_head_kv, 14 n_conv, 15 is_swa, 16 pos0, 17 slots,
//         18 qk_clip, 19 rms_eps, 20 has_trace.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_kv_prep
shared float kvp_sg[4];

void main() {
    const uint kh = gl_WorkGroupID.x;
    const uint is_v = gl_WorkGroupID.y;
    const uint d = gl_LocalInvocationIndex; // 0..128
    const uint rows = arg_u32(12);
    const uint nkv = arg_u32(13);
    const uint n_conv = arg_u32(14);
    const uint is_swa = arg_u32(15);
    const uint pos0 = arg_u32(16);
    const uint slots = arg_u32(17);
    const float qk_clip = arg_f32(18);
    const float rms_eps = arg_f32(19);
    const uint has_trace = arg_u32(20);
    const uint hist_len = n_conv - 1u;
    const uint C = nkv * 128u;
    const uint c = kh * 128u + d;

    const uint64_t x_buf = is_v == 0u ? arg(0) : arg(1);
    const uint64_t w_buf = (is_v == 0u ? arg(2) : arg(3)) + uint64_t(c) * uint64_t(n_conv) * 4u;
    const uint64_t d_buf = is_v == 0u ? arg(4) : arg(5);
    const uint64_t h_buf = (is_v == 0u ? arg(6) : arg(7)) + uint64_t(c) * uint64_t(hist_len) * 4u;
    const uint64_t c_buf = is_v == 0u ? arg(8) : arg(9);
    const uint64_t t_buf = is_v == 0u ? arg(10) : arg(11);

    float w[8];
    for (uint k = 0u; k < n_conv; k++) w[k] = F32(w_buf).v[k];
    float ring[8];
    for (uint k = 0u; k < hist_len; k++) ring[k] = F32(h_buf).v[k];

    const uint has_dyn = is_swa == 0u ? 1u : 0u;
    const float scale = inversesqrt(float(((has_dyn != 0u ? 2u : 1u) * n_conv) + 1u));

    for (uint r = 0u; r < rows; r++) {
        const float xr = F32(x_buf).v[r * C + c];
        ring[hist_len] = xr;

        float acc = 0.0;
        for (uint k = 0u; k < n_conv; k++) acc += ring[k] * w[k];
        if (has_dyn != 0u) {
            const uint64_t d_off = (uint64_t(r) * uint64_t(nkv) + uint64_t(kh)) * uint64_t(n_conv) * 4u;
            for (uint lag = 0u; lag < n_conv; lag++) {
                acc += ring[n_conv - 1u - lag] * F32(d_buf + d_off).v[lag];
            }
        }
        float val = (xr + acc) * scale;

        for (uint k = 0u; k < hist_len; k++) ring[k] = ring[k + 1u];
        if (has_trace != 0u) {
            const uint64_t tr = t_buf + (uint64_t(r) * uint64_t(C) + uint64_t(c)) * uint64_t(hist_len) * 4u;
            for (uint k = 0u; k < hist_len; k++) F32(tr).v[k] = ring[k];
        }

        // Per-head L2 clip (K) or RMSNorm (V) across 128 threads.
        float sq = subgroupAdd(val * val);
        if (gl_SubgroupInvocationID == 0u) kvp_sg[gl_SubgroupID] = sq;
        barrier();
        if (d == 0u) {
            const float tot = kvp_sg[0] + kvp_sg[1] + kvp_sg[2] + kvp_sg[3];
            if (is_v == 0u) {
                kvp_sg[0] = clamp(qk_clip / (sqrt(tot) + 1e-6), 0.0, 1.0);
            } else {
                kvp_sg[0] = inversesqrt(tot / 128.0 + rms_eps);
            }
        }
        barrier();
        val *= kvp_sg[0];

        const uint pos = pos0 + r;
        const uint slot = is_swa != 0u ? (pos % slots) : pos;
        F16(c_buf + (uint64_t(slot) * uint64_t(C) + uint64_t(c)) * 2u).v[0] = float16_t(val);
    }

    for (uint k = 0u; k < hist_len; k++) F32(h_buf).v[k] = ring[k];
}
#endif

// ---------------------------------------------------------------------------
// 26. DSpark GPU kernels: fuse_norm, qk_rope (+ optional F16 ctx store),
//     non-causal GQA attention over [ctx_kv(F16) ; block_kv(F32)], and init_cur.
// ---------------------------------------------------------------------------

// Fuses n_targets slices from cap[n_targets, cap_stride, H] with weights[n_targets],
// then applies RMSNorm(norm_w, eps) -> out[rows, H].
// Grid: (rows, 1, 1), 256 threads (8 subgroups).
// Buffers: 0 cap, 1 weights, 2 norm_w, 3 out.
// Params: 4 H, 5 cap_stride, 6 n_targets, 7 eps, 8 row_off.
#ifdef KERNEL_inkling2_dspark_fuse_norm
shared float dfn_sg[8];
shared float dfn_w[16];

void main() {
    const uint r = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint H = arg_u32(4);
    const uint cap_stride = arg_u32(5);
    const uint n_targets = arg_u32(6);
    const float eps = arg_f32(7);
    const uint row_off = arg_u32(8);

    if (tid < n_targets) dfn_w[tid] = F32(arg(1)).v[tid];
    barrier();

    const uint64_t out_row = arg(3) + uint64_t(r) * uint64_t(H) * 4u;
    float sq = 0.0;
    for (uint i = tid; i < H; i += 256u) {
        float acc = 0.0;
        for (uint ti = 0u; ti < n_targets; ti++) {
            const uint idx = (ti * cap_stride + (row_off + r)) * H + i;
            acc += dfn_w[ti] * F32(arg(0)).v[idx];
        }
        F32(out_row).v[i] = acc;
        sq += acc * acc;
    }
    sq = subgroupAdd(sq);
    if (gl_SubgroupInvocationID == 0u) dfn_sg[gl_SubgroupID] = sq;
    barrier();
    if (tid == 0u) {
        float tot = 0.0;
        for (uint g = 0u; g < 8u; g++) tot += dfn_sg[g];
        dfn_sg[0] = inversesqrt(tot / float(H) + eps);
    }
    barrier();
    const float inv = dfn_sg[0];
    for (uint i = tid; i < H; i += 256u) {
        F32(out_row).v[i] = F32(out_row).v[i] * inv * F32(arg(2)).v[i];
    }
}
#endif

// Per-head RMSNorm + Neox half-split RoPE, with optional F16 ctx KV store.
// Grid: (n_head, rows, 1), 128 threads (4 subgroups, supports hd <= 256).
// Buffers: 0 x (F32 [rows, nh*hd]), 1 norm_w (F32 [hd]),
//          2 v_in (optional F32 [rows, nh*hd]), 3 k_ctx (F16), 4 v_ctx (F16).
// Params: 5 nh, 6 hd, 7 pos0, 8 eps, 9 rope_theta, 10 store_ctx.
#ifdef KERNEL_inkling2_dspark_qk_rope
shared float dqk_buf[256];
shared float dqk_sg[4];

void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint nh = arg_u32(5);
    const uint hd = arg_u32(6);
    const uint pos = arg_u32(7) + r;
    const float eps = arg_f32(8);
    const float theta = arg_f32(9);
    const uint store_ctx = arg_u32(10);
    const uint row_off = (r * nh + h) * hd;

    float sq = 0.0;
    for (uint d = tid; d < hd; d += 128u) {
        const float v = F32(arg(0)).v[row_off + d];
        dqk_buf[d] = v;
        sq += v * v;
    }
    sq = subgroupAdd(sq);
    if (gl_SubgroupInvocationID == 0u) dqk_sg[gl_SubgroupID] = sq;
    barrier();
    if (tid == 0u) {
        const float tot = dqk_sg[0] + dqk_sg[1] + dqk_sg[2] + dqk_sg[3];
        dqk_sg[0] = inversesqrt(tot / float(hd) + eps);
    }
    barrier();
    const float inv = dqk_sg[0];
    for (uint d = tid; d < hd; d += 128u) {
        dqk_buf[d] = dqk_buf[d] * inv * F32(arg(1)).v[d];
    }
    barrier();

    const uint half_hd = hd >> 1u;
    const uint ctx_off = (pos * nh + h) * hd;
    for (uint i = tid; i < half_hd; i += 128u) {
        const float freq = 1.0 / pow(theta, float(2u * i) / float(hd));
        const float ang = float(pos) * freq;
        const float c = cos(ang);
        const float s = sin(ang);
        const float a = dqk_buf[i];
        const float b = dqk_buf[half_hd + i];
        const float n0 = a * c - b * s;
        const float n1 = a * s + b * c;
        if (store_ctx != 0u) {
            F16(arg(3)).v[ctx_off + i] = float16_t(n0);
            F16(arg(3)).v[ctx_off + half_hd + i] = float16_t(n1);
            F16(arg(4)).v[ctx_off + i] = float16_t(F32(arg(2)).v[row_off + i]);
            F16(arg(4)).v[ctx_off + half_hd + i] = float16_t(F32(arg(2)).v[row_off + half_hd + i]);
        } else {
            F32(arg(0)).v[row_off + i] = n0;
            F32(arg(0)).v[row_off + half_hd + i] = n1;
        }
    }
}
#endif

// Non-causal GQA over [ctx_kv[ctx_start..ctx_pos] (F16) ; block_kv[0..block] (F32)].
// Grid: (nh, block, 1), 32 threads (1 subgroup per head, supports hd <= 256, multiple of 32).
// Buffers: 0 q, 1 k_ctx (F16), 2 v_ctx (F16), 3 k_blk (F32), 4 v_blk (F32), 5 out (F32).
// Params: 6 nh, 7 nkv, 8 hd, 9 ctx_start, 10 ctx_pos, 11 block.
#ifdef KERNEL_inkling2_dspark_attn
void main() {
    const uint qh = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID;
    const uint nh = arg_u32(6);
    const uint nkv = arg_u32(7);
    const uint hd = arg_u32(8);
    const uint ctx_start = arg_u32(9);
    const uint ctx_pos = arg_u32(10);
    const uint block = arg_u32(11);
    const uint kh = qh / (nh / nkv);
    const uint kw = nkv * hd;
    const uint n_chunks = hd >> 5u; // 4 for hd=128
    const float scale = inversesqrt(float(hd));

    const uint64_t q_ptr = arg(0) + uint64_t((r * nh + qh) * hd) * 4u;
    float qv[8];
    float acc[8];
    for (uint c = 0u; c < n_chunks; c++) {
        qv[c] = F32(q_ptr).v[c * 32u + lane];
        acc[c] = 0.0;
    }

    float m = -1e30;
    float denom = 0.0;

    for (uint pos = ctx_start; pos < ctx_pos; pos++) {
        const uint64_t k_ptr = arg(1) + uint64_t(pos * kw + kh * hd) * 2u;
        const uint64_t v_ptr = arg(2) + uint64_t(pos * kw + kh * hd) * 2u;
        float dot_s = 0.0;
        for (uint c = 0u; c < n_chunks; c++) {
            dot_s += qv[c] * float(F16(k_ptr).v[c * 32u + lane]);
        }
        const float score = subgroupAdd(dot_s) * scale;
        const float new_m = max(m, score);
        const float alpha = exp(m - new_m);
        const float p = exp(score - new_m);
        denom = denom * alpha + p;
        for (uint c = 0u; c < n_chunks; c++) {
            acc[c] = acc[c] * alpha + p * float(F16(v_ptr).v[c * 32u + lane]);
        }
        m = new_m;
    }

    for (uint b = 0u; b < block; b++) {
        const uint64_t k_ptr = arg(3) + uint64_t(b * kw + kh * hd) * 4u;
        const uint64_t v_ptr = arg(4) + uint64_t(b * kw + kh * hd) * 4u;
        float dot_s = 0.0;
        for (uint c = 0u; c < n_chunks; c++) {
            dot_s += qv[c] * F32(k_ptr).v[c * 32u + lane];
        }
        const float score = subgroupAdd(dot_s) * scale;
        const float new_m = max(m, score);
        const float alpha = exp(m - new_m);
        const float p = exp(score - new_m);
        denom = denom * alpha + p;
        for (uint c = 0u; c < n_chunks; c++) {
            acc[c] = acc[c] * alpha + p * F32(v_ptr).v[c * 32u + lane];
        }
        m = new_m;
    }

    const float inv_d = 1.0 / denom;
    const uint64_t out_ptr = arg(5) + uint64_t((r * nh + qh) * hd) * 4u;
    for (uint c = 0u; c < n_chunks; c++) {
        F32(out_ptr).v[c * 32u + lane] = acc[c] * inv_d;
    }
}
#endif

// Stages [anchor_embd ; mask_embd ; mask_embd ; ...] into cur[block, H].
// Grid: (ceil(H / 256), block, 1), 256 threads.
// Buffers: 0 anchor_embd, 1 mask_embd, 2 cur. Params: 3 H.
#ifdef KERNEL_inkling2_dspark_init_cur
void main() {
    const uint i = gl_WorkGroupID.x * 256u + gl_LocalInvocationIndex;
    const uint r = gl_WorkGroupID.y;
    const uint H = arg_u32(3);
    if (i >= H) return;
    F32(arg(2)).v[r * H + i] = r == 0u ? F32(arg(0)).v[i] : F32(arg(1)).v[i];
}
#endif

// ---------------------------------------------------------------------------
// 27. 3-way batched loop controllers & 3-way batched RMSNorm (eliminates 208
//     serial dispatches per forward pass on Borealis!).
// ---------------------------------------------------------------------------

// Batched 3-way ctrl_down_f32 (j = gl_WorkGroupID.z in 0..3).
// Grid: (ceil(rank / 8), rows, 3), 256 threads (8 subgroups).
// Buffers: 0 cur0, 1 cur1, 2 cur2, 3 msg_out, 4 w0, 5 w1, 6 w2, 7 mid_out.
// Params: 8 H, 9 rank, 10 eps, 11 rows.
#if defined(KERNEL_inkling2_ctrl_down3_f32) || defined(KERNEL_inkling2_ctrl_down3_bf16)
shared float cd3_sg0[8];
shared float cd3_sg1[8];

vec4 cd3_load_w4(uint64_t addr, uint i) {
#ifdef KERNEL_inkling2_ctrl_down3_bf16
    const uvec2 u = U32x2(addr).v[i];
    return vec4(
        uintBitsToFloat(u.x << 16u),
        uintBitsToFloat(u.x & 0xffff0000u),
        uintBitsToFloat(u.y << 16u),
        uintBitsToFloat(u.y & 0xffff0000u)
    );
#else
    return F32x4(addr).v[i];
#endif
}

void main() {
    const uint o = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    const uint r = gl_WorkGroupID.y;
    const uint j = gl_WorkGroupID.z;
    const uint H = arg_u32(8);
    const uint rank = arg_u32(9);
    const float eps = arg_f32(10);
    const uint rows = arg_u32(11);
    const uint64_t cur_base = j == 0u ? arg(0) : (j == 1u ? arg(1) : arg(2));
    const uint64_t w_base = j == 0u ? arg(4) : (j == 1u ? arg(5) : arg(6));
    const uint64_t cur_row = cur_base + uint64_t(r) * uint64_t(H) * 4u;
    const uint64_t msg_row = arg(3) + uint64_t(j * rows + r) * uint64_t(H) * 4u;

    float sq0 = 0.0;
    float sq1 = 0.0;
    const uint H4 = H >> 2u;
    for (uint i = gl_LocalInvocationIndex; i < H4; i += 256u) {
        const vec4 v0 = F32x4(cur_row).v[i];
        const vec4 v1 = F32x4(msg_row).v[i];
        sq0 += dot(v0, v0);
        sq1 += dot(v1, v1);
    }
    sq0 = subgroupAdd(sq0);
    sq1 = subgroupAdd(sq1);
    if (gl_SubgroupInvocationID == 0u) {
        cd3_sg0[gl_SubgroupID] = sq0;
        cd3_sg1[gl_SubgroupID] = sq1;
    }
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        float t0 = 0.0, t1 = 0.0;
        for (uint g = 0u; g < 8u; g++) { t0 += cd3_sg0[g]; t1 += cd3_sg1[g]; }
        cd3_sg0[0] = inversesqrt(t0 / float(H) + eps);
        cd3_sg1[0] = inversesqrt(t1 / float(H) + eps);
    }
    barrier();
    if (o >= rank) return;

    const float inv0 = cd3_sg0[0];
    const float inv1 = cd3_sg1[0];
#ifdef KERNEL_inkling2_ctrl_down3_bf16
    const uint64_t elem_b = 2u;
#else
    const uint64_t elem_b = 4u;
#endif
    const uint64_t w0 = w_base + uint64_t(o) * uint64_t(2u * H) * elem_b;
    const uint64_t w1 = w0 + uint64_t(H) * elem_b;
    float acc0 = 0.0;
    float acc1 = 0.0;
    for (uint i = gl_SubgroupInvocationID; i < H4; i += 32u) {
        acc0 += dot(cd3_load_w4(w0, i), F32x4(cur_row).v[i]);
        acc1 += dot(cd3_load_w4(w1, i), F32x4(msg_row).v[i]);
    }
    const float tot = subgroupAdd(acc0) * inv0 + subgroupAdd(acc1) * inv1;
    if (gl_SubgroupInvocationID == 0u) {
        F32(arg(7)).v[(j * rows + r) * rank + o] = tot;
    }
}
#endif

// Batched 3-way coalesced ctrl_blend (F32 / BF16, j = gl_WorkGroupID.z in 0..3).
// Grid: (ceil(H / 64), rows, 3), 256 threads (4 lanes/row).
// Buffers: 0 cur0, 1 cur1, 2 cur2, 3 msg_out, 4 mid_out,
//          5 wg0, 6 wg1, 7 wg2, 8 wf0, 9 wf1, 10 wf2, 11 out0, 12 out1, 13 out2.
// Params: 14 H, 15 rank, 16 rows.
#if defined(KERNEL_inkling2_ctrl_blend3_f32) || defined(KERNEL_inkling2_ctrl_blend3_bf16)
shared float cb3_mid[128];

vec4 cb3_load_w4(uint64_t addr, uint k) {
#ifdef KERNEL_inkling2_ctrl_blend3_bf16
    const uvec2 u = U32x2(addr).v[k];
    return vec4(
        uintBitsToFloat(u.x << 16u),
        uintBitsToFloat(u.x & 0xffff0000u),
        uintBitsToFloat(u.y << 16u),
        uintBitsToFloat(u.y & 0xffff0000u)
    );
#else
    return F32x4(addr).v[k];
#endif
}

void main() {
    const uint row_in_sg = gl_SubgroupInvocationID >> 2u;
    const uint lane = gl_SubgroupInvocationID & 3u;
    const uint i = gl_WorkGroupID.x * 64u + gl_SubgroupID * 8u + row_in_sg;
    const uint r = gl_WorkGroupID.y;
    const uint j = gl_WorkGroupID.z;
    const uint H = arg_u32(14);
    const uint rank = arg_u32(15);
    const uint rows = arg_u32(16);
    if (gl_LocalInvocationIndex < rank) {
        cb3_mid[gl_LocalInvocationIndex] = F32(arg(4)).v[(j * rows + r) * rank + gl_LocalInvocationIndex];
    }
    barrier();
    if (i >= H) return;

#ifdef KERNEL_inkling2_ctrl_blend3_bf16
    const uint64_t elem_b = 2u;
#else
    const uint64_t elem_b = 4u;
#endif
    const uint64_t wg_base = j == 0u ? arg(5) : (j == 1u ? arg(6) : arg(7));
    const uint64_t wf_base = j == 0u ? arg(8) : (j == 1u ? arg(9) : arg(10));
    const uint64_t wg = wg_base + uint64_t(i) * uint64_t(rank) * elem_b;
    const uint64_t wf = wf_base + uint64_t(i) * uint64_t(rank) * elem_b;
    float g = 0.0;
    float f = 0.0;
    const uint r4 = rank >> 2u;
    for (uint k = lane; k < r4; k += 4u) {
        const vec4 m = vec4(cb3_mid[4u * k], cb3_mid[4u * k + 1u], cb3_mid[4u * k + 2u], cb3_mid[4u * k + 3u]);
        g += dot(cb3_load_w4(wg, k), m);
        f += dot(cb3_load_w4(wf, k), m);
    }
    g += subgroupShuffleXor(g, 2u);
    g += subgroupShuffleXor(g, 1u);
    f += subgroupShuffleXor(f, 2u);
    f += subgroupShuffleXor(f, 1u);
    if (lane == 0u) {
        const uint64_t cur_base = j == 0u ? arg(0) : (j == 1u ? arg(1) : arg(2));
        const uint64_t out_base = j == 0u ? arg(11) : (j == 1u ? arg(12) : arg(13));
        const float cv = F32(cur_base).v[r * H + i];
        const float mv = F32(arg(3)).v[(j * rows + r) * H + i];
        F32(out_base).v[r * H + i] = (1.0 - tanh(f)) * cv + tanh(g) * mv;
    }
}
#endif

// Batched 3-way RMSNorm (j = gl_WorkGroupID.y in 0..3).
// Grid: (rows, 3, 1), 256 threads (8 subgroups).
// Buffers: 0 x0, 1 x1, 2 x2, 3 w0, 4 w1, 5 w2, 6 y0, 7 y1, 8 y2.
// Params: 9 H, 10 eps.
#ifdef KERNEL_inkling2_rms_norm3
shared float rn3_sg[8];

void main() {
    const uint r = gl_WorkGroupID.x;
    const uint j = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint H = arg_u32(9);
    const float eps = arg_f32(10);
    const uint64_t x_row = (j == 0u ? arg(0) : (j == 1u ? arg(1) : arg(2))) + uint64_t(r) * uint64_t(H) * 4u;
    const uint64_t w_ptr = j == 0u ? arg(3) : (j == 1u ? arg(4) : arg(5));
    const uint64_t y_row = (j == 0u ? arg(6) : (j == 1u ? arg(7) : arg(8))) + uint64_t(r) * uint64_t(H) * 4u;

    float sq = 0.0;
    for (uint i = tid; i < H; i += 256u) {
        const float v = F32(x_row).v[i];
        sq += v * v;
    }
    sq = subgroupAdd(sq);
    if (gl_SubgroupInvocationID == 0u) rn3_sg[gl_SubgroupID] = sq;
    barrier();
    if (tid == 0u) {
        float tot = 0.0;
        for (uint g = 0u; g < 8u; g++) tot += rn3_sg[g];
        rn3_sg[0] = inversesqrt(tot / float(H) + eps);
    }
    barrier();
    const float inv = rn3_sg[0];
    for (uint i = tid; i < H; i += 256u) {
        F32(y_row).v[i] = F32(x_row).v[i] * inv * F32(w_ptr).v[i];
    }
}
#endif

// ---------------------------------------------------------------------------
// 28. Split-K + GQA-shared + 4-key-unrolled decode/verify attention
//     (`inkling2_attn_split` + `inkling2_attn_combine`), head_dim = 128.
//
// Each workgroup processes `chunk_keys` keys (4 subgroups x `chunk_keys/4` keys,
// unrolled 4 keys/step) for `g_step` (1..=4) query heads sharing ONE KV head
// (`g_step` divides `nh / nkv`, so for Inkling 2 Mini G=3 -> 3x less KV reads).
// `inkling2_attn_combine` merges chunks with the implicit zero attention sink
// (`M = max(0, max_c m_c)`, `L = exp(-M) + sum_c l_c * exp(m_c - M)`) and
// applies the optional sigmoid output gate.
//
// Split grid: (chunks, nh / g_step, rows), 128 threads (4 subgroups).
// Split buffers: 0 q, 1 k_cache (F16), 2 v_cache (F16), 3 rel_table, 4 sinks,
//                5 partial ([rows, nh, chunks, 130]), 6 q_clip (optional).
// Split params: 7 nh, 8 nkv, 9 g_step, 10 pos0, 11 slots, 12 is_swa, 13 window,
//               14 extent, 15 has_q_clip, 16 qk_clip, 17 log_floor, 18 log_alpha,
//               19 chunks, 20 chunk_keys.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_attn_split
shared float asp_m[4];
shared float asp_l[4];
shared vec4 asp_acc[4][32];

void main() {
    const uint c = gl_WorkGroupID.x;
    const uint y = gl_WorkGroupID.y;
    const uint r = gl_WorkGroupID.z;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;

    const uint nh = arg_u32(7);
    const uint nkv = arg_u32(8);
    const uint g_step = arg_u32(9);
    const uint pos_q = arg_u32(10) + r;
    const uint slots = arg_u32(11);
    const uint is_swa = arg_u32(12);
    const uint window = arg_u32(13);
    const uint extent = arg_u32(14);
    const uint has_q_clip = arg_u32(15);
    const uint chunks = arg_u32(19);
    const uint chunk_keys = arg_u32(20);

    const uint h0 = y * g_step;
    const uint kv_h = h0 / (nh / nkv);

    vec4 q[4];
    float sink[4];
    uint64_t rel_row[4];
    float mx[4] = float[4](-1.0 / 0.0, -1.0 / 0.0, -1.0 / 0.0, -1.0 / 0.0);
    float sum[4] = float[4](0.0, 0.0, 0.0, 0.0);
    vec4 acc[4] = vec4[4](vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));

    float tau = 1.0;
    if (has_q_clip != 0u) {
        const uint log_floor = arg_u32(17);
        const float log_alpha = arg_f32(18);
        if (log_alpha > 0.0 && log_floor > 0u) {
            const float ratio = float(pos_q + 1u) / float(log_floor);
            if (ratio > 1.0) tau = 1.0 + log_alpha * log(ratio);
        }
    }
    const float qk_clip = arg_f32(16);

    [[unroll]] for (uint g = 0u; g < 4u; g++) {
        if (g >= g_step) break;
        const uint h = h0 + g;
        const uint64_t q_off = (uint64_t(r) * uint64_t(nh) + uint64_t(h)) * 128u * 4u;
        vec4 qv = F32x4(arg(0) + q_off).v[lane];
        if (has_q_clip != 0u) {
            qv *= F32x4(arg(6) + uint64_t(h) * 128u * 4u).v[lane];
            const float norm = sqrt(subgroupAdd(dot(qv, qv))) + 1e-6;
            const float factor = clamp(qk_clip / norm, 0.0, 1.0) * tau;
            qv *= factor * inversesqrt(128.0);
        } else {
            qv *= inversesqrt(128.0);
        }
        q[g] = qv;
        sink[g] = F32(arg(4)).v[r * nh + h];
        rel_row[g] = arg(3) + (uint64_t(r) * uint64_t(nh) + uint64_t(h)) * uint64_t(extent) * 4u;
    }

    const uint k_start = (is_swa != 0u && pos_q + 1u > window) ? (pos_q + 1u - window) : 0u;
    const uint k_end = pos_q + 1u;
    const uint keys_per_sg = chunk_keys >> 2u;
    const uint first = k_start + c * chunk_keys + sg * keys_per_sg;
    const uint last = min(first + keys_per_sg, k_end);

    if (first < last) {
        U32x2 kbuf = U32x2(arg(1) + uint64_t(kv_h) * 256u);
        U32x2 vbuf = U32x2(arg(2) + uint64_t(kv_h) * 256u);
        const uint kv_row = nkv * 32u;
        uint slot = is_swa != 0u ? (first % slots) : first;

        [[dont_unroll]] for (uint key = first; key < last; key += 4u) {
            vec4 kr[4], vr[4];
            const uint rem = last - 1u - key;
            [[unroll]] for (uint u = 0u; u < 4u; u++) {
                uint su = slot + min(u, rem);
                if (is_swa != 0u && su >= slots) su -= slots;
                const uvec2 kp = kbuf.v[su * kv_row + lane];
                const uvec2 vp = vbuf.v[su * kv_row + lane];
                kr[u] = vec4(unpackHalf2x16(kp.x), unpackHalf2x16(kp.y));
                vr[u] = vec4(unpackHalf2x16(vp.x), unpackHalf2x16(vp.y));
            }
            [[unroll]] for (uint g = 0u; g < 4u; g++) {
                if (g >= g_step) break;
                float sc[4];
                float mn = mx[g];
                [[unroll]] for (uint u = 0u; u < 4u; u++) {
                    const float d = subgroupAdd(dot(q[g], kr[u]));
                    if (u <= rem) {
                        const uint dist = pos_q - (key + u);
                        const float rb = dist < extent ? F32(rel_row[g]).v[dist] : 0.0;
                        sc[u] = d + rb - sink[g];
                        mn = max(mn, sc[u]);
                    } else {
                        sc[u] = -1.0 / 0.0;
                    }
                }
                const float a = mx[g] == -1.0 / 0.0 ? 0.0 : exp(mx[g] - mn);
                sum[g] *= a;
                float e[4];
                [[unroll]] for (uint u = 0u; u < 4u; u++) {
                    e[u] = u <= rem ? exp(sc[u] - mn) : 0.0;
                    sum[g] += e[u];
                }
                acc[g] = acc[g] * a + vr[0] * e[0] + vr[1] * e[1] + vr[2] * e[2] + vr[3] * e[3];
                mx[g] = mn;
            }
            slot += 4u;
            if (is_swa != 0u && slot >= slots) slot -= slots;
        }
    }

    [[unroll]] for (uint g = 0u; g < 4u; g++) {
        if (g >= g_step) break;
        if (lane == 0u) {
            asp_m[sg] = mx[g];
            asp_l[sg] = sum[g];
        }
        asp_acc[sg][lane] = acc[g];
        barrier();
        if (sg == 0u) {
            const float M = max(max(asp_m[0], asp_m[1]), max(asp_m[2], asp_m[3]));
            const uint64_t P = arg(5) + 4u * (((uint64_t(r) * uint64_t(nh) + uint64_t(h0 + g)) * uint64_t(chunks) + uint64_t(c)) * 130u);
            if (M == -1.0 / 0.0) {
                if (lane == 0u) {
                    F32(P).v[0] = -1.0 / 0.0;
                    F32(P).v[1] = 0.0;
                }
            } else {
                const float f0 = asp_m[0] == -1.0 / 0.0 ? 0.0 : exp(asp_m[0] - M);
                const float f1 = asp_m[1] == -1.0 / 0.0 ? 0.0 : exp(asp_m[1] - M);
                const float f2 = asp_m[2] == -1.0 / 0.0 ? 0.0 : exp(asp_m[2] - M);
                const float f3 = asp_m[3] == -1.0 / 0.0 ? 0.0 : exp(asp_m[3] - M);
                const vec4 a = asp_acc[0][lane] * f0 + asp_acc[1][lane] * f1
                             + asp_acc[2][lane] * f2 + asp_acc[3][lane] * f3;
                F32x4(P + 8u).v[lane] = a;
                if (lane == 0u) {
                    F32(P).v[0] = M;
                    F32(P).v[1] = asp_l[0] * f0 + asp_l[1] * f1 + asp_l[2] * f2 + asp_l[3] * f3;
                }
            }
        }
        barrier();
    }
}
#endif

// Combine grid: (nh, rows, 1), 128 threads (1 thread per head_dim element 0..127).
// Buffers: 0 partial, 1 out, 2 gate (optional).
// Params: 3 nh, 4 chunks (<= 128), 5 has_gate.
#ifdef KERNEL_inkling2_attn_combine
shared float acb_m[128];
shared float acb_w[128];
shared float acb_red_m[4];
shared float acb_red_l[4];

void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint nh = arg_u32(3);
    const uint chunks = arg_u32(4);
    const uint has_gate = arg_u32(5);
    const uint64_t P = arg(0) + 4u * ((uint64_t(r) * uint64_t(nh) + uint64_t(h)) * uint64_t(chunks) * 130u);

    // Implicit zero attention sink at score 0.0 -> M >= 0.0.
    float mx = 0.0;
    if (tid < chunks) {
        const float m = F32(P).v[tid * 130u];
        acb_m[tid] = m;
        mx = max(mx, m);
    }
    mx = subgroupMax(mx);
    if (gl_SubgroupInvocationID == 0u) acb_red_m[gl_SubgroupID] = mx;
    barrier();
    const float M = max(max(acb_red_m[0], acb_red_m[1]), max(acb_red_m[2], acb_red_m[3]));

    float l_part = 0.0;
    if (tid < chunks) {
        const float m = acb_m[tid];
        const float w = m == -1.0 / 0.0 ? 0.0 : exp(m - M);
        acb_w[tid] = w;
        if (w != 0.0) l_part = F32(P).v[tid * 130u + 1u] * w;
    }
    l_part = subgroupAdd(l_part);
    if (gl_SubgroupInvocationID == 0u) acb_red_l[gl_SubgroupID] = l_part;
    barrier();
    const float L = exp(-M) + acb_red_l[0] + acb_red_l[1] + acb_red_l[2] + acb_red_l[3];

    float a = 0.0;
    for (uint c = 0u; c < chunks; c++) {
        const float w = acb_w[c];
        if (w != 0.0) a += F32(P).v[c * 130u + 2u + tid] * w;
    }
    float res = a / L;
    const uint64_t q_off = (uint64_t(r) * uint64_t(nh) + uint64_t(h)) * 128u * 4u;
    if (has_gate != 0u) {
        const float gv = F32(arg(2) + q_off).v[tid];
        res = res / (1.0 + exp(-gv));
    }
    F32(arg(1) + q_off).v[tid] = res;
}
#endif

// ---------------------------------------------------------------------------
// 29. Split-K + GQA-shared DSpark non-causal attention (hd = 128).
//     Chunks 0..ctx_chunks cover ctx_kv[ctx_start..ctx_pos] (F16);
//     final chunk c == ctx_chunks covers block_kv[0..block] (F32).
//
// Split grid: (ctx_chunks + 1, nh / g_step, block), 128 threads (4 subgroups).
// Split buffers: 0 q, 1 k_ctx (F16), 2 v_ctx (F16), 3 k_blk (F32), 4 v_blk (F32),
//                5 partial ([block, nh, ctx_chunks + 1, 130]).
// Split params: 6 nh, 7 nkv, 8 g_step, 9 ctx_start, 10 ctx_pos, 11 block,
//               12 ctx_chunks, 13 chunk_keys.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_dspark_attn_split
shared float dsp_m[4];
shared float dsp_l[4];
shared vec4 dsp_acc[4][32];

void main() {
    const uint c = gl_WorkGroupID.x;
    const uint y = gl_WorkGroupID.y;
    const uint r = gl_WorkGroupID.z;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;

    const uint nh = arg_u32(6);
    const uint nkv = arg_u32(7);
    const uint g_step = arg_u32(8);
    const uint ctx_start = arg_u32(9);
    const uint ctx_pos = arg_u32(10);
    const uint block = arg_u32(11);
    const uint ctx_chunks = arg_u32(12);
    const uint chunk_keys = arg_u32(13);
    const uint total_chunks = ctx_chunks + 1u;

    const uint h0 = y * g_step;
    const uint kv_h = h0 / (nh / nkv);
    const float scale = inversesqrt(128.0);

    vec4 q[4];
    float mx[4] = float[4](-1.0 / 0.0, -1.0 / 0.0, -1.0 / 0.0, -1.0 / 0.0);
    float sum[4] = float[4](0.0, 0.0, 0.0, 0.0);
    vec4 acc[4] = vec4[4](vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));

    [[unroll]] for (uint g = 0u; g < 4u; g++) {
        if (g >= g_step) break;
        const uint64_t q_off = (uint64_t(r) * uint64_t(nh) + uint64_t(h0 + g)) * 128u * 4u;
        q[g] = F32x4(arg(0) + q_off).v[lane] * scale;
    }

    if (c < ctx_chunks) {
        const uint keys_per_sg = chunk_keys >> 2u;
        const uint first = ctx_start + c * chunk_keys + sg * keys_per_sg;
        const uint last = min(first + keys_per_sg, ctx_pos);
        if (first < last) {
            U32x2 kbuf = U32x2(arg(1) + uint64_t(kv_h) * 256u);
            U32x2 vbuf = U32x2(arg(2) + uint64_t(kv_h) * 256u);
            const uint kv_row = nkv * 32u;
            [[dont_unroll]] for (uint key = first; key < last; key += 4u) {
                vec4 kr[4], vr[4];
                const uint rem = last - 1u - key;
                [[unroll]] for (uint u = 0u; u < 4u; u++) {
                    const uint su = key + min(u, rem);
                    const uvec2 kp = kbuf.v[su * kv_row + lane];
                    const uvec2 vp = vbuf.v[su * kv_row + lane];
                    kr[u] = vec4(unpackHalf2x16(kp.x), unpackHalf2x16(kp.y));
                    vr[u] = vec4(unpackHalf2x16(vp.x), unpackHalf2x16(vp.y));
                }
                [[unroll]] for (uint g = 0u; g < 4u; g++) {
                    if (g >= g_step) break;
                    float sc[4];
                    float mn = mx[g];
                    [[unroll]] for (uint u = 0u; u < 4u; u++) {
                        const float d = subgroupAdd(dot(q[g], kr[u]));
                        sc[u] = u <= rem ? d : -1.0 / 0.0;
                        mn = max(mn, sc[u]);
                    }
                    const float a = mx[g] == -1.0 / 0.0 ? 0.0 : exp(mx[g] - mn);
                    sum[g] *= a;
                    float e[4];
                    [[unroll]] for (uint u = 0u; u < 4u; u++) {
                        e[u] = u <= rem ? exp(sc[u] - mn) : 0.0;
                        sum[g] += e[u];
                    }
                    acc[g] = acc[g] * a + vr[0] * e[0] + vr[1] * e[1] + vr[2] * e[2] + vr[3] * e[3];
                    mx[g] = mn;
                }
            }
        }
    } else {
        // Final chunk: F32 block_kv[0..block] distributed across the 4 subgroups.
        const uint kv_row = nkv * 32u;
        F32x4 kblk = F32x4(arg(3) + uint64_t(kv_h) * 512u);
        F32x4 vblk = F32x4(arg(4) + uint64_t(kv_h) * 512u);
        for (uint b = sg; b < block; b += 4u) {
            const vec4 kv = kblk.v[b * kv_row + lane];
            const vec4 vv = vblk.v[b * kv_row + lane];
            [[unroll]] for (uint g = 0u; g < 4u; g++) {
                if (g >= g_step) break;
                const float s = subgroupAdd(dot(q[g], kv));
                const float mn = max(mx[g], s);
                const float a = mx[g] == -1.0 / 0.0 ? 0.0 : exp(mx[g] - mn);
                const float e = exp(s - mn);
                sum[g] = sum[g] * a + e;
                acc[g] = acc[g] * a + vv * e;
                mx[g] = mn;
            }
        }
    }

    [[unroll]] for (uint g = 0u; g < 4u; g++) {
        if (g >= g_step) break;
        if (lane == 0u) {
            dsp_m[sg] = mx[g];
            dsp_l[sg] = sum[g];
        }
        dsp_acc[sg][lane] = acc[g];
        barrier();
        if (sg == 0u) {
            const float M = max(max(dsp_m[0], dsp_m[1]), max(dsp_m[2], dsp_m[3]));
            const uint64_t P = arg(5) + 4u * (((uint64_t(r) * uint64_t(nh) + uint64_t(h0 + g)) * uint64_t(total_chunks) + uint64_t(c)) * 130u);
            if (M == -1.0 / 0.0) {
                if (lane == 0u) {
                    F32(P).v[0] = -1.0 / 0.0;
                    F32(P).v[1] = 0.0;
                }
            } else {
                const float f0 = dsp_m[0] == -1.0 / 0.0 ? 0.0 : exp(dsp_m[0] - M);
                const float f1 = dsp_m[1] == -1.0 / 0.0 ? 0.0 : exp(dsp_m[1] - M);
                const float f2 = dsp_m[2] == -1.0 / 0.0 ? 0.0 : exp(dsp_m[2] - M);
                const float f3 = dsp_m[3] == -1.0 / 0.0 ? 0.0 : exp(dsp_m[3] - M);
                const vec4 a = dsp_acc[0][lane] * f0 + dsp_acc[1][lane] * f1
                             + dsp_acc[2][lane] * f2 + dsp_acc[3][lane] * f3;
                F32x4(P + 8u).v[lane] = a;
                if (lane == 0u) {
                    F32(P).v[0] = M;
                    F32(P).v[1] = dsp_l[0] * f0 + dsp_l[1] * f1 + dsp_l[2] * f2 + dsp_l[3] * f3;
                }
            }
        }
        barrier();
    }
}
#endif

// DSpark combine grid: (nh, block, 1), 128 threads.
// Buffers: 0 partial, 1 out. Params: 2 nh, 3 total_chunks (<= 128).
#ifdef KERNEL_inkling2_dspark_attn_combine
shared float dcb_m[128];
shared float dcb_w[128];
shared float dcb_red_m[4];
shared float dcb_red_l[4];

void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint nh = arg_u32(2);
    const uint chunks = arg_u32(3);
    const uint64_t P = arg(0) + 4u * ((uint64_t(r) * uint64_t(nh) + uint64_t(h)) * uint64_t(chunks) * 130u);

    float mx = -1.0 / 0.0;
    if (tid < chunks) {
        const float m = F32(P).v[tid * 130u];
        dcb_m[tid] = m;
        mx = m;
    }
    mx = subgroupMax(mx);
    if (gl_SubgroupInvocationID == 0u) dcb_red_m[gl_SubgroupID] = mx;
    barrier();
    const float M = max(max(dcb_red_m[0], dcb_red_m[1]), max(dcb_red_m[2], dcb_red_m[3]));

    float l_part = 0.0;
    if (tid < chunks) {
        const float m = dcb_m[tid];
        const float w = m == -1.0 / 0.0 ? 0.0 : exp(m - M);
        dcb_w[tid] = w;
        if (w != 0.0) l_part = F32(P).v[tid * 130u + 1u] * w;
    }
    l_part = subgroupAdd(l_part);
    if (gl_SubgroupInvocationID == 0u) dcb_red_l[gl_SubgroupID] = l_part;
    barrier();
    const float L = dcb_red_l[0] + dcb_red_l[1] + dcb_red_l[2] + dcb_red_l[3];

    float a = 0.0;
    for (uint c = 0u; c < chunks; c++) {
        const float w = dcb_w[c];
        if (w != 0.0) a += F32(P).v[c * 130u + 2u + tid] * w;
    }
    const uint64_t out_off = (uint64_t(r) * uint64_t(nh) + uint64_t(h)) * 128u * 4u;
    F32(arg(1) + out_off).v[tid] = a / L;
}
#endif

// ---------------------------------------------------------------------------
// 30. Parallel-across-rows prefill short_conv, history update, and kv_prep.
//     Eliminates sequential `for (r = 0..rows)` loops during prompt prefill!
//     History is read-only during prefill and updated after the barrier by
//     `inkling2_sconv_hist_update` (requires `rows >= n_conv - 1`).
// ---------------------------------------------------------------------------

// Grid: (ceil(C / 256), rows, 1), 256 threads.
// Buffers: 0 x, 1 weight, 2 dyn, 3 history (RO), 4 y, 5 res.
// Params: 6 rows, 7 C, 8 n_conv, 9 n_heads, 10 has_res.
#ifdef KERNEL_inkling2_sconv_prefill
void main() {
    const uint c = gl_GlobalInvocationID.x;
    const uint r = gl_WorkGroupID.y;
    const uint C = arg_u32(7);
    if (c >= C) return;
    const uint n_conv = arg_u32(8);
    const uint n_heads = arg_u32(9);
    const uint has_res = arg_u32(10);
    const uint hist_len = n_conv - 1u;

    const uint64_t x_buf = arg(0);
    const uint64_t w_buf = arg(1) + uint64_t(c) * uint64_t(n_conv) * 4u;
    const uint64_t d_buf = arg(2);
    const uint64_t h_buf = arg(3) + uint64_t(c) * uint64_t(hist_len) * 4u;

    float ring[8];
    for (uint k = 0u; k < n_conv; k++) {
        const int src_r = int(r) + int(k) - int(hist_len);
        if (src_r < 0) {
            ring[k] = F32(h_buf).v[k + r];
        } else {
            ring[k] = F32(x_buf).v[uint(src_r) * C + c];
        }
    }
    const float xr = ring[hist_len];
    float acc = 0.0;
    for (uint k = 0u; k < n_conv; k++) {
        acc += ring[k] * F32(w_buf).v[k];
    }
    if (n_heads > 0u) {
        const uint head = c / (C / n_heads);
        const uint64_t d_off = (uint64_t(r) * uint64_t(n_heads) + uint64_t(head)) * uint64_t(n_conv) * 4u;
        for (uint lag = 0u; lag < n_conv; lag++) {
            acc += ring[n_conv - 1u - lag] * F32(d_buf + d_off).v[lag];
        }
    }
    const float scale = inversesqrt(float(((n_heads > 0u ? 2u : 1u) * n_conv) + 1u));
    float out_v = (xr + acc) * scale;
    if (has_res != 0u) out_v += F32(arg(5)).v[r * C + c];
    F32(arg(4)).v[r * C + c] = out_v;
}
#endif

// Grid: (ceil(C / 256), 1, 1), 256 threads.
// Buffers: 0 x, 1 history. Params: 2 rows (>= hist_len), 3 C, 4 hist_len.
#ifdef KERNEL_inkling2_sconv_hist_update
void main() {
    const uint c = gl_GlobalInvocationID.x;
    const uint C = arg_u32(3);
    if (c >= C) return;
    const uint rows = arg_u32(2);
    const uint hist_len = arg_u32(4);
    const uint64_t x_buf = arg(0);
    const uint64_t h_buf = arg(1) + uint64_t(c) * uint64_t(hist_len) * 4u;
    const uint base_r = rows - hist_len;
    for (uint k = 0u; k < hist_len; k++) {
        F32(h_buf).v[k] = F32(x_buf).v[(base_r + k) * C + c];
    }
}
#endif

// Grid: (n_head_kv, 2, rows), 128 threads (4 subgroups = 1 head of dim 128).
// Buffers: 0 k_raw, 1 v_raw, 2 k_conv_w, 3 v_conv_w, 4 k_dyn, 5 v_dyn,
//          6 k_hist (RO), 7 v_hist (RO), 8 k_cache, 9 v_cache.
// Params: 10 rows, 11 n_head_kv, 12 n_conv, 13 is_swa, 14 pos0, 15 slots,
//         16 qk_clip, 17 rms_eps.
#ifdef KERNEL_inkling2_kv_prep_prefill
shared float kvpp_sg[4];

void main() {
    const uint kh = gl_WorkGroupID.x;
    const uint is_v = gl_WorkGroupID.y;
    const uint r = gl_WorkGroupID.z;
    const uint d = gl_LocalInvocationIndex; // 0..128
    const uint nkv = arg_u32(11);
    const uint n_conv = arg_u32(12);
    const uint is_swa = arg_u32(13);
    const uint pos0 = arg_u32(14);
    const uint slots = arg_u32(15);
    const float qk_clip = arg_f32(16);
    const float rms_eps = arg_f32(17);
    const uint hist_len = n_conv - 1u;
    const uint C = nkv * 128u;
    const uint c = kh * 128u + d;

    const uint64_t x_buf = is_v == 0u ? arg(0) : arg(1);
    const uint64_t w_buf = (is_v == 0u ? arg(2) : arg(3)) + uint64_t(c) * uint64_t(n_conv) * 4u;
    const uint64_t d_buf = is_v == 0u ? arg(4) : arg(5);
    const uint64_t h_buf = (is_v == 0u ? arg(6) : arg(7)) + uint64_t(c) * uint64_t(hist_len) * 4u;
    const uint64_t c_buf = is_v == 0u ? arg(8) : arg(9);

    float ring[8];
    for (uint k = 0u; k < n_conv; k++) {
        const int src_r = int(r) + int(k) - int(hist_len);
        if (src_r < 0) {
            ring[k] = F32(h_buf).v[k + r];
        } else {
            ring[k] = F32(x_buf).v[uint(src_r) * C + c];
        }
    }
    const float xr = ring[hist_len];
    float acc = 0.0;
    for (uint k = 0u; k < n_conv; k++) acc += ring[k] * F32(w_buf).v[k];
    const uint has_dyn = is_swa == 0u ? 1u : 0u;
    if (has_dyn != 0u) {
        const uint64_t d_off = (uint64_t(r) * uint64_t(nkv) + uint64_t(kh)) * uint64_t(n_conv) * 4u;
        for (uint lag = 0u; lag < n_conv; lag++) {
            acc += ring[n_conv - 1u - lag] * F32(d_buf + d_off).v[lag];
        }
    }
    const float scale = inversesqrt(float(((has_dyn != 0u ? 2u : 1u) * n_conv) + 1u));
    float val = (xr + acc) * scale;

    float sq = subgroupAdd(val * val);
    if (gl_SubgroupInvocationID == 0u) kvpp_sg[gl_SubgroupID] = sq;
    barrier();
    const float tot = kvpp_sg[0] + kvpp_sg[1] + kvpp_sg[2] + kvpp_sg[3];
    if (is_v == 0u) {
        val *= clamp(qk_clip / (sqrt(tot) + 1e-6), 0.0, 1.0);
    } else {
        val *= inversesqrt(tot / 128.0 + rms_eps);
    }

    const uint pos = pos0 + r;
    const uint slot = is_swa != 0u ? (pos % slots) : pos;
    F16(c_buf + (uint64_t(slot) * uint64_t(C) + uint64_t(c)) * 2u).v[0] = float16_t(val);
}
#endif
