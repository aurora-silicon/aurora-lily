    const uint64_t b = row + uint64_t(t >> 3u) * 66u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const u16vec4 qv = I2U16x4(b + 2u + 8u * ib).v[0];
    const uint q01 = pack32(qv.xy), aux = pack32(qv.zw);
    const float db = d * float(2u * (aux >> 28u) + 1u);
    float s0 = 0.0, s1 = 0.0, s2 = 0.0, s3 = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint si = (aux >> (7u * l)) & 0x7fu;
        const uint qb = si + (si << 12u) + ((bitCount(si) & 1u) << 19u);
        const uvec4 sh = gum4_iq2xxs_grid[(q01 >> (8u * l)) & 0xffu]
            ^ ((uvec4(qb) << uvec4(15u, 14u, 13u, 12u)) & 0x80008000u);
        const vec2 p0 = unpackHalf2x16(sh.x), p1 = unpackHalf2x16(sh.y);
        const vec2 p2 = unpackHalf2x16(sh.z), p3 = unpackHalf2x16(sh.w);
        const vec4 wlo = vec4(p0.x, p1.x, p2.x, p3.x);
        const vec4 whi = vec4(p0.y, p1.y, p2.y, p3.y);
        const uint64_t loff = toff + 32u * l;
        s0 += dot(wlo, F32x4(x0 + loff).v[0]) + dot(whi, F32x4(x0 + loff + 16u).v[0]);
        s1 += dot(wlo, F32x4(x1 + loff).v[0]) + dot(whi, F32x4(x1 + loff + 16u).v[0]);
        if (cnt > 2u) s2 += dot(wlo, F32x4(x2 + loff).v[0]) + dot(whi, F32x4(x2 + loff + 16u).v[0]);
        if (cnt > 3u) s3 += dot(wlo, F32x4(x3 + loff).v[0]) + dot(whi, F32x4(x3 + loff + 16u).v[0]);
