    const uint qhu = uint(U16(bu + 34u).v[ib]);
    const float dlg = dg * float(2u * ((qhg >> 12u) & 7u) + 1u);
    const float dlu = du * float(2u * ((qhu >> 12u) & 7u) + 1u);
    const float delg = (qhg & 0x8000u) != 0u ? -0.125 : 0.125;
    const float delu = (qhu & 0x8000u) != 0u ? -0.125 : 0.125;
    const uint qsg = pack32(I2U16x2(bg + 2u + 4u * ib).v[0]);
    const uint qsu = pack32(I2U16x2(bu + 2u + 4u * ib).v[0]);
    float sg = 0.0, su = 0.0, xsum = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const vec4 xa = F32x4(xt + 32u * l).v[0];
        const vec4 xb = F32x4(xt + 32u * l + 16u).v[0];
        xsum += ((xa.x + xa.y) + (xa.z + xa.w)) + ((xb.x + xb.y) + (xb.z + xb.w));
        {
            const uint idx = ((qsg >> (8u * l)) & 0xffu) | (((qhg >> (3u * l)) & 7u) << 8u);
            const uint p = (gum4_iq1s_p[idx >> 1u] >> (16u * (idx & 1u))) & 0xffffu;
            const uvec2 ulo = gum4_iq1_4lut[p & 0xffu], uhi = gum4_iq1_4lut[p >> 8u];
            const vec2 w01 = unpackHalf2x16(ulo.x), w23 = unpackHalf2x16(ulo.y);
            const vec2 w45 = unpackHalf2x16(uhi.x), w67 = unpackHalf2x16(uhi.y);
            sg = fma(w01.x, xa.x, sg); sg = fma(w01.y, xa.y, sg);
            sg = fma(w23.x, xa.z, sg); sg = fma(w23.y, xa.w, sg);
            sg = fma(w45.x, xb.x, sg); sg = fma(w45.y, xb.y, sg);
            sg = fma(w67.x, xb.z, sg); sg = fma(w67.y, xb.w, sg);
        }
        {
            const uint idx = ((qsu >> (8u * l)) & 0xffu) | (((qhu >> (3u * l)) & 7u) << 8u);
            const uint p = (gum4_iq1s_p[idx >> 1u] >> (16u * (idx & 1u))) & 0xffffu;
            const uvec2 ulo = gum4_iq1_4lut[p & 0xffu], uhi = gum4_iq1_4lut[p >> 8u];
            const vec2 w01 = unpackHalf2x16(ulo.x), w23 = unpackHalf2x16(ulo.y);
            const vec2 w45 = unpackHalf2x16(uhi.x), w67 = unpackHalf2x16(uhi.y);
            su = fma(w01.x, xa.x, su); su = fma(w01.y, xa.y, su);
            su = fma(w23.x, xa.z, su); su = fma(w23.y, xa.w, su);
            su = fma(w45.x, xb.x, su); su = fma(w45.y, xb.y, su);
            su = fma(w67.x, xb.z, su); su = fma(w67.y, xb.w, su);
        }
    }
    out_g = dlg * fma(delg, xsum, sg);
    out_u = dlu * fma(delu, xsum, su);
#endif
}

// Pure-F32 multi-row (cnt=2..4) dot for IQ2/IQ1 types using scalar F32 accumulators.
void gum4_iq_dot_m_f32(uint64_t row, uint t, uint cnt, uint64_t x0, uint64_t x1, uint64_t x2, uint64_t x3,
                       out float d0, out float d1, out float d2, out float d3) {
    const uint64_t toff = uint64_t(t) * 128u;
    d0 = 0.0; d1 = 0.0; d2 = 0.0; d3 = 0.0;
