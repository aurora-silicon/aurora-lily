float gum4_sum8(float v) {
    v += subgroupShuffleXor(v, 4u);
    v += subgroupShuffleXor(v, 2u);
    v += subgroupShuffleXor(v, 1u);
    return v;
}

#if defined(KERNEL_inkling2_moe_gu_m4_q8_0)
void gum4_q8_dot_m(uint64_t row, uint t, uint cnt, uint64_t x0, uint64_t x1, uint64_t x2, uint64_t x3, inout float a0, inout float a1, inout float a2, inout float a3) {
    float d;
    vec4 w[8];
    i2_q8_decode_raw(row, t, d, w);
    const uint64_t toff = uint64_t(t) * 128u;
    float s0 = 0.0, s1 = 0.0, s2 = 0.0, s3 = 0.0;
    [[unroll]] for (uint q = 0u; q < 8u; q++) s0 += dot(w[q], F32x4(x0 + toff + 16u * q).v[0]);
    a0 += d * s0;
    if (cnt > 1u) {
        [[unroll]] for (uint q = 0u; q < 8u; q++) s1 += dot(w[q], F32x4(x1 + toff + 16u * q).v[0]);
        a1 += d * s1;
    }
    if (cnt > 2u) {
        [[unroll]] for (uint q = 0u; q < 8u; q++) s2 += dot(w[q], F32x4(x2 + toff + 16u * q).v[0]);
        a2 += d * s2;
    }
    if (cnt > 3u) {
        [[unroll]] for (uint q = 0u; q < 8u; q++) s3 += dot(w[q], F32x4(x3 + toff + 16u * q).v[0]);
        a3 += d * s3;
    }
}
#elif defined(KERNEL_inkling2_moe_gu_m4_iq2_xxs) || defined(KERNEL_inkling2_moe_gu_m4_iq2_xs) || \
      defined(KERNEL_inkling2_moe_gu_m4_iq1_s)
// Pure-F32 fused gate+up streaming-X dot for single-token tiles (cnt == 1, >90% of verify(4)).
void gum4_dot_pair_iq_f32(uint64_t row_g, uint64_t row_u, uint t, uint64_t xt, out float out_g, out float out_u) {
#if defined(KERNEL_inkling2_moe_gu_m4_iq2_xxs)
    const uint64_t bg = row_g + uint64_t(t >> 3u) * 66u;
    const uint64_t bu = row_u + uint64_t(t >> 3u) * 66u;
    const uint ib = t & 7u;
    const float dg = glm53_h2f(uint(U16(bg).v[0]));
    const float du = glm53_h2f(uint(U16(bu).v[0]));
    const u16vec4 qvg = I2U16x4(bg + 2u + 8u * ib).v[0];
    const u16vec4 qvu = I2U16x4(bu + 2u + 8u * ib).v[0];
    const uint q01g = pack32(qvg.xy), auxg = pack32(qvg.zw);
    const uint q01u = pack32(qvu.xy), auxu = pack32(qvu.zw);
    const float dbg = dg * float(2u * (auxg >> 28u) + 1u);
    const float dbu = du * float(2u * (auxu >> 28u) + 1u);
    float sg = 0.0, su = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const vec4 xa = F32x4(xt + 32u * l).v[0];
        const vec4 xb = F32x4(xt + 32u * l + 16u).v[0];
        {
            const uint si = (auxg >> (7u * l)) & 0x7fu;
            const uint qb = si + (si << 12u) + ((bitCount(si) & 1u) << 19u);
            const uvec4 sh = gum4_iq2xxs_grid[(q01g >> (8u * l)) & 0xffu]
                ^ ((uvec4(qb) << uvec4(15u, 14u, 13u, 12u)) & 0x80008000u);
            const vec2 p0 = unpackHalf2x16(sh.x), p1 = unpackHalf2x16(sh.y);
            const vec2 p2 = unpackHalf2x16(sh.z), p3 = unpackHalf2x16(sh.w);
            sg = fma(p0.x, xa.x, sg); sg = fma(p0.y, xb.x, sg);
            sg = fma(p1.x, xa.y, sg); sg = fma(p1.y, xb.y, sg);
            sg = fma(p2.x, xa.z, sg); sg = fma(p2.y, xb.z, sg);
            sg = fma(p3.x, xa.w, sg); sg = fma(p3.y, xb.w, sg);
        }
        {
            const uint si = (auxu >> (7u * l)) & 0x7fu;
            const uint qb = si + (si << 12u) + ((bitCount(si) & 1u) << 19u);
            const uvec4 sh = gum4_iq2xxs_grid[(q01u >> (8u * l)) & 0xffu]
                ^ ((uvec4(qb) << uvec4(15u, 14u, 13u, 12u)) & 0x80008000u);
            const vec2 p0 = unpackHalf2x16(sh.x), p1 = unpackHalf2x16(sh.y);
            const vec2 p2 = unpackHalf2x16(sh.z), p3 = unpackHalf2x16(sh.w);
            su = fma(p0.x, xa.x, su); su = fma(p0.y, xb.x, su);
            su = fma(p1.x, xa.y, su); su = fma(p1.y, xb.y, su);
            su = fma(p2.x, xa.z, su); su = fma(p2.y, xb.z, su);
            su = fma(p3.x, xa.w, su); su = fma(p3.y, xb.w, su);
        }
    }
    out_g = dbg * sg;
    out_u = dbu * su;
#elif defined(KERNEL_inkling2_moe_gu_m4_iq2_xs)
    [[unroll]] for (uint r = 0u; r < 2u; r++) {
        const uint64_t b = (r == 0u ? row_g : row_u) + uint64_t(t >> 3u) * 74u;
        const uint ib = t & 7u;
        const float d = glm53_h2f(uint(U16(b).v[0]));
        const u16vec4 qv = I2U16x4(b + 2u + 8u * ib).v[0];
        const uint scb = (uint(U16(b + 66u).v[ib >> 1u]) >> (8u * (ib & 1u))) & 0xffu;
        float s0 = 0.0, s1 = 0.0;
        [[unroll]] for (uint l = 0u; l < 4u; l++) {
            const vec4 xa = F32x4(xt + 32u * l).v[0];
            const vec4 xb = F32x4(xt + 32u * l + 16u).v[0];
            const uint q = uint(qv[l]);
            const uint g = q & 511u;
            const uint s7 = q >> 9u;
            const uint signs = s7 | ((bitCount(s7) & 1u) << 7u);
            const uint p = (gum4_iq2xs_p[g >> 1u] >> (16u * (g & 1u))) & 0xffffu;
            const uint sq = (signs & 0x55u) | ((signs & 0xaau) << 15u);
            const uvec2 ulo = gum4_iq2_4lut[p & 0xffu] ^ (uvec2(sq << 15u, sq << 13u) & 0x80008000u);
            const uvec2 uhi = gum4_iq2_4lut[p >> 8u]   ^ (uvec2(sq << 11u, sq << 9u)  & 0x80008000u);
            const vec2 w01 = unpackHalf2x16(ulo.x), w23 = unpackHalf2x16(ulo.y);
            const vec2 w45 = unpackHalf2x16(uhi.x), w67 = unpackHalf2x16(uhi.y);
            const float e = fma(w01.x, xa.x, fma(w01.y, xa.y, fma(w23.x, xa.z, w23.y * xa.w)))
                          + fma(w45.x, xb.x, fma(w45.y, xb.y, fma(w67.x, xb.z, w67.y * xb.w)));
