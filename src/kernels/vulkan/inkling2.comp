float ds_dot_task(uint64_t row, uint t, uint64_t x) {
#if defined(KERNEL_inkling2_moe_down_sum_q8_0)
    return i2_q8_dot_ptr(row, t, x);
#elif defined(KERNEL_inkling2_moe_down_sum_q2_0)
    const uint64_t b = row + uint64_t(t >> 1u) * 18u;
    const uint half_idx = t & 1u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint64_t qs = b + 2u + 8u * half_idx;
    float s = 0.0;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const uint pair = uint(U16(qs).v[i]);
        const vec4 x0 = F32x4(x + 32u * i).v[0];
        const vec4 x1 = F32x4(x + 32u * i + 16u).v[0];
        const vec4 w0 = vec4(
            float(int((pair >> 0u) & 3u) - 1),
            float(int((pair >> 2u) & 3u) - 1),
            float(int((pair >> 4u) & 3u) - 1),
            float(int((pair >> 6u) & 3u) - 1)
        );
        const vec4 w1 = vec4(
            float(int((pair >> 8u) & 3u) - 1),
            float(int((pair >> 10u) & 3u) - 1),
            float(int((pair >> 12u) & 3u) - 1),
            float(int((pair >> 14u) & 3u) - 1)
        );
        s += dot(w0, x0) + dot(w1, x1);
    }
    return d * s;
#elif defined(KERNEL_inkling2_moe_down_sum_mxfp4)
    const uint64_t b = row + uint64_t(t) * 17u;
    const uint e = uint(U8(b).v[0]);
    const float d = e < 2u ? uintBitsToFloat(0x00200000u << e) : uintBitsToFloat((e - 1u) << 23u);
    float s = 0.0;
    [[unroll]] for (uint q = 0u; q < 4u; q++) {
        const vec4 xlo = F32x4(x + 16u * q).v[0];
        const vec4 xhi = F32x4(x + 64u + 16u * q).v[0];
        const uint b0 = uint(U8(b + 1u).v[4u * q]);
        const uint b1 = uint(U8(b + 1u).v[4u * q + 1u]);
        const uint b2 = uint(U8(b + 1u).v[4u * q + 2u]);
        const uint b3 = uint(U8(b + 1u).v[4u * q + 3u]);
        s += dot(vec4(glm53_fp4_value(b0 & 15u), glm53_fp4_value(b1 & 15u),
