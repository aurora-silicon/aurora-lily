        }
        if (lane_t == 0u) {
            [[unroll]] for (uint m = 0u; m < 8u; m++) {
                if (m >= cnt) break;
                F32(arg(5)).v[dm4_rks[m] * H + n] = a[m];
            }
        }
        return;
    }
#else
#if defined(KERNEL_inkling2_moe_down_m4_q2_0)
    // 8 rows per subgroup (4 lanes/row): pure-F32 streaming-X with 2 KB shared LUT
    // and workgroup-uniform guards keeping all XOR reductions converged.
    if (H == 0u || tasks == 0u) return;
    const uint row_in_sg = gl_SubgroupInvocationID >> 2u;
    const uint lane_t = gl_SubgroupInvocationID & 3u;
    const uint n = gl_WorkGroupID.x * 64u + gl_SubgroupID * 8u + row_in_sg;
    const uint nr = min(n, H - 1u);
    const uint64_t w_row = arg(1) + (uint64_t(e) * uint64_t(H) + uint64_t(nr)) * uint64_t(row_bytes);
    if (cnt <= 4u) {
        const uint64_t xr0 = x_base + uint64_t(dm4_xoff[0]) * 4u;
        const uint64_t xr1 = cnt > 1u ? x_base + uint64_t(dm4_xoff[1]) * 4u : xr0;
        const uint64_t xr2 = cnt > 2u ? x_base + uint64_t(dm4_xoff[2]) * 4u : xr0;
        const uint64_t xr3 = cnt > 3u ? x_base + uint64_t(dm4_xoff[3]) * 4u : xr0;
        float a0 = 0.0, a1 = 0.0, a2 = 0.0, a3 = 0.0;
        for (uint t0 = 0u; t0 < tasks; t0 += 4u) {
            const uint t = t0 + lane_t;
            const uint tr = min(t, tasks - 1u);
            const uint64_t toff = uint64_t(tr) * 128u;
            const uint64_t b = w_row + uint64_t(tr >> 1u) * 18u;
            const float d = glm53_h2f(uint(U16(b).v[0]));
            const u16vec4 qv = I2U16x4(b + 2u + 8u * (tr & 1u)).v[0];
