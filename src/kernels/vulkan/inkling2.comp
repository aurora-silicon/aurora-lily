// ---------------------------------------------------------------------------
// 1. RMSNorm: y[r, j] = x[r, j] * rsqrt(mean(x^2) + eps) * (has_w ? w[j] : 1)
// Grid: (rows, 1, 1), 256 threads (8 subgroups).
// Buffers: 0 x, 1 w (0 if unused), 2 y. Params: 3 D, 4 eps_bits, 5 has_w.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_rms_norm
shared float rn_sg[8];
void main() {
    const uint r = gl_WorkGroupID.x;
    const uint D = arg_u32(3);
    const float eps = arg_f32(4);
    const uint has_w = arg_u32(5);
    const uint64_t x = arg(0) + uint64_t(r) * uint64_t(D) * 4u;
    const uint64_t w = arg(1);
    const uint64_t y = arg(2) + uint64_t(r) * uint64_t(D) * 4u;

    float sum = 0.0;
    for (uint i = gl_LocalInvocationIndex; i < D; i += 256u) {
        const float v = F32(x).v[i];
        sum += v * v;
    }
    sum = subgroupAdd(sum);
    if (gl_SubgroupInvocationID == 0u) rn_sg[gl_SubgroupID] = sum;
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        float tot = 0.0;
        for (uint s = 0u; s < 8u; s++) tot += rn_sg[s];
        rn_sg[0] = inversesqrt(tot / float(D) + eps);
    }
    barrier();
    const float inv = rn_sg[0];
    for (uint i = gl_LocalInvocationIndex; i < D; i += 256u) {
        float v = F32(x).v[i] * inv;
        if (has_w != 0u) v *= F32(w).v[i];
        F32(y).v[i] = v;
    }
}
#endif

// ---------------------------------------------------------------------------
// 2. Per-head L2 clip with optional per-channel scale and optional log-scale tau.
// x, y: [rows, n_heads, dim] (in-place allowed).
// scale: [n_heads, dim] (0 if unused).
// Grid: (n_heads, rows, 1), 32 threads (1 subgroup).
// Buffers: 0 x, 1 scale, 2 y.
// Params: 3 n_heads, 4 dim, 5 thresh, 6 has_scale, 7 pos0, 8 log_floor, 9 log_alpha.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_l2_clip
void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint n_heads = arg_u32(3);
    const uint dim = arg_u32(4);
    const float thresh = arg_f32(5);
    const uint has_scale = arg_u32(6);
    const uint pos0 = arg_u32(7);
    const uint log_floor = arg_u32(8);
    const float log_alpha = arg_f32(9);

    const uint64_t off = (uint64_t(r) * uint64_t(n_heads) + uint64_t(h)) * uint64_t(dim) * 4u;
    const uint64_t x = arg(0) + off;
    const uint64_t sc = arg(1) + uint64_t(h) * uint64_t(dim) * 4u;
    const uint64_t y = arg(2) + off;

    float sq = 0.0;
    for (uint i = gl_SubgroupInvocationID; i < dim; i += 32u) {
        float v = F32(x).v[i];
        if (has_scale != 0u) v *= F32(sc).v[i];
        sq += v * v;
    }
    const float norm = sqrt(subgroupAdd(sq)) + 1e-6;
    float factor = clamp(thresh / norm, 0.0, 1.0);
    if (log_alpha > 0.0 && log_floor > 0u) {
        const float ratio = max(1.0, float(pos0 + r + 1u) / float(log_floor));
        factor *= (1.0 + log_alpha * log(ratio));
    }
    for (uint i = gl_SubgroupInvocationID; i < dim; i += 32u) {
        float v = F32(x).v[i];
        if (has_scale != 0u) v *= F32(sc).v[i];
        F32(y).v[i] = v * factor;
    }
}
#endif

// ---------------------------------------------------------------------------
// 3. Block attention-residual mix (llama_model_inkling2::graph::mix).
// states: [n_states, rows, H] (concatenation of block snapshots and cur).
// queries: [n_q, H].
// out: [n_q, rows, H].
// Grid: (rows, 1, 1), 256 threads (8 subgroups).
// Buffers: 0 states_ptrs (u64[n_states]), 1 queries, 2 out, 3 copy_dst (optional), 4 norm_w (optional).
// Params: 5 H, 6 n_states (<= 16), 7 n_q (<= 4), 8 eps, 9 has_copy, 10 has_norm, 11 norm_eps.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_mix
shared float mx_sq[16][32];
shared float mx_dot[4][16][32];
shared float mx_inv[16];
shared float mx_w[4][16];
shared float mx_nsg[32];

void main() {
    const uint r = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint n_sg = gl_NumSubgroups;
    const uint H = arg_u32(5);
    const uint n_states = arg_u32(6);
    const uint n_q = arg_u32(7);
    const float eps = arg_f32(8);
    const uint has_copy = arg_u32(9);
    const uint has_norm = arg_u32(10);
    const float norm_eps = arg_f32(11);
    const uint64_t ptrs = arg(0);
    const uint64_t queries = arg(1);
    const uint64_t out_base = arg(2);
    const uint64_t copy_dst = arg(3);
    const uint64_t norm_w = arg(4);
    const uint64_t row_off = uint64_t(r) * uint64_t(H) * 4u;
    const float inv_sqrt_h = inversesqrt(float(H));
    const uint64_t stride = uint64_t(gl_NumWorkGroups.x) * uint64_t(H) * 4u;

    if ((H & 3u) == 0u && H <= 4096u && n_states <= 8u) {
        // Register-resident 1-vec4/thread path: reads every state ONCE (zero Pass-2
        // global loads) and completes mix in 2 barriers (3 with fused RMSNorm)!
        const uint H4 = H >> 2u;
        const bool in_bounds = tid < H4;
        const vec4 q0 = in_bounds ? F32x4(queries).v[tid] : vec4(0.0);
        const vec4 q1 = (in_bounds && n_q > 1u) ? F32x4(queries + uint64_t(H) * 4u).v[tid] : vec4(0.0);
        const vec4 q2 = (in_bounds && n_q > 2u) ? F32x4(queries + uint64_t(2u * H) * 4u).v[tid] : vec4(0.0);
        const vec4 q3 = (in_bounds && n_q > 3u) ? F32x4(queries + uint64_t(3u * H) * 4u).v[tid] : vec4(0.0);

        vec4 sv[8];
        vec4 last_v = vec4(0.0);
        [[unroll]] for (uint s = 0u; s < 8u; s++) {
            if (s >= n_states) break;
            const uint64_t st = U64(ptrs).v[s] + row_off;
            const vec4 v = in_bounds ? F32x4(st).v[tid] : vec4(0.0);
            sv[s] = v;
            last_v = v;
            const float sq = subgroupAdd(dot(v, v));
            const float d0 = subgroupAdd(dot(v, q0));
            const float d1 = n_q > 1u ? subgroupAdd(dot(v, q1)) : 0.0;
            const float d2 = n_q > 2u ? subgroupAdd(dot(v, q2)) : 0.0;
            const float d3 = n_q > 3u ? subgroupAdd(dot(v, q3)) : 0.0;
            if (lane == 0u) {
                mx_sq[s][sg] = sq;
                mx_dot[0][s][sg] = d0;
                if (n_q > 1u) mx_dot[1][s][sg] = d1;
                if (n_q > 2u) mx_dot[2][s][sg] = d2;
                if (n_q > 3u) mx_dot[3][s][sg] = d3;
            }
        }
        barrier();

        // Parallel per-(q, s) reduction across subgroups, then per-q softmax.
        if (tid < n_q * n_states) {
            const uint q = tid / n_states;
            const uint s = tid % n_states;
            float tsq = 0.0, td = 0.0;
            for (uint g = 0u; g < n_sg; g++) {
                tsq += mx_sq[s][g];
                td += mx_dot[q][s][g];
            }
            const float inv = inversesqrt(tsq / float(H) + eps);
            if (q == 0u) mx_inv[s] = inv;
            mx_w[q][s] = td * inv * inv_sqrt_h;
        }
        barrier();
        if (tid < n_q) {
            const uint q = tid;
            float logits[8];
            float mx = -1.0 / 0.0;
            for (uint s = 0u; s < n_states; s++) {
                const float lg = mx_w[q][s];
                logits[s] = lg;
                mx = max(mx, lg);
            }
            float sum = 0.0;
            for (uint s = 0u; s < n_states; s++) {
                logits[s] = exp(logits[s] - mx);
                sum += logits[s];
            }
            const float inv_sum = 1.0 / sum;
            for (uint s = 0u; s < n_states; s++) {
                mx_w[q][s] = logits[s] * inv_sum * mx_inv[s];
            }
        }
        barrier();

        vec4 a0 = vec4(0.0), a1 = vec4(0.0), a2 = vec4(0.0), a3 = vec4(0.0);
        if (in_bounds) {
            [[unroll]] for (uint s = 0u; s < 8u; s++) {
                if (s >= n_states) break;
                const vec4 v = sv[s];
                a0 += mx_w[0][s] * v;
                if (n_q > 1u) a1 += mx_w[1][s] * v;
                if (n_q > 2u) a2 += mx_w[2][s] * v;
                if (n_q > 3u) a3 += mx_w[3][s] * v;
            }
            if (has_copy != 0u) F32x4(copy_dst + row_off).v[tid] = last_v;
            if (has_norm == 0u) F32x4(out_base + row_off).v[tid] = a0;
            if (n_q > 1u) F32x4(out_base + stride + row_off).v[tid] = a1;
            if (n_q > 2u) F32x4(out_base + 2u * stride + row_off).v[tid] = a2;
            if (n_q > 3u) F32x4(out_base + 3u * stride + row_off).v[tid] = a3;
        }
        if (has_norm != 0u) {
            const float out_sq = subgroupAdd(in_bounds ? dot(a0, a0) : 0.0);
            if (lane == 0u) mx_nsg[sg] = out_sq;
            barrier();
            float tot = 0.0;
            for (uint g = 0u; g < n_sg; g++) tot += mx_nsg[g];
            const float inv = inversesqrt(tot / float(H) + norm_eps);
            if (in_bounds) {
                F32x4(out_base + row_off).v[tid] = a0 * inv * F32x4(norm_w).v[tid];
            }
        }
        return;
    }

    // Vectorized F32x4 path for n_states in 9..16 and H <= 4096 (multiple of 4).
    if ((H & 3u) == 0u && H <= 4096u) {
        const uint H4 = H >> 2u;
        const bool in_bounds = tid < H4;
        const vec4 q0 = in_bounds ? F32x4(queries).v[tid] : vec4(0.0);
        const vec4 q1 = (in_bounds && n_q > 1u) ? F32x4(queries + uint64_t(H) * 4u).v[tid] : vec4(0.0);
        const vec4 q2 = (in_bounds && n_q > 2u) ? F32x4(queries + uint64_t(2u * H) * 4u).v[tid] : vec4(0.0);
        const vec4 q3 = (in_bounds && n_q > 3u) ? F32x4(queries + uint64_t(3u * H) * 4u).v[tid] : vec4(0.0);

        for (uint s = 0u; s < n_states; s++) {
            const uint64_t st = U64(ptrs).v[s] + row_off;
            const vec4 v = in_bounds ? F32x4(st).v[tid] : vec4(0.0);
            const float sq = subgroupAdd(dot(v, v));
            const float d0 = subgroupAdd(dot(v, q0));
            const float d1 = n_q > 1u ? subgroupAdd(dot(v, q1)) : 0.0;
            const float d2 = n_q > 2u ? subgroupAdd(dot(v, q2)) : 0.0;
            const float d3 = n_q > 3u ? subgroupAdd(dot(v, q3)) : 0.0;
            if (lane == 0u) {
                mx_sq[s][sg] = sq;
                mx_dot[0][s][sg] = d0;
                if (n_q > 1u) mx_dot[1][s][sg] = d1;
                if (n_q > 2u) mx_dot[2][s][sg] = d2;
                if (n_q > 3u) mx_dot[3][s][sg] = d3;
            }
        }
        barrier();
        if (tid < n_q * n_states) {
            const uint q = tid / n_states;
            const uint s = tid % n_states;
            float tsq = 0.0, td = 0.0;
            for (uint g = 0u; g < n_sg; g++) {
                tsq += mx_sq[s][g];
                td += mx_dot[q][s][g];
            }
            const float inv = inversesqrt(tsq / float(H) + eps);
            if (q == 0u) mx_inv[s] = inv;
            mx_w[q][s] = td * inv * inv_sqrt_h;
        }
        barrier();
        if (tid < n_q) {
            const uint q = tid;
            float logits[16];
            float mx = -1.0 / 0.0;
            for (uint s = 0u; s < n_states; s++) {
                const float lg = mx_w[q][s];
                logits[s] = lg;
                mx = max(mx, lg);
            }
            float sum = 0.0;
            for (uint s = 0u; s < n_states; s++) {
                logits[s] = exp(logits[s] - mx);
                sum += logits[s];
            }
            const float inv_sum = 1.0 / sum;
            for (uint s = 0u; s < n_states; s++) {
                mx_w[q][s] = logits[s] * inv_sum * mx_inv[s];
            }
        }
        barrier();

        vec4 a0 = vec4(0.0), a1 = vec4(0.0), a2 = vec4(0.0), a3 = vec4(0.0);
        vec4 last_v = vec4(0.0);
        if (in_bounds) {
            for (uint s = 0u; s < n_states; s++) {
                const vec4 v = F32x4(U64(ptrs).v[s] + row_off).v[tid];
                last_v = v;
                a0 += mx_w[0][s] * v;
                if (n_q > 1u) a1 += mx_w[1][s] * v;
                if (n_q > 2u) a2 += mx_w[2][s] * v;
                if (n_q > 3u) a3 += mx_w[3][s] * v;
            }
            if (has_copy != 0u) F32x4(copy_dst + row_off).v[tid] = last_v;
            if (has_norm == 0u) F32x4(out_base + row_off).v[tid] = a0;
            if (n_q > 1u) F32x4(out_base + stride + row_off).v[tid] = a1;
            if (n_q > 2u) F32x4(out_base + 2u * stride + row_off).v[tid] = a2;
            if (n_q > 3u) F32x4(out_base + 3u * stride + row_off).v[tid] = a3;
        }
        if (has_norm != 0u) {
            const float out_sq = subgroupAdd(in_bounds ? dot(a0, a0) : 0.0);
            if (lane == 0u) mx_nsg[sg] = out_sq;
            barrier();
            float tot = 0.0;
            for (uint g = 0u; g < n_sg; g++) tot += mx_nsg[g];
            const float inv = inversesqrt(tot / float(H) + norm_eps);
            if (in_bounds) {
                F32x4(out_base + row_off).v[tid] = a0 * inv * F32x4(norm_w).v[tid];
            }
        }
        return;
    }

    // General fallback for H > 4096 or non-multiple-of-4 H (256 threads, 8 subgroups).
    for (uint s = 0u; s < n_states; s++) {
        const uint64_t st = U64(ptrs).v[s] + row_off;
        float sq = 0.0;
        float d0 = 0.0, d1 = 0.0, d2 = 0.0, d3 = 0.0;
        for (uint i = tid; i < H; i += 256u) {
            const float v = F32(st).v[i];
            sq += v * v;
            d0 += v * F32(queries).v[i];
            if (n_q > 1u) d1 += v * F32(queries + uint64_t(H) * 4u).v[i];
            if (n_q > 2u) d2 += v * F32(queries + uint64_t(2u * H) * 4u).v[i];
            if (n_q > 3u) d3 += v * F32(queries + uint64_t(3u * H) * 4u).v[i];
        }
        sq = subgroupAdd(sq);
        d0 = subgroupAdd(d0);
        if (n_q > 1u) d1 = subgroupAdd(d1);
        if (n_q > 2u) d2 = subgroupAdd(d2);
        if (n_q > 3u) d3 = subgroupAdd(d3);
        if (lane == 0u) {
            mx_sq[s][sg] = sq;
            mx_dot[0][s][sg] = d0;
            if (n_q > 1u) mx_dot[1][s][sg] = d1;
            if (n_q > 2u) mx_dot[2][s][sg] = d2;
            if (n_q > 3u) mx_dot[3][s][sg] = d3;
        }
    }
    barrier();
    if (tid < n_q) {
        const uint q = tid;
        float inv_s[16];
        float logits[16];
        float mx = -1.0 / 0.0;
        for (uint s = 0u; s < n_states; s++) {
            float tsq = 0.0, td = 0.0;
            for (uint g = 0u; g < n_sg; g++) {
                tsq += mx_sq[s][g];
                td += mx_dot[q][s][g];
            }
            const float inv = inversesqrt(tsq / float(H) + eps);
            inv_s[s] = inv;
            const float lg = td * inv * inv_sqrt_h;
            logits[s] = lg;
            mx = max(mx, lg);
        }
        float sum = 0.0;
        for (uint s = 0u; s < n_states; s++) {
            logits[s] = exp(logits[s] - mx);
            sum += logits[s];
        }
        const float inv_sum = 1.0 / sum;
        for (uint s = 0u; s < n_states; s++) mx_w[q][s] = logits[s] * inv_sum * inv_s[s];
    }
    barrier();

    float out_sq = 0.0;
    for (uint i = tid; i < H; i += 256u) {
        float acc0 = 0.0, acc1 = 0.0, acc2 = 0.0, acc3 = 0.0;
        float last_v = 0.0;
        for (uint s = 0u; s < n_states; s++) {
            const float v = F32(U64(ptrs).v[s] + row_off).v[i];
            last_v = v;
            acc0 += mx_w[0][s] * v;
            if (n_q > 1u) acc1 += mx_w[1][s] * v;
            if (n_q > 2u) acc2 += mx_w[2][s] * v;
            if (n_q > 3u) acc3 += mx_w[3][s] * v;
        }
        if (has_copy != 0u) F32(copy_dst + row_off).v[i] = last_v;
        F32(out_base + row_off).v[i] = acc0;
        if (has_norm != 0u) out_sq += acc0 * acc0;
        if (n_q > 1u) F32(out_base + stride + row_off).v[i] = acc1;
        if (n_q > 2u) F32(out_base + 2u * stride + row_off).v[i] = acc2;
        if (n_q > 3u) F32(out_base + 3u * stride + row_off).v[i] = acc3;
    }
    if (has_norm != 0u) {
        out_sq = subgroupAdd(out_sq);
        if (lane == 0u) mx_nsg[sg] = out_sq;
        barrier();
        float tot = 0.0;
        for (uint g = 0u; g < n_sg; g++) tot += mx_nsg[g];
        const float inv = inversesqrt(tot / float(H) + norm_eps);
        for (uint i = tid; i < H; i += 256u) {
            F32(out_base + row_off).v[i] *= inv * F32(norm_w).v[i];
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// 4. Loop controller concat-RMSNorm: out[r, 0..H] = rms(cur[r]), out[r, H..2H] = rms(msg[r]).
// Grid: (rows, 2, 1), 256 threads.
// Buffers: 0 cur, 1 msg, 2 out. Params: 3 H, 4 eps.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_ctrl_concat_norm
shared float cn_sg[8];
void main() {
    const uint r = gl_WorkGroupID.x;
    const uint half_id = gl_WorkGroupID.y;
    const uint H = arg_u32(3);
    const float eps = arg_f32(4);
    const uint64_t src = (half_id == 0u ? arg(0) : arg(1)) + uint64_t(r) * uint64_t(H) * 4u;
    const uint64_t dst = arg(2) + (uint64_t(r) * 2u + uint64_t(half_id)) * uint64_t(H) * 4u;

    float sq = 0.0;
    for (uint i = gl_LocalInvocationIndex; i < H; i += 256u) {
        const float v = F32(src).v[i];
        sq += v * v;
    }
    sq = subgroupAdd(sq);
    if (gl_SubgroupInvocationID == 0u) cn_sg[gl_SubgroupID] = sq;
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        float tot = 0.0;
        for (uint g = 0u; g < 8u; g++) tot += cn_sg[g];
        cn_sg[0] = inversesqrt(tot / float(H) + eps);
    }
    barrier();
    const float inv = cn_sg[0];
    for (uint i = gl_LocalInvocationIndex; i < H; i += 256u) {
        F32(dst).v[i] = F32(src).v[i] * inv;
    }
}
#endif

// ---------------------------------------------------------------------------
// 5. Loop controller blend: out = (1 - tanh(forget)) * cur + tanh(gain) * msg.
// Grid: (ceil(N/256), 1, 1), 256 threads.
// Buffers: 0 cur, 1 msg, 2 gain, 3 forget, 4 out. Params: 5 N.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_ctrl_blend
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= arg_u32(5)) return;
    const float c = F32(arg(0)).v[i];
    const float m = F32(arg(1)).v[i];
    const float g = tanh(F32(arg(2)).v[i]);
    const float f = tanh(F32(arg(3)).v[i]);
    F32(arg(4)).v[i] = (1.0 - f) * c + g * m;
}
#endif

// ---------------------------------------------------------------------------
// 6. Causal short convolution with residual, optional dynamic taps, and in-place
// history update.
// x, y: [rows, C]; weight: [C, n_conv]; history: [C, n_conv - 1];
// dyn (optional, 0 if unused): [rows, n_heads, n_conv].
// Grid: (ceil(C/256), 1, 1), 256 threads.
// Buffers: 0 x, 1 weight, 2 dyn, 3 history, 4 y, 5 trace (optional), 6 res (optional).
// Params: 7 rows, 8 C, 9 n_conv (<= 8), 10 n_heads (0 if static), 11 has_trace, 12 has_res.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_sconv
void main() {
    const uint c = gl_GlobalInvocationID.x;
    const uint C = arg_u32(8);
    if (c >= C) return;
    const uint rows = arg_u32(7);
    const uint n_conv = arg_u32(9);
    const uint n_heads = arg_u32(10);
    const uint has_trace = arg_u32(11);
    const uint has_res = arg_u32(12);
    const uint hist_len = n_conv - 1u;

    const uint64_t x_buf = arg(0);
    const uint64_t w_buf = arg(1) + uint64_t(c) * uint64_t(n_conv) * 4u;
    const uint64_t d_buf = arg(2);
    const uint64_t h_buf = arg(3) + uint64_t(c) * uint64_t(hist_len) * 4u;
    const uint64_t y_buf = arg(4);
    const uint64_t t_buf = arg(5);
    const uint64_t r_buf = arg(6);

    float w[8];
    for (uint k = 0u; k < n_conv; k++) w[k] = F32(w_buf).v[k];

    float ring[8];
    for (uint k = 0u; k < hist_len; k++) ring[k] = F32(h_buf).v[k];

    const uint head = n_heads > 0u ? (c / (C / n_heads)) : 0u;
    const float scale = inversesqrt(float(((n_heads > 0u ? 2u : 1u) * n_conv) + 1u));

    for (uint r = 0u; r < rows; r++) {
        const float xr = F32(x_buf).v[r * C + c];
        ring[hist_len] = xr;

        float acc = 0.0;
        for (uint k = 0u; k < n_conv; k++) {
            acc += ring[k] * w[k];
        }
        if (n_heads > 0u) {
            const uint64_t d_off = (uint64_t(r) * uint64_t(n_heads) + uint64_t(head)) * uint64_t(n_conv) * 4u;
            for (uint lag = 0u; lag < n_conv; lag++) {
                acc += ring[n_conv - 1u - lag] * F32(d_buf + d_off).v[lag];
            }
        }
        float out_v = (xr + acc) * scale;
        if (has_res != 0u) out_v += F32(r_buf).v[r * C + c];
        F32(y_buf).v[r * C + c] = out_v;

        // Shift ring left by 1.
        for (uint k = 0u; k < hist_len; k++) {
            ring[k] = ring[k + 1u];
        }
        if (has_trace != 0u) {
            const uint64_t tr = t_buf + (uint64_t(r) * uint64_t(C) + uint64_t(c)) * uint64_t(hist_len) * 4u;
            for (uint k = 0u; k < hist_len; k++) {
                F32(tr).v[k] = ring[k];
            }
        }
    }

    for (uint k = 0u; k < hist_len; k++) {
        F32(h_buf).v[k] = ring[k];
    }
}
#endif

// ---------------------------------------------------------------------------
// 7. Store K and V into f16 KV cache (SWA ring or global linear).
// k_in, v_in: [rows, n_head_kv, head_dim] f32.
// k_cache, v_cache: [slots, n_head_kv, head_dim] f16.
// Grid: (ceil(kv_width/256), rows, 1), 256 threads.
// Buffers: 0 k_in, 1 v_in, 2 k_cache, 3 v_cache.
// Params: 4 kv_width, 5 pos0, 6 slots, 7 is_swa.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_kv_store
void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint r = gl_WorkGroupID.y;
    const uint kv_w = arg_u32(4);
    if (i >= kv_w) return;
    const uint pos = arg_u32(5) + r;
    const uint slots = arg_u32(6);
    const uint slot = arg_u32(7) != 0u ? (pos % slots) : pos;
    const uint64_t src_off = (uint64_t(r) * uint64_t(kv_w) + uint64_t(i)) * 4u;
    const uint64_t dst_off = (uint64_t(slot) * uint64_t(kv_w) + uint64_t(i)) * 2u;
    F16(arg(2) + dst_off).v[0] = float16_t(F32(arg(0) + src_off).v[0]);
    F16(arg(3) + dst_off).v[0] = float16_t(F32(arg(1) + src_off).v[0]);
}
#endif

// ---------------------------------------------------------------------------
// 8. Relative-position bias GQA attention with zero sink (no RoPE).
// One subgroup (32 lanes) per (row, query_head), head_dim = 128 (4 vals/lane).
// q: [rows, n_head, 128] f32
// k_cache, v_cache: [slots, n_head_kv, 128] f16
// rel_table: [rows, n_head, extent] f32 (R @ attn_rel_bias)
// sinks: [rows, n_head] f32
// out: [rows, n_head, 128] f32
// Grid: (n_head, rows, 1), 32 threads.
// Buffers: 0 q, 1 k_cache, 2 v_cache, 3 rel_table, 4 sinks, 5 out, 6 gate (optional), 7 q_clip (optional).
// Params: 8 n_head, 9 n_head_kv, 10 pos0, 11 slots, 12 is_swa, 13 window, 14 extent,
//         15 has_gate, 16 has_q_clip, 17 qk_clip, 18 log_floor, 19 log_alpha.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_attn
void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID;
    const uint n_head = arg_u32(8);
    const uint n_head_kv = arg_u32(9);
    const uint pos_q = arg_u32(10) + r;
    const uint slots = arg_u32(11);
    const uint is_swa = arg_u32(12);
    const uint window = arg_u32(13);
    const uint extent = arg_u32(14);
    const uint has_gate = arg_u32(15);
    const uint has_q_clip = arg_u32(16);

    const uint kv_h = h / (n_head / n_head_kv);
    const uint64_t q_off = (uint64_t(r) * uint64_t(n_head) + uint64_t(h)) * 128u * 4u;
    vec4 qv = F32x4(arg(0) + q_off).v[lane];
    if (has_q_clip != 0u) {
        qv *= F32x4(arg(7) + uint64_t(h) * 128u * 4u).v[lane];
        const float norm = sqrt(subgroupAdd(dot(qv, qv))) + 1e-6;
        float factor = clamp(arg_f32(17) / norm, 0.0, 1.0);
        const uint log_floor = arg_u32(18);
        const float log_alpha = arg_f32(19);
        if (log_alpha > 0.0 && log_floor > 0u) {
            const float ratio = float(pos_q + 1u) / float(log_floor);
            if (ratio > 1.0) factor *= (1.0 + log_alpha * log(ratio));
        }
        qv *= factor * inversesqrt(128.0);
    } else {
        qv *= inversesqrt(128.0);
    }
    const float sink = F32(arg(4)).v[r * n_head + h];
    const uint64_t rel_row = arg(3) + (uint64_t(r) * uint64_t(n_head) + uint64_t(h)) * uint64_t(extent) * 4u;

    const uint k_start = (is_swa != 0u && pos_q + 1u > window) ? (pos_q + 1u - window) : 0u;
    const uint k_end = pos_q + 1u;
    const uint64_t kv_stride = uint64_t(n_head_kv) * 128u * 2u;
    const uint64_t kv_h_off = uint64_t(kv_h) * 128u * 2u;

    // Implicit zero attention sink: m = 0.0, l = 1.0 (exp(0 - 0) = 1.0).
    float m = 0.0;
    float l = 1.0;
    vec4 acc = vec4(0.0);

    for (uint p = k_start; p < k_end; p++) {
        const uint slot = is_swa != 0u ? (p % slots) : p;
        const uint64_t k_ptr = arg(1) + uint64_t(slot) * kv_stride + kv_h_off + uint64_t(lane) * 8u;
        const uvec2 kp = U32x2(k_ptr).v[0];
        const vec4 kv = vec4(unpackHalf2x16(kp.x), unpackHalf2x16(kp.y));
        const float dot = subgroupAdd(dot(qv, kv));

        const uint dist = pos_q - p;
        const float rb = dist < extent ? F32(rel_row).v[dist] : 0.0;
        const float s = dot + rb - sink;

        const float m_new = max(m, s);
        const float alpha = exp(m - m_new);
        const float beta = exp(s - m_new);
        l = l * alpha + beta;
        m = m_new;

        const uint64_t v_ptr = arg(2) + uint64_t(slot) * kv_stride + kv_h_off + uint64_t(lane) * 8u;
        const uvec2 vp = U32x2(v_ptr).v[0];
        const vec4 vv = vec4(unpackHalf2x16(vp.x), unpackHalf2x16(vp.y));
        acc = acc * alpha + vv * beta;
    }

    vec4 res = acc / l;
    if (has_gate != 0u) {
        const vec4 gv = F32x4(arg(6) + q_off).v[lane];
        res = res / (vec4(1.0) + exp(-gv));
    }
    F32x4(arg(5) + q_off).v[lane] = res;
}
#endif

// ---------------------------------------------------------------------------
// 9. Elementwise helpers: gate_mul (a * sigmoid(g)), add (a + b), softcap.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_gate_mul
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= arg_u32(3)) return;
    const float a = F32(arg(0)).v[i];
    const float g = F32(arg(1)).v[i];
    F32(arg(2)).v[i] = a / (1.0 + exp(-g));
}
#endif

#ifdef KERNEL_inkling2_add
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= arg_u32(3)) return;
    F32(arg(2)).v[i] = F32(arg(0)).v[i] + F32(arg(1)).v[i];
}
#endif

#ifdef KERNEL_inkling2_softcap
void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint cols_out = arg_u32(2);
    const uint r = gl_WorkGroupID.y;
    if (i >= cols_out) return;
    const uint cols_in = arg_u32(3);
    const float cap = arg_f32(4);
    float v = F32(arg(0)).v[r * cols_in + i];
    if (cap > 0.0) v = cap * tanh(v / cap);
    F32(arg(1)).v[r * cols_out + i] = v;
}
#endif

// ---------------------------------------------------------------------------
// 10. Sigmoid top-k MoE router with optional bias and route_scale.
// logits: [rows, E], bias: [E] (0 if unused), out_ids: [rows, K] u32, out_w: [rows, K] f32.
// Grid: (rows, 1, 1), 32 threads (1 subgroup).
// Buffers: 0 logits, 1 bias, 2 out_ids, 3 out_w.
// Params: 4 E (<= 256), 5 K (<= 16), 6 has_bias, 7 route_scale.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_router
void main() {
    const uint r = gl_WorkGroupID.x;
    const uint lane = gl_SubgroupInvocationID;
    const uint E = arg_u32(4);
    const uint K = arg_u32(5);
    const uint has_bias = arg_u32(6);
    const float route_scale = arg_f32(7);
    const uint64_t lrow = arg(0) + uint64_t(r) * uint64_t(E) * 4u;
    const uint64_t bias = arg(1);

    float p[8];
    float s[8];
    [[unroll]] for (uint j = 0u; j < 8u; j++) {
        const uint e = lane + 32u * j;
        if (e < E) {
            const float pr = 1.0 / (1.0 + exp(-F32(lrow).v[e]));
            p[j] = pr;
            s[j] = pr + (has_bias != 0u ? F32(bias).v[e] : 0.0);
        } else {
            p[j] = 0.0;
            s[j] = -1e30;
        }
    }

    uint my_e = 0u;
    float my_w = 0.0;
    float wsum = 0.0;
    for (uint k = 0u; k < K; k++) {
        float best_s = -1e30;
        uint best_e = 0xffffffffu;
        [[unroll]] for (uint j = 0u; j < 8u; j++) {
            if (s[j] > best_s) {
                best_s = s[j];
                best_e = lane + 32u * j;
            }
        }
        const float top = subgroupMax(best_s);
        const uint e = subgroupMin(best_s == top ? best_e : 0xffffffffu);
        float ep = 0.0;
        [[unroll]] for (uint j = 0u; j < 8u; j++) {
            if (lane + 32u * j == e) {
                ep = p[j];
                s[j] = -1e30;
            }
        }
        const float prob_e = subgroupAdd(ep);
        wsum += prob_e;
        if (lane == k) {
            my_e = e;
            my_w = prob_e;
        }
    }

    if (lane < K) {
        const float inv = route_scale / max(wsum, 1e-20);
        U32(arg(2)).v[r * K + lane] = my_e;
        F32(arg(3)).v[r * K + lane] = my_w * inv;
    }
}
#endif

// ---------------------------------------------------------------------------
// 11. SITU activation on fused [rows * K, 2 * ff] -> [rows * K, ff],
// with optional per-expert scale[expert_id].
// Grid: (ceil(ff/256), rows * K, 1), 256 threads.
// Buffers: 0 gate_up, 1 exp_ids, 2 exp_scale (0 if unused), 3 out.
// Params: 4 ff, 5 beta, 6 linear_beta, 7 has_scale.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_situ
void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint rk = gl_WorkGroupID.y;
    const uint ff = arg_u32(4);
    if (i >= ff) return;
    const float beta = arg_f32(5);
    const float lb = arg_f32(6);
    const uint has_scale = arg_u32(7);

    float sc = 1.0;
    if (has_scale != 0u) {
        const uint e = U32(arg(1)).v[rk];
        sc = F32(arg(2)).v[e];
    }
    const uint64_t row = arg(0) + uint64_t(rk) * uint64_t(2u * ff) * 4u;
    const float gate = F32(row).v[i] * sc;
    const float up = F32(row).v[ff + i] * sc;
    const float act = beta * tanh(gate / beta) / (1.0 + exp(-gate));
    const float lin = lb > 0.0 ? lb * tanh(up / lb) : up;
    F32(arg(3)).v[rk * ff + i] = act * lin;
}
#endif

// ---------------------------------------------------------------------------
// 12. MoE weighted sum over K experts, with optional per-expert down_scale.
// in: [rows, K, H], ids: [rows, K] u32, weights: [rows, K] f32, scale: [E] (0 if unused).
// out: [rows, H].
// Grid: (ceil(H/256), rows, 1), 256 threads.
// Buffers: 0 in_buf, 1 ids, 2 weights, 3 scale, 4 out.
// Params: 5 H, 6 K, 7 has_scale.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_moe_sum
void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint r = gl_WorkGroupID.y;
    const uint H = arg_u32(5);
    if (i >= H) return;
    const uint K = arg_u32(6);
    const uint has_scale = arg_u32(7);
    float acc = 0.0;
    for (uint k = 0u; k < K; k++) {
        const uint rk = r * K + k;
        float w = F32(arg(2)).v[rk];
        if (has_scale != 0u) {
            const uint e = U32(arg(1)).v[rk];
            w *= F32(arg(3)).v[e];
        }
        acc += w * F32(arg(0)).v[rk * H + i];
    }
    F32(arg(4)).v[r * H + i] = acc;
}
#endif

