        return;
    }
#elif defined(KERNEL_inkling2_moe_down_m4_q8_0)
    // 4 rows/sg (8 lanes/row) = 32 rows/WG: 8 x 34B = 272B coalesced bursts + 2x grid occupancy!
    const uint row_in_sg = gl_SubgroupInvocationID >> 3u;
    const uint lane_t = gl_SubgroupInvocationID & 7u;
    const uint n = gl_WorkGroupID.x * 32u + gl_SubgroupID * 4u + row_in_sg;
    if (n >= H) return;
    const uint64_t w_row = arg(1) + (uint64_t(e) * uint64_t(H) + uint64_t(n)) * uint64_t(row_bytes);

    if (cnt == 1u) {
        const uint64_t xr0 = x_base + uint64_t(dm4_xoff[0]) * 4u;
        float a0 = 0.0;
        for (uint t = lane_t; t < tasks; t += 8u) {
