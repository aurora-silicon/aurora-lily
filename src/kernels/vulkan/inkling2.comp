#ifdef GUM4_TYPE
float gum4_sum8(float v) {
    v += subgroupShuffleXor(v, 4u);
    v += subgroupShuffleXor(v, 2u);
    v += subgroupShuffleXor(v, 1u);
    return v;
}

#if defined(KERNEL_inkling2_moe_gu_m4_q8_0)
void gum4_q8_dot_m(uint64_t row, uint t, uint cnt, uint64_t x0, uint64_t x1, uint64_t x2, uint64_t x3, inout float a0, inout float a1, inout float a2, inout float a3) {
    float d;
    vec4 w[8];
    i2_q8_decode_raw(row, t, d, w);
    const uint64_t toff = uint64_t(t) * 128u;
    float s0 = 0.0, s1 = 0.0, s2 = 0.0, s3 = 0.0;
    [[unroll]] for (uint q = 0u; q < 8u; q++) s0 += dot(w[q], F32x4(x0 + toff + 16u * q).v[0]);
    a0 += d * s0;
    if (cnt > 1u) {
        [[unroll]] for (uint q = 0u; q < 8u; q++) s1 += dot(w[q], F32x4(x1 + toff + 16u * q).v[0]);
        a1 += d * s1;
    }
    if (cnt > 2u) {
        [[unroll]] for (uint q = 0u; q < 8u; q++) s2 += dot(w[q], F32x4(x2 + toff + 16u * q).v[0]);
        a2 += d * s2;
    }
    if (cnt > 3u) {
        [[unroll]] for (uint q = 0u; q < 8u; q++) s3 += dot(w[q], F32x4(x3 + toff + 16u * q).v[0]);
        a3 += d * s3;
    }
}
#else
void gum4_dot_task(uint64_t row, uint t, uint cnt, uint64_t x_rows[4], inout float acc[4]) {
    const uint64_t toff = uint64_t(t) * 128u;
#if defined(KERNEL_inkling2_moe_gu_m4_iq2_xxs)
    const uint64_t b = row + uint64_t(t >> 3u) * 66u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint q01 = uint(U16(b + 2u).v[4u * ib]) | (uint(U16(b + 2u).v[4u * ib + 1u]) << 16u);
    const uint aux = uint(U16(b + 2u).v[4u * ib + 2u]) | (uint(U16(b + 2u).v[4u * ib + 3u]) << 16u);
    const float db = d * (0.5 + float(aux >> 28u)) * 0.25;
    float s[4] = float[4](0.0, 0.0, 0.0, 0.0);
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint g = (q01 >> (8u * l)) & 0xffu;
        const uint s7 = (aux >> (7u * l)) & 0x7fu;
        const uvec4 sh = glm53_iq2xxs_grid_h[g] ^ glm53_iq2xxs_signs_h[s7];
        const vec2 p0 = unpackHalf2x16(sh.x), p1 = unpackHalf2x16(sh.y);
        const vec2 p2 = unpackHalf2x16(sh.z), p3 = unpackHalf2x16(sh.w);
        const vec4 wlo = vec4(p0.x, p1.x, p2.x, p3.x);
        const vec4 whi = vec4(p0.y, p1.y, p2.y, p3.y);
        for (uint m = 0u; m < cnt; m++) {
            const uint64_t xp = x_rows[m] + toff + 32u * l;
            s[m] += dot(wlo, F32x4(xp).v[0]) + dot(whi, F32x4(xp + 16u).v[0]);
        }
    }
    for (uint m = 0u; m < cnt; m++) acc[m] += db * s[m];
#elif defined(KERNEL_inkling2_moe_gu_m4_iq2_xs)
    const uint64_t b = row + uint64_t(t >> 3u) * 74u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint scb = (uint(U16(b + 66u).v[ib >> 1u]) >> (8u * (ib & 1u))) & 0xffu;
    const float db0 = d * (0.5 + float(scb & 0xfu)) * 0.25;
    const float db1 = d * (0.5 + float(scb >> 4u)) * 0.25;
    float s0[4] = float[4](0.0, 0.0, 0.0, 0.0);
    float s1[4] = float[4](0.0, 0.0, 0.0, 0.0);
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint q = uint(U16(b + 2u).v[4u * ib + l]);
        const uint g = q & 511u;
        const uint s7 = q >> 9u;
        const uint signs = s7 | ((bitCount(s7) & 1u) << 7u);
        const uint lo = glm53_iq2xs_grid[2u * g];
        const uint hi = glm53_iq2xs_grid[2u * g + 1u];
        const vec4 wlo = vec4(
            (signs & 1u) != 0u ? -float(lo & 0xffu) : float(lo & 0xffu),
            (signs & 2u) != 0u ? -float((lo >> 8u) & 0xffu) : float((lo >> 8u) & 0xffu),
            (signs & 4u) != 0u ? -float((lo >> 16u) & 0xffu) : float((lo >> 16u) & 0xffu),
            (signs & 8u) != 0u ? -float(lo >> 24u) : float(lo >> 24u)
        );
        const vec4 whi = vec4(
            (signs & 16u) != 0u ? -float(hi & 0xffu) : float(hi & 0xffu),
            (signs & 32u) != 0u ? -float((hi >> 8u) & 0xffu) : float((hi >> 8u) & 0xffu),
            (signs & 64u) != 0u ? -float((hi >> 16u) & 0xffu) : float((hi >> 16u) & 0xffu),
            (signs & 128u) != 0u ? -float(hi >> 24u) : float(hi >> 24u)
        );
        for (uint m = 0u; m < cnt; m++) {
            const uint64_t xp = x_rows[m] + toff + 32u * l;
            const float e = dot(wlo, F32x4(xp).v[0]) + dot(whi, F32x4(xp + 16u).v[0]);
            if (l < 2u) s0[m] += e; else s1[m] += e;
        }
    }
    for (uint m = 0u; m < cnt; m++) acc[m] += db0 * s0[m] + db1 * s1[m];
#elif defined(KERNEL_inkling2_moe_gu_m4_iq2_s)
    const uint64_t b = row + uint64_t(t >> 3u) * 82u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint qs = uint(U16(b + 2u).v[2u * ib]) | (uint(U16(b + 2u).v[2u * ib + 1u]) << 16u);
    const uint sg = uint(U16(b + 34u).v[2u * ib]) | (uint(U16(b + 34u).v[2u * ib + 1u]) << 16u);
    const uint hs = uint(U16(b + 66u).v[ib >> 1u]) >> (8u * (ib & 1u));
    const uint scb = uint(U16(b + 74u).v[ib >> 1u]) >> (8u * (ib & 1u));
    const float db0 = d * (0.5 + float(scb & 0xfu)) * 0.25;
    const float db1 = d * (0.5 + float((scb >> 4u) & 0xfu)) * 0.25;
    float s0[4] = float[4](0.0, 0.0, 0.0, 0.0);
