// ---------------------------------------------------------------------------
// 15. Relative-position bias projection:
//     out[r, e] = sum_{d=0..D} x[r, d] * bias[e, d]
// Tiles n_rows in blocks of 32 (when D <= 16) with 32 threads (1 subgroup) per
// WG: for ext=1024 launches 32 WGs/tile (8x more parallelism on decode, 32x
// less bias bandwidth on prefill) and fuses R L2 clip + tau for ALL row counts.
// x: [n_rows, D] f32, bias: [ext, D] (ty: 0=F32, 1=F16, 2=BF16), out: [n_rows, ext] f32.
// Grid: (ceil(ext / 32), D <= 16 ? ceil(n_rows / 32) : n_rows, 1), 32 threads.
// Buffers: 0 x, 1 bias, 2 out, 3 r_clip (optional).
// Params: 4 D, 5 ext, 6 ty, 7 n_rows, 8 has_r_clip, 9 rel_clip, 10 pos0,
//         11 log_floor, 12 log_alpha, 13 nh.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_rel_bias
shared float rb_x[512]; // up to 32 * 16 floats = 2 KB
shared float rb_b[512]; // up to 32 * 16 floats = 2 KB (coalesced bias tile)

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint D = arg_u32(4);
    const uint ext = arg_u32(5);
    const uint ty = arg_u32(6);
    const uint n_rows = arg_u32(7);
    const uint has_r_clip = arg_u32(8);

    if (D <= 16u) {
        const uint tile_r0 = gl_WorkGroupID.y * 32u;
        const uint tile_cnt = min(32u, n_rows - tile_r0);
        const uint e0 = gl_WorkGroupID.x * 32u;
        const uint e_cnt = min(32u, ext - e0);
        const uint total_x = tile_cnt * D;
        const uint total_b = e_cnt * D;
        const uint64_t x_base = arg(0) + uint64_t(tile_r0) * uint64_t(D) * 4u;
        for (uint i = tid; i < total_x; i += 128u) {
            rb_x[i] = F32(x_base).v[i];
        }
        // Coalesced bias tile load into shared memory (zero 64B-stride waste!).
        if (ty == 0u && D == 16u) {
            const uint be = tid >> 2u;
            const uint bd = (tid & 3u) << 2u;
            if (be < e_cnt) {
                const vec4 v = F32x4(arg(1) + (uint64_t(e0 + be) * 16u + uint64_t(bd)) * 4u).v[0];
                rb_b[be * 16u + bd] = v.x;
                rb_b[be * 16u + bd + 1u] = v.y;
                rb_b[be * 16u + bd + 2u] = v.z;
                rb_b[be * 16u + bd + 3u] = v.w;
            }
        } else if (ty == 0u) {
            const uint64_t b_base = arg(1) + uint64_t(e0) * uint64_t(D) * 4u;
            for (uint i = tid; i < total_b; i += 128u) rb_b[i] = F32(b_base).v[i];
        } else if (ty == 1u) {
            const uint64_t b_base = arg(1) + uint64_t(e0) * uint64_t(D) * 2u;
            for (uint i = tid; i < total_b; i += 128u) rb_b[i] = float(F16(b_base).v[i]);
        } else {
            const uint64_t b_base = arg(1) + uint64_t(e0) * uint64_t(D) * 2u;
            for (uint i = tid; i < total_b; i += 128u) rb_b[i] = uintBitsToFloat(uint(U16(b_base).v[i]) << 16u);
        }
        barrier();

        if (has_r_clip != 0u && tid < tile_cnt) {
            const uint lr = tid;
            const uint r_global = tile_r0 + lr;
            const uint nh = arg_u32(13);
            const uint head_h = r_global % nh;
            const uint tok_r = r_global / nh;
            const uint base = lr * D;
            const uint64_t sc_ptr = arg(3) + uint64_t(head_h) * uint64_t(D) * 4u;
            float sq = 0.0;
            for (uint d = 0u; d < D; d++) {
                const float v = rb_x[base + d] * F32(sc_ptr).v[d];
                rb_x[base + d] = v;
                sq += v * v;
            }
            const float norm = sqrt(sq) + 1e-6;
            float factor = clamp(arg_f32(9) / norm, 0.0, 1.0);
            const uint log_floor = arg_u32(11);
            const float log_alpha = arg_f32(12);
            if (log_alpha > 0.0 && log_floor > 0u) {
                const float ratio = float(arg_u32(10) + tok_r + 1u) / float(log_floor);
                if (ratio > 1.0) factor *= (1.0 + log_alpha * log(ratio));
            }
            for (uint d = 0u; d < D; d++) rb_x[base + d] *= factor;
        }
        barrier();

        if (lane >= e_cnt) return;
        const uint e = e0 + lane;
        if (D == 16u) {
            const uint bb = lane * 16u;
            const vec4 b0 = vec4(rb_b[bb], rb_b[bb + 1u], rb_b[bb + 2u], rb_b[bb + 3u]);
            const vec4 b1 = vec4(rb_b[bb + 4u], rb_b[bb + 5u], rb_b[bb + 6u], rb_b[bb + 7u]);
            const vec4 b2 = vec4(rb_b[bb + 8u], rb_b[bb + 9u], rb_b[bb + 10u], rb_b[bb + 11u]);
            const vec4 b3 = vec4(rb_b[bb + 12u], rb_b[bb + 13u], rb_b[bb + 14u], rb_b[bb + 15u]);
            for (uint lr = sg; lr < tile_cnt; lr += 4u) {
                const uint base = lr * 16u;
                const float acc =
                    dot(vec4(rb_x[base], rb_x[base + 1u], rb_x[base + 2u], rb_x[base + 3u]), b0)
                  + dot(vec4(rb_x[base + 4u], rb_x[base + 5u], rb_x[base + 6u], rb_x[base + 7u]), b1)
                  + dot(vec4(rb_x[base + 8u], rb_x[base + 9u], rb_x[base + 10u], rb_x[base + 11u]), b2)
                  + dot(vec4(rb_x[base + 12u], rb_x[base + 13u], rb_x[base + 14u], rb_x[base + 15u]), b3);
                F32(arg(2)).v[(tile_r0 + lr) * ext + e] = acc;
            }
            return;
        }
        float bv[16];
        const uint bb = lane * D;
        for (uint d = 0u; d < D; d++) bv[d] = rb_b[bb + d];
        for (uint lr = sg; lr < tile_cnt; lr += 4u) {
            float acc = 0.0;
            const uint base = lr * D;
            for (uint d = 0u; d < D; d++) acc += rb_x[base + d] * bv[d];
            F32(arg(2)).v[(tile_r0 + lr) * ext + e] = acc;
        }
        return;
    }

    const uint r = gl_WorkGroupID.y;
    const uint e = gl_WorkGroupID.x * 128u + tid;
    if (e >= ext) return;
    const uint64_t x_row = arg(0) + uint64_t(r) * uint64_t(D) * 4u;
    float acc = 0.0;
    if (ty == 0u) {
        const uint64_t b_row = arg(1) + uint64_t(e) * uint64_t(D) * 4u;
        for (uint d = 0u; d < D; d++) acc += F32(x_row).v[d] * F32(b_row).v[d];
    } else if (ty == 1u) {
        const uint64_t b_row = arg(1) + uint64_t(e) * uint64_t(D) * 2u;
        for (uint d = 0u; d < D; d++) acc += F32(x_row).v[d] * float(F16(b_row).v[d]);
    } else {
        const uint64_t b_row = arg(1) + uint64_t(e) * uint64_t(D) * 2u;
        for (uint d = 0u; d < D; d++) {
            acc += F32(x_row).v[d] * uintBitsToFloat(uint(U16(b_row).v[d]) << 16u);
        }
    }
    F32(arg(2)).v[r * ext + e] = acc;
}
#endif

// ---------------------------------------------------------------------------
// 16. Device-to-device f32 copy: dst[i] = src[i] for i in 0..n.
// Grid: (ceil(n / 256), 1, 1), 256 threads.
// Buffers: 0 src, 1 dst. Params: 2 n.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_copy_f32
void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint n = arg_u32(2);
    if (i < n) {
        F32(arg(1)).v[i] = F32(arg(0)).v[i];
    }
}
#endif

// ---------------------------------------------------------------------------
// 17. Fused MoE gate+up projection + SITU activation + optional per-expert scale.
// Loads x[rk / K_exp] once into shared memory (up to 2304 floats = 9.2 KB),
// each subgroup computes both gate (2*j) and up (2*j+1) rows and writes
// situ_out[rk, j] directly (eliminates gate_up intermediate + situ dispatch).
// Grid: (ceil(ff / 8), rows * K, 1), 256 threads (8 subgroups).
// Buffers: 0 x, 1 W, 2 exp_ids, 3 exp_scale, 4 y.
// Params: 5 ff, 6 KK, 7 row_bytes, 8 K_exp, 9 has_scale, 10 beta, 11 linear_beta.
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_moe_gu_situ_q8_0)
#define GU_TYPE GLM53_Q8_0
#elif defined(KERNEL_inkling2_moe_gu_situ_q4_k)
#define GU_TYPE GLM53_Q4_K
#elif defined(KERNEL_inkling2_moe_gu_situ_q2_k)
#define GU_TYPE GLM53_Q2_K
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_xxs)
#define GU_TYPE GLM53_IQ2_XXS
#elif defined(KERNEL_inkling2_moe_gu_situ_bf16)
#define GU_TYPE GLM53_BF16
#elif defined(KERNEL_inkling2_moe_gu_situ_f32)
#define GU_TYPE GLM53_F32
#elif defined(KERNEL_inkling2_moe_gu_situ_f16)
#define GU_TYPE GLM53_F16
#elif defined(KERNEL_inkling2_moe_gu_situ_q4_0)
#define GU_TYPE GLM53_Q4_0
#elif defined(KERNEL_inkling2_moe_gu_situ_q5_k)
#define GU_TYPE GLM53_Q5_K
#elif defined(KERNEL_inkling2_moe_gu_situ_q6_k)
#define GU_TYPE GLM53_Q6_K
#elif defined(KERNEL_inkling2_moe_gu_situ_iq4_nl)
#define GU_TYPE GLM53_IQ4_NL
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_s)
#define GU_TYPE GLM53_IQ2_S
#elif defined(KERNEL_inkling2_moe_gu_situ_mxfp4)
#define GU_TYPE GLM53_MXFP4
#elif defined(KERNEL_inkling2_moe_gu_situ_nvfp4)
#define GU_TYPE GLM53_NVFP4
#elif defined(KERNEL_inkling2_moe_gu_situ_q2_0)
#define GU_TYPE GLM53_Q2_0
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_xs)
#define GU_TYPE GLM53_IQ2_XS
#elif defined(KERNEL_inkling2_moe_gu_situ_iq3_xxs)
#define GU_TYPE GLM53_IQ3_XXS
#elif defined(KERNEL_inkling2_moe_gu_situ_iq1_s)
#define GU_TYPE GLM53_IQ1_S
#elif defined(KERNEL_inkling2_moe_gu_situ_iq4_xs)
#define GU_TYPE GLM53_IQ4_XS
#endif

#ifdef GU_TYPE
float gu_group_sum8(float v) {
    v += subgroupShuffleXor(v, 4u);
    v += subgroupShuffleXor(v, 2u);
    v += subgroupShuffleXor(v, 1u);
    return v;
}

float gu_dot_task(uint64_t row, uint t, in vec4 xv[8]) {
#if defined(KERNEL_inkling2_moe_gu_situ_q8_0)
    return i2_q8_dot_xv(row, t, xv);
#elif defined(KERNEL_inkling2_moe_gu_situ_nvfp4)
    return i2_nvfp4_dot_xv(row, t, xv);
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_xxs)
    return glm53_dot_iq2_xxs(row, t, xv);
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_xs)
    const uint64_t b = row + uint64_t(t >> 3u) * 74u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint scb = (uint(U16(b + 66u).v[ib >> 1u]) >> (8u * (ib & 1u))) & 0xffu;
    const float db0 = d * (0.5 + float(scb & 0xfu)) * 0.25;
    const float db1 = d * (0.5 + float(scb >> 4u)) * 0.25;
    float s0 = 0.0, s1 = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint q = uint(U16(b + 2u).v[4u * ib + l]);
        const uint g = q & 511u;
        const uint s7 = q >> 9u;
        const uint signs = s7 | ((bitCount(s7) & 1u) << 7u);
        const uint lo = glm53_iq2xs_grid[2u * g];
        const uint hi = glm53_iq2xs_grid[2u * g + 1u];
        const vec4 a = xv[2u * l];
        const vec4 c = xv[2u * l + 1u];
        float e = 0.0;
        e += ((signs & 1u) != 0u ? -float(lo & 0xffu) : float(lo & 0xffu)) * a.x;
        e += ((signs & 2u) != 0u ? -float((lo >> 8u) & 0xffu) : float((lo >> 8u) & 0xffu)) * a.y;
        e += ((signs & 4u) != 0u ? -float((lo >> 16u) & 0xffu) : float((lo >> 16u) & 0xffu)) * a.z;
        e += ((signs & 8u) != 0u ? -float(lo >> 24u) : float(lo >> 24u)) * a.w;
        e += ((signs & 16u) != 0u ? -float(hi & 0xffu) : float(hi & 0xffu)) * c.x;
        e += ((signs & 32u) != 0u ? -float((hi >> 8u) & 0xffu) : float((hi >> 8u) & 0xffu)) * c.y;
        e += ((signs & 64u) != 0u ? -float((hi >> 16u) & 0xffu) : float((hi >> 16u) & 0xffu)) * c.z;
        e += ((signs & 128u) != 0u ? -float(hi >> 24u) : float(hi >> 24u)) * c.w;
        if (l < 2u) s0 += e; else s1 += e;
    }
    return db0 * s0 + db1 * s1;
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_s)
    const uint64_t b = row + uint64_t(t >> 3u) * 82u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint qs = uint(U16(b + 2u).v[2u * ib]) | (uint(U16(b + 2u).v[2u * ib + 1u]) << 16u);
    const uint sg = uint(U16(b + 34u).v[2u * ib]) | (uint(U16(b + 34u).v[2u * ib + 1u]) << 16u);
    const uint hs = uint(U16(b + 66u).v[ib >> 1u]) >> (8u * (ib & 1u));
    const uint scb = uint(U16(b + 74u).v[ib >> 1u]) >> (8u * (ib & 1u));
    const float db0 = d * (0.5 + float(scb & 0xfu)) * 0.25;
    const float db1 = d * (0.5 + float((scb >> 4u) & 0xfu)) * 0.25;
    float s0 = 0.0, s1 = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint g = ((qs >> (8u * l)) & 0xffu) | (((hs & 0xffu) << (8u - 2u * l)) & 0x300u);
        const uint signs = (sg >> (8u * l)) & 0xffu;
        const uint lo = glm53_iq2s_grid[2u * g];
        const uint hi = glm53_iq2s_grid[2u * g + 1u];
        const vec4 a = xv[2u * l];
        const vec4 c = xv[2u * l + 1u];
        float e = 0.0;
        e += ((signs & 1u) != 0u ? -float(lo & 0xffu) : float(lo & 0xffu)) * a.x;
        e += ((signs & 2u) != 0u ? -float((lo >> 8u) & 0xffu) : float((lo >> 8u) & 0xffu)) * a.y;
        e += ((signs & 4u) != 0u ? -float((lo >> 16u) & 0xffu) : float((lo >> 16u) & 0xffu)) * a.z;
        e += ((signs & 8u) != 0u ? -float(lo >> 24u) : float(lo >> 24u)) * a.w;
        e += ((signs & 16u) != 0u ? -float(hi & 0xffu) : float(hi & 0xffu)) * c.x;
        e += ((signs & 32u) != 0u ? -float((hi >> 8u) & 0xffu) : float((hi >> 8u) & 0xffu)) * c.y;
        e += ((signs & 64u) != 0u ? -float((hi >> 16u) & 0xffu) : float((hi >> 16u) & 0xffu)) * c.z;
        e += ((signs & 128u) != 0u ? -float(hi >> 24u) : float(hi >> 24u)) * c.w;
        if (l < 2u) s0 += e; else s1 += e;
    }
    return db0 * s0 + db1 * s1;
#elif defined(KERNEL_inkling2_moe_gu_situ_iq1_s)
    const uint64_t b = row + uint64_t(t >> 3u) * 50u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint qh = uint(U16(b + 34u).v[ib]);
    const float dl = d * float(2u * ((qh >> 12u) & 7u) + 1u);
    const float delta = (qh & 0x8000u) != 0u ? -0.125 : 0.125;
    const uint qs = uint(U16(b + 2u).v[2u * ib]) | (uint(U16(b + 2u).v[2u * ib + 1u]) << 16u);
    float s = 0.0;
    float xsum = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint idx = ((qs >> (8u * l)) & 0xffu) | (((qh >> (3u * l)) & 7u) << 8u);
        const uint lo = glm53_iq1s_grid[2u * idx];
        const uint hi = glm53_iq1s_grid[2u * idx + 1u];
        const vec4 a = xv[2u * l];
        const vec4 c = xv[2u * l + 1u];
        xsum += (a.x + a.y + a.z + a.w) + (c.x + c.y + c.z + c.w);
        s += float(bitfieldExtract(int(lo), 0, 8)) * a.x
           + float(bitfieldExtract(int(lo), 8, 8)) * a.y
           + float(bitfieldExtract(int(lo), 16, 8)) * a.z
           + float(bitfieldExtract(int(lo), 24, 8)) * a.w
           + float(bitfieldExtract(int(hi), 0, 8)) * c.x
           + float(bitfieldExtract(int(hi), 8, 8)) * c.y
           + float(bitfieldExtract(int(hi), 16, 8)) * c.z
           + float(bitfieldExtract(int(hi), 24, 8)) * c.w;
    }
    return dl * (s + delta * xsum);
#else
    float w[32];
    glm53_decode(GU_TYPE, row, t, w);
    float acc = 0.0;
    [[unroll]] for (uint q = 0u; q < 8u; q++) {
        acc += dot(vec4(w[4u * q], w[4u * q + 1u], w[4u * q + 2u], w[4u * q + 3u]), xv[q]);
    }
    return acc;
#endif
}

void main() {
    // 4 groups of 8 lanes per subgroup, each group handles 2 (gate, up) pairs (j0, j1):
    // reuses xv[8] across 4 weight rows -> 2x fewer x loads, 72 / 8 = 9.0 exact waves!
    const uint pair_in_sg = gl_SubgroupInvocationID >> 3u;
    const uint lane_t = gl_SubgroupInvocationID & 7u;
    const uint j0 = gl_WorkGroupID.x * 64u + gl_SubgroupID * 8u + pair_in_sg * 2u;
    const uint j1 = j0 + 1u;
    const uint rk = gl_WorkGroupID.y;
    const uint ff = arg_u32(5);
    if (j0 >= ff) return;
    const bool has1 = j1 < ff;
    const uint KK = arg_u32(6);
    const uint row_bytes = arg_u32(7);
    const uint K_exp = arg_u32(8);
    const uint x_idx = rk / K_exp;
    const uint64_t x_row = arg(0) + uint64_t(x_idx) * uint64_t(KK) * 4u;

    const uint e = U32(arg(2)).v[rk];
    const uint64_t w_exp = arg(1) + uint64_t(e) * uint64_t(2u * ff) * uint64_t(row_bytes);
    const uint64_t w_g0 = w_exp + uint64_t(j0) * uint64_t(row_bytes);
    const uint64_t w_u0 = w_exp + uint64_t(ff + j0) * uint64_t(row_bytes);
    const uint64_t w_g1 = w_g0 + uint64_t(row_bytes);
    const uint64_t w_u1 = w_u0 + uint64_t(row_bytes);
    const uint tasks = KK >> 5u;

    float ag0 = 0.0, au0 = 0.0, ag1 = 0.0, au1 = 0.0;
    for (uint t = lane_t; t < tasks; t += 8u) {
        const uint64_t xt = x_row + uint64_t(t) * 128u;
        vec4 xv[8];
        [[unroll]] for (uint q = 0u; q < 8u; q++) xv[q] = F32x4(xt + 16u * q).v[0];
        ag0 += gu_dot_task(w_g0, t, xv);
        au0 += gu_dot_task(w_u0, t, xv);
        if (has1) {
            ag1 += gu_dot_task(w_g1, t, xv);
            au1 += gu_dot_task(w_u1, t, xv);
        }
    }
    ag0 = gu_group_sum8(ag0);
    au0 = gu_group_sum8(au0);
    if (has1) {
        ag1 = gu_group_sum8(ag1);
        au1 = gu_group_sum8(au1);
    }
    if (lane_t == 0u) {
        const float beta = arg_f32(10);
        const float lb = arg_f32(11);
        const float sc = arg_u32(9) != 0u ? F32(arg(3)).v[e] : 1.0;
        const float g0 = ag0 * sc;
        const float u0 = au0 * sc;
        const float a0 = beta * tanh(g0 / beta) / (1.0 + exp(-g0));
        const float l0 = lb > 0.0 ? lb * tanh(u0 / lb) : u0;
        F32(arg(4)).v[rk * ff + j0] = a0 * l0;
        if (has1) {
            const float g1 = ag1 * sc;
            const float u1 = au1 * sc;
            const float a1 = beta * tanh(g1 / beta) / (1.0 + exp(-g1));
            const float l1 = lb > 0.0 ? lb * tanh(u1 / lb) : u1;
            F32(arg(4)).v[rk * ff + j1] = a1 * l1;
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// 18. Fused MoE down projection + weighted expert sum + optional down_scale.
// Eliminates down_out intermediate and inkling2_moe_sum dispatch, and spreads
// all K_exp * (KK/32) tasks across 32 subgroup lanes (for K=8, KK=1152:
// 288 tasks / 32 = 9.0 exact waves, 100% SIMD utilization!).
// Grid: (ceil(H / 8), rows, 1), 256 threads (8 subgroups).
// Buffers: 0 situ_out, 1 W, 2 exp_ids, 3 exp_w, 4 exp_scale, 5 moe_out.
// Params: 6 H, 7 KK, 8 row_bytes, 9 K_exp, 10 has_scale.
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_moe_down_sum_q8_0)
#define DS_TYPE GLM53_Q8_0
#elif defined(KERNEL_inkling2_moe_down_sum_q4_k)
#define DS_TYPE GLM53_Q4_K
#elif defined(KERNEL_inkling2_moe_down_sum_q2_k)
#define DS_TYPE GLM53_Q2_K
#elif defined(KERNEL_inkling2_moe_down_sum_iq2_xxs)
#define DS_TYPE GLM53_IQ2_XXS
#elif defined(KERNEL_inkling2_moe_down_sum_bf16)
#define DS_TYPE GLM53_BF16
#elif defined(KERNEL_inkling2_moe_down_sum_f32)
#define DS_TYPE GLM53_F32
#elif defined(KERNEL_inkling2_moe_down_sum_f16)
#define DS_TYPE GLM53_F16
#elif defined(KERNEL_inkling2_moe_down_sum_q4_0)
#define DS_TYPE GLM53_Q4_0
#elif defined(KERNEL_inkling2_moe_down_sum_q5_k)
#define DS_TYPE GLM53_Q5_K
#elif defined(KERNEL_inkling2_moe_down_sum_q6_k)
#define DS_TYPE GLM53_Q6_K
#elif defined(KERNEL_inkling2_moe_down_sum_iq4_nl)
#define DS_TYPE GLM53_IQ4_NL
#elif defined(KERNEL_inkling2_moe_down_sum_iq2_s)
#define DS_TYPE GLM53_IQ2_S
#elif defined(KERNEL_inkling2_moe_down_sum_mxfp4)
#define DS_TYPE GLM53_MXFP4
#elif defined(KERNEL_inkling2_moe_down_sum_nvfp4)
#define DS_TYPE GLM53_NVFP4
#elif defined(KERNEL_inkling2_moe_down_sum_q2_0)
#define DS_TYPE GLM53_Q2_0
#elif defined(KERNEL_inkling2_moe_down_sum_iq2_xs)
#define DS_TYPE GLM53_IQ2_XS
#elif defined(KERNEL_inkling2_moe_down_sum_iq3_xxs)
#define DS_TYPE GLM53_IQ3_XXS
#elif defined(KERNEL_inkling2_moe_down_sum_iq1_s)
#define DS_TYPE GLM53_IQ1_S
#elif defined(KERNEL_inkling2_moe_down_sum_iq4_xs)
#define DS_TYPE GLM53_IQ4_XS
#endif

#ifdef DS_TYPE
float ds_dot_task(uint64_t row, uint t, uint64_t x) {
#if defined(KERNEL_inkling2_moe_down_sum_q8_0)
    return i2_q8_dot_ptr(row, t, x);
#elif defined(KERNEL_inkling2_moe_down_sum_q2_0)
    const uint64_t b = row + uint64_t(t >> 1u) * 18u;
    const uint half_idx = t & 1u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint64_t qs = b + 2u + 8u * half_idx;
    float s = 0.0;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const uint pair = uint(U16(qs).v[i]);
        const vec4 x0 = F32x4(x + 32u * i).v[0];
        const vec4 x1 = F32x4(x + 32u * i + 16u).v[0];
        const vec4 w0 = vec4(
            float(int((pair >> 0u) & 3u) - 1),
            float(int((pair >> 2u) & 3u) - 1),
            float(int((pair >> 4u) & 3u) - 1),
            float(int((pair >> 6u) & 3u) - 1)
        );
        const vec4 w1 = vec4(
            float(int((pair >> 8u) & 3u) - 1),
            float(int((pair >> 10u) & 3u) - 1),
            float(int((pair >> 12u) & 3u) - 1),
            float(int((pair >> 14u) & 3u) - 1)
        );
        s += dot(w0, x0) + dot(w1, x1);
    }
    return d * s;
#elif defined(KERNEL_inkling2_moe_down_sum_mxfp4)
    const uint64_t b = row + uint64_t(t) * 17u;
    const uint e = uint(U8(b).v[0]);
    const float d = e < 2u ? uintBitsToFloat(0x00200000u << e) : uintBitsToFloat((e - 1u) << 23u);
    float s = 0.0;
    [[unroll]] for (uint q = 0u; q < 4u; q++) {
        const vec4 xlo = F32x4(x + 16u * q).v[0];
        const vec4 xhi = F32x4(x + 64u + 16u * q).v[0];
        const uint b0 = uint(U8(b + 1u).v[4u * q]);
        const uint b1 = uint(U8(b + 1u).v[4u * q + 1u]);
        const uint b2 = uint(U8(b + 1u).v[4u * q + 2u]);
        const uint b3 = uint(U8(b + 1u).v[4u * q + 3u]);
        s += dot(vec4(glm53_fp4_value(b0 & 15u), glm53_fp4_value(b1 & 15u),
                      glm53_fp4_value(b2 & 15u), glm53_fp4_value(b3 & 15u)), xlo);
        s += dot(vec4(glm53_fp4_value(b0 >> 4u), glm53_fp4_value(b1 >> 4u),
                      glm53_fp4_value(b2 >> 4u), glm53_fp4_value(b3 >> 4u)), xhi);
    }
    return d * s;
#elif defined(KERNEL_inkling2_moe_down_sum_nvfp4)
    const uint64_t b = row + uint64_t(t >> 1u) * 36u;
    const uint half_idx = t & 1u;
    const uint sw = U32(b).v[0];
    float acc = 0.0;
    [[unroll]] for (uint sb = 0u; sb < 2u; sb++) {
        const uint s = 2u * half_idx + sb;
        const float d = glm53_ue4m3_to_f32((sw >> (8u * s)) & 0xffu);
        const uint64_t qs = b + 4u + 8u * s;
        float sub_s = 0.0;
        [[unroll]] for (uint q = 0u; q < 2u; q++) {
            const uint word = U32(qs).v[q];
            const vec4 xlo = F32x4(x + 64u * sb + 16u * q).v[0];
            const vec4 xhi = F32x4(x + 64u * sb + 32u + 16u * q).v[0];
            const uint b0 = word & 0xffu;
            const uint b1 = (word >> 8u) & 0xffu;
            const uint b2 = (word >> 16u) & 0xffu;
            const uint b3 = (word >> 24u) & 0xffu;
            sub_s += dot(vec4(glm53_fp4_value(b0 & 15u), glm53_fp4_value(b1 & 15u),
                              glm53_fp4_value(b2 & 15u), glm53_fp4_value(b3 & 15u)), xlo);
            sub_s += dot(vec4(glm53_fp4_value(b0 >> 4u), glm53_fp4_value(b1 >> 4u),
                              glm53_fp4_value(b2 >> 4u), glm53_fp4_value(b3 >> 4u)), xhi);
        }
        acc += d * sub_s;
    }
    return acc;
#else
    float w[32];
    glm53_decode(DS_TYPE, row, t, w);
    return glm53_task_dot(w, x);
#endif
}

shared uint ds_exp[16];
shared float ds_w[16];
#if defined(KERNEL_inkling2_moe_down_sum_q8_0) || defined(KERNEL_inkling2_moe_down_sum_nvfp4)
void main() {
    // 4 subgroups (128 threads) x 2 adjacent output rows/subgroup = 8 rows/WG
    // (288 WGs for H=2304). With K_exp=8, 4 lanes per expert run all 8 experts in
    // parallel (36 / 4 = 9 exact iterations, 100% lane utilization) while reusing
    // xv[8] across both output rows (n0, n1).
    const uint n0 = gl_WorkGroupID.x * 8u + gl_SubgroupID * 2u;
    const uint n1 = n0 + 1u;
    const uint r = gl_WorkGroupID.y;
    const uint H = arg_u32(6);
    const uint KK = arg_u32(7);
    const uint row_bytes = arg_u32(8);
    const uint K_exp = arg_u32(9);
    const uint has_scale = arg_u32(10);

    if (gl_LocalInvocationIndex < K_exp) {
        const uint k = gl_LocalInvocationIndex;
        const uint e = U32(arg(2)).v[r * K_exp + k];
        float w = F32(arg(3)).v[r * K_exp + k];
        if (has_scale != 0u) w *= F32(arg(4)).v[e];
        ds_exp[k] = e;
        ds_w[k] = w;
    }
    barrier();
    if (n0 >= H) return;
    const bool has1 = n1 < H;
    const uint tasks = KK >> 5u;
    float acc0 = 0.0, acc1 = 0.0;
    if (K_exp == 8u) {
        const uint k = gl_SubgroupInvocationID >> 2u;
        const uint lane_t = gl_SubgroupInvocationID & 3u;
        const uint e = ds_exp[k];
        const float wk = ds_w[k];
        const uint64_t w0 = arg(1) + (uint64_t(e) * uint64_t(H) + uint64_t(n0)) * uint64_t(row_bytes);
        const uint64_t w1 = w0 + uint64_t(row_bytes);
        const uint64_t x_row = arg(0) + uint64_t(r * 8u + k) * uint64_t(KK) * 4u;
        float k0 = 0.0, k1 = 0.0;
        for (uint t = lane_t; t < tasks; t += 4u) {
            const uint64_t xt = x_row + uint64_t(t) * 128u;
            vec4 xv[8];
            [[unroll]] for (uint q = 0u; q < 8u; q++) xv[q] = F32x4(xt + 16u * q).v[0];
#if defined(KERNEL_inkling2_moe_down_sum_nvfp4)
            k0 += i2_nvfp4_dot_xv(w0, t, xv);
            if (has1) k1 += i2_nvfp4_dot_xv(w1, t, xv);
#else
            k0 += i2_q8_dot_xv(w0, t, xv);
            if (has1) k1 += i2_q8_dot_xv(w1, t, xv);
#endif
        }
        acc0 = wk * k0;
        if (has1) acc1 = wk * k1;
    } else {
        for (uint k = 0u; k < K_exp; k++) {
            const uint e = ds_exp[k];
            const float wk = ds_w[k];
            const uint64_t w0 = arg(1) + (uint64_t(e) * uint64_t(H) + uint64_t(n0)) * uint64_t(row_bytes);
            const uint64_t w1 = w0 + uint64_t(row_bytes);
            const uint64_t x_row = arg(0) + uint64_t(r * K_exp + k) * uint64_t(KK) * 4u;
            float k0 = 0.0, k1 = 0.0;
            for (uint t = gl_SubgroupInvocationID; t < tasks; t += 32u) {
                const uint64_t xt = x_row + uint64_t(t) * 128u;
                vec4 xv[8];
                [[unroll]] for (uint q = 0u; q < 8u; q++) xv[q] = F32x4(xt + 16u * q).v[0];
#if defined(KERNEL_inkling2_moe_down_sum_nvfp4)
                k0 += i2_nvfp4_dot_xv(w0, t, xv);
                if (has1) k1 += i2_nvfp4_dot_xv(w1, t, xv);
#else
                k0 += i2_q8_dot_xv(w0, t, xv);
                if (has1) k1 += i2_q8_dot_xv(w1, t, xv);
#endif
            }
            acc0 += wk * k0;
            if (has1) acc1 += wk * k1;
        }
    }
    acc0 = subgroupAdd(acc0);
    if (has1) acc1 = subgroupAdd(acc1);
    if (gl_SubgroupInvocationID == 0u) {
        F32(arg(5)).v[r * H + n0] = acc0;
        if (has1) F32(arg(5)).v[r * H + n1] = acc1;
    }
}
#else
void main() {
    const uint n = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    const uint r = gl_WorkGroupID.y;
    const uint H = arg_u32(6);
    const uint KK = arg_u32(7);
    const uint row_bytes = arg_u32(8);
    const uint K_exp = arg_u32(9);
    const uint has_scale = arg_u32(10);

    if (gl_LocalInvocationIndex < K_exp) {
        const uint k = gl_LocalInvocationIndex;
        const uint e = U32(arg(2)).v[r * K_exp + k];
        float w = F32(arg(3)).v[r * K_exp + k];
        if (has_scale != 0u) w *= F32(arg(4)).v[e];
        ds_exp[k] = e;
        ds_w[k] = w;
    }
    barrier();
    if (n >= H) return;

    const uint tasks = KK >> 5u;
    float acc = 0.0;
    if (K_exp == 8u) {
        const uint k = gl_SubgroupInvocationID >> 2u;
        const uint lane_t = gl_SubgroupInvocationID & 3u;
        const uint e = ds_exp[k];
        const uint64_t w_row = arg(1) + (uint64_t(e) * uint64_t(H) + uint64_t(n)) * uint64_t(row_bytes);
        const uint64_t x_row = arg(0) + uint64_t(r * 8u + k) * uint64_t(KK) * 4u;
        float k_acc = 0.0;
        for (uint t = lane_t; t < tasks; t += 4u) {
            k_acc += ds_dot_task(w_row, t, x_row + uint64_t(t) * 128u);
        }
        acc = ds_w[k] * k_acc;
    } else {
        for (uint k = 0u; k < K_exp; k++) {
            const uint e = ds_exp[k];
            const uint64_t w_row = arg(1) + (uint64_t(e) * uint64_t(H) + uint64_t(n)) * uint64_t(row_bytes);
            const uint64_t x_row = arg(0) + uint64_t(r * K_exp + k) * uint64_t(KK) * 4u;
            float k_acc = 0.0;
            for (uint t = gl_SubgroupInvocationID; t < tasks; t += 32u) {
                k_acc += ds_dot_task(w_row, t, x_row + uint64_t(t) * 128u);
            }
            acc += ds_w[k] * k_acc;
        }
    }
    acc = subgroupAdd(acc);
    if (gl_SubgroupInvocationID == 0u) {
        F32(arg(5)).v[r * H + n] = acc;
    }
}
