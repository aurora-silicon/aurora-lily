        const uint q = uint(qv[l]);
        const uint g = q & 511u;
        const uint s7 = q >> 9u;
        const uint signs = s7 | ((bitCount(s7) & 1u) << 7u);
        const uint p = (gum4_iq2xs_p[g >> 1u] >> (16u * (g & 1u))) & 0xffffu;
        const uint sq = (signs & 0x55u) | ((signs & 0xaau) << 15u);
        const uvec2 ulo = gum4_iq2_4lut[p & 0xffu] ^ (uvec2(sq << 15u, sq << 13u) & 0x80008000u);
        const uvec2 uhi = gum4_iq2_4lut[p >> 8u]   ^ (uvec2(sq << 11u, sq << 9u)  & 0x80008000u);
        const vec4 wlo = vec4(unpackHalf2x16(ulo.x), unpackHalf2x16(ulo.y));
        const vec4 whi = vec4(unpackHalf2x16(uhi.x), unpackHalf2x16(uhi.y));
        const uint64_t loff = toff + 32u * l;
        const float e0 = dot(wlo, F32x4(x0 + loff).v[0]) + dot(whi, F32x4(x0 + loff + 16u).v[0]);
        const float e1 = dot(wlo, F32x4(x1 + loff).v[0]) + dot(whi, F32x4(x1 + loff + 16u).v[0]);
        if (l < 2u) {
            s0a += e0; s1a += e1;
            if (cnt > 2u) s2a += dot(wlo, F32x4(x2 + loff).v[0]) + dot(whi, F32x4(x2 + loff + 16u).v[0]);
            if (cnt > 3u) s3a += dot(wlo, F32x4(x3 + loff).v[0]) + dot(whi, F32x4(x3 + loff + 16u).v[0]);
        } else {
            s0b += e0; s1b += e1;
