            const float dd = (t < tasks) ? d : 0.0;
            a0 = fma(dd, s0, a0);
            if (cnt > 1u) a1 = fma(dd, s1, a1);
            if (cnt > 2u) a2 = fma(dd, s2, a2);
            if (cnt > 3u) a3 = fma(dd, s3, a3);
