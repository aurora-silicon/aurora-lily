        a0 = dm4_sum4(a0);
        if (cnt > 1u) a1 = dm4_sum4(a1);
        if (cnt > 2u) a2 = dm4_sum4(a2);
        if (cnt > 3u) a3 = dm4_sum4(a3);
        if (lane_t == 0u && n < H) {
            F32(arg(5)).v[dm4_rks[0] * H + n] = a0;
            if (cnt > 1u) F32(arg(5)).v[dm4_rks[1] * H + n] = a1;
            if (cnt > 2u) F32(arg(5)).v[dm4_rks[2] * H + n] = a2;
            if (cnt > 3u) F32(arg(5)).v[dm4_rks[3] * H + n] = a3;
        }
