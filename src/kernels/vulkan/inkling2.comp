// ---------------------------------------------------------------------------
// 22. DSpark helpers: silu_mul (silu(gate) * up), dspark_gru, and add3_bias.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_silu_mul
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= arg_u32(3)) return;
    const float g = F32(arg(0)).v[i];
    const float u = F32(arg(1)).v[i];
    F32(arg(2)).v[i] = (g / (1.0 + exp(-g))) * u;
}
#endif

// Updates rnn_state[j] in place and writes latent[j] from joint_out[3*rank] + bias[3*rank].
// Buffers: 0 joint_out, 1 bias, 2 rnn_state, 3 latent. Params: 4 rank.
#ifdef KERNEL_inkling2_dspark_gru
void main() {
    const uint j = gl_GlobalInvocationID.x;
    const uint rank = arg_u32(4);
    if (j >= rank) return;
    const float j0 = F32(arg(0)).v[j] + F32(arg(1)).v[j];
    const float j1 = F32(arg(0)).v[rank + j] + F32(arg(1)).v[rank + j];
    const float j2 = F32(arg(0)).v[2u * rank + j] + F32(arg(1)).v[2u * rank + j];
    const float g = 1.0 / (1.0 + exp(-j0));
    const float s = F32(arg(2)).v[j];
    F32(arg(2)).v[j] = g * s + (1.0 - g) * tanh(j1);
    F32(arg(3)).v[j] = tanh(j2);
}
#endif

// out[i] = a[i] + b[i] + c[i] (for combined = h_slot + corr + hidden_out_b).
// Buffers: 0 a, 1 b, 2 c, 3 out. Params: 4 n.
#ifdef KERNEL_inkling2_add3
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= arg_u32(4)) return;
    F32(arg(3)).v[i] = F32(arg(0)).v[i] + F32(arg(1)).v[i] + F32(arg(2)).v[i];
}
#endif

// ---------------------------------------------------------------------------
// 23. Fused loop controller down-projection (F32/BF16, weight-reused across rows <= 8):
//     mid[r, o] = W_down[o, 0..H] . rms(cur[r]) + W_down[o, H..2*H] . rms(msg[r])
// Grid: (ceil(rank / 2), 1, 1), 64 threads (2 subgroups).
// Buffers: 0 cur, 1 msg, 2 W_down ([rank, 2*H]), 3 mid ([rows, rank]).
// Params: 4 H, 5 rank, 6 eps, 7 rows.
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_ctrl_down_f32) || defined(KERNEL_inkling2_ctrl_down_bf16)
// Zero-barrier single-pass per-row ctrl_down: reads cur[r] and msg[r] ONCE,
// ZERO shared memory, ZERO barriers, (rank, rows, 1) x 32 threads (64*rows WGs across 40 cores)!
vec4 cd_load_w4(uint64_t addr, uint i) {
#ifdef KERNEL_inkling2_ctrl_down_bf16
    const uvec2 u = U32x2(addr).v[i];
    return vec4(
        uintBitsToFloat(u.x << 16u),
        uintBitsToFloat(u.x & 0xffff0000u),
        uintBitsToFloat(u.y << 16u),
        uintBitsToFloat(u.y & 0xffff0000u)
    );
#else
    return F32x4(addr).v[i];
#endif
}

void main() {
    const uint o = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID;
    const uint H = arg_u32(4);
    const uint rank = arg_u32(5);
    const float eps = arg_f32(6);
    if (o >= rank) return;
    const uint H4 = H >> 2u;
    const uint64_t cur_row = arg(0) + uint64_t(r) * uint64_t(H) * 4u;
    const uint64_t msg_row = arg(1) + uint64_t(r) * uint64_t(H) * 4u;

    float sq0 = 0.0, sq1 = 0.0, acc0 = 0.0, acc1 = 0.0;
#ifdef KERNEL_inkling2_ctrl_down_bf16
    const uint64_t w0 = arg(2) + uint64_t(o) * uint64_t(2u * H) * 2u;
    const uint64_t w1 = w0 + uint64_t(H) * 2u;
    if ((H & 7u) == 0u) {
        const uint H8 = H >> 3u;
        for (uint i = lane; i < H8; i += 32u) {
            const uvec4 u0 = U32x4(w0).v[i];
            const uvec4 u1 = U32x4(w1).v[i];
            const vec4 ca = F32x4(cur_row).v[2u * i];
            const vec4 cb = F32x4(cur_row).v[2u * i + 1u];
            const vec4 ma = F32x4(msg_row).v[2u * i];
            const vec4 mb = F32x4(msg_row).v[2u * i + 1u];
            sq0 += dot(ca, ca) + dot(cb, cb);
            sq1 += dot(ma, ma) + dot(mb, mb);
            acc0 += dot(vec4(uintBitsToFloat(u0.x << 16u), uintBitsToFloat(u0.x & 0xffff0000u),
                             uintBitsToFloat(u0.y << 16u), uintBitsToFloat(u0.y & 0xffff0000u)), ca)
                  + dot(vec4(uintBitsToFloat(u0.z << 16u), uintBitsToFloat(u0.z & 0xffff0000u),
                             uintBitsToFloat(u0.w << 16u), uintBitsToFloat(u0.w & 0xffff0000u)), cb);
            acc1 += dot(vec4(uintBitsToFloat(u1.x << 16u), uintBitsToFloat(u1.x & 0xffff0000u),
                             uintBitsToFloat(u1.y << 16u), uintBitsToFloat(u1.y & 0xffff0000u)), ma)
                  + dot(vec4(uintBitsToFloat(u1.z << 16u), uintBitsToFloat(u1.z & 0xffff0000u),
                             uintBitsToFloat(u1.w << 16u), uintBitsToFloat(u1.w & 0xffff0000u)), mb);
        }
    } else {
        for (uint i = lane; i < H4; i += 32u) {
            const vec4 cv = F32x4(cur_row).v[i];
            const vec4 mv = F32x4(msg_row).v[i];
            sq0 += dot(cv, cv);
            sq1 += dot(mv, mv);
            acc0 += dot(cd_load_w4(w0, i), cv);
            acc1 += dot(cd_load_w4(w1, i), mv);
        }
    }
#else
    const uint64_t w0 = arg(2) + uint64_t(o) * uint64_t(2u * H) * 4u;
    const uint64_t w1 = w0 + uint64_t(H) * 4u;
    for (uint i = lane; i < H4; i += 32u) {
        const vec4 cv = F32x4(cur_row).v[i];
        const vec4 mv = F32x4(msg_row).v[i];
        sq0 += dot(cv, cv);
        sq1 += dot(mv, mv);
        acc0 += dot(cd_load_w4(w0, i), cv);
        acc1 += dot(cd_load_w4(w1, i), mv);
    }
#endif
    const float inv0 = inversesqrt(subgroupAdd(sq0) / float(H) + eps);
    const float inv1 = inversesqrt(subgroupAdd(sq1) / float(H) + eps);
    const float tot = subgroupAdd(acc0) * inv0 + subgroupAdd(acc1) * inv1;
    if (lane == 0u) F32(arg(3)).v[r * rank + o] = tot;
}
#endif

// ---------------------------------------------------------------------------
// 24. Fused loop controller gain+forget+blend (per-row high-grid dispatch):
//     out[r, i] = (1 - tanh(W_forget[i] . mid[r])) * cur[r, i] + tanh(W_gain[i] . mid[r]) * msg[r, i]
// Grid: (ceil(H / 32), rows, 1), 128 threads (4 subgroups x 8 rows/sg = 32 rows/WG, 4 lanes/row).
// Buffers: 0 cur, 1 msg, 2 mid, 3 W_gain ([H, rank]), 4 W_forget ([H, rank]), 5 out, 6 norm_w (unused).
// Params: 7 H, 8 rank (<= 128), 9 rows, 10 norm_eps.
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_ctrl_blend_f32) || defined(KERNEL_inkling2_ctrl_blend_bf16)
shared float cb_mid[128];

vec4 cb_load_w4(uint64_t addr, uint k) {
#ifdef KERNEL_inkling2_ctrl_blend_bf16
    const uvec2 u = U32x2(addr).v[k];
    return vec4(
        uintBitsToFloat(u.x << 16u),
        uintBitsToFloat(u.x & 0xffff0000u),
        uintBitsToFloat(u.y << 16u),
        uintBitsToFloat(u.y & 0xffff0000u)
    );
#else
    return F32x4(addr).v[k];
#endif
}

void main() {
    const uint row_in_sg = gl_SubgroupInvocationID >> 2u;
    const uint lane = gl_SubgroupInvocationID & 3u;
    const uint r = gl_WorkGroupID.y;
    const uint H = arg_u32(7);
    const uint rank = arg_u32(8);
    if (gl_LocalInvocationIndex < rank) {
        cb_mid[gl_LocalInvocationIndex] = F32(arg(2)).v[r * rank + gl_LocalInvocationIndex];
    }
    barrier();

#ifdef KERNEL_inkling2_ctrl_blend_bf16
    const uint64_t elem_b = 2u;
#else
    const uint64_t elem_b = 4u;
#endif
    const uint r4 = rank >> 2u;
    const uint i = gl_WorkGroupID.x * 32u + gl_SubgroupID * 8u + row_in_sg;
    if (i >= H) return;
    const uint64_t wg = arg(3) + uint64_t(i) * uint64_t(rank) * elem_b;
    const uint64_t wf = arg(4) + uint64_t(i) * uint64_t(rank) * elem_b;
    float g = 0.0, f = 0.0;
#ifdef KERNEL_inkling2_ctrl_blend_bf16
    if ((rank & 7u) == 0u) {
        const uint r8 = rank >> 3u;
        for (uint k = lane; k < r8; k += 4u) {
            const uint k8 = 8u * k;
            const vec4 m0 = vec4(cb_mid[k8], cb_mid[k8 + 1u], cb_mid[k8 + 2u], cb_mid[k8 + 3u]);
            const vec4 m1 = vec4(cb_mid[k8 + 4u], cb_mid[k8 + 5u], cb_mid[k8 + 6u], cb_mid[k8 + 7u]);
            const uvec4 ug = U32x4(wg).v[k];
            const uvec4 uf = U32x4(wf).v[k];
            g += dot(vec4(uintBitsToFloat(ug.x << 16u), uintBitsToFloat(ug.x & 0xffff0000u),
                          uintBitsToFloat(ug.y << 16u), uintBitsToFloat(ug.y & 0xffff0000u)), m0)
               + dot(vec4(uintBitsToFloat(ug.z << 16u), uintBitsToFloat(ug.z & 0xffff0000u),
                          uintBitsToFloat(ug.w << 16u), uintBitsToFloat(ug.w & 0xffff0000u)), m1);
            f += dot(vec4(uintBitsToFloat(uf.x << 16u), uintBitsToFloat(uf.x & 0xffff0000u),
                          uintBitsToFloat(uf.y << 16u), uintBitsToFloat(uf.y & 0xffff0000u)), m0)
               + dot(vec4(uintBitsToFloat(uf.z << 16u), uintBitsToFloat(uf.z & 0xffff0000u),
                          uintBitsToFloat(uf.w << 16u), uintBitsToFloat(uf.w & 0xffff0000u)), m1);
        }
    } else
#endif
    {
        for (uint k = lane; k < r4; k += 4u) {
            const uint k4 = 4u * k;
            const vec4 m = vec4(cb_mid[k4], cb_mid[k4 + 1u], cb_mid[k4 + 2u], cb_mid[k4 + 3u]);
            g += dot(cb_load_w4(wg, k), m);
            f += dot(cb_load_w4(wf, k), m);
        }
    }
    g += subgroupShuffleXor(g, 2u); g += subgroupShuffleXor(g, 1u);
    f += subgroupShuffleXor(f, 2u); f += subgroupShuffleXor(f, 1u);
    if (lane == 0u) {
        const uint idx = r * H + i;
        const float cv = F32(arg(0)).v[idx];
        const float mv = F32(arg(1)).v[idx];
        F32(arg(5)).v[idx] = (1.0 - tanh(f)) * cv + tanh(g) * mv;
    }
}
#endif

// ---------------------------------------------------------------------------
// 25. Fused K/V short_conv + l2_clip(K) / rms_norm(V) + f16 kv_store.
// Single subgroup (32 lanes x vec4 = 128 head dims): ZERO barriers, ZERO shared
// memory, 16-byte coalesced F32x4 input loads and 8-byte U32x2 F16x4 KV stores!
// Grid: (n_head_kv, 2, 1), 32 threads (1 subgroup = 1 head of dim 128).
// workgroup.y == 0 -> K (sconv -> l2_clip -> f16 k_cache)
// workgroup.y == 1 -> V (sconv -> rms_norm -> f16 v_cache)
// Buffers: 0 k_raw, 1 v_raw, 2 k_conv_w, 3 v_conv_w, 4 k_dyn, 5 v_dyn,
//          6 k_hist, 7 v_hist, 8 k_cache, 9 v_cache, 10 k_trace, 11 v_trace.
// Params: 12 rows, 13 n_head_kv, 14 n_conv, 15 is_swa, 16 pos0, 17 slots,
//         18 qk_clip, 19 rms_eps, 20 has_trace.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_kv_prep_4
void main() {
    const uint kh = gl_WorkGroupID.x;
    const uint is_v = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID; // 0..31 -> 4 channels/lane = 128 head dims
    const uint rows = arg_u32(12);
    const uint nkv = arg_u32(13);
    const uint is_swa = arg_u32(15);
    const uint pos0 = arg_u32(16);
    const uint slots = arg_u32(17);
    const float qk_clip = arg_f32(18);
    const float rms_eps = arg_f32(19);
    const uint has_trace = arg_u32(20);
    const uint C = nkv * 128u;
    const uint c0 = kh * 128u + lane * 4u;

    const uint64_t x_buf = is_v == 0u ? arg(0) : arg(1);
    const uint64_t w_base = is_v == 0u ? arg(2) : arg(3);
    const uint64_t d_buf = is_v == 0u ? arg(4) : arg(5);
    const uint64_t h_base = is_v == 0u ? arg(6) : arg(7);
    const uint64_t c_buf = is_v == 0u ? arg(8) : arg(9);
    const uint64_t t_buf = is_v == 0u ? arg(10) : arg(11);

    const uint has_dyn = is_swa == 0u ? 1u : 0u;
    const float scale = has_dyn != 0u ? inversesqrt(9.0) : inversesqrt(5.0);

    const vec4 wa = F32x4(w_base + uint64_t(c0) * 16u).v[0];
    const vec4 wb = F32x4(w_base + uint64_t(c0 + 1u) * 16u).v[0];
    const vec4 wc = F32x4(w_base + uint64_t(c0 + 2u) * 16u).v[0];
    const vec4 wd = F32x4(w_base + uint64_t(c0 + 3u) * 16u).v[0];
    const vec4 w0 = vec4(wa.x, wb.x, wc.x, wd.x);
    const vec4 w1 = vec4(wa.y, wb.y, wc.y, wd.y);
    const vec4 w2 = vec4(wa.z, wb.z, wc.z, wd.z);
    const vec4 w3 = vec4(wa.w, wb.w, wc.w, wd.w);

    vec4 r0 = F32x4(h_base + uint64_t(c0) * 4u).v[0];
    vec4 r1 = F32x4(h_base + uint64_t(C + c0) * 4u).v[0];
    vec4 r2 = F32x4(h_base + uint64_t(2u * C + c0) * 4u).v[0];
    if (has_trace != 0u) {
        F32x4(t_buf + uint64_t(c0) * 4u).v[0] = r1;
        F32x4(t_buf + uint64_t(C + c0) * 4u).v[0] = r2;
    }

    for (uint r = 0u; r < rows; r++) {
        const vec4 xr = F32x4(x_buf + uint64_t(r * C + c0) * 4u).v[0];
        vec4 acc = r0 * w0 + r1 * w1 + r2 * w2 + xr * w3;
        if (has_dyn != 0u) {
            const uint64_t d_off = (uint64_t(r) * uint64_t(nkv) + uint64_t(kh)) * 16u;
            const vec4 dv = F32x4(d_buf + d_off).v[0];
            acc += xr * dv.x + r2 * dv.y + r1 * dv.z + r0 * dv.w;
        }
        vec4 val = (xr + acc) * scale;
        r0 = r1;
        r1 = r2;
        r2 = xr;
        if (has_trace != 0u) {
            F32x4(t_buf + uint64_t((2u + r) * C + c0) * 4u).v[0] = xr;
        }
        const float tot = subgroupAdd(dot(val, val));
        const float factor = is_v == 0u
            ? clamp(qk_clip / (sqrt(tot) + 1e-6), 0.0, 1.0)
            : inversesqrt(tot / 128.0 + rms_eps);
        val *= factor;
        const uint pos = pos0 + r;
        const uint slot = is_swa != 0u ? (pos % slots) : pos;
        U32x2(c_buf + (uint64_t(slot) * uint64_t(C) + uint64_t(c0)) * 2u).v[0] =
            uvec2(packHalf2x16(val.xy), packHalf2x16(val.zw));
    }
    F32x4(h_base + uint64_t(c0) * 4u).v[0] = r0;
    F32x4(h_base + uint64_t(C + c0) * 4u).v[0] = r1;
    F32x4(h_base + uint64_t(2u * C + c0) * 4u).v[0] = r2;
}
#endif

#ifdef KERNEL_inkling2_kv_prep
void main() {
    const uint kh = gl_WorkGroupID.x;
    const uint is_v = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID; // 0..31 -> 4 channels/lane = 128 head dims
    const uint rows = arg_u32(12);
    const uint nkv = arg_u32(13);
    const uint n_conv = arg_u32(14);
    const uint is_swa = arg_u32(15);
    const uint pos0 = arg_u32(16);
    const uint slots = arg_u32(17);
    const float qk_clip = arg_f32(18);
    const float rms_eps = arg_f32(19);
    const uint has_trace = arg_u32(20);
    const uint hist_len = n_conv - 1u;
    const uint C = nkv * 128u;
    const uint c0 = kh * 128u + lane * 4u;

    const uint64_t x_buf = is_v == 0u ? arg(0) : arg(1);
    const uint64_t w_base = is_v == 0u ? arg(2) : arg(3);
    const uint64_t d_buf = is_v == 0u ? arg(4) : arg(5);
    const uint64_t h_base = is_v == 0u ? arg(6) : arg(7);
    const uint64_t c_buf = is_v == 0u ? arg(8) : arg(9);
    const uint64_t t_buf = is_v == 0u ? arg(10) : arg(11);

    const uint has_dyn = is_swa == 0u ? 1u : 0u;
    const float scale = inversesqrt(float(((has_dyn != 0u ? 2u : 1u) * n_conv) + 1u));

    if (n_conv == 4u) {
        const vec4 wa = F32x4(w_base + uint64_t(c0) * 16u).v[0];
        const vec4 wb = F32x4(w_base + uint64_t(c0 + 1u) * 16u).v[0];
        const vec4 wc = F32x4(w_base + uint64_t(c0 + 2u) * 16u).v[0];
        const vec4 wd = F32x4(w_base + uint64_t(c0 + 3u) * 16u).v[0];
        const vec4 w0 = vec4(wa.x, wb.x, wc.x, wd.x);
        const vec4 w1 = vec4(wa.y, wb.y, wc.y, wd.y);
        const vec4 w2 = vec4(wa.z, wb.z, wc.z, wd.z);
        const vec4 w3 = vec4(wa.w, wb.w, wc.w, wd.w);

        vec4 r0 = F32x4(h_base + uint64_t(c0) * 4u).v[0];
        vec4 r1 = F32x4(h_base + uint64_t(C + c0) * 4u).v[0];
        vec4 r2 = F32x4(h_base + uint64_t(2u * C + c0) * 4u).v[0];
        if (has_trace != 0u) {
            F32x4(t_buf + uint64_t(c0) * 4u).v[0] = r1;
            F32x4(t_buf + uint64_t(C + c0) * 4u).v[0] = r2;
        }

        for (uint r = 0u; r < rows; r++) {
            const vec4 xr = F32x4(x_buf + uint64_t(r * C + c0) * 4u).v[0];
            vec4 acc = r0 * w0 + r1 * w1 + r2 * w2 + xr * w3;
            if (has_dyn != 0u) {
                const uint64_t d_off = (uint64_t(r) * uint64_t(nkv) + uint64_t(kh)) * 16u;
                const vec4 dv = F32x4(d_buf + d_off).v[0];
                acc += xr * dv.x + r2 * dv.y + r1 * dv.z + r0 * dv.w;
            }
            vec4 val = (xr + acc) * scale;
            r0 = r1;
            r1 = r2;
            r2 = xr;
            if (has_trace != 0u) {
                F32x4(t_buf + uint64_t((2u + r) * C + c0) * 4u).v[0] = xr;
            }
            const float tot = subgroupAdd(dot(val, val));
            const float factor = is_v == 0u
                ? clamp(qk_clip / (sqrt(tot) + 1e-6), 0.0, 1.0)
                : inversesqrt(tot / 128.0 + rms_eps);
            val *= factor;
            const uint pos = pos0 + r;
            const uint slot = is_swa != 0u ? (pos % slots) : pos;
            U32x2(c_buf + (uint64_t(slot) * uint64_t(C) + uint64_t(c0)) * 2u).v[0] =
                uvec2(packHalf2x16(val.xy), packHalf2x16(val.zw));
        }
        F32x4(h_base + uint64_t(c0) * 4u).v[0] = r0;
        F32x4(h_base + uint64_t(C + c0) * 4u).v[0] = r1;
        F32x4(h_base + uint64_t(2u * C + c0) * 4u).v[0] = r2;
        return;
    }

    vec4 w[8];
    for (uint k = 0u; k < n_conv; k++) {
        w[k] = vec4(
            F32(w_base + uint64_t(c0) * uint64_t(n_conv) * 4u).v[k],
            F32(w_base + uint64_t(c0 + 1u) * uint64_t(n_conv) * 4u).v[k],
            F32(w_base + uint64_t(c0 + 2u) * uint64_t(n_conv) * 4u).v[k],
            F32(w_base + uint64_t(c0 + 3u) * uint64_t(n_conv) * 4u).v[k]
        );
    }
    vec4 ring[8];
    for (uint k = 0u; k < hist_len; k++) {
        ring[k] = F32x4(h_base + uint64_t(k * C + c0) * 4u).v[0];
    }
    if (has_trace != 0u) {
        for (uint k = 0u; k + 1u < hist_len; k++) {
            F32x4(t_buf + uint64_t(k * C + c0) * 4u).v[0] = ring[k + 1u];
        }
    }

    for (uint r = 0u; r < rows; r++) {
        const vec4 xr = F32x4(x_buf + uint64_t(r * C + c0) * 4u).v[0];
        ring[hist_len] = xr;

        vec4 acc = vec4(0.0);
        for (uint k = 0u; k < n_conv; k++) acc += ring[k] * w[k];
        if (has_dyn != 0u) {
            const uint64_t d_off = (uint64_t(r) * uint64_t(nkv) + uint64_t(kh)) * uint64_t(n_conv) * 4u;
            for (uint lag = 0u; lag < n_conv; lag++) {
                acc += ring[n_conv - 1u - lag] * F32(d_buf + d_off).v[lag];
            }
        }
        vec4 val = (xr + acc) * scale;

        for (uint k = 0u; k < hist_len; k++) ring[k] = ring[k + 1u];
        if (has_trace != 0u) {
            F32x4(t_buf + uint64_t((hist_len - 1u + r) * C + c0) * 4u).v[0] = xr;
        }

        const float tot = subgroupAdd(dot(val, val));
        const float factor = is_v == 0u
            ? clamp(qk_clip / (sqrt(tot) + 1e-6), 0.0, 1.0)
            : inversesqrt(tot / 128.0 + rms_eps);
        val *= factor;

        const uint pos = pos0 + r;
        const uint slot = is_swa != 0u ? (pos % slots) : pos;
        U32x2(c_buf + (uint64_t(slot) * uint64_t(C) + uint64_t(c0)) * 2u).v[0] =
            uvec2(packHalf2x16(val.xy), packHalf2x16(val.zw));
    }

    for (uint k = 0u; k < hist_len; k++) {
        F32x4(h_base + uint64_t(k * C + c0) * 4u).v[0] = ring[k];
    }
}
#endif

// ---------------------------------------------------------------------------
// 26. DSpark GPU kernels: fuse_norm, qk_rope (+ optional F16 ctx store),
//     non-causal GQA attention over [ctx_kv(F16) ; block_kv(F32)], and init_cur.
// ---------------------------------------------------------------------------

// Fuses n_targets slices from cap[n_targets, cap_stride, H] with weights[n_targets],
// then applies RMSNorm(norm_w, eps) -> out[rows, H].
// Grid: (rows, 1, 1), 256 threads (8 subgroups).
// Buffers: 0 cap, 1 weights, 2 norm_w, 3 out.
// Params: 4 H, 5 cap_stride, 6 n_targets, 7 eps, 8 row_off.
#ifdef KERNEL_inkling2_dspark_fuse_norm
shared float dfn_sg[8];
shared float dfn_w[16];

void main() {
    const uint r = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint H = arg_u32(4);
    const uint cap_stride = arg_u32(5);
    const uint n_targets = arg_u32(6);
    const float eps = arg_f32(7);
    const uint row_off = arg_u32(8);

    if (tid < n_targets) dfn_w[tid] = F32(arg(1)).v[tid];
    barrier();

    const uint64_t out_row = arg(3) + uint64_t(r) * uint64_t(H) * 4u;
    float sq = 0.0;
    for (uint i = tid; i < H; i += 256u) {
        float acc = 0.0;
        for (uint ti = 0u; ti < n_targets; ti++) {
            const uint idx = (ti * cap_stride + (row_off + r)) * H + i;
            acc += dfn_w[ti] * F32(arg(0)).v[idx];
        }
        F32(out_row).v[i] = acc;
        sq += acc * acc;
    }
    sq = subgroupAdd(sq);
    if (gl_SubgroupInvocationID == 0u) dfn_sg[gl_SubgroupID] = sq;
    barrier();
    if (tid == 0u) {
        float tot = 0.0;
        for (uint g = 0u; g < 8u; g++) tot += dfn_sg[g];
        dfn_sg[0] = inversesqrt(tot / float(H) + eps);
    }
    barrier();
    const float inv = dfn_sg[0];
    for (uint i = tid; i < H; i += 256u) {
        F32(out_row).v[i] = F32(out_row).v[i] * inv * F32(arg(2)).v[i];
    }
}
#endif

// Per-head RMSNorm + Neox half-split RoPE, with optional F16 ctx KV store.
// Grid: (n_head, rows, 1), 128 threads (4 subgroups, supports hd <= 256).
// Buffers: 0 x (F32 [rows, nh*hd]), 1 norm_w (F32 [hd]),
//          2 v_in (optional F32 [rows, nh*hd]), 3 k_ctx (F16), 4 v_ctx (F16).
// Params: 5 nh, 6 hd, 7 pos0, 8 eps, 9 rope_theta, 10 store_ctx.
#ifdef KERNEL_inkling2_dspark_qk_rope
shared float dqk_buf[256];
shared float dqk_sg[4];

void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint nh = arg_u32(5);
    const uint hd = arg_u32(6);
    const uint pos = arg_u32(7) + r;
    const float eps = arg_f32(8);
    const float theta = arg_f32(9);
    const uint store_ctx = arg_u32(10);
    const uint max_rows = arg_u32(11);
    if (r >= max_rows) return;
    const uint row_off = (r * nh + h) * hd;

    float sq = 0.0;
    for (uint d = tid; d < hd; d += 128u) {
        const float v = F32(arg(0)).v[row_off + d];
        dqk_buf[d] = v;
        sq += v * v;
    }
    sq = subgroupAdd(sq);
    if (gl_SubgroupInvocationID == 0u) dqk_sg[gl_SubgroupID] = sq;
    barrier();
    if (tid == 0u) {
        const float tot = dqk_sg[0] + dqk_sg[1] + dqk_sg[2] + dqk_sg[3];
        dqk_sg[0] = inversesqrt(tot / float(hd) + eps);
    }
    barrier();
    const float inv = dqk_sg[0];
    for (uint d = tid; d < hd; d += 128u) {
        dqk_buf[d] = dqk_buf[d] * inv * F32(arg(1)).v[d];
    }
    barrier();

    const uint half_hd = hd >> 1u;
    const uint ctx_off = (pos * nh + h) * hd;
    for (uint i = tid; i < half_hd; i += 128u) {
        const float freq = 1.0 / pow(theta, float(2u * i) / float(hd));
        const float ang = float(pos) * freq;
        const float c = cos(ang);
        const float s = sin(ang);
        const float a = dqk_buf[i];
        const float b = dqk_buf[half_hd + i];
        const float n0 = a * c - b * s;
        const float n1 = a * s + b * c;
        if (store_ctx != 0u) {
            F16(arg(3)).v[ctx_off + i] = float16_t(n0);
            F16(arg(3)).v[ctx_off + half_hd + i] = float16_t(n1);
            F16(arg(4)).v[ctx_off + i] = float16_t(F32(arg(2)).v[row_off + i]);
            F16(arg(4)).v[ctx_off + half_hd + i] = float16_t(F32(arg(2)).v[row_off + half_hd + i]);
        } else {
            F32(arg(0)).v[row_off + i] = n0;
            F32(arg(0)).v[row_off + half_hd + i] = n1;
        }
    }
}
#endif

// Non-causal GQA over [ctx_kv[ctx_start..ctx_pos] (F16) ; block_kv[0..block] (F32)].
// Grid: (nh, block, 1), 32 threads (1 subgroup per head, supports hd <= 256, multiple of 32).
// Buffers: 0 q, 1 k_ctx (F16), 2 v_ctx (F16), 3 k_blk (F32), 4 v_blk (F32), 5 out (F32).
// Params: 6 nh, 7 nkv, 8 hd, 9 ctx_start, 10 ctx_pos, 11 block.
#ifdef KERNEL_inkling2_dspark_attn
void main() {
    const uint qh = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID;
    const uint nh = arg_u32(6);
    const uint nkv = arg_u32(7);
    const uint hd = arg_u32(8);
    const uint ctx_start = arg_u32(9);
    const uint ctx_pos = arg_u32(10);
    const uint block = arg_u32(11);
    const uint kh = qh / (nh / nkv);
    const uint kw = nkv * hd;
    const uint n_chunks = hd >> 5u; // 4 for hd=128
    const float scale = inversesqrt(float(hd));

    const uint64_t q_ptr = arg(0) + uint64_t((r * nh + qh) * hd) * 4u;
    float qv[8];
    float acc[8];
    for (uint c = 0u; c < n_chunks; c++) {
        qv[c] = F32(q_ptr).v[c * 32u + lane];
        acc[c] = 0.0;
    }

    float m = -1e30;
    float denom = 0.0;

    for (uint pos = ctx_start; pos < ctx_pos; pos++) {
        const uint64_t k_ptr = arg(1) + uint64_t(pos * kw + kh * hd) * 2u;
        const uint64_t v_ptr = arg(2) + uint64_t(pos * kw + kh * hd) * 2u;
        float dot_s = 0.0;
        for (uint c = 0u; c < n_chunks; c++) {
            dot_s += qv[c] * float(F16(k_ptr).v[c * 32u + lane]);
        }
        const float score = subgroupAdd(dot_s) * scale;
        const float new_m = max(m, score);
        const float alpha = exp(m - new_m);
        const float p = exp(score - new_m);
        denom = denom * alpha + p;
        for (uint c = 0u; c < n_chunks; c++) {
            acc[c] = acc[c] * alpha + p * float(F16(v_ptr).v[c * 32u + lane]);
        }
        m = new_m;
    }

    for (uint b = 0u; b < block; b++) {
        const uint64_t k_ptr = arg(3) + uint64_t(b * kw + kh * hd) * 4u;
        const uint64_t v_ptr = arg(4) + uint64_t(b * kw + kh * hd) * 4u;
        float dot_s = 0.0;
        for (uint c = 0u; c < n_chunks; c++) {
            dot_s += qv[c] * F32(k_ptr).v[c * 32u + lane];
        }
        const float score = subgroupAdd(dot_s) * scale;
        const float new_m = max(m, score);
        const float alpha = exp(m - new_m);
        const float p = exp(score - new_m);
        denom = denom * alpha + p;
        for (uint c = 0u; c < n_chunks; c++) {
            acc[c] = acc[c] * alpha + p * F32(v_ptr).v[c * 32u + lane];
        }
        m = new_m;
    }

    const float inv_d = 1.0 / denom;
    const uint64_t out_ptr = arg(5) + uint64_t((r * nh + qh) * hd) * 4u;
    for (uint c = 0u; c < n_chunks; c++) {
        F32(out_ptr).v[c * 32u + lane] = acc[c] * inv_d;
    }
}
#endif

// Stages [anchor_embd ; mask_embd ; mask_embd ; ...] into cur[block, H].
// Grid: (ceil(H / 256), block, 1), 256 threads.
// Buffers: 0 anchor_embd, 1 mask_embd, 2 cur. Params: 3 H.
#ifdef KERNEL_inkling2_dspark_init_cur
void main() {
    const uint i = gl_WorkGroupID.x * 256u + gl_LocalInvocationIndex;
    const uint r = gl_WorkGroupID.y;
    const uint H = arg_u32(3);
    if (i >= H) return;
    F32(arg(2)).v[r * H + i] = r == 0u ? F32(arg(0)).v[i] : F32(arg(1)).v[i];
}
#endif

// ---------------------------------------------------------------------------
// 27. 3-way batched loop controllers & 3-way batched RMSNorm (eliminates 208
//     serial dispatches per forward pass on Borealis!).
// ---------------------------------------------------------------------------

// Batched 3-way ctrl_down_f32/bf16 (per-row high-grid dispatch, j = gl_WorkGroupID.z in 0..3).
// Grid: (ceil(rank / 4), rows, 3), 128 threads (4 subgroups).
// Buffers: 0 cur0, 1 cur1, 2 cur2, 3 msg_out, 4 w0, 5 w1, 6 w2, 7 mid_out.
// Params: 8 H, 9 rank, 10 eps, 11 rows.
#if defined(KERNEL_inkling2_ctrl_down3_f32) || defined(KERNEL_inkling2_ctrl_down3_bf16)
// Zero-barrier single-pass per-row 3-way ctrl_down: reads cur[r] and msg[r] ONCE,
// ZERO shared memory, ZERO barriers, (ceil(rank/2), rows, 3) x 64 threads (96*rows WGs across 40 cores)!
vec4 cd3_load_w4(uint64_t addr, uint i) {
#ifdef KERNEL_inkling2_ctrl_down3_bf16
    const uvec2 u = U32x2(addr).v[i];
    return vec4(
        uintBitsToFloat(u.x << 16u),
        uintBitsToFloat(u.x & 0xffff0000u),
        uintBitsToFloat(u.y << 16u),
        uintBitsToFloat(u.y & 0xffff0000u)
    );
#else
    return F32x4(addr).v[i];
#endif
}

void main() {
    const uint o = gl_WorkGroupID.x * 2u + gl_SubgroupID;
    const uint r = gl_WorkGroupID.y;
    const uint j = gl_WorkGroupID.z;
    const uint lane = gl_SubgroupInvocationID;
    const uint H = arg_u32(8);
    const uint rank = arg_u32(9);
    const float eps = arg_f32(10);
    const uint rows = arg_u32(11);
    if (o >= rank) return;
    const uint64_t cur_base = j == 0u ? arg(0) : (j == 1u ? arg(1) : arg(2));
    const uint64_t w_base = j == 0u ? arg(4) : (j == 1u ? arg(5) : arg(6));
    const uint64_t cur_row = cur_base + uint64_t(r) * uint64_t(H) * 4u;
    const uint64_t msg_row = arg(3) + uint64_t(j * rows + r) * uint64_t(H) * 4u;
    const uint H4 = H >> 2u;

    float sq0 = 0.0, sq1 = 0.0, acc0 = 0.0, acc1 = 0.0;
#ifdef KERNEL_inkling2_ctrl_down3_bf16
    const uint64_t w0 = w_base + uint64_t(o) * uint64_t(2u * H) * 2u;
    const uint64_t w1 = w0 + uint64_t(H) * 2u;
    if ((H & 7u) == 0u) {
        const uint H8 = H >> 3u;
        for (uint i = lane; i < H8; i += 32u) {
            const uvec4 u0 = U32x4(w0).v[i];
            const uvec4 u1 = U32x4(w1).v[i];
            const vec4 ca = F32x4(cur_row).v[2u * i];
            const vec4 cb = F32x4(cur_row).v[2u * i + 1u];
            const vec4 ma = F32x4(msg_row).v[2u * i];
            const vec4 mb = F32x4(msg_row).v[2u * i + 1u];
            sq0 += dot(ca, ca) + dot(cb, cb);
            sq1 += dot(ma, ma) + dot(mb, mb);
            acc0 += dot(vec4(uintBitsToFloat(u0.x << 16u), uintBitsToFloat(u0.x & 0xffff0000u),
                             uintBitsToFloat(u0.y << 16u), uintBitsToFloat(u0.y & 0xffff0000u)), ca)
                  + dot(vec4(uintBitsToFloat(u0.z << 16u), uintBitsToFloat(u0.z & 0xffff0000u),
                             uintBitsToFloat(u0.w << 16u), uintBitsToFloat(u0.w & 0xffff0000u)), cb);
            acc1 += dot(vec4(uintBitsToFloat(u1.x << 16u), uintBitsToFloat(u1.x & 0xffff0000u),
                             uintBitsToFloat(u1.y << 16u), uintBitsToFloat(u1.y & 0xffff0000u)), ma)
                  + dot(vec4(uintBitsToFloat(u1.z << 16u), uintBitsToFloat(u1.z & 0xffff0000u),
                             uintBitsToFloat(u1.w << 16u), uintBitsToFloat(u1.w & 0xffff0000u)), mb);
        }
    } else {
        for (uint i = lane; i < H4; i += 32u) {
            const vec4 cv = F32x4(cur_row).v[i];
            const vec4 mv = F32x4(msg_row).v[i];
            sq0 += dot(cv, cv);
            sq1 += dot(mv, mv);
            acc0 += dot(cd3_load_w4(w0, i), cv);
            acc1 += dot(cd3_load_w4(w1, i), mv);
        }
    }
#else
    const uint64_t w0 = w_base + uint64_t(o) * uint64_t(2u * H) * 4u;
    const uint64_t w1 = w0 + uint64_t(H) * 4u;
    for (uint i = lane; i < H4; i += 32u) {
        const vec4 cv = F32x4(cur_row).v[i];
        const vec4 mv = F32x4(msg_row).v[i];
        sq0 += dot(cv, cv);
        sq1 += dot(mv, mv);
        acc0 += dot(cd3_load_w4(w0, i), cv);
        acc1 += dot(cd3_load_w4(w1, i), mv);
    }
#endif
    const float inv0 = inversesqrt(subgroupAdd(sq0) / float(H) + eps);
    const float inv1 = inversesqrt(subgroupAdd(sq1) / float(H) + eps);
    const float tot = subgroupAdd(acc0) * inv0 + subgroupAdd(acc1) * inv1;
    if (lane == 0u) F32(arg(7)).v[(j * rows + r) * rank + o] = tot;
}
#endif

// Batched 3-way coalesced ctrl_blend (per-row high-grid dispatch, j = gl_WorkGroupID.z in 0..3).
// Grid: (ceil(H / 32), rows, 3), 128 threads (4 lanes/row, 216*rows WGs across 40 cores).
// Buffers: 0 cur0, 1 cur1, 2 cur2, 3 msg_out, 4 mid_out,
//          5 wg0, 6 wg1, 7 wg2, 8 wf0, 9 wf1, 10 wf2, 11 out0, 12 out1, 13 out2,
//          14 nw0, 15 nw1, 16 nw2.
// Params: 17 H, 18 rank, 19 rows, 20 has_norm, 21 norm_eps.
#if defined(KERNEL_inkling2_ctrl_blend3_f32) || defined(KERNEL_inkling2_ctrl_blend3_bf16)
shared float cb3_mid[128];

vec4 cb3_load_w4(uint64_t addr, uint k) {
#ifdef KERNEL_inkling2_ctrl_blend3_bf16
    const uvec2 u = U32x2(addr).v[k];
    return vec4(
        uintBitsToFloat(u.x << 16u),
        uintBitsToFloat(u.x & 0xffff0000u),
        uintBitsToFloat(u.y << 16u),
        uintBitsToFloat(u.y & 0xffff0000u)
    );
#else
    return F32x4(addr).v[k];
#endif
}

void main() {
    const uint row_in_sg = gl_SubgroupInvocationID >> 2u;
    const uint lane = gl_SubgroupInvocationID & 3u;
    const uint r = gl_WorkGroupID.y;
    const uint j = gl_WorkGroupID.z;
    const uint H = arg_u32(17);
    const uint rank = arg_u32(18);
    const uint rows = arg_u32(19);
    if (gl_LocalInvocationIndex < rank) {
        cb3_mid[gl_LocalInvocationIndex] = F32(arg(4)).v[(j * rows + r) * rank + gl_LocalInvocationIndex];
    }
    barrier();

#ifdef KERNEL_inkling2_ctrl_blend3_bf16
    const uint64_t elem_b = 2u;
#else
    const uint64_t elem_b = 4u;
#endif
    const uint64_t wg_base = j == 0u ? arg(5) : (j == 1u ? arg(6) : arg(7));
    const uint64_t wf_base = j == 0u ? arg(8) : (j == 1u ? arg(9) : arg(10));
    const uint64_t cur_base = j == 0u ? arg(0) : (j == 1u ? arg(1) : arg(2));
    const uint64_t out_base = j == 0u ? arg(11) : (j == 1u ? arg(12) : arg(13));
    const uint r4 = rank >> 2u;

    const uint i = gl_WorkGroupID.x * 32u + gl_SubgroupID * 8u + row_in_sg;
    if (i >= H) return;
    const uint64_t wg = wg_base + uint64_t(i) * uint64_t(rank) * elem_b;
    const uint64_t wf = wf_base + uint64_t(i) * uint64_t(rank) * elem_b;
    float g = 0.0, f = 0.0;
#ifdef KERNEL_inkling2_ctrl_blend3_bf16
    if ((rank & 7u) == 0u) {
        const uint r8 = rank >> 3u;
        for (uint k = lane; k < r8; k += 4u) {
            const uint k8 = 8u * k;
            const vec4 m0 = vec4(cb3_mid[k8], cb3_mid[k8 + 1u], cb3_mid[k8 + 2u], cb3_mid[k8 + 3u]);
            const vec4 m1 = vec4(cb3_mid[k8 + 4u], cb3_mid[k8 + 5u], cb3_mid[k8 + 6u], cb3_mid[k8 + 7u]);
            const uvec4 ug = U32x4(wg).v[k];
            const uvec4 uf = U32x4(wf).v[k];
            g += dot(vec4(uintBitsToFloat(ug.x << 16u), uintBitsToFloat(ug.x & 0xffff0000u),
                          uintBitsToFloat(ug.y << 16u), uintBitsToFloat(ug.y & 0xffff0000u)), m0)
               + dot(vec4(uintBitsToFloat(ug.z << 16u), uintBitsToFloat(ug.z & 0xffff0000u),
                          uintBitsToFloat(ug.w << 16u), uintBitsToFloat(ug.w & 0xffff0000u)), m1);
            f += dot(vec4(uintBitsToFloat(uf.x << 16u), uintBitsToFloat(uf.x & 0xffff0000u),
                          uintBitsToFloat(uf.y << 16u), uintBitsToFloat(uf.y & 0xffff0000u)), m0)
               + dot(vec4(uintBitsToFloat(uf.z << 16u), uintBitsToFloat(uf.z & 0xffff0000u),
                          uintBitsToFloat(uf.w << 16u), uintBitsToFloat(uf.w & 0xffff0000u)), m1);
        }
    } else
#endif
    {
        for (uint k = lane; k < r4; k += 4u) {
            const uint k4 = 4u * k;
            const vec4 m = vec4(cb3_mid[k4], cb3_mid[k4 + 1u], cb3_mid[k4 + 2u], cb3_mid[k4 + 3u]);
            g += dot(cb3_load_w4(wg, k), m);
            f += dot(cb3_load_w4(wf, k), m);
        }
    }
    g += subgroupShuffleXor(g, 2u); g += subgroupShuffleXor(g, 1u);
    f += subgroupShuffleXor(f, 2u); f += subgroupShuffleXor(f, 1u);
    if (lane == 0u) {
        const float cv = F32(cur_base).v[r * H + i];
        const float mv = F32(arg(3)).v[(j * rows + r) * H + i];
        F32(out_base).v[r * H + i] = (1.0 - tanh(f)) * cv + tanh(g) * mv;
    }
}
#endif

// Batched 3-way RMSNorm (j = gl_WorkGroupID.y in 0..3).
// Grid: (rows, 3, 1), 256 threads (8 subgroups).
// Buffers: 0 x0, 1 x1, 2 x2, 3 w0, 4 w1, 5 w2, 6 y0, 7 y1, 8 y2.
// Params: 9 H, 10 eps.
#ifdef KERNEL_inkling2_rms_norm3
shared float rn3_sg[8];

void main() {
    const uint r = gl_WorkGroupID.x;
    const uint j = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint H = arg_u32(9);
    const float eps = arg_f32(10);
    const uint out_bf16 = arg_u32(11);
    const uint64_t x_row = (j == 0u ? arg(0) : (j == 1u ? arg(1) : arg(2))) + uint64_t(r) * uint64_t(H) * 4u;
    const uint64_t w_ptr = j == 0u ? arg(3) : (j == 1u ? arg(4) : arg(5));
    const uint64_t y_row = (j == 0u ? arg(6) : (j == 1u ? arg(7) : arg(8))) + uint64_t(r) * uint64_t(H) * (out_bf16 != 0u ? 2u : 4u);

    float sq = 0.0;
    if ((H & 3u) == 0u) {
        const uint H4 = H >> 2u;
        const uint n_sg = gl_NumSubgroups;
        const uint wg_t = n_sg * 32u;
        if (H4 == 3u * wg_t) {
            const vec4 v0 = F32x4(x_row).v[tid];
            const vec4 v1 = F32x4(x_row).v[tid + wg_t];
            const vec4 v2 = F32x4(x_row).v[tid + 2u * wg_t];
            const float s = subgroupAdd((dot(v0, v0) + dot(v1, v1)) + dot(v2, v2));
            if (gl_SubgroupInvocationID == 0u) rn3_sg[gl_SubgroupID] = s;
            barrier();
            const float tot = subgroupAdd(gl_SubgroupInvocationID < n_sg ? rn3_sg[gl_SubgroupInvocationID] : 0.0);
            const float inv = inversesqrt(tot / float(H) + eps);
            const vec4 o0 = v0 * inv * F32x4(w_ptr).v[tid];
            const vec4 o1 = v1 * inv * F32x4(w_ptr).v[tid + wg_t];
            const vec4 o2 = v2 * inv * F32x4(w_ptr).v[tid + 2u * wg_t];
            if (out_bf16 != 0u) {
                U32x2(y_row).v[tid] = i2_bf16_words(o0);
                U32x2(y_row).v[tid + wg_t] = i2_bf16_words(o1);
                U32x2(y_row).v[tid + 2u * wg_t] = i2_bf16_words(o2);
            } else {
                F32x4(y_row).v[tid] = o0;
                F32x4(y_row).v[tid + wg_t] = o1;
                F32x4(y_row).v[tid + 2u * wg_t] = o2;
            }
            return;
        }
        for (uint i = tid; i < H4; i += wg_t) {
            const vec4 v = F32x4(x_row).v[i];
            sq += dot(v, v);
        }
        sq = subgroupAdd(sq);
        if (gl_SubgroupInvocationID == 0u) rn3_sg[gl_SubgroupID] = sq;
        barrier();
        const float tot = subgroupAdd(gl_SubgroupInvocationID < n_sg ? rn3_sg[gl_SubgroupInvocationID] : 0.0);
        const float inv = inversesqrt(tot / float(H) + eps);
        for (uint i = tid; i < H4; i += wg_t) {
            const vec4 v = F32x4(x_row).v[i] * inv * F32x4(w_ptr).v[i];
            if (out_bf16 != 0u) U32x2(y_row).v[i] = i2_bf16_words(v);
            else F32x4(y_row).v[i] = v;
        }
        return;
    }
    for (uint i = tid; i < H; i += 256u) {
        const float v = F32(x_row).v[i];
        sq += v * v;
    }
    sq = subgroupAdd(sq);
    if (gl_SubgroupInvocationID == 0u) rn3_sg[gl_SubgroupID] = sq;
    barrier();
    float tot = 0.0;
    [[unroll]] for (uint g = 0u; g < 8u; g++) tot += rn3_sg[g];
    const float inv = inversesqrt(tot / float(H) + eps);
    for (uint i = tid; i < H; i += 256u) {
        F32(y_row).v[i] = F32(x_row).v[i] * inv * F32(w_ptr).v[i];
    }
}
#endif

// ---------------------------------------------------------------------------
// 28. Split-K + GQA-shared + 4-key-unrolled decode/verify attention
//     (`inkling2_attn_split` + `inkling2_attn_combine`), head_dim = 128.
//
// Each workgroup processes `chunk_keys` keys (4 subgroups x `chunk_keys/4` keys,
// unrolled 4 keys/step) for `g_step` (1..=4) query heads sharing ONE KV head
// (`g_step` divides `nh / nkv`, so for Inkling 2 Mini G=3 -> 3x less KV reads).
// `inkling2_attn_combine` merges chunks with the implicit zero attention sink
// (`M = max(0, max_c m_c)`, `L = exp(-M) + sum_c l_c * exp(m_c - M)`) and
// applies the optional sigmoid output gate.
//
// Split grid: (chunks, nh / g_step, rows), 128 threads (4 subgroups).
// Split buffers: 0 q, 1 k_cache (F16), 2 v_cache (F16), 3 rel_table, 4 sinks,
//                5 partial ([rows, nh, chunks, 130]), 6 q_clip (optional),
//                7 out (used directly when chunks == 1), 8 gate (optional).
// Split params: 9 nh, 10 nkv, 11 g_step, 12 pos0, 13 slots, 14 is_swa, 15 window,
//               16 extent, 17 has_q_clip, 18 qk_clip, 19 log_floor, 20 log_alpha,
//               21 chunks, 22 chunk_keys, 23 has_gate.
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_attn_split) || defined(KERNEL_inkling2_attn_split_rel_f32)
#ifdef KERNEL_inkling2_attn_split_rel_f32
#define ASP_P0 12u
#else
#define ASP_P0 9u
#endif
shared float asp_m[4];
shared float asp_l[4];
shared vec4 asp_acc[4][32];

void main() {
    const uint c = gl_WorkGroupID.x;
    const uint y = gl_WorkGroupID.y;
    const uint z = gl_WorkGroupID.z;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;

    const uint nh = arg_u32(ASP_P0 + 0u);
    const uint nkv = arg_u32(ASP_P0 + 1u);
    const uint g_step = arg_u32(ASP_P0 + 2u);
    const uint pos0 = arg_u32(ASP_P0 + 3u);
    const uint slots = arg_u32(ASP_P0 + 4u);
    const uint is_swa = arg_u32(ASP_P0 + 5u);
    const uint window = arg_u32(ASP_P0 + 6u);
    const uint extent = arg_u32(ASP_P0 + 7u);
    const uint has_q_clip = arg_u32(ASP_P0 + 8u);
    const float qk_clip = arg_f32(ASP_P0 + 9u);
    const uint log_floor = arg_u32(ASP_P0 + 10u);
    const float log_alpha = arg_f32(ASP_P0 + 11u);
    const uint chunks = arg_u32(ASP_P0 + 12u);
    const uint chunk_keys = arg_u32(ASP_P0 + 13u);
    const uint has_gate = arg_u32(ASP_P0 + 14u);
#ifdef KERNEL_inkling2_attn_split_rel_f32
    const float rel_clip_thr = arg_f32(ASP_P0 + 15u);
    const uint out_bf16 = arg_u32(ASP_P0 + 16u);
#else
    const uint out_bf16 = arg_u32(ASP_P0 + 15u);
#endif

    const uint r = z;
    const uint h0 = y * g_step;
    const uint kv_h = h0 / (nh / nkv);
    const uint pos = pos0 + r;

    vec4 q[4];
    float sink[4];
#ifdef KERNEL_inkling2_attn_split_rel_f32
    vec4 r_vec[4];
#else
    uint64_t rel_row[4];
#endif
    float mx[4] = float[4](-1.0 / 0.0, -1.0 / 0.0, -1.0 / 0.0, -1.0 / 0.0);
    float sum[4] = float[4](0.0, 0.0, 0.0, 0.0);
    vec4 acc[4] = vec4[4](vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));

    float tau = 1.0;
    if (log_alpha > 0.0 && log_floor > 0u) {
        const float ratio = float(pos + 1u) / float(log_floor);
        if (ratio > 1.0) tau = 1.0 + log_alpha * log(ratio);
    }

    [[unroll]] for (uint g = 0u; g < 4u; g++) {
        if (g >= g_step) break;
        const uint h = h0 + g;
        const uint64_t q_off = (uint64_t(r) * uint64_t(nh) + uint64_t(h)) * 128u * 4u;
        vec4 qv = F32x4(arg(0) + q_off).v[lane];
        if (has_q_clip != 0u) {
            qv *= F32x4(arg(6) + uint64_t(h) * 128u * 4u).v[lane];
            const float norm = sqrt(subgroupAdd(dot(qv, qv))) + 1e-6;
            const float factor = clamp(qk_clip / norm, 0.0, 1.0) * tau;
            qv *= factor * inversesqrt(128.0);
        } else {
            qv *= inversesqrt(128.0);
        }
        q[g] = qv;
        sink[g] = F32(arg(4)).v[r * nh + h];
#ifdef KERNEL_inkling2_attn_split_rel_f32
        if (lane < 4u) {
            const uint64_t R = arg(9) + 4u * ((uint64_t(r) * uint64_t(nh) + uint64_t(h)) * 16u + 4u * lane);
            vec4 rv = F32x4(R).v[0];
            if (rel_clip_thr > 0.0) {
                const uint64_t RC = arg(11) + 4u * (uint64_t(h) * 16u + 4u * lane);
                rv *= F32x4(RC).v[0];
                float rsq = dot(rv, rv);
                rsq += subgroupShuffleXor(rsq, 1u);
                rsq += subgroupShuffleXor(rsq, 2u);
                rv *= clamp(rel_clip_thr / (sqrt(rsq) + 1e-6), 0.0, 1.0) * tau;
            }
            r_vec[g] = rv;
        }
#else
        rel_row[g] = arg(3) + (uint64_t(r) * uint64_t(nh) + uint64_t(h)) * uint64_t(extent) * 4u;
#endif
    }

    const uint k_start = (is_swa != 0u && pos + 1u > window) ? (pos + 1u - window) : 0u;
    const uint k_end = pos + 1u;
    const uint keys_per_sg = chunk_keys >> 2u;
    const uint first = k_start + c * chunk_keys + sg * keys_per_sg;
    const uint last = min(first + keys_per_sg, k_end);

    if (first < last) {
        U32x2 kbuf = U32x2(arg(1) + uint64_t(kv_h) * 256u);
        U32x2 vbuf = U32x2(arg(2) + uint64_t(kv_h) * 256u);
        const uint kv_row = nkv * 32u;
        uint slot = is_swa != 0u ? (first % slots) : first;

        [[dont_unroll]] for (uint key = first; key < last; key += 4u) {
            vec4 kr[4], vr[4];
            const uint rem = last - 1u - key;
            [[unroll]] for (uint u = 0u; u < 4u; u++) {
                uint su = slot + min(u, rem);
                if (is_swa != 0u && su >= slots) su -= slots;
                const uvec2 kp = kbuf.v[su * kv_row + lane];
                const uvec2 vp = vbuf.v[su * kv_row + lane];
                kr[u] = vec4(unpackHalf2x16(kp.x), unpackHalf2x16(kp.y));
                vr[u] = vec4(unpackHalf2x16(vp.x), unpackHalf2x16(vp.y));
            }
            [[unroll]] for (uint g = 0u; g < 4u; g++) {
                if (g >= g_step) break;
                float sc[4];
                float mn = mx[g];
                [[unroll]] for (uint u = 0u; u < 4u; u++) {
                    const float d = subgroupAdd(dot(q[g], kr[u]));
                    if (u <= rem) {
                        const uint dist = pos - (key + u);
#ifdef KERNEL_inkling2_attn_split_rel_f32
                        float rb = 0.0;
                        if (dist < extent) {
                            const float part = lane < 4u
                                ? dot(r_vec[g], F32x4(arg(10) + uint64_t(dist) * 64u).v[lane])
                                : 0.0;
                            float s4 = part + subgroupShuffleXor(part, 1u);
                            s4 += subgroupShuffleXor(s4, 2u);
                            rb = subgroupBroadcast(s4, 0u);
                        }
#else
                        const float rb = dist < extent ? F32(rel_row[g]).v[dist] : 0.0;
#endif
                        sc[u] = d + rb - sink[g];
                        mn = max(mn, sc[u]);
                    } else {
                        sc[u] = -1.0 / 0.0;
                    }
                }
                const float a = mx[g] == -1.0 / 0.0 ? 0.0 : exp(mx[g] - mn);
                sum[g] *= a;
                float e[4];
                [[unroll]] for (uint u = 0u; u < 4u; u++) {
                    e[u] = u <= rem ? exp(sc[u] - mn) : 0.0;
                    sum[g] += e[u];
                }
                acc[g] = acc[g] * a + vr[0] * e[0] + vr[1] * e[1] + vr[2] * e[2] + vr[3] * e[3];
                mx[g] = mn;
            }
            slot += 4u;
            if (is_swa != 0u && slot >= slots) slot -= slots;
        }
    }

    [[unroll]] for (uint g = 0u; g < 4u; g++) {
        if (g >= g_step) break;
        const uint h = h0 + g;
        if (lane == 0u) {
            asp_m[sg] = mx[g];
            asp_l[sg] = sum[g];
        }
        asp_acc[sg][lane] = acc[g];
        barrier();
        if (sg == 0u) {
            const float M = max(max(asp_m[0], asp_m[1]), max(asp_m[2], asp_m[3]));
            const float f0 = (M == -1.0 / 0.0 || asp_m[0] == -1.0 / 0.0) ? 0.0 : exp(asp_m[0] - M);
            const float f1 = (M == -1.0 / 0.0 || asp_m[1] == -1.0 / 0.0) ? 0.0 : exp(asp_m[1] - M);
            const float f2 = (M == -1.0 / 0.0 || asp_m[2] == -1.0 / 0.0) ? 0.0 : exp(asp_m[2] - M);
            const float f3 = (M == -1.0 / 0.0 || asp_m[3] == -1.0 / 0.0) ? 0.0 : exp(asp_m[3] - M);
            const vec4 a = asp_acc[0][lane] * f0 + asp_acc[1][lane] * f1
                         + asp_acc[2][lane] * f2 + asp_acc[3][lane] * f3;
            const float l_tot = asp_l[0] * f0 + asp_l[1] * f1 + asp_l[2] * f2 + asp_l[3] * f3;
            if (chunks == 1u) {
                const float M0 = max(M, 0.0);
                const float w = M == -1.0 / 0.0 ? 0.0 : exp(M - M0);
                const float L = exp(-M0) + l_tot * w;
                vec4 res = (M == -1.0 / 0.0) ? vec4(0.0) : ((a * w) / L);
                const uint64_t q_off = (uint64_t(r) * uint64_t(nh) + uint64_t(h)) * 128u * 4u;
                if (has_gate != 0u) {
                    const vec4 gv = F32x4(arg(8) + q_off).v[lane];
                    res = res / (vec4(1.0) + exp(-gv));
                }
                if (out_bf16 != 0u) U32x2(arg(7) + (q_off >> 1u)).v[lane] = i2_bf16_words(res);
                else F32x4(arg(7) + q_off).v[lane] = res;
            } else {
                const uint64_t P = arg(5) + 4u * (((uint64_t(r) * uint64_t(nh) + uint64_t(h)) * uint64_t(chunks) + uint64_t(c)) * 130u);
                if (M == -1.0 / 0.0) {
                    if (lane == 0u) {
                        F32(P).v[0] = -1.0 / 0.0;
                        F32(P).v[1] = 0.0;
                    }
                } else {
                    F32x4(P + 8u).v[lane] = a;
                    if (lane == 0u) {
                        F32(P).v[0] = M;
                        F32(P).v[1] = l_tot;
                    }
                }
            }
        }
        barrier();
    }
}
#endif

// Combine grid: (nh, rows, 1), 128 threads (1 thread per head_dim element 0..127).
// Buffers: 0 partial, 1 out, 2 gate (optional).
// Params: 3 nh, 4 chunks (<= 128), 5 has_gate.
#ifdef KERNEL_inkling2_attn_combine
shared float acb_m[128];
shared float acb_w[128];
shared float acb_lw[128];
shared float acb_red_m[4];

void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint nh = arg_u32(3);
    const uint chunks = arg_u32(4);
    const uint has_gate = arg_u32(5);
    const uint out_bf16 = arg_u32(6);
    const uint64_t P = arg(0) + 4u * ((uint64_t(r) * uint64_t(nh) + uint64_t(h)) * uint64_t(chunks) * 130u);

    // Implicit zero attention sink at score 0.0 -> M >= 0.0.
    float mx = 0.0;
    if (tid < chunks) {
        const float m = F32(P).v[tid * 130u];
        acb_m[tid] = m;
        mx = max(mx, m);
    }
    mx = subgroupMax(mx);
    if (gl_SubgroupInvocationID == 0u) acb_red_m[gl_SubgroupID] = mx;
    barrier();
    const float M = max(max(acb_red_m[0], acb_red_m[1]), max(acb_red_m[2], acb_red_m[3]));

    if (tid < chunks) {
        const float m = acb_m[tid];
        const float w = m == -1.0 / 0.0 ? 0.0 : exp(m - M);
        acb_w[tid] = w;
        acb_lw[tid] = w != 0.0 ? F32(P).v[tid * 130u + 1u] * w : 0.0;
    }
    barrier();

    // Accumulate both L and a sequentially in chunk order so empty trailing chunks
    // (w == 0) cannot alter floating-point rounding between decode(1) and verify(m).
    float L = exp(-M);
    float a = 0.0;
    for (uint c = 0u; c < chunks; c++) {
        const float w = acb_w[c];
        if (w != 0.0) {
            L += acb_lw[c];
            a += F32(P).v[c * 130u + 2u + tid] * w;
        }
    }
    float res = a / L;
    const uint64_t q_off = (uint64_t(r) * uint64_t(nh) + uint64_t(h)) * 128u * 4u;
    if (has_gate != 0u) {
        const float gv = F32(arg(2) + q_off).v[tid];
        res = res / (1.0 + exp(-gv));
    }
    if (out_bf16 != 0u) {
        const uint u = floatBitsToUint(res);
        U16(arg(1) + (q_off >> 1u)).v[tid] = uint16_t((u + 0x7fffu + ((u >> 16u) & 1u)) >> 16u);
    } else {
        F32(arg(1) + q_off).v[tid] = res;
    }
}
#endif

// 4-way Z-split zero-barrier 1-subgroup combine for chunks <= 32 (480 WGs for 5x24 heads!).
// Grid: (nh, rows, 4), 32 threads (each WG handles 32 contiguous dims = 1 exact 128B cache line/chunk).
#ifdef KERNEL_inkling2_attn_combine_s32_z4
void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint dg = gl_WorkGroupID.z;
    const uint lane = gl_SubgroupInvocationID;
    const uint d = dg * 32u + lane;
    const uint nh = arg_u32(3);
    const uint chunks = arg_u32(4);
    const uint has_gate = arg_u32(5);
    const uint out_bf16 = arg_u32(6);
    const uint64_t P = arg(0) + 4u * ((uint64_t(r) * uint64_t(nh) + uint64_t(h)) * uint64_t(chunks) * 130u);

    float m = 0.0;
    float l = 0.0;
    if (lane < chunks) {
        m = F32(P).v[lane * 130u];
        l = F32(P).v[lane * 130u + 1u];
    }
    const float M = max(0.0, subgroupMax(m));
    const float w = (lane < chunks && m != -1.0 / 0.0) ? exp(m - M) : 0.0;
    const float lw = w != 0.0 ? l * w : 0.0;

    const bool all_valid = subgroupAdd(uint(m == -1.0 / 0.0)) == 0u;
    float L = exp(-M);
    float a = 0.0;
    const uint64_t Pd = P + 4u * (2u + d);
    if (all_valid) {
        uint c = 0u;
        for (; c + 3u < chunks; c += 4u) {
            const float w0 = subgroupBroadcast(w, c + 0u);
            const float w1 = subgroupBroadcast(w, c + 1u);
            const float w2 = subgroupBroadcast(w, c + 2u);
            const float w3 = subgroupBroadcast(w, c + 3u);
            L += subgroupBroadcast(lw, c + 0u);
            L += subgroupBroadcast(lw, c + 1u);
            L += subgroupBroadcast(lw, c + 2u);
            L += subgroupBroadcast(lw, c + 3u);
            const float v0 = F32(Pd).v[(c + 0u) * 130u];
            const float v1 = F32(Pd).v[(c + 1u) * 130u];
            const float v2 = F32(Pd).v[(c + 2u) * 130u];
            const float v3 = F32(Pd).v[(c + 3u) * 130u];
            a += v0 * w0;
            a += v1 * w1;
            a += v2 * w2;
            a += v3 * w3;
        }
        for (; c < chunks; c++) {
            L += subgroupBroadcast(lw, c);
            a += F32(Pd).v[c * 130u] * subgroupBroadcast(w, c);
        }
    } else {
        for (uint c = 0u; c < chunks; c++) {
            const float wc = subgroupBroadcast(w, c);
            if (wc != 0.0) {
                L += subgroupBroadcast(lw, c);
                a += F32(Pd).v[c * 130u] * wc;
            }
        }
    }
    float res = a / L;
    const uint64_t q_off = (uint64_t(r) * uint64_t(nh) + uint64_t(h)) * 128u * 4u;
    if (has_gate != 0u) {
        const float gv = F32(arg(2) + q_off).v[d];
        res = res / (1.0 + exp(-gv));
    }
    if (out_bf16 != 0u) {
        const uint u = floatBitsToUint(res);
        const uint b0 = (u + 0x7fffu + ((u >> 16u) & 1u)) >> 16u;
        const uint b1 = subgroupShuffleXor(b0, 1u);
        if ((lane & 1u) == 0u) U32(arg(1) + (q_off >> 1u)).v[d >> 1u] = b0 | (b1 << 16u);
    } else {
        F32(arg(1) + q_off).v[d] = res;
    }
}
#endif

// ---------------------------------------------------------------------------
// 29. Split-K + GQA-shared DSpark non-causal attention (hd = 128).
//     Chunks 0..ctx_chunks cover ctx_kv[ctx_start..ctx_pos] (F16);
//     final chunk c == ctx_chunks covers block_kv[0..block] (F32).
//
// Split grid: (ctx_chunks + 1, nh / g_step, block), 128 threads (4 subgroups).
// Split buffers: 0 q, 1 k_ctx (F16), 2 v_ctx (F16), 3 k_blk (F32), 4 v_blk (F32),
//                5 partial ([block, nh, ctx_chunks + 1, 130]).
// Split params: 6 nh, 7 nkv, 8 g_step, 9 ctx_start, 10 ctx_pos, 11 block,
//               12 ctx_chunks, 13 chunk_keys.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_dspark_attn_split
shared float dsp_m[4];
shared float dsp_l[4];
shared vec4 dsp_acc[4][32];

void main() {
    const uint c = gl_WorkGroupID.x;
    const uint y = gl_WorkGroupID.y;
    const uint r = gl_WorkGroupID.z;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;

    const uint nh = arg_u32(6);
    const uint nkv = arg_u32(7);
    const uint g_step = arg_u32(8);
    const uint ctx_start = arg_u32(9);
    const uint ctx_pos = arg_u32(10);
    const uint block = arg_u32(11);
    const uint ctx_chunks = arg_u32(12);
    const uint chunk_keys = arg_u32(13);
    const uint total_chunks = ctx_chunks + 1u;

    const uint h0 = y * g_step;
    const uint kv_h = h0 / (nh / nkv);
    const float scale = inversesqrt(128.0);

    vec4 q[4];
    float mx[4] = float[4](-1.0 / 0.0, -1.0 / 0.0, -1.0 / 0.0, -1.0 / 0.0);
    float sum[4] = float[4](0.0, 0.0, 0.0, 0.0);
    vec4 acc[4] = vec4[4](vec4(0.0), vec4(0.0), vec4(0.0), vec4(0.0));

    [[unroll]] for (uint g = 0u; g < 4u; g++) {
        if (g >= g_step) break;
        const uint64_t q_off = (uint64_t(r) * uint64_t(nh) + uint64_t(h0 + g)) * 128u * 4u;
        q[g] = F32x4(arg(0) + q_off).v[lane] * scale;
    }

    if (c < ctx_chunks) {
        const uint keys_per_sg = chunk_keys >> 2u;
        const uint first = ctx_start + c * chunk_keys + sg * keys_per_sg;
        const uint last = min(first + keys_per_sg, ctx_pos);
        if (first < last) {
            U32x2 kbuf = U32x2(arg(1) + uint64_t(kv_h) * 256u);
            U32x2 vbuf = U32x2(arg(2) + uint64_t(kv_h) * 256u);
            const uint kv_row = nkv * 32u;
            [[dont_unroll]] for (uint key = first; key < last; key += 4u) {
                vec4 kr[4], vr[4];
                const uint rem = last - 1u - key;
                [[unroll]] for (uint u = 0u; u < 4u; u++) {
                    const uint su = key + min(u, rem);
                    const uvec2 kp = kbuf.v[su * kv_row + lane];
                    const uvec2 vp = vbuf.v[su * kv_row + lane];
                    kr[u] = vec4(unpackHalf2x16(kp.x), unpackHalf2x16(kp.y));
                    vr[u] = vec4(unpackHalf2x16(vp.x), unpackHalf2x16(vp.y));
                }
                [[unroll]] for (uint g = 0u; g < 4u; g++) {
                    if (g >= g_step) break;
                    float sc[4];
                    float mn = mx[g];
                    [[unroll]] for (uint u = 0u; u < 4u; u++) {
                        const float d = subgroupAdd(dot(q[g], kr[u]));
                        sc[u] = u <= rem ? d : -1.0 / 0.0;
                        mn = max(mn, sc[u]);
                    }
                    const float a = mx[g] == -1.0 / 0.0 ? 0.0 : exp(mx[g] - mn);
                    sum[g] *= a;
                    float e[4];
                    [[unroll]] for (uint u = 0u; u < 4u; u++) {
                        e[u] = u <= rem ? exp(sc[u] - mn) : 0.0;
                        sum[g] += e[u];
                    }
                    acc[g] = acc[g] * a + vr[0] * e[0] + vr[1] * e[1] + vr[2] * e[2] + vr[3] * e[3];
                    mx[g] = mn;
                }
            }
        }
    } else {
        // Final chunk: F32 block_kv[0..block] distributed across the 4 subgroups.
        const uint kv_row = nkv * 32u;
        F32x4 kblk = F32x4(arg(3) + uint64_t(kv_h) * 512u);
        F32x4 vblk = F32x4(arg(4) + uint64_t(kv_h) * 512u);
        for (uint b = sg; b < block; b += 4u) {
            const vec4 kv = kblk.v[b * kv_row + lane];
            const vec4 vv = vblk.v[b * kv_row + lane];
            [[unroll]] for (uint g = 0u; g < 4u; g++) {
                if (g >= g_step) break;
                const float s = subgroupAdd(dot(q[g], kv));
                const float mn = max(mx[g], s);
                const float a = mx[g] == -1.0 / 0.0 ? 0.0 : exp(mx[g] - mn);
                const float e = exp(s - mn);
                sum[g] = sum[g] * a + e;
                acc[g] = acc[g] * a + vv * e;
                mx[g] = mn;
            }
        }
    }

    [[unroll]] for (uint g = 0u; g < 4u; g++) {
        if (g >= g_step) break;
        if (lane == 0u) {
            dsp_m[sg] = mx[g];
            dsp_l[sg] = sum[g];
        }
        dsp_acc[sg][lane] = acc[g];
        barrier();
        if (sg == 0u) {
            const float M = max(max(dsp_m[0], dsp_m[1]), max(dsp_m[2], dsp_m[3]));
            const uint64_t P = arg(5) + 4u * (((uint64_t(r) * uint64_t(nh) + uint64_t(h0 + g)) * uint64_t(total_chunks) + uint64_t(c)) * 130u);
            if (M == -1.0 / 0.0) {
                if (lane == 0u) {
                    F32(P).v[0] = -1.0 / 0.0;
                    F32(P).v[1] = 0.0;
                }
            } else {
                const float f0 = dsp_m[0] == -1.0 / 0.0 ? 0.0 : exp(dsp_m[0] - M);
                const float f1 = dsp_m[1] == -1.0 / 0.0 ? 0.0 : exp(dsp_m[1] - M);
                const float f2 = dsp_m[2] == -1.0 / 0.0 ? 0.0 : exp(dsp_m[2] - M);
                const float f3 = dsp_m[3] == -1.0 / 0.0 ? 0.0 : exp(dsp_m[3] - M);
                const vec4 a = dsp_acc[0][lane] * f0 + dsp_acc[1][lane] * f1
                             + dsp_acc[2][lane] * f2 + dsp_acc[3][lane] * f3;
                F32x4(P + 8u).v[lane] = a;
                if (lane == 0u) {
                    F32(P).v[0] = M;
                    F32(P).v[1] = dsp_l[0] * f0 + dsp_l[1] * f1 + dsp_l[2] * f2 + dsp_l[3] * f3;
                }
            }
        }
        barrier();
    }
}
#endif

// DSpark combine grid: (nh, block, 1), 128 threads.
// Buffers: 0 partial, 1 out. Params: 2 nh, 3 total_chunks (<= 128).
#ifdef KERNEL_inkling2_dspark_attn_combine
shared float dcb_m[128];
shared float dcb_w[128];
shared float dcb_red_m[4];
shared float dcb_red_l[4];

void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint nh = arg_u32(2);
    const uint chunks = arg_u32(3);
    const uint64_t P = arg(0) + 4u * ((uint64_t(r) * uint64_t(nh) + uint64_t(h)) * uint64_t(chunks) * 130u);

    float mx = -1.0 / 0.0;
    if (tid < chunks) {
        const float m = F32(P).v[tid * 130u];
        dcb_m[tid] = m;
        mx = m;
    }
    mx = subgroupMax(mx);
    if (gl_SubgroupInvocationID == 0u) dcb_red_m[gl_SubgroupID] = mx;
    barrier();
    const float M = max(max(dcb_red_m[0], dcb_red_m[1]), max(dcb_red_m[2], dcb_red_m[3]));

    float l_part = 0.0;
    if (tid < chunks) {
        const float m = dcb_m[tid];
        const float w = m == -1.0 / 0.0 ? 0.0 : exp(m - M);
        dcb_w[tid] = w;
        if (w != 0.0) l_part = F32(P).v[tid * 130u + 1u] * w;
    }
    l_part = subgroupAdd(l_part);
    if (gl_SubgroupInvocationID == 0u) dcb_red_l[gl_SubgroupID] = l_part;
    barrier();
    const float L = dcb_red_l[0] + dcb_red_l[1] + dcb_red_l[2] + dcb_red_l[3];

    float a = 0.0;
    for (uint c = 0u; c < chunks; c++) {
        const float w = dcb_w[c];
        if (w != 0.0) a += F32(P).v[c * 130u + 2u + tid] * w;
    }
    const uint64_t out_off = (uint64_t(r) * uint64_t(nh) + uint64_t(h)) * 128u * 4u;
    F32(arg(1) + out_off).v[tid] = a / L;
}
#endif

// ---------------------------------------------------------------------------
// 30. Parallel-across-rows prefill short_conv, history update, and kv_prep.
//     Eliminates sequential `for (r = 0..rows)` loops during prompt prefill!
//     History is read-only during prefill and updated after the barrier by
//     `inkling2_sconv_hist_update` (requires `rows >= n_conv - 1`).
// ---------------------------------------------------------------------------

// Grid: (ceil(C / 256), rows, 1), 256 threads.
// Buffers: 0 x, 1 weight, 2 dyn, 3 history (RO), 4 y, 5 res.
// Params: 6 rows, 7 C, 8 n_conv, 9 n_heads, 10 has_res.
#ifdef KERNEL_inkling2_sconv_prefill
void main() {
    const uint c = gl_GlobalInvocationID.x;
    const uint r = gl_WorkGroupID.y;
    const uint C = arg_u32(7);
    if (c >= C) return;
    const uint n_conv = arg_u32(8);
    const uint n_heads = arg_u32(9);
    const uint has_res = arg_u32(10);
    const uint hist_len = n_conv - 1u;

    const uint64_t x_buf = arg(0);
    const uint64_t w_buf = arg(1) + uint64_t(c) * uint64_t(n_conv) * 4u;
    const uint64_t d_buf = arg(2);
    const uint64_t h_buf = arg(3);

    float ring[8];
    for (uint k = 0u; k < n_conv; k++) {
        const int src_r = int(r) + int(k) - int(hist_len);
        if (src_r < 0) {
            ring[k] = F32(h_buf).v[(k + r) * C + c];
        } else {
            ring[k] = F32(x_buf).v[uint(src_r) * C + c];
        }
    }
    const float xr = ring[hist_len];
    float acc = 0.0;
    for (uint k = 0u; k < n_conv; k++) {
        acc += ring[k] * F32(w_buf).v[k];
    }
    if (n_heads > 0u) {
        const uint head = c / (C / n_heads);
        const uint64_t d_off = (uint64_t(r) * uint64_t(n_heads) + uint64_t(head)) * uint64_t(n_conv) * 4u;
        for (uint lag = 0u; lag < n_conv; lag++) {
            acc += ring[n_conv - 1u - lag] * F32(d_buf + d_off).v[lag];
        }
    }
    const float scale = inversesqrt(float(((n_heads > 0u ? 2u : 1u) * n_conv) + 1u));
    float out_v = (xr + acc) * scale;
    if (has_res != 0u) out_v += F32(arg(5)).v[r * C + c];
    F32(arg(4)).v[r * C + c] = out_v;
}
#endif

// Grid: (ceil(C / 256), 1, 1), 256 threads.
// Buffers: 0 x, 1 history. Params: 2 rows (>= hist_len), 3 C, 4 hist_len.
#ifdef KERNEL_inkling2_sconv_hist_update
void main() {
    const uint c = gl_GlobalInvocationID.x;
    const uint C = arg_u32(3);
    if (c >= C) return;
    const uint rows = arg_u32(2);
    const uint hist_len = arg_u32(4);
    const uint64_t x_buf = arg(0);
    const uint64_t h_buf = arg(1);
    const uint base_r = rows - hist_len;
    for (uint k = 0u; k < hist_len; k++) {
        F32(h_buf).v[k * C + c] = F32(x_buf).v[(base_r + k) * C + c];
    }
}
#endif

// Grid: (n_head_kv, 2, rows), 32 threads (1 subgroup = 32 lanes x vec4 = 128 head dims).
// Zero barriers, zero shared memory; matches inkling2_kv_prep bit-for-bit.
// Buffers: 0 k_raw, 1 v_raw, 2 k_conv_w, 3 v_conv_w, 4 k_dyn, 5 v_dyn,
//          6 k_hist (RO), 7 v_hist (RO), 8 k_cache, 9 v_cache.
// Params: 10 rows, 11 n_head_kv, 12 n_conv, 13 is_swa, 14 pos0, 15 slots,
//         16 qk_clip, 17 rms_eps.
#ifdef KERNEL_inkling2_kv_prep_prefill
void main() {
    const uint kh = gl_WorkGroupID.x;
    const uint is_v = gl_WorkGroupID.y;
    const uint r = gl_WorkGroupID.z;
    const uint lane = gl_SubgroupInvocationID; // 0..31 -> 4 channels/lane = 128 head dims
    const uint nkv = arg_u32(11);
    const uint n_conv = arg_u32(12);
    const uint is_swa = arg_u32(13);
    const uint pos0 = arg_u32(14);
    const uint slots = arg_u32(15);
    const float qk_clip = arg_f32(16);
    const float rms_eps = arg_f32(17);
    const uint hist_len = n_conv - 1u;
    const uint C = nkv * 128u;
    const uint c0 = kh * 128u + lane * 4u;

    const uint64_t x_buf = is_v == 0u ? arg(0) : arg(1);
    const uint64_t w_base = is_v == 0u ? arg(2) : arg(3);
    const uint64_t d_buf = is_v == 0u ? arg(4) : arg(5);
    const uint64_t h_base = is_v == 0u ? arg(6) : arg(7);
    const uint64_t c_buf = is_v == 0u ? arg(8) : arg(9);

    const uint has_dyn = is_swa == 0u ? 1u : 0u;
    const float scale = inversesqrt(float(((has_dyn != 0u ? 2u : 1u) * n_conv) + 1u));
    vec4 val;
    if (n_conv == 4u) {
        const vec4 r0 = r < 3u
            ? F32x4(h_base + uint64_t(r * C + c0) * 4u).v[0]
            : F32x4(x_buf + uint64_t((r - 3u) * C + c0) * 4u).v[0];
        const vec4 r1 = r < 2u
            ? F32x4(h_base + uint64_t((1u + r) * C + c0) * 4u).v[0]
            : F32x4(x_buf + uint64_t((r - 2u) * C + c0) * 4u).v[0];
        const vec4 r2 = r < 1u
            ? F32x4(h_base + uint64_t(2u * C + c0) * 4u).v[0]
            : F32x4(x_buf + uint64_t((r - 1u) * C + c0) * 4u).v[0];
        const vec4 xr = F32x4(x_buf + uint64_t(r * C + c0) * 4u).v[0];

        const vec4 wa = F32x4(w_base + uint64_t(c0) * 16u).v[0];
        const vec4 wb = F32x4(w_base + uint64_t(c0 + 1u) * 16u).v[0];
        const vec4 wc = F32x4(w_base + uint64_t(c0 + 2u) * 16u).v[0];
        const vec4 wd = F32x4(w_base + uint64_t(c0 + 3u) * 16u).v[0];
        const vec4 w0 = vec4(wa.x, wb.x, wc.x, wd.x);
        const vec4 w1 = vec4(wa.y, wb.y, wc.y, wd.y);
        const vec4 w2 = vec4(wa.z, wb.z, wc.z, wd.z);
        const vec4 w3 = vec4(wa.w, wb.w, wc.w, wd.w);

        vec4 acc = r0 * w0 + r1 * w1 + r2 * w2 + xr * w3;
        if (has_dyn != 0u) {
            const uint64_t d_off = (uint64_t(r) * uint64_t(nkv) + uint64_t(kh)) * 16u;
            const vec4 dv = F32x4(d_buf + d_off).v[0];
            acc += xr * dv.x + r2 * dv.y + r1 * dv.z + r0 * dv.w;
        }
        val = (xr + acc) * scale;
    } else {
        vec4 ring[8];
        for (uint k = 0u; k < n_conv; k++) {
            const int src_r = int(r) + int(k) - int(hist_len);
            if (src_r < 0) {
                ring[k] = F32x4(h_base + uint64_t((k + r) * C + c0) * 4u).v[0];
            } else {
                ring[k] = F32x4(x_buf + uint64_t(uint(src_r) * C + c0) * 4u).v[0];
            }
        }
        const vec4 xr = ring[hist_len];
        vec4 acc = vec4(0.0);
        for (uint k = 0u; k < n_conv; k++) {
            const vec4 wk = vec4(
                F32(w_base + uint64_t(c0) * uint64_t(n_conv) * 4u).v[k],
                F32(w_base + uint64_t(c0 + 1u) * uint64_t(n_conv) * 4u).v[k],
                F32(w_base + uint64_t(c0 + 2u) * uint64_t(n_conv) * 4u).v[k],
                F32(w_base + uint64_t(c0 + 3u) * uint64_t(n_conv) * 4u).v[k]
            );
            acc += ring[k] * wk;
        }
        if (has_dyn != 0u) {
            const uint64_t d_off = (uint64_t(r) * uint64_t(nkv) + uint64_t(kh)) * uint64_t(n_conv) * 4u;
            for (uint lag = 0u; lag < n_conv; lag++) {
                acc += ring[n_conv - 1u - lag] * F32(d_buf + d_off).v[lag];
            }
        }
        val = (xr + acc) * scale;
    }

    const float tot = subgroupAdd(dot(val, val));
    const float factor = is_v == 0u
        ? clamp(qk_clip / (sqrt(tot) + 1e-6), 0.0, 1.0)
        : inversesqrt(tot / 128.0 + rms_eps);
    val *= factor;

    const uint pos = pos0 + r;
    const uint slot = is_swa != 0u ? (pos % slots) : pos;
    U32x2(c_buf + (uint64_t(slot) * uint64_t(C) + uint64_t(c0)) * 2u).v[0] =
        uvec2(packHalf2x16(val.xy), packHalf2x16(val.zw));
}
#endif

// ---------------------------------------------------------------------------
// 32. Fused MoE router + expert bucketing (`rows <= 8`, `E <= 256`, `K <= 16`).
// Eliminates 48 dispatches and 48 barriers per verify pass!
// Grid: (1, 1, 1), 256 threads (8 subgroups).
// Buffers: 0 logits, 1 bias, 2 out_ids, 3 out_w, 4 sorted_rk, 5 tiles, 6 n_tiles.
// Params: 7 rows, 8 E, 9 K, 10 has_bias, 11 route_scale.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_router_bucket
shared uint rb_counts[256];
shared uint rb_offsets[256];
shared uint rb_cursor[256];
shared uint rb_tile_offs[256];
shared uint rb_sg_c[8];
shared uint rb_sg_t[8];

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint rows = arg_u32(7);
    const uint E = arg_u32(8);
    const uint K = arg_u32(9);
    const uint has_bias = arg_u32(10);
    const float route_scale = arg_f32(11);

    if (tid < E) rb_counts[tid] = 0u;
    barrier();

    uint my_e = 0u;
    if (sg < rows) {
        const uint64_t lrow = arg(0) + uint64_t(sg) * uint64_t(E) * 4u;
        const uint64_t bias = arg(1);
        float my_w = 0.0;
        float wsum = 0.0;
        if (E <= 128u) {
            float p[4];
            float s[4];
            [[unroll]] for (uint j = 0u; j < 4u; j++) {
                const uint e = lane + 32u * j;
                if (e < E) {
                    const float pr = 1.0 / (1.0 + exp(-F32(lrow).v[e]));
                    p[j] = pr;
                    s[j] = pr + (has_bias != 0u ? F32(bias).v[e] : 0.0);
                } else {
                    p[j] = 0.0;
                    s[j] = -1e30;
                }
            }
            for (uint k = 0u; k < K; k++) {
                float best_s = -1e30;
                uint best_e = 0xffffffffu;
                [[unroll]] for (uint j = 0u; j < 4u; j++) {
                    if (s[j] > best_s) {
                        best_s = s[j];
                        best_e = lane + 32u * j;
                    }
                }
                const float top = subgroupMax(best_s);
                const uint e = subgroupMin(best_s == top ? best_e : 0xffffffffu);
                float ep = 0.0;
                [[unroll]] for (uint j = 0u; j < 4u; j++) {
                    if (lane + 32u * j == e) {
                        ep = p[j];
                        s[j] = -1e30;
                    }
                }
                const float prob_e = subgroupAdd(ep);
                wsum += prob_e;
                if (lane == k) {
                    my_e = e;
                    my_w = prob_e;
                }
            }
        } else {
            float p[8];
            float s[8];
            [[unroll]] for (uint j = 0u; j < 8u; j++) {
                const uint e = lane + 32u * j;
                if (e < E) {
                    const float pr = 1.0 / (1.0 + exp(-F32(lrow).v[e]));
                    p[j] = pr;
                    s[j] = pr + (has_bias != 0u ? F32(bias).v[e] : 0.0);
                } else {
                    p[j] = 0.0;
                    s[j] = -1e30;
                }
            }
            for (uint k = 0u; k < K; k++) {
                float best_s = -1e30;
                uint best_e = 0xffffffffu;
                [[unroll]] for (uint j = 0u; j < 8u; j++) {
                    if (s[j] > best_s) {
                        best_s = s[j];
                        best_e = lane + 32u * j;
                    }
                }
                const float top = subgroupMax(best_s);
                const uint e = subgroupMin(best_s == top ? best_e : 0xffffffffu);
                float ep = 0.0;
                [[unroll]] for (uint j = 0u; j < 8u; j++) {
                    if (lane + 32u * j == e) {
                        ep = p[j];
                        s[j] = -1e30;
                    }
                }
                const float prob_e = subgroupAdd(ep);
                wsum += prob_e;
                if (lane == k) {
                    my_e = e;
                    my_w = prob_e;
                }
            }
        }
        if (lane < K) {
            const float inv = route_scale / max(wsum, 1e-20);
            U32(arg(2)).v[sg * K + lane] = my_e;
            F32(arg(3)).v[sg * K + lane] = my_w * inv;
            atomicAdd(rb_counts[my_e], 1u);
        }
    }
    barrier();

    // Parallel 256-lane prefix sum over counts and tile counts (replaces 128-iter serial tid==0 loop).
    const uint c_e = tid < E ? rb_counts[tid] : 0u;
    const uint t_e = (c_e + 7u) >> 3u;
    const uint ex_c = subgroupExclusiveAdd(c_e);
    const uint ex_t = subgroupExclusiveAdd(t_e);
    if (lane == 31u) {
        rb_sg_c[sg] = ex_c + c_e;
        rb_sg_t[sg] = ex_t + t_e;
    }
    barrier();
    uint base_c = 0u, base_t = 0u, tot_t = 0u;
    [[unroll]] for (uint g = 0u; g < 8u; g++) {
        const uint sc = rb_sg_c[g];
        const uint st = rb_sg_t[g];
        base_c += g < sg ? sc : 0u;
        base_t += g < sg ? st : 0u;
        tot_t += st;
    }
    if (tid < E) {
        const uint off = base_c + ex_c;
        const uint toff = base_t + ex_t;
        rb_offsets[tid] = off;
        rb_cursor[tid] = off;
        rb_tile_offs[tid] = toff;
    }
    if (tid == 0u) {
        U32(arg(6)).v[0] = tot_t;
        const uint gx_gu = arg_u32(12);
        const uint gx_down = arg_u32(13);
        if (gx_gu != 0u) {
            U32(arg(6)).v[4] = gx_gu;
            U32(arg(6)).v[5] = tot_t;
            U32(arg(6)).v[6] = 1u;
            U32(arg(6)).v[8] = gx_down;
            U32(arg(6)).v[9] = tot_t;
            U32(arg(6)).v[10] = 1u;
        }
    }
    barrier();

    if (sg < rows && lane < K) {
        const uint pos = atomicAdd(rb_cursor[my_e], 1u);
        U32(arg(4)).v[pos] = sg * K + lane;
    }
    if (tid < E) {
        const uint c = rb_counts[tid];
        const uint base = rb_offsets[tid];
        const uint tbase = rb_tile_offs[tid];
        for (uint off = 0u; off < c; off += 8u) {
            const uint cnt = min(8u, c - off);
            U32x4(arg(5)).v[tbase + (off >> 3u)] = uvec4(tid, base + off, cnt, 0u);
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// 33. Parallel multi-row greedy argmax + GPU speculative acceptance + GPU
//     short-conv rollback (enables single-CB verify + DSpark inject + propose!).
// ---------------------------------------------------------------------------

// Grid: (64, rows, 1), 256 threads (8 subgroups).
// Buffers: 0 logits [rows, vocab], 1 part_val [rows, 64], 2 part_idx [rows, 64].
// Params: 3 vocab.
#ifdef KERNEL_inkling2_argmax_rows_partial
shared float arp_v[8];
shared uint arp_i[8];

void main() {
    const uint g = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint vocab = arg_u32(3);
    const uint64_t row = arg(0) + uint64_t(r) * uint64_t(vocab) * 4u;

    float bv = -1.0 / 0.0;
    uint bi = 0xffffffffu;
    for (uint i = g * 256u + tid; i < vocab; i += 64u * 256u) {
        const float v = F32(row).v[i];
        if (v > bv || (v == bv && i < bi)) {
            bv = v;
            bi = i;
        }
    }
    const float sv = subgroupMax(bv);
    const uint si = subgroupMin(bv == sv ? bi : 0xffffffffu);
    if (lane == 0u) {
        arp_v[sg] = sv;
        arp_i[sg] = si;
    }
    barrier();
    if (sg == 0u) {
        const float lv = lane < 8u ? arp_v[lane] : (-1.0 / 0.0);
        const uint li = lane < 8u ? arp_i[lane] : 0xffffffffu;
        const float mv = subgroupMax(lv);
        const uint mi = subgroupMin(lv == mv ? li : 0xffffffffu);
        if (lane == 0u) {
            F32(arg(1)).v[r * 64u + g] = mv;
            U32(arg(2)).v[r * 64u + g] = mi;
        }
    }
}
#endif

// Grid: (1, rows, 1), 64 threads (2 subgroups).
// Buffers: 0 part_val [rows, 64], 1 part_idx [rows, 64], 2 out [rows].
#ifdef KERNEL_inkling2_argmax_rows_final
shared float arf_v[2];
shared uint arf_i[2];

void main() {
    const uint r = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const float bv = F32(arg(0)).v[r * 64u + tid];
    const uint bi = U32(arg(1)).v[r * 64u + tid];
    const float sv = subgroupMax(bv);
    const uint si = subgroupMin(bv == sv ? bi : 0xffffffffu);
    if (lane == 0u) {
        arf_v[sg] = sv;
        arf_i[sg] = si;
    }
    barrier();
    if (tid == 0u) {
        const bool pick1 = arf_v[1] > arf_v[0] || (arf_v[1] == arf_v[0] && arf_i[1] < arf_i[0]);
        U32(arg(2)).v[r] = pick1 ? arf_i[1] : arf_i[0];
    }
}
#endif

// Computes speculative acceptance on GPU, stages anchor into ds.best_toks[0],
// and zeroes ds.rnn_state[0..rank].
// spec_meta[0..6] = [accepted, kept, anchor, new_pos, kept - 1, swa_ctx_start].
// Grid: (1, 1, 1), 256 threads.
// Buffers: 0 staged_ids, 1 draws_gpu, 2 spec_meta, 3 ds_best_toks, 4 ds_rnn_state.
// Params: 5 rows, 6 pos_before, 7 rank, 8 ds_window.
#ifdef KERNEL_inkling2_spec_accept
void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint rows = arg_u32(5);
    const uint pos_before = arg_u32(6);
    const uint rank = arg_u32(7);
    const uint ds_window = arg_u32(8);

    for (uint i = tid; i < rank; i += 256u) {
        F32(arg(4)).v[i] = 0.0;
    }
    if (tid == 0u) {
        uint accepted = 0u;
        for (uint i = 0u; i + 1u < rows; i++) {
            if (U32(arg(1)).v[i] == U32(arg(0)).v[i + 1u]) {
                accepted = i + 1u;
            } else {
                break;
            }
        }
        const uint kept = accepted + 1u;
        const uint anchor = U32(arg(1)).v[accepted];
        const uint new_pos = pos_before + kept;
        const uint swa_start = new_pos > ds_window ? (new_pos - ds_window) : 0u;
        U32(arg(2)).v[0] = accepted;
        U32(arg(2)).v[1] = kept;
        U32(arg(2)).v[2] = anchor;
        U32(arg(2)).v[3] = new_pos;
        U32(arg(2)).v[4] = accepted; // kept - 1 == accepted
        U32(arg(2)).v[5] = swa_start;
        U32(arg(3)).v[0] = anchor;
    }
}
#endif

// Parallel GPU short-conv history rollback across all 192 (48 slots x 4) tensors.
// Each trace buffer holds `[rows + hist_len - 1, C]` and each history holds `[hist_len, C]`,
// so restoring after `kept` rows copies `hist_len * C` contiguous floats starting at
// `trace_base + (kept - 1) * C * 4`.
// Grid: (ceil(max_floats / 256), n_entries, 1), 256 threads.
// Buffers: 0 spec_meta, 1 rb_table (u64 [n_entries * 3]: trace_base, hist_dst, C).
// Params: 2 rows, 3 hist_len.
#ifdef KERNEL_inkling2_sconv_rollback
void main() {
    const uint kept = U32(arg(0)).v[1];
    const uint rows = arg_u32(2);
    if (kept >= rows) return;
    const uint hist_len = arg_u32(3);
    const uint entry = gl_WorkGroupID.y;
    const uint idx = gl_WorkGroupID.x * 256u + gl_LocalInvocationIndex;
    const uint64_t trace_base = U64(arg(1)).v[3u * entry];
    const uint64_t hist_dst = U64(arg(1)).v[3u * entry + 1u];
    const uint C = uint(U64(arg(1)).v[3u * entry + 2u]);
    const uint n = C * hist_len;
    if (idx >= n) return;
    const uint64_t src = trace_base + uint64_t(kept - 1u) * uint64_t(C) * 4u;
    F32(hist_dst).v[idx] = F32(src).v[idx];
}
#endif

// ---------------------------------------------------------------------------
// 34. Fused DSpark Markov head (BF16) + Q4_0 draft LM head with fused
//     partial argmax. Cuts 9 dispatches/7 barriers per draft slot down to 4/3!
// ---------------------------------------------------------------------------

// Fused embed(markov_w1[prev_tok]) + concat + joint_proj(BF16) + GRU update.
// Grid: (ceil(rank / 4), 1, 1), 128 threads (4 subgroups = 4 output dims/WG).
// Buffers: 0 prev_tok (u32[1]), 1 rnn_in (f32[rank]), 2 markov_w1 (bf16[vocab, rank]),
//          3 h_slot (f32[H]), 4 f_rnn_last (f32[H]), 5 joint_proj (bf16[3*rank, 2*rank+2*H]),
//          6 joint_proj_b (f32[3*rank]), 7 rnn_out (f32[rank]), 8 latent (f32[rank]).
// Params: 9 rank (multiple of 8), 10 H (multiple of 8), 11 w1_rows.
#ifdef KERNEL_inkling2_dspark_markov_gru_bf16
void main() {
    const uint j = gl_WorkGroupID.x * 4u + gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint rank = arg_u32(9);
    if (j >= rank) return;
    const uint H = arg_u32(10);
    const uint w1_rows = arg_u32(11);
    const uint k_tot = 2u * rank + 2u * H;
    const uint64_t row_b = uint64_t(k_tot) * 2u;
    const uint64_t w0_base = arg(5) + uint64_t(j) * row_b;
    const uint64_t w1_base = arg(5) + uint64_t(rank + j) * row_b;
    const uint64_t w2_base = arg(5) + uint64_t(2u * rank + j) * row_b;

    const uint tok = min(U32(arg(0)).v[0], w1_rows - 1u);
    const uint64_t mk_row = arg(2) + uint64_t(tok) * uint64_t(rank) * 2u;

    float a0 = 0.0, a1 = 0.0, a2 = 0.0;
    const uint r8 = rank >> 3u;
    const uint h8 = H >> 3u;

    // Segment 0: rnn_in [0..rank]
    {
        const uint64_t x0p = arg(1);
        for (uint i = lane; i < r8; i += 32u) {
            const vec4 xv0 = F32x4(x0p).v[2u * i];
            const vec4 xv1 = F32x4(x0p).v[2u * i + 1u];
            const uvec4 u0 = U32x4(w0_base).v[i];
            const uvec4 u1 = U32x4(w1_base).v[i];
            const uvec4 u2 = U32x4(w2_base).v[i];
            a0 += dot(vec4(uintBitsToFloat(u0.x << 16u), uintBitsToFloat(u0.x & 0xffff0000u),
                           uintBitsToFloat(u0.y << 16u), uintBitsToFloat(u0.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u0.z << 16u), uintBitsToFloat(u0.z & 0xffff0000u),
                           uintBitsToFloat(u0.w << 16u), uintBitsToFloat(u0.w & 0xffff0000u)), xv1);
            a1 += dot(vec4(uintBitsToFloat(u1.x << 16u), uintBitsToFloat(u1.x & 0xffff0000u),
                           uintBitsToFloat(u1.y << 16u), uintBitsToFloat(u1.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u1.z << 16u), uintBitsToFloat(u1.z & 0xffff0000u),
                           uintBitsToFloat(u1.w << 16u), uintBitsToFloat(u1.w & 0xffff0000u)), xv1);
            a2 += dot(vec4(uintBitsToFloat(u2.x << 16u), uintBitsToFloat(u2.x & 0xffff0000u),
                           uintBitsToFloat(u2.y << 16u), uintBitsToFloat(u2.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u2.z << 16u), uintBitsToFloat(u2.z & 0xffff0000u),
                           uintBitsToFloat(u2.w << 16u), uintBitsToFloat(u2.w & 0xffff0000u)), xv1);
        }
    }
    // Segment 1: markov_w1[tok] [rank..2*rank]
    {
        const uint64_t off_b = uint64_t(rank) * 2u;
        for (uint i = lane; i < r8; i += 32u) {
            const uvec4 xm = U32x4(mk_row).v[i];
            const vec4 xv0 = vec4(
                uintBitsToFloat(xm.x << 16u), uintBitsToFloat(xm.x & 0xffff0000u),
                uintBitsToFloat(xm.y << 16u), uintBitsToFloat(xm.y & 0xffff0000u)
            );
            const vec4 xv1 = vec4(
                uintBitsToFloat(xm.z << 16u), uintBitsToFloat(xm.z & 0xffff0000u),
                uintBitsToFloat(xm.w << 16u), uintBitsToFloat(xm.w & 0xffff0000u)
            );
            const uvec4 u0 = U32x4(w0_base + off_b).v[i];
            const uvec4 u1 = U32x4(w1_base + off_b).v[i];
            const uvec4 u2 = U32x4(w2_base + off_b).v[i];
            a0 += dot(vec4(uintBitsToFloat(u0.x << 16u), uintBitsToFloat(u0.x & 0xffff0000u),
                           uintBitsToFloat(u0.y << 16u), uintBitsToFloat(u0.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u0.z << 16u), uintBitsToFloat(u0.z & 0xffff0000u),
                           uintBitsToFloat(u0.w << 16u), uintBitsToFloat(u0.w & 0xffff0000u)), xv1);
            a1 += dot(vec4(uintBitsToFloat(u1.x << 16u), uintBitsToFloat(u1.x & 0xffff0000u),
                           uintBitsToFloat(u1.y << 16u), uintBitsToFloat(u1.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u1.z << 16u), uintBitsToFloat(u1.z & 0xffff0000u),
                           uintBitsToFloat(u1.w << 16u), uintBitsToFloat(u1.w & 0xffff0000u)), xv1);
            a2 += dot(vec4(uintBitsToFloat(u2.x << 16u), uintBitsToFloat(u2.x & 0xffff0000u),
                           uintBitsToFloat(u2.y << 16u), uintBitsToFloat(u2.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u2.z << 16u), uintBitsToFloat(u2.z & 0xffff0000u),
                           uintBitsToFloat(u2.w << 16u), uintBitsToFloat(u2.w & 0xffff0000u)), xv1);
        }
    }
    // Segment 2: h_slot [2*rank..2*rank+H]
    {
        const uint64_t off_b = uint64_t(2u * rank) * 2u;
        const uint64_t xp = arg(3);
        for (uint i = lane; i < h8; i += 32u) {
            const vec4 xv0 = F32x4(xp).v[2u * i];
            const vec4 xv1 = F32x4(xp).v[2u * i + 1u];
            const uvec4 u0 = U32x4(w0_base + off_b).v[i];
            const uvec4 u1 = U32x4(w1_base + off_b).v[i];
            const uvec4 u2 = U32x4(w2_base + off_b).v[i];
            a0 += dot(vec4(uintBitsToFloat(u0.x << 16u), uintBitsToFloat(u0.x & 0xffff0000u),
                           uintBitsToFloat(u0.y << 16u), uintBitsToFloat(u0.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u0.z << 16u), uintBitsToFloat(u0.z & 0xffff0000u),
                           uintBitsToFloat(u0.w << 16u), uintBitsToFloat(u0.w & 0xffff0000u)), xv1);
            a1 += dot(vec4(uintBitsToFloat(u1.x << 16u), uintBitsToFloat(u1.x & 0xffff0000u),
                           uintBitsToFloat(u1.y << 16u), uintBitsToFloat(u1.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u1.z << 16u), uintBitsToFloat(u1.z & 0xffff0000u),
                           uintBitsToFloat(u1.w << 16u), uintBitsToFloat(u1.w & 0xffff0000u)), xv1);
            a2 += dot(vec4(uintBitsToFloat(u2.x << 16u), uintBitsToFloat(u2.x & 0xffff0000u),
                           uintBitsToFloat(u2.y << 16u), uintBitsToFloat(u2.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u2.z << 16u), uintBitsToFloat(u2.z & 0xffff0000u),
                           uintBitsToFloat(u2.w << 16u), uintBitsToFloat(u2.w & 0xffff0000u)), xv1);
        }
    }
    // Segment 3: f_rnn_last [2*rank+H..2*rank+2*H]
    {
        const uint64_t off_b = uint64_t(2u * rank + H) * 2u;
        const uint64_t xp = arg(4);
        for (uint i = lane; i < h8; i += 32u) {
            const vec4 xv0 = F32x4(xp).v[2u * i];
            const vec4 xv1 = F32x4(xp).v[2u * i + 1u];
            const uvec4 u0 = U32x4(w0_base + off_b).v[i];
            const uvec4 u1 = U32x4(w1_base + off_b).v[i];
            const uvec4 u2 = U32x4(w2_base + off_b).v[i];
            a0 += dot(vec4(uintBitsToFloat(u0.x << 16u), uintBitsToFloat(u0.x & 0xffff0000u),
                           uintBitsToFloat(u0.y << 16u), uintBitsToFloat(u0.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u0.z << 16u), uintBitsToFloat(u0.z & 0xffff0000u),
                           uintBitsToFloat(u0.w << 16u), uintBitsToFloat(u0.w & 0xffff0000u)), xv1);
            a1 += dot(vec4(uintBitsToFloat(u1.x << 16u), uintBitsToFloat(u1.x & 0xffff0000u),
                           uintBitsToFloat(u1.y << 16u), uintBitsToFloat(u1.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u1.z << 16u), uintBitsToFloat(u1.z & 0xffff0000u),
                           uintBitsToFloat(u1.w << 16u), uintBitsToFloat(u1.w & 0xffff0000u)), xv1);
            a2 += dot(vec4(uintBitsToFloat(u2.x << 16u), uintBitsToFloat(u2.x & 0xffff0000u),
                           uintBitsToFloat(u2.y << 16u), uintBitsToFloat(u2.y & 0xffff0000u)), xv0)
                + dot(vec4(uintBitsToFloat(u2.z << 16u), uintBitsToFloat(u2.z & 0xffff0000u),
                           uintBitsToFloat(u2.w << 16u), uintBitsToFloat(u2.w & 0xffff0000u)), xv1);
        }
    }

    a0 = subgroupAdd(a0);
    a1 = subgroupAdd(a1);
    a2 = subgroupAdd(a2);
    if (lane == 0u) {
        const float j0 = a0 + F32(arg(6)).v[j];
        const float j1 = a1 + F32(arg(6)).v[rank + j];
        const float j2 = a2 + F32(arg(6)).v[2u * rank + j];
        const float g = 1.0 / (1.0 + exp(-j0));
        const float s = F32(arg(1)).v[j];
        F32(arg(7)).v[j] = g * s + (1.0 - g) * tanh(j1);
        F32(arg(8)).v[j] = tanh(j2);
    }
}
#endif

// Fused hidden_out(BF16 [H, rank]) * latent + h_slot + hidden_out_b -> combined[H].
// Grid: (ceil(H / 32), 1, 1), 256 threads (8 subgroups x 4 rows/sg = 32 rows/WG).
// Buffers: 0 latent, 1 hidden_out (BF16), 2 h_slot, 3 hidden_out_b, 4 combined.
// Params: 5 H, 6 rank (<= 512, multiple of 8).
#ifdef KERNEL_inkling2_dspark_hidden_out_add_bf16
shared vec4 dhoa_lat[128];

void main() {
    const uint H = arg_u32(5);
    const uint rank = arg_u32(6);
    const uint r4 = rank >> 2u;
    if (gl_LocalInvocationIndex < r4) {
        dhoa_lat[gl_LocalInvocationIndex] = F32x4(arg(0)).v[gl_LocalInvocationIndex];
    }
    barrier();

    const uint row_in_sg = gl_SubgroupInvocationID >> 3u;
    const uint lane_t = gl_SubgroupInvocationID & 7u;
    const uint n = gl_WorkGroupID.x * 32u + gl_SubgroupID * 4u + row_in_sg;
    if (n >= H) return;

    const uint64_t wr = arg(1) + uint64_t(n) * uint64_t(rank) * 2u;
    const uint r8 = rank >> 3u;
    float acc = 0.0;
    for (uint i = lane_t; i < r8; i += 8u) {
        const uvec4 u = U32x4(wr).v[i];
        const vec4 w0 = vec4(
            uintBitsToFloat(u.x << 16u), uintBitsToFloat(u.x & 0xffff0000u),
            uintBitsToFloat(u.y << 16u), uintBitsToFloat(u.y & 0xffff0000u)
        );
        const vec4 w1 = vec4(
            uintBitsToFloat(u.z << 16u), uintBitsToFloat(u.z & 0xffff0000u),
            uintBitsToFloat(u.w << 16u), uintBitsToFloat(u.w & 0xffff0000u)
        );
        acc += dot(w0, dhoa_lat[2u * i]) + dot(w1, dhoa_lat[2u * i + 1u]);
    }
    acc += subgroupShuffleXor(acc, 4u);
    acc += subgroupShuffleXor(acc, 2u);
    acc += subgroupShuffleXor(acc, 1u);
    if (lane_t == 0u) {
        F32(arg(4)).v[n] = acc + F32(arg(2)).v[n] + F32(arg(3)).v[n];
    }
}
#endif

// Fused Q4_0 draft LM head GEMV (8 lanes/row, 4 rows/sg = 32 rows/WG):
// For K = 2304 (72 Q4_0 blocks), 72 / 8 = 9.000 exact waves (100% SIMD util,
// eliminating the 24-idle-lane tail of 32-lane reduction!), 8 x 18B = 144B
// coalesced cache-line bursts, zero xv[8] register array (~40 GPRs -> 1024 threads/core!)
// + 32-to-1 WG partial argmax -> writes 16x less DRAM than logits and drops sample_f32!
// Grid: (ceil(vocab / 32), 1, 1), 256 threads.
// Buffers: 0 x (f32[K]), 1 W (Q4_0 [vocab, row_bytes]), 2 part_val, 3 part_idx.
// Params: 4 vocab, 5 K (multiple of 32), 6 row_bytes.
#ifdef KERNEL_inkling2_draft_head_q4_0_argmax
layout(buffer_reference, scalar, buffer_reference_align = 2) readonly buffer I2Q4Pairs { u16vec4 v[]; };
shared float dhq4_bv[8];
shared uint dhq4_bi[8];

float dhq4_dot_l8(uint64_t b, uint64_t xt) {
    const float d = unpackHalf2x16(uint(U16(b).v[0])).x;
    const u16vec4 p0 = I2Q4Pairs(b + 2u).v[0];
    const u16vec4 p1 = I2Q4Pairs(b + 2u).v[1];
    float s = 0.0;
#define DHQ4_Q(w0, w1, qoff)                                                                  \
    {                                                                                         \
        const vec4 lo = vec4(float(int((w0) & 15u) - 8), float(int(((w0) >> 8u) & 15u) - 8),  \
                             float(int((w1) & 15u) - 8), float(int(((w1) >> 8u) & 15u) - 8)); \
        const vec4 hi = vec4(float(int(((w0) >> 4u) & 15u) - 8), float(int((w0) >> 12u) - 8), \
                             float(int(((w1) >> 4u) & 15u) - 8), float(int((w1) >> 12u) - 8)); \
        s += dot(lo, F32x4(xt + (qoff)).v[0]) + dot(hi, F32x4(xt + (qoff) + 64u).v[0]);       \
    }
    DHQ4_Q(uint(p0.x), uint(p0.y), 0u)
    DHQ4_Q(uint(p0.z), uint(p0.w), 16u)
    DHQ4_Q(uint(p1.x), uint(p1.y), 32u)
    DHQ4_Q(uint(p1.z), uint(p1.w), 48u)
#undef DHQ4_Q
    return d * s;
}

void main() {
    const uint wg = gl_WorkGroupID.x;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint row_in_sg = lane >> 3u;
    const uint lane_t = lane & 7u;
    const uint vocab = arg_u32(4);
    const uint K = arg_u32(5);
    const uint row_bytes = arg_u32(6);
    const uint tasks = K >> 5u;
    const uint64_t X = arg(0);
    const uint64_t W = arg(1);

    const uint n = (wg * 8u + sg) * 4u + row_in_sg;
    float acc = 0.0;
    if (n < vocab) {
        const uint64_t r_ptr = W + uint64_t(n) * uint64_t(row_bytes);
        for (uint t = lane_t; t < tasks; t += 8u) {
            acc += dhq4_dot_l8(r_ptr + uint64_t(t) * 18u, X + uint64_t(t) * 128u);
        }
    }
    acc += subgroupShuffleXor(acc, 4u);
    acc += subgroupShuffleXor(acc, 2u);
    acc += subgroupShuffleXor(acc, 1u);

    const float my_v = (lane_t == 0u && n < vocab) ? acc : (-1.0 / 0.0);
    const uint my_i = (lane_t == 0u && n < vocab) ? n : 0xffffffffu;
    const float sv = subgroupMax(my_v);
    const uint si = subgroupMin(my_v == sv ? my_i : 0xffffffffu);
    if (lane == 0u) {
        dhq4_bv[sg] = sv;
        dhq4_bi[sg] = si;
    }
    barrier();
    if (sg == 0u) {
        const float lv = lane < 8u ? dhq4_bv[lane] : (-1.0 / 0.0);
        const uint li = lane < 8u ? dhq4_bi[lane] : 0xffffffffu;
        const float mv = subgroupMax(lv);
        const uint mi = subgroupMin(lv == mv ? li : 0xffffffffu);
        if (lane == 0u) {
            F32(arg(2)).v[wg] = mv;
            U32(arg(3)).v[wg] = mi;
        }
    }
}
#endif

// Fused Q2_K draft LM head GEMV (64 rows/WG, 8 rows/subgroup, 4 lanes/row):
// For K = 2304 (9 blocks of 256w = 84B), 4 lanes read ONE entire 84B block per iter
// (64B coalesced qs burst + 16B coalesced scales + 4-way broadcast dd) with 100.0%
// SIMD utilization (9.000 exact iters, ZERO idle lanes, 7 weight regs -> zero spills)!
// Grid: (ceil(vocab / 64), 1, 1), 256 threads. Requires K % 256 == 0.
// Buffers: 0 x (f32[K]), 1 W (Q2_K [vocab, row_bytes]), 2 part_val, 3 part_idx.
// Params: 4 vocab, 5 K, 6 row_bytes.
#ifdef KERNEL_inkling2_draft_head_q2_k_argmax
shared float dhq2_bv[8];
shared uint dhq2_bi[8];

float dhq2_sh_dot(uvec4 qv, uint shift, in vec4 xv[4], float sx, float d, float dmin, uint sc) {
    const uvec4 q = (qv >> shift) & uvec4(0x03030303u);
    float s = 0.0;
    [[unroll]] for (uint c = 0u; c < 4u; c++) {
        const uint w = q[c];
        s += dot(vec4(float(w & 3u), float((w >> 8u) & 3u),
                      float((w >> 16u) & 3u), float(w >> 24u)), xv[c]);
    }
    return d * float(sc & 0xfu) * s - dmin * float(sc >> 4u) * sx;
}

void main() {
    const uint wg = gl_WorkGroupID.x;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint vocab = arg_u32(4);
    const uint K = arg_u32(5);
    const uint row_bytes = arg_u32(6);
    const uint n_blks = K >> 8u;
    const uint64_t X = arg(0);
    const uint64_t W = arg(1);

    const uint row_in_sg = lane >> 2u;
    const uint qtr = lane & 3u;
    const uint half_q = qtr >> 1u;
    const uint h_idx = qtr & 1u;
    const uint n = (wg * 8u + sg) * 8u + row_in_sg;

    float acc = 0.0;
    if (n < vocab) {
        const uint64_t r_ptr = W + uint64_t(n) * uint64_t(row_bytes);
        const uint64_t q_off = 16u + uint64_t(half_q) * 32u + uint64_t(h_idx) * 16u;
        const uint64_t s_off = uint64_t(half_q) * 8u;
        for (uint blk = 0u; blk < n_blks; blk++) {
            const uint64_t bo = uint64_t(blk) * 84u;
            const uvec4 qr = U32x4(r_ptr + bo + q_off).v[0];
            const uvec2 sc = U32x2(r_ptr + bo + s_off).v[0];
            const vec2 df = unpackHalf2x16(U32(r_ptr + bo + 80u).v[0]);
            [[unroll]] for (uint sh = 0u; sh < 4u; sh++) {
                const uint g = 8u * half_q + 2u * sh + h_idx;
                const uint64_t xg = X + 4u * uint64_t(blk * 256u + g * 16u);
                vec4 xv[4];
                vec4 sv = vec4(0.0);
                [[unroll]] for (uint i = 0u; i < 4u; i++) {
                    xv[i] = F32x4(xg + 16u * i).v[0];
                    sv += xv[i];
                }
                const float sx = (sv.x + sv.y) + (sv.z + sv.w);
                const uint sb = (sc[sh >> 1u] >> (8u * (2u * (sh & 1u) + h_idx))) & 0xffu;
                acc += dhq2_sh_dot(qr, 2u * sh, xv, sx, df.x, df.y, sb);
            }
        }
    }
    acc += subgroupShuffleXor(acc, 2u);
    acc += subgroupShuffleXor(acc, 1u);

    const float my_v = (qtr == 0u && n < vocab) ? acc : (-1.0 / 0.0);
    const uint my_i = (qtr == 0u && n < vocab) ? n : 0xffffffffu;
    const float sv = subgroupMax(my_v);
    const uint si = subgroupMin(my_v == sv ? my_i : 0xffffffffu);
    if (lane == 0u) {
        dhq2_bv[sg] = sv;
        dhq2_bi[sg] = si;
    }
    barrier();
    if (sg == 0u) {
        const float lv = lane < 8u ? dhq2_bv[lane] : (-1.0 / 0.0);
        const uint li = lane < 8u ? dhq2_bi[lane] : 0xffffffffu;
        const float mv = subgroupMax(lv);
        const uint mi = subgroupMin(lv == mv ? li : 0xffffffffu);
        if (lane == 0u) {
            F32(arg(2)).v[wg] = mv;
            U32(arg(3)).v[wg] = mi;
        }
    }
}
#endif

// Final argmax reduction across arbitrary `n_parts` partials -> out[0].
// Grid: (1, 1, 1), 256 threads (8 subgroups).
// Buffers: 0 part_val (f32[n_parts]), 1 part_idx (u32[n_parts]), 2 out (u32[1]).
// Params: 3 n_parts.
#ifdef KERNEL_inkling2_argmax_final
shared float af_v[8];
shared uint af_i[8];

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint n_parts = arg_u32(3);
    float bv = -1.0 / 0.0;
    uint bi = 0xffffffffu;
    for (uint i = tid; i < n_parts; i += 256u) {
        const float v = F32(arg(0)).v[i];
        const uint idx = U32(arg(1)).v[i];
        if (v > bv || (v == bv && idx < bi)) {
            bv = v;
            bi = idx;
        }
    }
    const float sv = subgroupMax(bv);
    const uint si = subgroupMin(bv == sv ? bi : 0xffffffffu);
    if (lane == 0u) {
        af_v[sg] = sv;
        af_i[sg] = si;
    }
    barrier();
    if (sg == 0u) {
        const float lv = lane < 8u ? af_v[lane] : (-1.0 / 0.0);
        const uint li = lane < 8u ? af_i[lane] : 0xffffffffu;
        const float mv = subgroupMax(lv);
        const uint mi = subgroupMin(lv == mv ? li : 0xffffffffu);
        if (lane == 0u) U32(arg(2)).v[0] = mi;
    }
}
#endif
