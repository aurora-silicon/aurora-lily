// Fused residual add + RMSNorm: sum = a + b, y = rms_norm(sum, w).
// Eliminates 6 dispatches + 6 barriers per DSpark propose pass!
// Grid: (rows, 1, 1), 256 threads (8 subgroups).
// Buffers: 0 a, 1 b, 2 w, 3 sum_out, 4 norm_out. Params: 5 D, 6 eps.
#ifdef KERNEL_inkling2_add_rms_norm
shared float arn_sg[8];

void main() {
    const uint r = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint D = arg_u32(5);
    const float eps = arg_f32(6);
    const uint64_t off = uint64_t(r) * uint64_t(D) * 4u;
    const uint64_t pa = arg(0) + off;
    const uint64_t pb = arg(1) + off;
    const uint64_t ps = arg(3) + off;
    const uint64_t py = arg(4) + off;
    const uint64_t pw = arg(2);

    float sq = 0.0;
    if ((D & 3u) == 0u) {
        const uint D4 = D >> 2u;
        for (uint i = tid; i < D4; i += 256u) {
            const vec4 s = F32x4(pa).v[i] + F32x4(pb).v[i];
            F32x4(ps).v[i] = s;
            sq += dot(s, s);
        }
        sq = subgroupAdd(sq);
        if (lane == 0u) arn_sg[sg] = sq;
        barrier();
        const float tot = subgroupAdd(lane < 8u ? arn_sg[lane] : 0.0);
        const float inv = inversesqrt(tot / float(D) + eps);
        for (uint i = tid; i < D4; i += 256u) {
            F32x4(py).v[i] = F32x4(ps).v[i] * inv * F32x4(pw).v[i];
        }
    } else {
        for (uint i = tid; i < D; i += 256u) {
            const float s = F32(pa).v[i] + F32(pb).v[i];
            F32(ps).v[i] = s;
            sq += s * s;
        }
        sq = subgroupAdd(sq);
        if (lane == 0u) arn_sg[sg] = sq;
        barrier();
        const float tot = subgroupAdd(lane < 8u ? arn_sg[lane] : 0.0);
        const float inv = inversesqrt(tot / float(D) + eps);
        for (uint i = tid; i < D; i += 256u) {
            F32(py).v[i] = F32(ps).v[i] * inv * F32(pw).v[i];
        }
    }
}
#endif

// Round-to-nearest-even F32x4 -> packed BF16x4 (matches glm53_bf16_bits bit-for-bit).
uvec2 i2_bf16_words(vec4 f) {
    const uvec4 u = floatBitsToUint(f);
    const uvec4 r = u + 0x7fffu + ((u >> 16u) & 1u);
    return uvec2((r.x >> 16u) | (r.y & 0xffff0000u), (r.z >> 16u) | (r.w & 0xffff0000u));
}

// ---------------------------------------------------------------------------
// 1. RMSNorm: y[r, j] = x[r, j] * rsqrt(mean(x^2) + eps) * (has_w ? w[j] : 1)
// Grid: (rows, 1, 1), 256 threads (8 subgroups).
// Buffers: 0 x, 1 w (0 if unused), 2 y. Params: 3 D, 4 eps_bits, 5 has_w, 6 out_bf16.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_rms_norm
shared float rn_sg[8];
void main() {
    const uint r = gl_WorkGroupID.x;
    const uint D = arg_u32(3);
    const float eps = arg_f32(4);
    const uint has_w = arg_u32(5);
    const uint out_bf16 = arg_u32(6);
    const uint64_t x = arg(0) + uint64_t(r) * uint64_t(D) * 4u;
    const uint64_t w = arg(1);
    const uint64_t y = arg(2) + uint64_t(r) * uint64_t(D) * (out_bf16 != 0u ? 2u : 4u);

    float sum = 0.0;
    if ((D & 3u) == 0u) {
        const uint D4 = D >> 2u;
        const uint tid = gl_LocalInvocationIndex;
        const uint n_sg = gl_NumSubgroups;
        const uint wg_t = n_sg * 32u;
        if (D4 == 3u * wg_t) {
            // 1-read register-cached fast path (e.g. D=2304 -> tg=192, 6 warps, zero 2nd read of x!).
            const vec4 v0 = F32x4(x).v[tid];
            const vec4 v1 = F32x4(x).v[tid + wg_t];
            const vec4 v2 = F32x4(x).v[tid + 2u * wg_t];
            const float s = subgroupAdd((dot(v0, v0) + dot(v1, v1)) + dot(v2, v2));
            if (gl_SubgroupInvocationID == 0u) rn_sg[gl_SubgroupID] = s;
            barrier();
            const float tot = subgroupAdd(gl_SubgroupInvocationID < n_sg ? rn_sg[gl_SubgroupInvocationID] : 0.0);
            const float inv = inversesqrt(tot / float(D) + eps);
            vec4 o0 = v0 * inv, o1 = v1 * inv, o2 = v2 * inv;
            if (has_w != 0u) {
                o0 *= F32x4(w).v[tid];
                o1 *= F32x4(w).v[tid + wg_t];
                o2 *= F32x4(w).v[tid + 2u * wg_t];
            }
            if (out_bf16 != 0u) {
                U32x2(y).v[tid] = i2_bf16_words(o0);
                U32x2(y).v[tid + wg_t] = i2_bf16_words(o1);
                U32x2(y).v[tid + 2u * wg_t] = i2_bf16_words(o2);
            } else {
                F32x4(y).v[tid] = o0;
                F32x4(y).v[tid + wg_t] = o1;
                F32x4(y).v[tid + 2u * wg_t] = o2;
            }
            return;
        }
        for (uint i = tid; i < D4; i += wg_t) {
            const vec4 v = F32x4(x).v[i];
            sum += dot(v, v);
        }
        sum = subgroupAdd(sum);
        if (gl_SubgroupInvocationID == 0u) rn_sg[gl_SubgroupID] = sum;
        barrier();
        const float tot = subgroupAdd(gl_SubgroupInvocationID < n_sg ? rn_sg[gl_SubgroupInvocationID] : 0.0);
        const float inv = inversesqrt(tot / float(D) + eps);
        for (uint i = tid; i < D4; i += wg_t) {
            vec4 v = F32x4(x).v[i] * inv;
            if (has_w != 0u) v *= F32x4(w).v[i];
            if (out_bf16 != 0u) U32x2(y).v[i] = i2_bf16_words(v);
            else F32x4(y).v[i] = v;
        }
        return;
    }
    for (uint i = gl_LocalInvocationIndex; i < D; i += 256u) {
        const float v = F32(x).v[i];
        sum += v * v;
    }
    sum = subgroupAdd(sum);
    if (gl_SubgroupInvocationID == 0u) rn_sg[gl_SubgroupID] = sum;
    barrier();
    float tot = 0.0;
    [[unroll]] for (uint s = 0u; s < 8u; s++) tot += rn_sg[s];
    const float inv = inversesqrt(tot / float(D) + eps);
    for (uint i = gl_LocalInvocationIndex; i < D; i += 256u) {
        float v = F32(x).v[i] * inv;
        if (has_w != 0u) v *= F32(w).v[i];
        F32(y).v[i] = v;
    }
}
#endif

// ---------------------------------------------------------------------------
// 2. Per-head L2 clip with optional per-channel scale and optional log-scale tau.
// x, y: [rows, n_heads, dim] (in-place allowed).
// scale: [n_heads, dim] (0 if unused).
// Grid: (n_heads, rows, 1), 32 threads (1 subgroup).
// Buffers: 0 x, 1 scale, 2 y.
// Params: 3 n_heads, 4 dim, 5 thresh, 6 has_scale, 7 pos0, 8 log_floor, 9 log_alpha.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_l2_clip
void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint n_heads = arg_u32(3);
    const uint dim = arg_u32(4);
    const float thresh = arg_f32(5);
    const uint has_scale = arg_u32(6);
    const uint pos0 = arg_u32(7);
    const uint log_floor = arg_u32(8);
    const float log_alpha = arg_f32(9);

    const uint64_t off = (uint64_t(r) * uint64_t(n_heads) + uint64_t(h)) * uint64_t(dim) * 4u;
    const uint64_t x = arg(0) + off;
    const uint64_t sc = arg(1) + uint64_t(h) * uint64_t(dim) * 4u;
    const uint64_t y = arg(2) + off;

    float sq = 0.0;
    for (uint i = gl_SubgroupInvocationID; i < dim; i += 32u) {
        float v = F32(x).v[i];
        if (has_scale != 0u) v *= F32(sc).v[i];
        sq += v * v;
    }
    const float norm = sqrt(subgroupAdd(sq)) + 1e-6;
    float factor = clamp(thresh / norm, 0.0, 1.0);
    if (log_alpha > 0.0 && log_floor > 0u) {
        const float ratio = max(1.0, float(pos0 + r + 1u) / float(log_floor));
        factor *= (1.0 + log_alpha * log(ratio));
    }
    for (uint i = gl_SubgroupInvocationID; i < dim; i += 32u) {
        float v = F32(x).v[i];
        if (has_scale != 0u) v *= F32(sc).v[i];
        F32(y).v[i] = v * factor;
    }
}
#endif

// ---------------------------------------------------------------------------
// 3. Block attention-residual mix (llama_model_inkling2::graph::mix).
// states: [n_states, rows, H] (concatenation of block snapshots and cur).
// queries: [n_q, H].
// out: [n_q, rows, H].
// Grid: (rows, 1, 1), 256 threads (8 subgroups).
// Buffers: 0 states_ptrs (u64[n_states]), 1 queries, 2 out, 3 copy_dst (optional), 4 norm_w (optional).
// Params: 5 H, 6 n_states (<= 16), 7 n_q (<= 4), 8 eps, 9 has_copy, 10 has_norm, 11 norm_eps.
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_mix_q1) || defined(KERNEL_inkling2_mix_q1_s4)
#ifdef KERNEL_inkling2_mix_q1_s4
#define MX1_MAX 4u
#else
#define MX1_MAX 8u
#endif
shared float mx1_sq[MX1_MAX][20];
shared float mx1_dot[MX1_MAX][20];
shared float mx1_nsg[20];

void main() {
    const uint r = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint n_sg = gl_NumSubgroups;
    const uint H = arg_u32(5);
    const uint n_states = arg_u32(6);
    const float eps = arg_f32(8);
    const uint has_copy = arg_u32(9);
    const uint has_norm = arg_u32(10);
    const float norm_eps = arg_f32(11);
    const uint out_bf16 = arg_u32(12);
    const uint64_t ptrs = arg(0);
    const uint64_t queries = arg(1);
    const uint64_t out_base = arg(2);
    const uint64_t copy_dst = arg(3);
    const uint64_t norm_w = arg(4);
    const uint64_t row_off = uint64_t(r) * uint64_t(H) * 4u;
    const uint64_t out_row = out_base + uint64_t(r) * uint64_t(H) * (out_bf16 != 0u ? 2u : 4u);
    const float inv_sqrt_h = inversesqrt(float(H));

    const uint H4 = H >> 2u;
    const bool in_bounds = tid < H4;
    const vec4 q0 = in_bounds ? F32x4(queries).v[tid] : vec4(0.0);

    vec4 sv[MX1_MAX];
    [[unroll]] for (uint s = 0u; s < MX1_MAX; s++) {
        if (s >= n_states) break;
        const uint64_t st = U64(ptrs).v[s] + row_off;
        const vec4 v = in_bounds ? F32x4(st).v[tid] : vec4(0.0);
        sv[s] = v;
        if (has_copy != 0u && s + 1u == n_states && in_bounds) {
            F32x4(copy_dst + row_off).v[tid] = v;
        }
        const float sq = subgroupAdd(dot(v, v));
        const float d0 = subgroupAdd(dot(v, q0));
        if (lane == 0u) {
            mx1_sq[s][sg] = sq;
            mx1_dot[s][sg] = d0;
        }
    }
    barrier();

    // Lane-distributed softmax: lane s owns state s (2 scalar regs instead of 16, 1 exp() instead of 8!).
    float my_inv = 0.0;
    float my_lg = -1.0 / 0.0;
    [[unroll]] for (uint s = 0u; s < MX1_MAX; s++) {
        if (s >= n_states) break;
        const float tsq = subgroupAdd(lane < n_sg ? mx1_sq[s][lane] : 0.0);
        const float td = subgroupAdd(lane < n_sg ? mx1_dot[s][lane] : 0.0);
        if (lane == s) {
            my_inv = inversesqrt(tsq / float(H) + eps);
            my_lg = td * my_inv * inv_sqrt_h;
        }
    }
    const float mx = subgroupMax(my_lg);
    const float w_raw = lane < n_states ? exp(my_lg - mx) : 0.0;
    const float my_w = w_raw * my_inv / subgroupAdd(w_raw);

    vec4 a0 = vec4(0.0);
    if (in_bounds) {
        [[unroll]] for (uint s = 0u; s < MX1_MAX; s++) {
            if (s >= n_states) break;
            a0 += subgroupBroadcast(my_w, s) * sv[s];
        }
        if (has_norm == 0u) {
            if (out_bf16 != 0u) U32x2(out_row).v[tid] = i2_bf16_words(a0);
            else F32x4(out_row).v[tid] = a0;
        }
    }
    if (has_norm != 0u) {
        const float out_sq = subgroupAdd(in_bounds ? dot(a0, a0) : 0.0);
        if (lane == 0u) mx1_nsg[sg] = out_sq;
        barrier();
        const float tot = subgroupAdd(lane < n_sg ? mx1_nsg[lane] : 0.0);
        const float inv = inversesqrt(tot / float(H) + norm_eps);
        if (in_bounds) {
            const vec4 nv = a0 * inv * F32x4(norm_w).v[tid];
            if (out_bf16 != 0u) U32x2(out_row).v[tid] = i2_bf16_words(nv);
            else F32x4(out_row).v[tid] = nv;
        }
    }
}
#endif

// Fused 3-query attn_res_mix + copy_dst + 3-way RMSNorm (+ optional BF16 output) for global layers!
// Eliminates inkling2_rms_norm3 dispatch + barrier + F32 mix_out round-trip.
// Grid: (rows, 1, 1), ceil(H / 4 / 32) * 32 threads (576 for H = 2304).
// Buffers: 0 ptrs, 1 queries ([3, H]), 2 copy_dst, 3 nw0, 4 nw1, 5 nw2, 6 out0, 7 out1, 8 out2.
// Params: 9 H, 10 n_states (<= 8), 11 eps, 12 has_copy, 13 norm_eps, 14 out_bf16.
#ifdef KERNEL_inkling2_mix_q3_norm
shared float mq3_sq[8][20];
shared float mq3_dot[3][8][20];
shared float mq3_nsg[3][20];

void main() {
    const uint r = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint n_sg = gl_NumSubgroups;
    const uint H = arg_u32(9);
    const uint n_states = arg_u32(10);
    const float eps = arg_f32(11);
    const uint has_copy = arg_u32(12);
    const float norm_eps = arg_f32(13);
    const uint out_bf16 = arg_u32(14);
    const uint64_t ptrs = arg(0);
    const uint64_t queries = arg(1);
    const uint64_t row_off = uint64_t(r) * uint64_t(H) * 4u;
    const uint64_t out_off = uint64_t(r) * uint64_t(H) * (out_bf16 != 0u ? 2u : 4u);
    const float inv_sqrt_h = inversesqrt(float(H));

    const uint H4 = H >> 2u;
    const bool in_bounds = tid < H4;
    const vec4 q0 = in_bounds ? F32x4(queries).v[tid] : vec4(0.0);
    const vec4 q1 = in_bounds ? F32x4(queries + uint64_t(H) * 4u).v[tid] : vec4(0.0);
    const vec4 q2 = in_bounds ? F32x4(queries + uint64_t(2u * H) * 4u).v[tid] : vec4(0.0);

    vec4 sv[8];
    [[unroll]] for (uint s = 0u; s < 8u; s++) {
        if (s >= n_states) break;
        const uint64_t st = U64(ptrs).v[s] + row_off;
        const vec4 v = in_bounds ? F32x4(st).v[tid] : vec4(0.0);
        sv[s] = v;
        if (has_copy != 0u && s + 1u == n_states && in_bounds) {
            F32x4(arg(2) + row_off).v[tid] = v;
        }
        const float sq = subgroupAdd(dot(v, v));
        const float d0 = subgroupAdd(dot(v, q0));
        const float d1 = subgroupAdd(dot(v, q1));
        const float d2 = subgroupAdd(dot(v, q2));
        if (lane == 0u) {
            mq3_sq[s][sg] = sq;
            mq3_dot[0][s][sg] = d0;
            mq3_dot[1][s][sg] = d1;
            mq3_dot[2][s][sg] = d2;
        }
    }
    barrier();

    float my_inv = 0.0;
    float my_l0 = -1.0 / 0.0, my_l1 = -1.0 / 0.0, my_l2 = -1.0 / 0.0;
    [[unroll]] for (uint s = 0u; s < 8u; s++) {
        if (s >= n_states) break;
        const float tsq = subgroupAdd(lane < n_sg ? mq3_sq[s][lane] : 0.0);
        const float t0 = subgroupAdd(lane < n_sg ? mq3_dot[0][s][lane] : 0.0);
        const float t1 = subgroupAdd(lane < n_sg ? mq3_dot[1][s][lane] : 0.0);
        const float t2 = subgroupAdd(lane < n_sg ? mq3_dot[2][s][lane] : 0.0);
        if (lane == s) {
            my_inv = inversesqrt(tsq / float(H) + eps);
            const float sc = my_inv * inv_sqrt_h;
            my_l0 = t0 * sc;
            my_l1 = t1 * sc;
            my_l2 = t2 * sc;
        }
    }
    const float m0 = subgroupMax(my_l0), m1 = subgroupMax(my_l1), m2 = subgroupMax(my_l2);
    const float r0 = lane < n_states ? exp(my_l0 - m0) : 0.0;
    const float r1 = lane < n_states ? exp(my_l1 - m1) : 0.0;
    const float r2 = lane < n_states ? exp(my_l2 - m2) : 0.0;
    const float w0 = r0 * my_inv / subgroupAdd(r0);
    const float w1 = r1 * my_inv / subgroupAdd(r1);
    const float w2 = r2 * my_inv / subgroupAdd(r2);

    vec4 a0 = vec4(0.0), a1 = vec4(0.0), a2 = vec4(0.0);
    if (in_bounds) {
        [[unroll]] for (uint s = 0u; s < 8u; s++) {
            if (s >= n_states) break;
            const vec4 v = sv[s];
            a0 += subgroupBroadcast(w0, s) * v;
            a1 += subgroupBroadcast(w1, s) * v;
            a2 += subgroupBroadcast(w2, s) * v;
        }
    }
    const float s0 = subgroupAdd(in_bounds ? dot(a0, a0) : 0.0);
    const float s1 = subgroupAdd(in_bounds ? dot(a1, a1) : 0.0);
    const float s2 = subgroupAdd(in_bounds ? dot(a2, a2) : 0.0);
    if (lane == 0u) {
        mq3_nsg[0][sg] = s0;
        mq3_nsg[1][sg] = s1;
        mq3_nsg[2][sg] = s2;
    }
    barrier();
    const float inv0 = inversesqrt(subgroupAdd(lane < n_sg ? mq3_nsg[0][lane] : 0.0) / float(H) + norm_eps);
    const float inv1 = inversesqrt(subgroupAdd(lane < n_sg ? mq3_nsg[1][lane] : 0.0) / float(H) + norm_eps);
    const float inv2 = inversesqrt(subgroupAdd(lane < n_sg ? mq3_nsg[2][lane] : 0.0) / float(H) + norm_eps);
    if (in_bounds) {
        const vec4 n0 = a0 * inv0 * F32x4(arg(3)).v[tid];
        const vec4 n1 = a1 * inv1 * F32x4(arg(4)).v[tid];
        const vec4 n2 = a2 * inv2 * F32x4(arg(5)).v[tid];
        if (out_bf16 != 0u) {
            U32x2(arg(6) + out_off).v[tid] = i2_bf16_words(n0);
            U32x2(arg(7) + out_off).v[tid] = i2_bf16_words(n1);
            U32x2(arg(8) + out_off).v[tid] = i2_bf16_words(n2);
        } else {
            F32x4(arg(6) + out_off).v[tid] = n0;
            F32x4(arg(7) + out_off).v[tid] = n1;
            F32x4(arg(8) + out_off).v[tid] = n2;
        }
    }
}
#endif

#if defined(KERNEL_inkling2_mix_s4)
// Register-lean 1-barrier multi-query attn_res_mix for n_states <= 4 (vec4 sv[4]).
shared float mx4_sq[4][20];
shared float mx4_dot[4][4][20];
shared float mx4_nsg[20];

void main() {
    const uint r = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint n_sg = gl_NumSubgroups;
    const uint H = arg_u32(5);
    const uint n_states = arg_u32(6);
    const uint n_q = arg_u32(7);
    const float eps = arg_f32(8);
    const uint has_copy = arg_u32(9);
    const uint has_norm = arg_u32(10);
    const float norm_eps = arg_f32(11);
    const uint64_t ptrs = arg(0);
    const uint64_t queries = arg(1);
    const uint64_t out_base = arg(2);
    const uint64_t copy_dst = arg(3);
    const uint64_t norm_w = arg(4);
    const uint64_t row_off = uint64_t(r) * uint64_t(H) * 4u;
    const float inv_sqrt_h = inversesqrt(float(H));
    const uint64_t stride = uint64_t(gl_NumWorkGroups.x) * uint64_t(H) * 4u;

    const uint H4 = H >> 2u;
    const bool in_bounds = tid < H4;
    const vec4 q0 = in_bounds ? F32x4(queries).v[tid] : vec4(0.0);
    const vec4 q1 = (in_bounds && n_q > 1u) ? F32x4(queries + uint64_t(H) * 4u).v[tid] : vec4(0.0);
    const vec4 q2 = (in_bounds && n_q > 2u) ? F32x4(queries + uint64_t(2u * H) * 4u).v[tid] : vec4(0.0);
    const vec4 q3 = (in_bounds && n_q > 3u) ? F32x4(queries + uint64_t(3u * H) * 4u).v[tid] : vec4(0.0);

    vec4 sv[4];
    [[unroll]] for (uint s = 0u; s < 4u; s++) {
        if (s >= n_states) break;
        const uint64_t st = U64(ptrs).v[s] + row_off;
        const vec4 v = in_bounds ? F32x4(st).v[tid] : vec4(0.0);
        sv[s] = v;
        if (has_copy != 0u && s + 1u == n_states && in_bounds) F32x4(copy_dst + row_off).v[tid] = v;
        const float sq = subgroupAdd(dot(v, v));
        const float d0 = subgroupAdd(dot(v, q0));
        const float d1 = n_q > 1u ? subgroupAdd(dot(v, q1)) : 0.0;
        const float d2 = n_q > 2u ? subgroupAdd(dot(v, q2)) : 0.0;
        const float d3 = n_q > 3u ? subgroupAdd(dot(v, q3)) : 0.0;
        if (lane == 0u) {
            mx4_sq[s][sg] = sq;
            mx4_dot[0][s][sg] = d0;
            if (n_q > 1u) mx4_dot[1][s][sg] = d1;
            if (n_q > 2u) mx4_dot[2][s][sg] = d2;
            if (n_q > 3u) mx4_dot[3][s][sg] = d3;
        }
    }
    barrier();

    float my_inv = 0.0;
    float my_l0 = -1.0 / 0.0, my_l1 = -1.0 / 0.0, my_l2 = -1.0 / 0.0, my_l3 = -1.0 / 0.0;
    [[unroll]] for (uint s = 0u; s < 4u; s++) {
        if (s >= n_states) break;
        const float tsq = subgroupAdd(lane < n_sg ? mx4_sq[s][lane] : 0.0);
        const float t0 = subgroupAdd(lane < n_sg ? mx4_dot[0][s][lane] : 0.0);
        const float t1 = n_q > 1u ? subgroupAdd(lane < n_sg ? mx4_dot[1][s][lane] : 0.0) : 0.0;
        const float t2 = n_q > 2u ? subgroupAdd(lane < n_sg ? mx4_dot[2][s][lane] : 0.0) : 0.0;
        const float t3 = n_q > 3u ? subgroupAdd(lane < n_sg ? mx4_dot[3][s][lane] : 0.0) : 0.0;
        if (lane == s) {
            my_inv = inversesqrt(tsq / float(H) + eps);
            const float sc = my_inv * inv_sqrt_h;
            my_l0 = t0 * sc;
            my_l1 = t1 * sc;
            my_l2 = t2 * sc;
            my_l3 = t3 * sc;
        }
    }
    const float m0 = subgroupMax(my_l0);
    const float r0 = lane < n_states ? exp(my_l0 - m0) : 0.0;
    const float w0 = r0 * my_inv / subgroupAdd(r0);
    float w1 = 0.0, w2 = 0.0, w3 = 0.0;
    if (n_q > 1u) {
        const float m1 = subgroupMax(my_l1);
        const float r1 = lane < n_states ? exp(my_l1 - m1) : 0.0;
        w1 = r1 * my_inv / subgroupAdd(r1);
    }
    if (n_q > 2u) {
        const float m2 = subgroupMax(my_l2);
        const float r2 = lane < n_states ? exp(my_l2 - m2) : 0.0;
        w2 = r2 * my_inv / subgroupAdd(r2);
    }
    if (n_q > 3u) {
        const float m3 = subgroupMax(my_l3);
        const float r3 = lane < n_states ? exp(my_l3 - m3) : 0.0;
        w3 = r3 * my_inv / subgroupAdd(r3);
    }

    vec4 a0 = vec4(0.0), a1 = vec4(0.0), a2 = vec4(0.0), a3 = vec4(0.0);
    if (in_bounds) {
        [[unroll]] for (uint s = 0u; s < 4u; s++) {
            if (s >= n_states) break;
            const vec4 v = sv[s];
            a0 += subgroupBroadcast(w0, s) * v;
            if (n_q > 1u) a1 += subgroupBroadcast(w1, s) * v;
            if (n_q > 2u) a2 += subgroupBroadcast(w2, s) * v;
            if (n_q > 3u) a3 += subgroupBroadcast(w3, s) * v;
        }
        if (has_norm == 0u) F32x4(out_base + row_off).v[tid] = a0;
        if (n_q > 1u) F32x4(out_base + stride + row_off).v[tid] = a1;
        if (n_q > 2u) F32x4(out_base + 2u * stride + row_off).v[tid] = a2;
        if (n_q > 3u) F32x4(out_base + 3u * stride + row_off).v[tid] = a3;
    }
    if (has_norm != 0u) {
        const float out_sq = subgroupAdd(in_bounds ? dot(a0, a0) : 0.0);
        if (lane == 0u) mx4_nsg[sg] = out_sq;
        barrier();
        const float tot = subgroupAdd(lane < n_sg ? mx4_nsg[lane] : 0.0);
        const float inv = inversesqrt(tot / float(H) + norm_eps);
        if (in_bounds) F32x4(out_base + row_off).v[tid] = a0 * inv * F32x4(norm_w).v[tid];
    }
}
#endif

#ifdef KERNEL_inkling2_mix
shared float mx_sq[16][32];
shared float mx_dot[4][16][32];
shared float mx_w[4][16];
shared float mx_nsg[32];

void main() {
    const uint r = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint n_sg = gl_NumSubgroups;
    const uint H = arg_u32(5);
    const uint n_states = arg_u32(6);
    const uint n_q = arg_u32(7);
    const float eps = arg_f32(8);
    const uint has_copy = arg_u32(9);
    const uint has_norm = arg_u32(10);
    const float norm_eps = arg_f32(11);
    const uint64_t ptrs = arg(0);
    const uint64_t queries = arg(1);
    const uint64_t out_base = arg(2);
    const uint64_t copy_dst = arg(3);
    const uint64_t norm_w = arg(4);
    const uint64_t row_off = uint64_t(r) * uint64_t(H) * 4u;
    const float inv_sqrt_h = inversesqrt(float(H));
    const uint64_t stride = uint64_t(gl_NumWorkGroups.x) * uint64_t(H) * 4u;

    if ((H & 3u) == 0u && n_sg * 32u >= (H >> 2u) && n_states <= 8u) {
        // Register-resident 1-vec4/thread path: reads every state ONCE (zero Pass-2
        // global loads) and computes softmax in every subgroup -> ONE single barrier!
        const uint H4 = H >> 2u;
        const bool in_bounds = tid < H4;
        const vec4 q0 = in_bounds ? F32x4(queries).v[tid] : vec4(0.0);
        const vec4 q1 = (in_bounds && n_q > 1u) ? F32x4(queries + uint64_t(H) * 4u).v[tid] : vec4(0.0);
        const vec4 q2 = (in_bounds && n_q > 2u) ? F32x4(queries + uint64_t(2u * H) * 4u).v[tid] : vec4(0.0);
        const vec4 q3 = (in_bounds && n_q > 3u) ? F32x4(queries + uint64_t(3u * H) * 4u).v[tid] : vec4(0.0);

        vec4 sv[8];
        vec4 last_v = vec4(0.0);
        [[unroll]] for (uint s = 0u; s < 8u; s++) {
            if (s >= n_states) break;
            const uint64_t st = U64(ptrs).v[s] + row_off;
            const vec4 v = in_bounds ? F32x4(st).v[tid] : vec4(0.0);
            sv[s] = v;
            last_v = v;
            const float sq = subgroupAdd(dot(v, v));
            const float d0 = subgroupAdd(dot(v, q0));
            const float d1 = n_q > 1u ? subgroupAdd(dot(v, q1)) : 0.0;
            const float d2 = n_q > 2u ? subgroupAdd(dot(v, q2)) : 0.0;
            const float d3 = n_q > 3u ? subgroupAdd(dot(v, q3)) : 0.0;
            if (lane == 0u) {
                mx_sq[s][sg] = sq;
                mx_dot[0][s][sg] = d0;
                if (n_q > 1u) mx_dot[1][s][sg] = d1;
                if (n_q > 2u) mx_dot[2][s][sg] = d2;
                if (n_q > 3u) mx_dot[3][s][sg] = d3;
            }
        }
        barrier();

        for (uint q = sg; q < n_q; q += n_sg) {
            float inv_s[8];
            float logits[8];
            float mx = -1.0 / 0.0;
            for (uint s = 0u; s < n_states; s++) {
                const float tsq = subgroupAdd(lane < n_sg ? mx_sq[s][lane] : 0.0);
                const float td = subgroupAdd(lane < n_sg ? mx_dot[q][s][lane] : 0.0);
                const float inv = inversesqrt(tsq / float(H) + eps);
                inv_s[s] = inv;
                const float lg = td * inv * inv_sqrt_h;
                logits[s] = lg;
                mx = max(mx, lg);
            }
            if (lane == 0u) {
                float sum = 0.0;
                for (uint s = 0u; s < n_states; s++) {
                    logits[s] = exp(logits[s] - mx);
                    sum += logits[s];
                }
                const float inv_sum = 1.0 / sum;
                for (uint s = 0u; s < n_states; s++) {
                    mx_w[q][s] = logits[s] * inv_sum * inv_s[s];
                }
            }
        }
        barrier();

        vec4 a0 = vec4(0.0), a1 = vec4(0.0), a2 = vec4(0.0), a3 = vec4(0.0);
        if (in_bounds) {
            [[unroll]] for (uint s = 0u; s < 8u; s++) {
                if (s >= n_states) break;
                const vec4 v = sv[s];
                a0 += mx_w[0][s] * v;
                if (n_q > 1u) a1 += mx_w[1][s] * v;
                if (n_q > 2u) a2 += mx_w[2][s] * v;
                if (n_q > 3u) a3 += mx_w[3][s] * v;
            }
            if (has_copy != 0u) F32x4(copy_dst + row_off).v[tid] = last_v;
            if (has_norm == 0u) F32x4(out_base + row_off).v[tid] = a0;
            if (n_q > 1u) F32x4(out_base + stride + row_off).v[tid] = a1;
            if (n_q > 2u) F32x4(out_base + 2u * stride + row_off).v[tid] = a2;
            if (n_q > 3u) F32x4(out_base + 3u * stride + row_off).v[tid] = a3;
        }
        if (has_norm != 0u) {
            const float out_sq = subgroupAdd(in_bounds ? dot(a0, a0) : 0.0);
            if (lane == 0u) mx_nsg[sg] = out_sq;
            barrier();
            const float tot = subgroupAdd(lane < n_sg ? mx_nsg[lane] : 0.0);
            const float inv = inversesqrt(tot / float(H) + norm_eps);
            if (in_bounds) {
                F32x4(out_base + row_off).v[tid] = a0 * inv * F32x4(norm_w).v[tid];
            }
        }
        return;
    }

    if ((H & 3u) == 0u) {
        const uint H4 = H >> 2u;
        const uint wg_t = n_sg * 32u;
        for (uint s = 0u; s < n_states; s++) {
            const uint64_t st = U64(ptrs).v[s] + row_off;
            float sq = 0.0;
            float d0 = 0.0, d1 = 0.0, d2 = 0.0, d3 = 0.0;
            for (uint i = tid; i < H4; i += wg_t) {
                const vec4 v = F32x4(st).v[i];
                sq += dot(v, v);
                d0 += dot(v, F32x4(queries).v[i]);
                if (n_q > 1u) d1 += dot(v, F32x4(queries + uint64_t(H) * 4u).v[i]);
                if (n_q > 2u) d2 += dot(v, F32x4(queries + uint64_t(2u * H) * 4u).v[i]);
                if (n_q > 3u) d3 += dot(v, F32x4(queries + uint64_t(3u * H) * 4u).v[i]);
            }
            sq = subgroupAdd(sq);
            d0 = subgroupAdd(d0);
            if (n_q > 1u) d1 = subgroupAdd(d1);
            if (n_q > 2u) d2 = subgroupAdd(d2);
            if (n_q > 3u) d3 = subgroupAdd(d3);
            if (lane == 0u) {
                mx_sq[s][sg] = sq;
                mx_dot[0][s][sg] = d0;
                if (n_q > 1u) mx_dot[1][s][sg] = d1;
                if (n_q > 2u) mx_dot[2][s][sg] = d2;
                if (n_q > 3u) mx_dot[3][s][sg] = d3;
            }
        }
        barrier();

        if (tid < n_q) {
            const uint q = tid;
            float inv_s[16];
            float logits[16];
            float mx = -1.0 / 0.0;
            for (uint s = 0u; s < n_states; s++) {
                float tsq = 0.0, td = 0.0;
                for (uint g = 0u; g < n_sg; g++) {
                    tsq += mx_sq[s][g];
                    td += mx_dot[q][s][g];
                }
                const float inv = inversesqrt(tsq / float(H) + eps);
                inv_s[s] = inv;
                const float lg = td * inv * inv_sqrt_h;
                logits[s] = lg;
                mx = max(mx, lg);
            }
            float sum = 0.0;
            for (uint s = 0u; s < n_states; s++) {
                logits[s] = exp(logits[s] - mx);
                sum += logits[s];
            }
            const float inv_sum = 1.0 / sum;
            for (uint s = 0u; s < n_states; s++) {
                mx_w[q][s] = logits[s] * inv_sum * inv_s[s];
            }
        }
        barrier();

        float out_sq = 0.0;
        for (uint i = tid; i < H4; i += wg_t) {
            vec4 a0 = vec4(0.0), a1 = vec4(0.0), a2 = vec4(0.0), a3 = vec4(0.0);
            vec4 last_v = vec4(0.0);
            for (uint s = 0u; s < n_states; s++) {
                const vec4 v = F32x4(U64(ptrs).v[s] + row_off).v[i];
                last_v = v;
                a0 += mx_w[0][s] * v;
                if (n_q > 1u) a1 += mx_w[1][s] * v;
                if (n_q > 2u) a2 += mx_w[2][s] * v;
                if (n_q > 3u) a3 += mx_w[3][s] * v;
            }
            if (has_copy != 0u) F32x4(copy_dst + row_off).v[i] = last_v;
            F32x4(out_base + row_off).v[i] = a0;
            if (has_norm != 0u) out_sq += dot(a0, a0);
            if (n_q > 1u) F32x4(out_base + stride + row_off).v[i] = a1;
            if (n_q > 2u) F32x4(out_base + 2u * stride + row_off).v[i] = a2;
            if (n_q > 3u) F32x4(out_base + 3u * stride + row_off).v[i] = a3;
        }
        if (has_norm != 0u) {
            out_sq = subgroupAdd(out_sq);
            if (lane == 0u) mx_nsg[sg] = out_sq;
            barrier();
            float tot = 0.0;
            for (uint g = 0u; g < n_sg; g++) tot += mx_nsg[g];
            const float inv = inversesqrt(tot / float(H) + norm_eps);
            for (uint i = tid; i < H4; i += wg_t) {
                F32x4(out_base + row_off).v[i] *= inv * F32x4(norm_w).v[i];
            }
        }
        return;
    }

    // General scalar fallback for non-multiple-of-4 H (256 threads, 8 subgroups).
    for (uint s = 0u; s < n_states; s++) {
        const uint64_t st = U64(ptrs).v[s] + row_off;
        float sq = 0.0;
        float d0 = 0.0, d1 = 0.0, d2 = 0.0, d3 = 0.0;
        for (uint i = tid; i < H; i += 256u) {
            const float v = F32(st).v[i];
            sq += v * v;
            d0 += v * F32(queries).v[i];
            if (n_q > 1u) d1 += v * F32(queries + uint64_t(H) * 4u).v[i];
            if (n_q > 2u) d2 += v * F32(queries + uint64_t(2u * H) * 4u).v[i];
            if (n_q > 3u) d3 += v * F32(queries + uint64_t(3u * H) * 4u).v[i];
        }
        sq = subgroupAdd(sq);
        d0 = subgroupAdd(d0);
        if (n_q > 1u) d1 = subgroupAdd(d1);
        if (n_q > 2u) d2 = subgroupAdd(d2);
        if (n_q > 3u) d3 = subgroupAdd(d3);
        if (lane == 0u) {
            mx_sq[s][sg] = sq;
            mx_dot[0][s][sg] = d0;
            if (n_q > 1u) mx_dot[1][s][sg] = d1;
            if (n_q > 2u) mx_dot[2][s][sg] = d2;
            if (n_q > 3u) mx_dot[3][s][sg] = d3;
        }
    }
    barrier();
    if (tid < n_q) {
        const uint q = tid;
        float inv_s[16];
        float logits[16];
        float mx = -1.0 / 0.0;
        for (uint s = 0u; s < n_states; s++) {
            float tsq = 0.0, td = 0.0;
            for (uint g = 0u; g < n_sg; g++) {
                tsq += mx_sq[s][g];
                td += mx_dot[q][s][g];
            }
            const float inv = inversesqrt(tsq / float(H) + eps);
            inv_s[s] = inv;
            const float lg = td * inv * inv_sqrt_h;
            logits[s] = lg;
            mx = max(mx, lg);
        }
        float sum = 0.0;
        for (uint s = 0u; s < n_states; s++) {
            logits[s] = exp(logits[s] - mx);
            sum += logits[s];
        }
        const float inv_sum = 1.0 / sum;
        for (uint s = 0u; s < n_states; s++) mx_w[q][s] = logits[s] * inv_sum * inv_s[s];
    }
    barrier();

    float out_sq = 0.0;
    for (uint i = tid; i < H; i += 256u) {
        float acc0 = 0.0, acc1 = 0.0, acc2 = 0.0, acc3 = 0.0;
        float last_v = 0.0;
        for (uint s = 0u; s < n_states; s++) {
            const float v = F32(U64(ptrs).v[s] + row_off).v[i];
            last_v = v;
            acc0 += mx_w[0][s] * v;
            if (n_q > 1u) acc1 += mx_w[1][s] * v;
            if (n_q > 2u) acc2 += mx_w[2][s] * v;
            if (n_q > 3u) acc3 += mx_w[3][s] * v;
        }
        if (has_copy != 0u) F32(copy_dst + row_off).v[i] = last_v;
        F32(out_base + row_off).v[i] = acc0;
        if (has_norm != 0u) out_sq += acc0 * acc0;
        if (n_q > 1u) F32(out_base + stride + row_off).v[i] = acc1;
        if (n_q > 2u) F32(out_base + 2u * stride + row_off).v[i] = acc2;
        if (n_q > 3u) F32(out_base + 3u * stride + row_off).v[i] = acc3;
    }
    if (has_norm != 0u) {
        out_sq = subgroupAdd(out_sq);
        if (lane == 0u) mx_nsg[sg] = out_sq;
        barrier();
        float tot = 0.0;
        for (uint g = 0u; g < n_sg; g++) tot += mx_nsg[g];
        const float inv = inversesqrt(tot / float(H) + norm_eps);
        for (uint i = tid; i < H; i += 256u) {
            F32(out_base + row_off).v[i] *= inv * F32(norm_w).v[i];
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// 4. Loop controller concat-RMSNorm: out[r, 0..H] = rms(cur[r]), out[r, H..2H] = rms(msg[r]).
// Grid: (rows, 2, 1), 256 threads.
// Buffers: 0 cur, 1 msg, 2 out. Params: 3 H, 4 eps.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_ctrl_concat_norm
shared float cn_sg[8];
void main() {
    const uint r = gl_WorkGroupID.x;
    const uint half_id = gl_WorkGroupID.y;
    const uint H = arg_u32(3);
    const float eps = arg_f32(4);
    const uint64_t src = (half_id == 0u ? arg(0) : arg(1)) + uint64_t(r) * uint64_t(H) * 4u;
    const uint64_t dst = arg(2) + (uint64_t(r) * 2u + uint64_t(half_id)) * uint64_t(H) * 4u;

    float sq = 0.0;
    for (uint i = gl_LocalInvocationIndex; i < H; i += 256u) {
        const float v = F32(src).v[i];
        sq += v * v;
    }
    sq = subgroupAdd(sq);
    if (gl_SubgroupInvocationID == 0u) cn_sg[gl_SubgroupID] = sq;
    barrier();
    if (gl_LocalInvocationIndex == 0u) {
        float tot = 0.0;
        for (uint g = 0u; g < 8u; g++) tot += cn_sg[g];
        cn_sg[0] = inversesqrt(tot / float(H) + eps);
    }
    barrier();
    const float inv = cn_sg[0];
    for (uint i = gl_LocalInvocationIndex; i < H; i += 256u) {
        F32(dst).v[i] = F32(src).v[i] * inv;
    }
}
#endif

// ---------------------------------------------------------------------------
// 5. Loop controller blend: out = (1 - tanh(forget)) * cur + tanh(gain) * msg.
// Grid: (ceil(N/256), 1, 1), 256 threads.
// Buffers: 0 cur, 1 msg, 2 gain, 3 forget, 4 out. Params: 5 N.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_ctrl_blend
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= arg_u32(5)) return;
    const float c = F32(arg(0)).v[i];
    const float m = F32(arg(1)).v[i];
    const float g = tanh(F32(arg(2)).v[i]);
    const float f = tanh(F32(arg(3)).v[i]);
    F32(arg(4)).v[i] = (1.0 - f) * c + g * m;
}
#endif

// ---------------------------------------------------------------------------
// 6. Causal short convolution with residual, optional dynamic taps, and in-place
// history update.
// x, y: [rows, C]; weight: [C, n_conv]; history: [C, n_conv - 1];
// dyn (optional, 0 if unused): [rows, n_heads, n_conv].
// Grid: (ceil(C/256), 1, 1), 256 threads.
// Buffers: 0 x, 1 weight, 2 dyn, 3 history, 4 y, 5 trace (optional), 6 res (optional).
// Params: 7 rows, 8 C, 9 n_conv (<= 8), 10 n_heads (0 if static), 11 has_trace, 12 has_res.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_sconv_4
void main() {
    const uint c = gl_GlobalInvocationID.x;
    const uint C = arg_u32(8);
    if (c >= C) return;
    const uint rows = arg_u32(7);
    const uint has_trace = arg_u32(11);
    const uint has_res = arg_u32(12);

    const uint64_t x_buf = arg(0);
    const uint64_t w_buf = arg(1) + uint64_t(c) * 16u;
    const uint64_t h_buf = arg(3);
    const uint64_t y_buf = arg(4);
    const uint64_t t_buf = arg(5);
    const uint64_t r_buf = arg(6);

    const vec4 wv = F32x4(w_buf).v[0];
    float r0 = F32(h_buf).v[c];
    float r1 = F32(h_buf).v[C + c];
    float r2 = F32(h_buf).v[2u * C + c];
    if (has_trace != 0u) {
        F32(t_buf).v[c] = r1;
        F32(t_buf).v[C + c] = r2;
    }
    const float scale = inversesqrt(5.0);
    for (uint r = 0u; r < rows; r++) {
        const uint idx = r * C + c;
        const float xr = F32(x_buf).v[idx];
        const float acc = r0 * wv.x + r1 * wv.y + r2 * wv.z + xr * wv.w;
        float out_v = (xr + acc) * scale;
        if (has_res != 0u) out_v += F32(r_buf).v[idx];
        F32(y_buf).v[idx] = out_v;
        r0 = r1;
        r1 = r2;
        r2 = xr;
        if (has_trace != 0u) {
            F32(t_buf).v[(2u + r) * C + c] = xr;
        }
    }
    F32(h_buf).v[c] = r0;
    F32(h_buf).v[C + c] = r1;
    F32(h_buf).v[2u * C + c] = r2;
}
#endif

#ifdef KERNEL_inkling2_sconv
void main() {
    const uint c = gl_GlobalInvocationID.x;
    const uint C = arg_u32(8);
    if (c >= C) return;
    const uint rows = arg_u32(7);
    const uint n_conv = arg_u32(9);
    const uint n_heads = arg_u32(10);
    const uint has_trace = arg_u32(11);
    const uint has_res = arg_u32(12);
    const uint hist_len = n_conv - 1u;

    const uint64_t x_buf = arg(0);
    const uint64_t w_buf = arg(1) + uint64_t(c) * uint64_t(n_conv) * 4u;
    const uint64_t d_buf = arg(2);
    const uint64_t h_buf = arg(3);
    const uint64_t y_buf = arg(4);
    const uint64_t t_buf = arg(5);
    const uint64_t r_buf = arg(6);

    if (n_conv == 4u && n_heads == 0u) {
        const vec4 wv = F32x4(w_buf).v[0];
        float r0 = F32(h_buf).v[c];
        float r1 = F32(h_buf).v[C + c];
        float r2 = F32(h_buf).v[2u * C + c];
        if (has_trace != 0u) {
            F32(t_buf).v[c] = r1;
            F32(t_buf).v[C + c] = r2;
        }
        const float scale = inversesqrt(5.0);
        for (uint r = 0u; r < rows; r++) {
            const uint idx = r * C + c;
            const float xr = F32(x_buf).v[idx];
            const float acc = r0 * wv.x + r1 * wv.y + r2 * wv.z + xr * wv.w;
            float out_v = (xr + acc) * scale;
            if (has_res != 0u) out_v += F32(r_buf).v[idx];
            F32(y_buf).v[idx] = out_v;
            r0 = r1;
            r1 = r2;
            r2 = xr;
            if (has_trace != 0u) {
                F32(t_buf).v[(2u + r) * C + c] = xr;
            }
        }
        F32(h_buf).v[c] = r0;
        F32(h_buf).v[C + c] = r1;
        F32(h_buf).v[2u * C + c] = r2;
        return;
    }

    float w[8];
    for (uint k = 0u; k < n_conv; k++) w[k] = F32(w_buf).v[k];

    float ring[8];
    for (uint k = 0u; k < hist_len; k++) ring[k] = F32(h_buf).v[k * C + c];
    if (has_trace != 0u) {
        for (uint k = 0u; k + 1u < hist_len; k++) {
            F32(t_buf).v[k * C + c] = ring[k + 1u];
        }
    }

    const uint head = n_heads > 0u ? (c / (C / n_heads)) : 0u;
    const float scale = inversesqrt(float(((n_heads > 0u ? 2u : 1u) * n_conv) + 1u));

    for (uint r = 0u; r < rows; r++) {
        const float xr = F32(x_buf).v[r * C + c];
        ring[hist_len] = xr;

        float acc = 0.0;
        for (uint k = 0u; k < n_conv; k++) {
            acc += ring[k] * w[k];
        }
        if (n_heads > 0u) {
            const uint64_t d_off = (uint64_t(r) * uint64_t(n_heads) + uint64_t(head)) * uint64_t(n_conv) * 4u;
            for (uint lag = 0u; lag < n_conv; lag++) {
                acc += ring[n_conv - 1u - lag] * F32(d_buf + d_off).v[lag];
            }
        }
        float out_v = (xr + acc) * scale;
        if (has_res != 0u) out_v += F32(r_buf).v[r * C + c];
        F32(y_buf).v[r * C + c] = out_v;

        // Shift ring left by 1.
        for (uint k = 0u; k < hist_len; k++) {
            ring[k] = ring[k + 1u];
        }
        if (has_trace != 0u) {
            F32(t_buf).v[(hist_len - 1u + r) * C + c] = xr;
        }
    }

    for (uint k = 0u; k < hist_len; k++) {
        F32(h_buf).v[k * C + c] = ring[k];
    }
}
#endif

// ---------------------------------------------------------------------------
// 7. Store K and V into f16 KV cache (SWA ring or global linear).
// k_in, v_in: [rows, n_head_kv, head_dim] f32.
// k_cache, v_cache: [slots, n_head_kv, head_dim] f16.
// Grid: (ceil(kv_width/256), rows, 1), 256 threads.
// Buffers: 0 k_in, 1 v_in, 2 k_cache, 3 v_cache.
// Params: 4 kv_width, 5 pos0, 6 slots, 7 is_swa.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_kv_store
void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint r = gl_WorkGroupID.y;
    const uint kv_w = arg_u32(4);
    if (i >= kv_w) return;
    const uint pos = arg_u32(5) + r;
    const uint slots = arg_u32(6);
    const uint slot = arg_u32(7) != 0u ? (pos % slots) : pos;
    const uint64_t src_off = (uint64_t(r) * uint64_t(kv_w) + uint64_t(i)) * 4u;
    const uint64_t dst_off = (uint64_t(slot) * uint64_t(kv_w) + uint64_t(i)) * 2u;
    F16(arg(2) + dst_off).v[0] = float16_t(F32(arg(0) + src_off).v[0]);
    F16(arg(3) + dst_off).v[0] = float16_t(F32(arg(1) + src_off).v[0]);
}
#endif

// ---------------------------------------------------------------------------
// 8. Relative-position bias GQA attention with zero sink (no RoPE).
// One subgroup (32 lanes) per (row, query_head), head_dim = 128 (4 vals/lane).
// q: [rows, n_head, 128] f32
// k_cache, v_cache: [slots, n_head_kv, 128] f16
// rel_table: [rows, n_head, extent] f32 (R @ attn_rel_bias)
// sinks: [rows, n_head] f32
// out: [rows, n_head, 128] f32
// Grid: (n_head, rows, 1), 32 threads.
// Buffers: 0 q, 1 k_cache, 2 v_cache, 3 rel_table, 4 sinks, 5 out, 6 gate (optional), 7 q_clip (optional).
// Params: 8 n_head, 9 n_head_kv, 10 pos0, 11 slots, 12 is_swa, 13 window, 14 extent,
//         15 has_gate, 16 has_q_clip, 17 qk_clip, 18 log_floor, 19 log_alpha.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_attn
void main() {
    const uint h = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint lane = gl_SubgroupInvocationID;
    const uint n_head = arg_u32(8);
    const uint n_head_kv = arg_u32(9);
    const uint pos_q = arg_u32(10) + r;
    const uint slots = arg_u32(11);
    const uint is_swa = arg_u32(12);
    const uint window = arg_u32(13);
    const uint extent = arg_u32(14);
    const uint has_gate = arg_u32(15);
    const uint has_q_clip = arg_u32(16);

    const uint kv_h = h / (n_head / n_head_kv);
    const uint64_t q_off = (uint64_t(r) * uint64_t(n_head) + uint64_t(h)) * 128u * 4u;
    vec4 qv = F32x4(arg(0) + q_off).v[lane];
    if (has_q_clip != 0u) {
        qv *= F32x4(arg(7) + uint64_t(h) * 128u * 4u).v[lane];
        const float norm = sqrt(subgroupAdd(dot(qv, qv))) + 1e-6;
        float factor = clamp(arg_f32(17) / norm, 0.0, 1.0);
        const uint log_floor = arg_u32(18);
        const float log_alpha = arg_f32(19);
        if (log_alpha > 0.0 && log_floor > 0u) {
            const float ratio = float(pos_q + 1u) / float(log_floor);
            if (ratio > 1.0) factor *= (1.0 + log_alpha * log(ratio));
        }
        qv *= factor * inversesqrt(128.0);
    } else {
        qv *= inversesqrt(128.0);
    }
    const float sink = F32(arg(4)).v[r * n_head + h];
    const uint64_t rel_row = arg(3) + (uint64_t(r) * uint64_t(n_head) + uint64_t(h)) * uint64_t(extent) * 4u;

    const uint k_start = (is_swa != 0u && pos_q + 1u > window) ? (pos_q + 1u - window) : 0u;
    const uint k_end = pos_q + 1u;
    const uint64_t kv_stride = uint64_t(n_head_kv) * 128u * 2u;
    const uint64_t kv_h_off = uint64_t(kv_h) * 128u * 2u;

    // Implicit zero attention sink: m = 0.0, l = 1.0 (exp(0 - 0) = 1.0).
    float m = 0.0;
    float l = 1.0;
    vec4 acc = vec4(0.0);

    for (uint p = k_start; p < k_end; p++) {
        const uint slot = is_swa != 0u ? (p % slots) : p;
        const uint64_t k_ptr = arg(1) + uint64_t(slot) * kv_stride + kv_h_off + uint64_t(lane) * 8u;
        const uvec2 kp = U32x2(k_ptr).v[0];
        const vec4 kv = vec4(unpackHalf2x16(kp.x), unpackHalf2x16(kp.y));
        const float dot = subgroupAdd(dot(qv, kv));

        const uint dist = pos_q - p;
        const float rb = dist < extent ? F32(rel_row).v[dist] : 0.0;
        const float s = dot + rb - sink;

        const float m_new = max(m, s);
        const float alpha = exp(m - m_new);
        const float beta = exp(s - m_new);
        l = l * alpha + beta;
        m = m_new;

        const uint64_t v_ptr = arg(2) + uint64_t(slot) * kv_stride + kv_h_off + uint64_t(lane) * 8u;
        const uvec2 vp = U32x2(v_ptr).v[0];
        const vec4 vv = vec4(unpackHalf2x16(vp.x), unpackHalf2x16(vp.y));
        acc = acc * alpha + vv * beta;
    }

    vec4 res = acc / l;
    if (has_gate != 0u) {
        const vec4 gv = F32x4(arg(6) + q_off).v[lane];
        res = res / (vec4(1.0) + exp(-gv));
    }
    F32x4(arg(5) + q_off).v[lane] = res;
}
#endif

// ---------------------------------------------------------------------------
// 9. Elementwise helpers: gate_mul (a * sigmoid(g)), add (a + b), softcap.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_gate_mul
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= arg_u32(3)) return;
    const float a = F32(arg(0)).v[i];
    const float g = F32(arg(1)).v[i];
    F32(arg(2)).v[i] = a / (1.0 + exp(-g));
}
#endif

#ifdef KERNEL_inkling2_add
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= arg_u32(3)) return;
    F32(arg(2)).v[i] = F32(arg(0)).v[i] + F32(arg(1)).v[i];
}
#endif

#ifdef KERNEL_inkling2_softcap
void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint cols_out = arg_u32(2);
    const uint r = gl_WorkGroupID.y;
    if (i >= cols_out) return;
    const uint cols_in = arg_u32(3);
    const float cap = arg_f32(4);
    float v = F32(arg(0)).v[r * cols_in + i];
    if (cap > 0.0) v = cap * tanh(v / cap);
    F32(arg(1)).v[r * cols_out + i] = v;
}
#endif

// ---------------------------------------------------------------------------
// 10. Sigmoid top-k MoE router with optional bias and route_scale.
// logits: [rows, E], bias: [E] (0 if unused), out_ids: [rows, K] u32, out_w: [rows, K] f32.
// Grid: (rows, 1, 1), 32 threads (1 subgroup).
// Buffers: 0 logits, 1 bias, 2 out_ids, 3 out_w.
// Params: 4 E (<= 256), 5 K (<= 16), 6 has_bias, 7 route_scale.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_router
void main() {
    const uint r = gl_WorkGroupID.x;
    const uint lane = gl_SubgroupInvocationID;
    const uint E = arg_u32(4);
    const uint K = arg_u32(5);
    const uint has_bias = arg_u32(6);
    const float route_scale = arg_f32(7);
    const uint64_t lrow = arg(0) + uint64_t(r) * uint64_t(E) * 4u;
    const uint64_t bias = arg(1);

    float p[8];
    float s[8];
    [[unroll]] for (uint j = 0u; j < 8u; j++) {
        const uint e = lane + 32u * j;
        if (e < E) {
            const float pr = 1.0 / (1.0 + exp(-F32(lrow).v[e]));
            p[j] = pr;
            s[j] = pr + (has_bias != 0u ? F32(bias).v[e] : 0.0);
        } else {
            p[j] = 0.0;
            s[j] = -1e30;
        }
    }

    uint my_e = 0u;
    float my_w = 0.0;
    float wsum = 0.0;
    for (uint k = 0u; k < K; k++) {
        float best_s = -1e30;
        uint best_e = 0xffffffffu;
        [[unroll]] for (uint j = 0u; j < 8u; j++) {
            if (s[j] > best_s) {
                best_s = s[j];
                best_e = lane + 32u * j;
            }
        }
        const float top = subgroupMax(best_s);
        const uint e = subgroupMin(best_s == top ? best_e : 0xffffffffu);
        float ep = 0.0;
        [[unroll]] for (uint j = 0u; j < 8u; j++) {
            if (lane + 32u * j == e) {
                ep = p[j];
                s[j] = -1e30;
            }
        }
        const float prob_e = subgroupAdd(ep);
        wsum += prob_e;
        if (lane == k) {
            my_e = e;
            my_w = prob_e;
        }
    }

    if (lane < K) {
        const float inv = route_scale / max(wsum, 1e-20);
        U32(arg(2)).v[r * K + lane] = my_e;
        F32(arg(3)).v[r * K + lane] = my_w * inv;
    }
}
#endif

// ---------------------------------------------------------------------------
// 11. SITU activation on fused [rows * K, 2 * ff] -> [rows * K, ff],
// with optional per-expert scale[expert_id].
// Grid: (ceil(ff/256), rows * K, 1), 256 threads.
// Buffers: 0 gate_up, 1 exp_ids, 2 exp_scale (0 if unused), 3 out.
// Params: 4 ff, 5 beta, 6 linear_beta, 7 has_scale.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_situ
void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint rk = gl_WorkGroupID.y;
    const uint ff = arg_u32(4);
    if (i >= ff) return;
    const float beta = arg_f32(5);
    const float lb = arg_f32(6);
    const uint has_scale = arg_u32(7);

    float sc = 1.0;
    if (has_scale != 0u) {
        const uint e = U32(arg(1)).v[rk];
        sc = F32(arg(2)).v[e];
    }
    const uint64_t row = arg(0) + uint64_t(rk) * uint64_t(2u * ff) * 4u;
    const float gate = F32(row).v[i] * sc;
    const float up = F32(row).v[ff + i] * sc;
    const float act = beta * tanh(gate / beta) / (1.0 + exp(-gate));
    const float lin = lb > 0.0 ? lb * tanh(up / lb) : up;
    F32(arg(3)).v[rk * ff + i] = act * lin;
}
#endif

// ---------------------------------------------------------------------------
// 12. MoE weighted sum over K experts, with optional per-expert down_scale.
// in: [rows, K, H], ids: [rows, K] u32, weights: [rows, K] f32, scale: [E] (0 if unused).
// out: [rows, H].
// Grid: (ceil(H/256), rows, 1), 256 threads.
// Buffers: 0 in_buf, 1 ids, 2 weights, 3 scale, 4 out.
// Params: 5 H, 6 K, 7 has_scale.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_moe_sum
shared float ms_ew[16];

void main() {
    const uint i = gl_GlobalInvocationID.x;
    const uint r = gl_WorkGroupID.y;
    const uint H = arg_u32(5);
    const uint K = arg_u32(6);
    const uint has_scale = arg_u32(7);
    if (K <= 16u) {
        if (gl_LocalInvocationIndex < K) {
            const uint rk = r * K + gl_LocalInvocationIndex;
            float w = F32(arg(2)).v[rk];
            if (has_scale != 0u) {
                const uint e = U32(arg(1)).v[rk];
                w *= F32(arg(3)).v[e];
            }
            ms_ew[gl_LocalInvocationIndex] = w;
        }
        barrier();
    }
    if (i >= H) return;
    float acc = 0.0;
    const uint64_t in_base = arg(0) + uint64_t(i) * 4u;
    for (uint k = 0u; k < K; k++) {
        const uint rk = r * K + k;
        float w;
        if (K <= 16u) {
            w = ms_ew[k];
        } else {
            w = F32(arg(2)).v[rk];
            if (has_scale != 0u) {
                const uint e = U32(arg(1)).v[rk];
                w *= F32(arg(3)).v[e];
            }
        }
        acc += w * F32(in_base).v[rk * H];
    }
    F32(arg(4)).v[r * H + i] = acc;
}
#endif

// Fused MoE weighted expert sum + static post-FFN short_conv (+ residual add + optional trace).
// Eliminates `sc.moe_out` DRAM round-trip, 48 dispatches, and 48 barriers on decode/verify!
// Grid: (ceil(H / 32), 1, 1), 32 threads (1 subgroup).
// Buffers: 0 down_out, 1 exp_ids, 2 exp_w, 3 down_scale (opt), 4 conv_w, 5 history, 6 y, 7 trace (opt), 8 res (opt).
// Params: 9 rows, 10 H, 11 K_exp, 12 has_scale, 13 n_conv, 14 has_trace, 15 has_res.
#ifdef KERNEL_inkling2_moe_sum_sconv_4
shared float msc4_ew[64];

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint c = gl_GlobalInvocationID.x;
    const uint rows = arg_u32(9);
    const uint H = arg_u32(10);
    const uint K_exp = arg_u32(11);
    const uint has_scale = arg_u32(12);
    const uint has_trace = arg_u32(14);
    const uint has_res = arg_u32(15);
    const uint rk_tot = rows * K_exp;
    for (uint i = tid; i < rk_tot; i += 32u) {
        float ew = F32(arg(2)).v[i];
        if (has_scale != 0u) ew *= F32(arg(3)).v[U32(arg(1)).v[i]];
        msc4_ew[i] = ew;
    }
    subgroupBarrier();
    if (c >= H) return;

    const uint64_t w_buf = arg(4) + uint64_t(c) * 16u;
    const uint64_t h_buf = arg(5);
    const uint64_t t_buf = arg(7);
    const float scale = inversesqrt(5.0);
    const uint64_t down_base = arg(0) + uint64_t(c) * 4u;

    const vec4 wv = F32x4(w_buf).v[0];
    float r0 = F32(h_buf).v[c];
    float r1 = F32(h_buf).v[H + c];
    float r2 = F32(h_buf).v[2u * H + c];
    if (has_trace != 0u) {
        F32(t_buf).v[c] = r1;
        F32(t_buf).v[H + c] = r2;
    }
    for (uint r = 0u; r < rows; r++) {
        float xr = 0.0;
        if (K_exp == 8u) {
            const uint rk0 = r * 8u;
            [[unroll]] for (uint k = 0u; k < 8u; k++) {
                const uint rk = rk0 + k;
                xr += msc4_ew[rk] * F32(down_base).v[rk * H];
            }
        } else {
            for (uint k = 0u; k < K_exp; k++) {
                const uint rk = r * K_exp + k;
                xr += msc4_ew[rk] * F32(down_base).v[rk * H];
            }
        }
        const float acc = r0 * wv.x + r1 * wv.y + r2 * wv.z + xr * wv.w;
        float out_v = (xr + acc) * scale;
        if (has_res != 0u) out_v += F32(arg(8)).v[r * H + c];
        F32(arg(6)).v[r * H + c] = out_v;
        r0 = r1;
        r1 = r2;
        r2 = xr;
        if (has_trace != 0u) {
            F32(t_buf).v[(2u + r) * H + c] = xr;
        }
    }
    F32(h_buf).v[c] = r0;
    F32(h_buf).v[H + c] = r1;
    F32(h_buf).v[2u * H + c] = r2;
}
#endif

#ifdef KERNEL_inkling2_moe_sum_sconv
shared float msc_ew[64];

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint c = gl_GlobalInvocationID.x;
    const uint rows = arg_u32(9);
    const uint H = arg_u32(10);
    const uint K_exp = arg_u32(11);
    const uint has_scale = arg_u32(12);
    const uint n_conv = arg_u32(13);
    const uint has_trace = arg_u32(14);
    const uint has_res = arg_u32(15);
    const uint rk_tot = rows * K_exp;
    if (rk_tot <= 64u) {
        if (tid < rk_tot) {
            float ew = F32(arg(2)).v[tid];
            if (has_scale != 0u) ew *= F32(arg(3)).v[U32(arg(1)).v[tid]];
            msc_ew[tid] = ew;
        }
        barrier();
    }
    if (c >= H) return;
    const uint hist_len = n_conv - 1u;

    const uint64_t w_buf = arg(4) + uint64_t(c) * uint64_t(n_conv) * 4u;
    const uint64_t h_buf = arg(5);
    const uint64_t t_buf = arg(7);
    const float scale = inversesqrt(float(n_conv + 1u));
    const uint64_t down_base = arg(0) + uint64_t(c) * 4u;

    if (n_conv == 4u && rk_tot <= 64u) {
        const vec4 wv = F32x4(w_buf).v[0];
        float r0 = F32(h_buf).v[c];
        float r1 = F32(h_buf).v[H + c];
        float r2 = F32(h_buf).v[2u * H + c];
        if (has_trace != 0u) {
            F32(t_buf).v[c] = r1;
            F32(t_buf).v[H + c] = r2;
        }
        for (uint r = 0u; r < rows; r++) {
            float xr = 0.0;
            if (K_exp == 8u) {
                const uint rk0 = r * 8u;
                [[unroll]] for (uint k = 0u; k < 8u; k++) {
                    const uint rk = rk0 + k;
                    xr += msc_ew[rk] * F32(down_base).v[rk * H];
                }
            } else {
                for (uint k = 0u; k < K_exp; k++) {
                    const uint rk = r * K_exp + k;
                    xr += msc_ew[rk] * F32(down_base).v[rk * H];
                }
            }
            const float acc = r0 * wv.x + r1 * wv.y + r2 * wv.z + xr * wv.w;
            float out_v = (xr + acc) * scale;
            if (has_res != 0u) out_v += F32(arg(8)).v[r * H + c];
            F32(arg(6)).v[r * H + c] = out_v;
            r0 = r1;
            r1 = r2;
            r2 = xr;
            if (has_trace != 0u) {
                F32(t_buf).v[(2u + r) * H + c] = xr;
            }
        }
        F32(h_buf).v[c] = r0;
        F32(h_buf).v[H + c] = r1;
        F32(h_buf).v[2u * H + c] = r2;
        return;
    }

    float cw[8];
    for (uint k = 0u; k < n_conv; k++) cw[k] = F32(w_buf).v[k];
    float ring[8];
    for (uint k = 0u; k < hist_len; k++) ring[k] = F32(h_buf).v[k * H + c];
    if (has_trace != 0u) {
        for (uint k = 0u; k + 1u < hist_len; k++) F32(t_buf).v[k * H + c] = ring[k + 1u];
    }

    for (uint r = 0u; r < rows; r++) {
        float xr = 0.0;
        for (uint k = 0u; k < K_exp; k++) {
            const uint rk = r * K_exp + k;
            float ew = F32(arg(2)).v[rk];
            if (has_scale != 0u) {
                const uint e = U32(arg(1)).v[rk];
                ew *= F32(arg(3)).v[e];
            }
            xr += ew * F32(down_base).v[rk * H];
        }
        ring[hist_len] = xr;
        float acc = 0.0;
        for (uint k = 0u; k < n_conv; k++) acc += ring[k] * cw[k];
        float out_v = (xr + acc) * scale;
        if (has_res != 0u) out_v += F32(arg(8)).v[r * H + c];
        F32(arg(6)).v[r * H + c] = out_v;

        for (uint k = 0u; k < hist_len; k++) ring[k] = ring[k + 1u];
        if (has_trace != 0u) {
            F32(t_buf).v[(hist_len - 1u + r) * H + c] = xr;
        }
    }
    for (uint k = 0u; k < hist_len; k++) F32(h_buf).v[k * H + c] = ring[k];
}
#endif

// ---------------------------------------------------------------------------
// 13. Embedding gather from any GGML weight type.
// ids: [rows] u32, W: [vocab, H] (GGML), out: [rows, H] f32.
// Grid: (H / 32, rows, 1), 32 threads (1 subgroup decodes one 32-value task).
// Buffers: 0 ids, 1 W, 2 out. Params: 3 H, 4 row_bytes, 5 vocab.
// ---------------------------------------------------------------------------
#if defined(KERNEL_inkling2_embed_q8_0)
