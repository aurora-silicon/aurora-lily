}

void main() {
    const uint li = gl_LocalInvocationIndex;
    const uint rk = gl_WorkGroupID.y;
    const uint ff = arg_u32(5);
    const uint KK = arg_u32(6);
    const uint row_bytes = arg_u32(7);
    const uint K_exp = arg_u32(8);
    if (ff == 0u || KK == 0u) return;
#if defined(KERNEL_inkling2_moe_gu_situ_iq2_xxs)
    gu_iq2xxs_grid[li] = glm53_iq2xxs_grid_h[li] - uvec4(0x0c000c00u);
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_xs)
    gu_iq2xs_p[li] = i2_iq2xs_grid_p[li];
    gu_iq2_4lut[li] = i2_iq2_4lut_entry(li);
#elif defined(KERNEL_inkling2_moe_gu_situ_iq2_s)
    gu_iq2s_p[li] = i2_iq2s_grid_p[li];
    gu_iq2s_p[li + 256u] = i2_iq2s_grid_p[li + 256u];
    gu_iq2_4lut[li] = i2_iq2_4lut_entry(li);
#elif defined(KERNEL_inkling2_moe_gu_situ_iq1_s)
    [[unroll]] for (uint k = 0u; k < 1024u; k += 256u) {
        gu_iq1s_p[k + li] = i2_iq1s_grid_p[k + li];
    }
    gu_iq1_4lut[li] = i2_iq1_4lut_entry(li);
#endif
    barrier();

    // 4 groups of 8 lanes per subgroup, 2 (gate, up) pairs per group = 64 rows/WG:
    // halves WG count and LUT-init barriers while streaming 8 f32 activations at a time.
    const uint pair_in_sg = gl_SubgroupInvocationID >> 3u;
    const uint lane_t = gl_SubgroupInvocationID & 7u;
    if (gl_WorkGroupID.x * 64u + gl_SubgroupID * 8u >= ff) return;
    const uint j0 = gl_WorkGroupID.x * 64u + gl_SubgroupID * 8u + pair_in_sg * 2u;
    const uint j1 = j0 + 1u;
    const uint jr0 = min(j0, ff - 1u);
    const uint jr1 = min(j1, ff - 1u);

    const uint x_idx = rk / K_exp;
    const uint64_t x_row = arg(0) + uint64_t(x_idx) * uint64_t(KK) * 4u;
    const uint e = U32(arg(2)).v[rk];
    const uint64_t w_exp = arg(1) + uint64_t(e) * uint64_t(2u * ff) * uint64_t(row_bytes);
    const uint64_t w_g0 = w_exp + uint64_t(jr0) * uint64_t(row_bytes);
    const uint64_t w_u0 = w_exp + uint64_t(ff + jr0) * uint64_t(row_bytes);
    const uint64_t w_g1 = w_exp + uint64_t(jr1) * uint64_t(row_bytes);
    const uint64_t w_u1 = w_exp + uint64_t(ff + jr1) * uint64_t(row_bytes);
    const uint tasks = KK >> 5u;

    float ag0 = 0.0, au0 = 0.0, ag1 = 0.0, au1 = 0.0;
    for (uint t0 = 0u; t0 < tasks; t0 += 8u) {
        const uint t = t0 + lane_t;
        const uint tr = min(t, tasks - 1u);
        const uint64_t xt = x_row + uint64_t(tr) * 128u;
        float dg0, du0, dg1, du1;
        gu_dot_iq_pair_f32(w_g0, w_u0, tr, xt, dg0, du0);
        gu_dot_iq_pair_f32(w_g1, w_u1, tr, xt, dg1, du1);
        if (t < tasks) {
            ag0 += dg0; au0 += du0;
            ag1 += dg1; au1 += du1;
        }
    }
    ag0 = gu_group_sum8(ag0);
    au0 = gu_group_sum8(au0);
    ag1 = gu_group_sum8(ag1);
    au1 = gu_group_sum8(au1);
    if (lane_t == 0u) {
        const float beta = arg_f32(10);
        const float lb = arg_f32(11);
        const float sc = arg_u32(9) != 0u ? F32(arg(3)).v[e] : 1.0;
        if (j0 < ff) {
            const float g0 = ag0 * sc;
            const float u0 = au0 * sc;
            const float a0 = beta * tanh(g0 / beta) / (1.0 + exp(-g0));
            const float l0 = lb > 0.0 ? lb * tanh(u0 / lb) : u0;
            F32(arg(4)).v[rk * ff + j0] = a0 * l0;
        }
        if (j1 < ff) {
            const float g1 = ag1 * sc;
            const float u1 = au1 * sc;
            const float a1 = beta * tanh(g1 / beta) / (1.0 + exp(-g1));
            const float l1 = lb > 0.0 ? lb * tanh(u1 / lb) : u1;
            F32(arg(4)).v[rk * ff + j1] = a1 * l1;
        }
    }
}
