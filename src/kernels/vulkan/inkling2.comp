        }
        const float res = d * (float(2u * (scb & 0xfu) + 1u) * s0 + float(2u * (scb >> 4u) + 1u) * s1);
        if (r == 0u) out_g = res; else out_u = res;
    }
#elif defined(KERNEL_inkling2_moe_gu_m4_iq1_s)
    const uint64_t bg = row_g + uint64_t(t >> 3u) * 50u;
    const uint64_t bu = row_u + uint64_t(t >> 3u) * 50u;
    const uint ib = t & 7u;
