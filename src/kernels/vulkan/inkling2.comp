// ---------------------------------------------------------------------------
// 19. Expert bucketing for grouped multi-row MoE (prefill & speculative verify).
// Groups `rows_k` routing assignments by expert `e in 0..E` (E <= 256) and
// emits up to M_TILE=4 tiles `(e, start, count, 0)` into `tiles` + total count
// into `n_tiles[0]`. Single workgroup of 256 threads (< 5 us on M4).
// Buffers: 0 exp_ids, 1 sorted_rk, 2 tiles (uvec4), 3 n_tiles (u32[1]).
// Params: 4 rows_k, 5 E.
// ---------------------------------------------------------------------------
#ifdef KERNEL_inkling2_moe_bucket
shared uint bk_counts[256];
shared uint bk_offsets[256];
shared uint bk_tile_offs[256];
shared uint bk_cursor[256];

void main() {
    const uint tid = gl_LocalInvocationIndex;
    const uint rows_k = arg_u32(4);
    const uint E = arg_u32(5);

    if (tid < E) bk_counts[tid] = 0u;
    barrier();

    for (uint i = tid; i < rows_k; i += 256u) {
        const uint e = U32(arg(0)).v[i];
        atomicAdd(bk_counts[e], 1u);
    }
    barrier();

    if (tid == 0u) {
        uint off = 0u;
        uint toff = 0u;
        for (uint e = 0u; e < E; e++) {
            const uint c = bk_counts[e];
            bk_offsets[e] = off;
            bk_cursor[e] = off;
            bk_tile_offs[e] = toff;
            off += c;
            toff += (c + 7u) >> 3u;
        }
        U32(arg(3)).v[0] = toff;
    }
    barrier();

    for (uint i = tid; i < rows_k; i += 256u) {
        const uint e = U32(arg(0)).v[i];
        const uint pos = atomicAdd(bk_cursor[e], 1u);
        U32(arg(1)).v[pos] = i;
    }
    barrier();

    if (tid < E) {
        const uint c = bk_counts[tid];
        const uint base = bk_offsets[tid];
        const uint tbase = bk_tile_offs[tid];
        for (uint off = 0u; off < c; off += 8u) {
            const uint cnt = min(8u, c - off);
            U32x4(arg(2)).v[tbase + (off >> 3u)] = uvec4(tid, base + off, cnt, 0u);
        }
    }
}
#endif

