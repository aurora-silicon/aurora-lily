// Decodes one 16-element NVFP4 sub-block at `qs` (8 bytes, 4-byte aligned)
// into 4 vec4s (w0,w1 = low nibbles 0..7; w2,w3 = high nibbles 8..15).
void i2_nvfp4_decode_sb(uint64_t qs, out vec4 w0, out vec4 w1, out vec4 w2, out vec4 w3) {
    const uvec2 words = U32x2(qs).v[0];
    const vec2 a0 = unpackHalf2x16(i2_nvfp4_byte_h[words.x & 0xffu]);
    const vec2 a1 = unpackHalf2x16(i2_nvfp4_byte_h[(words.x >> 8u) & 0xffu]);
    const vec2 a2 = unpackHalf2x16(i2_nvfp4_byte_h[(words.x >> 16u) & 0xffu]);
    const vec2 a3 = unpackHalf2x16(i2_nvfp4_byte_h[words.x >> 24u]);
    const vec2 b0 = unpackHalf2x16(i2_nvfp4_byte_h[words.y & 0xffu]);
    const vec2 b1 = unpackHalf2x16(i2_nvfp4_byte_h[(words.y >> 8u) & 0xffu]);
    const vec2 b2 = unpackHalf2x16(i2_nvfp4_byte_h[(words.y >> 16u) & 0xffu]);
    const vec2 b3 = unpackHalf2x16(i2_nvfp4_byte_h[words.y >> 24u]);
    w0 = vec4(a0.x, a1.x, a2.x, a3.x);
    w1 = vec4(b0.x, b1.x, b2.x, b3.x);
    w2 = vec4(a0.y, a1.y, a2.y, a3.y);
    w3 = vec4(b0.y, b1.y, b2.y, b3.y);
}

// Fast constant-LUT factored-scale NVFP4 dot product over preloaded xv[8].
float i2_nvfp4_dot_xv(uint64_t row, uint t, in vec4 xv[8]) {
    const uint64_t b = row + uint64_t(t >> 1u) * 36u;
    const uint half_idx = t & 1u;
    const uint sw = U32(b).v[0];
    float acc = 0.0;
    [[unroll]] for (uint sb = 0u; sb < 2u; sb++) {
        const uint s = 2u * half_idx + sb;
        const float d = i2_ue4m3_lut[(sw >> (8u * s)) & 0xffu];
        vec4 w0, w1, w2, w3;
        i2_nvfp4_decode_sb(b + 4u + 8u * s, w0, w1, w2, w3);
        const float sub_s = dot(w0, xv[4u * sb]) + dot(w1, xv[4u * sb + 1u])
                          + dot(w2, xv[4u * sb + 2u]) + dot(w3, xv[4u * sb + 3u]);
        acc += d * sub_s;
    }
    return acc;
}
