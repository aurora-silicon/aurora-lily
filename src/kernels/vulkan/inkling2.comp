            const uint pair = uint(qv0[i]);
            const uvec2 ulo = ds_q2_lut[pair & 0xffu], uhi = ds_q2_lut[pair >> 8u];
            const vec2 a01 = unpackHalf2x16(ulo.x), a23 = unpackHalf2x16(ulo.y);
            const vec2 b01 = unpackHalf2x16(uhi.x), b23 = unpackHalf2x16(uhi.y);
            s0 = fma(a01.x, xa.x, s0); s0 = fma(a01.y, xa.y, s0);
            s0 = fma(a23.x, xa.z, s0); s0 = fma(a23.y, xa.w, s0);
            s0 = fma(b01.x, xb.x, s0); s0 = fma(b01.y, xb.y, s0);
            s0 = fma(b23.x, xb.z, s0); s0 = fma(b23.y, xb.w, s0);
