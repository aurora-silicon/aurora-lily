uvec2 i2_iq2_4lut_entry(uint li) {
    // 0.125 * {8, 25, 43} = {1.0, 3.125, 5.375} = exact FP16 {0x3c00, 0x4240, 0x4560}.
    const uint mag[4] = uint[4](0x3c00u, 0x4240u, 0x4560u, 0x0000u);
    return uvec2(
        mag[li & 3u] | (mag[(li >> 2u) & 3u] << 16u),
        mag[(li >> 4u) & 3u] | (mag[li >> 6u] << 16u)
    );
}
#endif
#if defined(KERNEL_inkling2_moe_gu_situ_iq1_s) || defined(KERNEL_inkling2_moe_gu_m4_iq1_s)
uvec2 i2_iq1_4lut_entry(uint li) {
    // 2-bit signed values {-1, 0, +1} packed as exact FP16 in uvec2 (2 KB shared table).
    return uvec2(
        packHalf2x16(vec2(float(bitfieldExtract(int(li), 0, 2)), float(bitfieldExtract(int(li), 2, 2)))),
        packHalf2x16(vec2(float(bitfieldExtract(int(li), 4, 2)), float(bitfieldExtract(int(li), 6, 2))))
    );
}
#endif
#if defined(KERNEL_inkling2_moe_down_sum_q2_0) || defined(KERNEL_inkling2_moe_down_m4_q2_0)
uvec2 i2_q2_4lut_entry(uint c) {
    // 2-bit codes {0,1,2,3} - 1 = {-1, 0, +1, +2} packed as exact FP16 in uvec2 (2 KB shared table).
    return uvec2(
        packHalf2x16(vec2(float(int((c >> 0u) & 3u) - 1), float(int((c >> 2u) & 3u) - 1))),
        packHalf2x16(vec2(float(int((c >> 4u) & 3u) - 1), float(int((c >> 6u) & 3u) - 1)))
    );
}
#endif
#if defined(KERNEL_inkling2_moe_down_sum_nvfp4) || defined(KERNEL_inkling2_moe_gu_situ_nvfp4) || \
    defined(KERNEL_inkling2_moe_gu_m4_nvfp4) || defined(KERNEL_inkling2_moe_down_m4_nvfp4)
// Pure-ALU branchless SWAR E2M1 pair + UE4M3FN decoder for AoS block_nvfp4:
// zero shared-memory LUT, zero bank conflicts, zero init barrier, bit-exact 2^-14 * 2^+14!
vec2 i2_aos_e2m1_pair(uint p) {
    const uint h2 = ((p & 0x00070007u) << 9u) | ((p & 0x00080008u) << 12u);
    return unpackHalf2x16(h2);
}

float i2_aos_ue4m3_x16k(uint b) {
    b &= 0x7fu;
    const float norm = uintBitsToFloat((b + (134u << 3u)) << 20u);
    const float sub = float(b) * 32.0;
    return (b == 0x7fu) ? 0.0 : ((b < 8u) ? sub : norm);
}

void i2_nvfp4_decode_u1(uint word, out vec4 w_lo, out vec4 w_hi) {
    const vec2 l02 = i2_aos_e2m1_pair(word);
    const vec2 l13 = i2_aos_e2m1_pair(word >> 8u);
    const vec2 h02 = i2_aos_e2m1_pair(word >> 4u);
    const vec2 h13 = i2_aos_e2m1_pair(word >> 12u);
    w_lo = vec4(l02.x, l13.x, l02.y, l13.y);
    w_hi = vec4(h02.x, h13.x, h02.y, h13.y);
}

void i2_nvfp4_decode_u2(uvec2 words, out vec4 w0, out vec4 w1, out vec4 w2, out vec4 w3) {
    i2_nvfp4_decode_u1(words.x, w0, w2);
    i2_nvfp4_decode_u1(words.y, w1, w3);
}

float i2_nvfp4_dot_xv(uint64_t row, uint t, in vec4 xv[8]) {
    const uint64_t b = row + uint64_t(t >> 1u) * 36u;
    const uint half_idx = t & 1u;
    const uint sw = U32(b).v[0];
    const uvec4 q = U32x4(b + 4u + 16u * half_idx).v[0];
    const uint s0 = 2u * half_idx;
    const float d0 = i2_aos_ue4m3_x16k(sw >> (8u * s0));
    const float d1 = i2_aos_ue4m3_x16k(sw >> (8u * (s0 + 1u)));
    vec4 w0, w1, w2, w3;
    i2_nvfp4_decode_u2(q.xy, w0, w1, w2, w3);
    float acc = d0 * (dot(w0, xv[0]) + dot(w1, xv[1]) + dot(w2, xv[2]) + dot(w3, xv[3]));
    i2_nvfp4_decode_u2(q.zw, w0, w1, w2, w3);
    acc += d1 * (dot(w0, xv[4]) + dot(w1, xv[5]) + dot(w2, xv[6]) + dot(w3, xv[7]));
    return acc;
}
