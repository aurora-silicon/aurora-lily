            (signs & 4u) != 0u ? -float((lo >> 16u) & 0xffu) : float((lo >> 16u) & 0xffu),
            (signs & 8u) != 0u ? -float(lo >> 24u) : float(lo >> 24u)
        );
        const vec4 whi = vec4(
            (signs & 16u) != 0u ? -float(hi & 0xffu) : float(hi & 0xffu),
            (signs & 32u) != 0u ? -float((hi >> 8u) & 0xffu) : float((hi >> 8u) & 0xffu),
            (signs & 64u) != 0u ? -float((hi >> 16u) & 0xffu) : float((hi >> 16u) & 0xffu),
            (signs & 128u) != 0u ? -float(hi >> 24u) : float(hi >> 24u)
        );
        for (uint m = 0u; m < cnt; m++) {
            const uint64_t xp = x_rows[m] + toff + 32u * l;
            const float e = dot(wlo, F32x4(xp).v[0]) + dot(whi, F32x4(xp + 16u).v[0]);
            if (l < 2u) s0[m] += e; else s1[m] += e;
        }
    }
    for (uint m = 0u; m < cnt; m++) acc[m] += db0 * s0[m] + db1 * s1[m];
#elif defined(KERNEL_inkling2_moe_gu_m4_iq1_s)
    const uint64_t b = row + uint64_t(t >> 3u) * 50u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint qh = uint(U16(b + 34u).v[ib]);
    const float dl = d * float(2u * ((qh >> 12u) & 7u) + 1u);
    const float delta = (qh & 0x8000u) != 0u ? -0.125 : 0.125;
    const uint qs = uint(U16(b + 2u).v[2u * ib]) | (uint(U16(b + 2u).v[2u * ib + 1u]) << 16u);
    float s[4] = float[4](0.0, 0.0, 0.0, 0.0);
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint idx = ((qs >> (8u * l)) & 0xffu) | (((qh >> (3u * l)) & 7u) << 8u);
