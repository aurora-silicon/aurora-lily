        const uint hi = glm53_iq1s_grid[2u * idx + 1u];
        const vec4 wlo = vec4(
            float(bitfieldExtract(int(lo), 0, 8)) + delta,
            float(bitfieldExtract(int(lo), 8, 8)) + delta,
            float(bitfieldExtract(int(lo), 16, 8)) + delta,
            float(bitfieldExtract(int(lo), 24, 8)) + delta
        );
        const vec4 whi = vec4(
            float(bitfieldExtract(int(hi), 0, 8)) + delta,
            float(bitfieldExtract(int(hi), 8, 8)) + delta,
            float(bitfieldExtract(int(hi), 16, 8)) + delta,
            float(bitfieldExtract(int(hi), 24, 8)) + delta
        );
        for (uint m = 0u; m < cnt; m++) {
            const uint64_t xp = x_rows[m] + toff + 32u * l;
            s[m] += dot(wlo, F32x4(xp).v[0]) + dot(whi, F32x4(xp + 16u).v[0]);
        }
    }
    for (uint m = 0u; m < cnt; m++) acc[m] += dl * s[m];
#else
    float w[32];
    glm53_decode(GUM4_TYPE, row, t, w);
    for (uint m = 0u; m < cnt; m++) acc[m] += glm53_task_dot(w, x_rows[m] + toff);
