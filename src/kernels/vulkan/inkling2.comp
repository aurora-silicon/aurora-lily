#define GLM53_Q8_0 8u
layout(buffer_reference, scalar, buffer_reference_align = 2) readonly buffer Q8Pairs { u16vec4 v[]; };
float i2_q8_dot_xv(uint64_t row, uint t, in vec4 xv[8]) {
    const uint64_t b = row + uint64_t(t) * 34u;
    const float d = unpackHalf2x16(uint(U16(b).v[0])).x;
    vec4 w[8];
    [[unroll]] for (uint h = 0u; h < 4u; h++) {
        const u16vec4 pairs = Q8Pairs(b + 2u).v[h];
        const uint p0 = uint(pairs.x), p1 = uint(pairs.y), p2 = uint(pairs.z), p3 = uint(pairs.w);
        w[2u * h] = vec4(
            float(int(p0 << 24) >> 24), float(int(p0 << 16) >> 24),
            float(int(p1 << 24) >> 24), float(int(p1 << 16) >> 24)
        );
        w[2u * h + 1u] = vec4(
            float(int(p2 << 24) >> 24), float(int(p2 << 16) >> 24),
            float(int(p3 << 24) >> 24), float(int(p3 << 16) >> 24)
        );
    }
    float s = 0.0;
    [[unroll]] for (uint q = 0u; q < 8u; q++) s += dot(w[q], xv[q]);
    return d * s;
}
float i2_q8_dot_ptr(uint64_t row, uint t, uint64_t x) {
    const uint64_t b = row + uint64_t(t) * 34u;
    const float d = unpackHalf2x16(uint(U16(b).v[0])).x;
    vec4 w[8];
    [[unroll]] for (uint h = 0u; h < 4u; h++) {
        const u16vec4 pairs = Q8Pairs(b + 2u).v[h];
        const uint p0 = uint(pairs.x), p1 = uint(pairs.y), p2 = uint(pairs.z), p3 = uint(pairs.w);
        w[2u * h] = vec4(
            float(int(p0 << 24) >> 24), float(int(p0 << 16) >> 24),
            float(int(p1 << 24) >> 24), float(int(p1 << 16) >> 24)
        );
        w[2u * h + 1u] = vec4(
            float(int(p2 << 24) >> 24), float(int(p2 << 16) >> 24),
            float(int(p3 << 24) >> 24), float(int(p3 << 16) >> 24)
        );
    }
    float s = 0.0;
    [[unroll]] for (uint q = 0u; q < 8u; q++) s += dot(w[q], F32x4(x + 16u * q).v[0]);
    return d * s;
}
void i2_q8_decode_raw(uint64_t row, uint t, out float d, out vec4 w[8]) {
    const uint64_t b = row + uint64_t(t) * 34u;
