// Q8_0 blocks are 34 bytes apart. The four pairs in a load can start at
// any two-byte boundary, including the codes immediately after the scale.
layout(buffer_reference, scalar, buffer_reference_align = 2) readonly buffer Q8Pairs { u16vec4 v[]; };
#endif
void main() {
    const uint64_t X = arg(0);
    const uint K = arg_u32(9);
    // The row count is the kernel's (glm53_gemv_<type>_m<rows>): a branch
    // on a runtime count in the loop waits for every load in flight (Q4_K
    // 8192 x 4096 at m = 1: 65 -> 55 us, 2026-11-14).
    const uint m = GEMV_M;
    const uint row_bytes = arg_u32(11);
    const uint x_group = arg_u32(16);
    const uint x_row_stride = arg_u32(17);
    const uint y_stride_param = arg_u32(18);
    const uint tasks = K / GLM53_TASK;
    const uint width = min(tasks, 32u);
    const uint per_sg = 32u / width;
#ifdef GEMV_R2
    const uint rows_per_tg = 16u * per_sg;
#else
    const uint rows_per_tg = 8u * per_sg;
#endif
    // The threadgroup's set.
    uint tg = gl_WorkGroupID.x;
    uint set = 0u;
    uint N = arg_u32(12);
    [[unroll]] for (uint s = 0u; s < 3u; s++) {
        const uint tgs = (N + rows_per_tg - 1u) / rows_per_tg;
        if (set == s && tg >= tgs) {
            tg -= tgs;
            set = s + 1u;
            N = arg_u32(13u + s);
        }
    }
    const uint64_t W = arg(1u + set);
    const uint64_t Y = arg(5u + set);
    const uint y_row_stride = y_stride_param != 0u ? y_stride_param : N;
    const uint lane = gl_SubgroupInvocationID;
#ifdef GEMV_R2
    const uint n = 2u * ((tg * 8u + gl_SubgroupID) * per_sg + lane / width);
    const uint64_t row_b = W + uint64_t(min(n + 1u, N - 1u)) * row_bytes;
    float acc_b = 0.0;
#else
    const uint n = (tg * 8u + gl_SubgroupID) * per_sg + lane / width;
#endif
    const uint sub = lane % width;
    const bool live = n < N;
    const uint64_t row = W + uint64_t(min(n, N - 1u)) * row_bytes;
    const uint g = min(n, N - 1u) / x_group;
    float acc0 = 0.0, acc1 = 0.0, acc2 = 0.0, acc3 = 0.0;
#ifdef GEMV_WIDE
    float acc4 = 0.0, acc5 = 0.0, acc6 = 0.0, acc7 = 0.0;
#endif
#ifdef GEMV_Q8_0
    // Q8_0: the block scale multiplies each row's sum of the task, not
    // every weight; at two rows this kernel is bound by its ALU work (kda_out
    // 4096 x 8192 at m = 2: 102.7 -> 81.0 us, m = 1 unchanged at 71,
    // 2026-11-14).
    for (uint t = sub; t < tasks; t += width) {
        const uint64_t b = row + uint64_t(t) * 34u;
        const float d = glm53_h2f(uint(U16(b).v[0]));
        float w[32];
        [[unroll]] for (uint h = 0u; h < 4u; h++) {
            const u16vec4 pairs = Q8Pairs(b + 2u).v[h];
            [[unroll]] for (uint c = 0u; c < 4u; c++) {
                const uint pair = uint(pairs[c]);
                w[8u * h + 2u * c] = float(int(pair << 24) >> 24);
                w[8u * h + 2u * c + 1u] = float(int(pair << 16) >> 24);
            }
        }
        const uint64_t xt = X + 4u * (uint64_t(g) * K + t * GLM53_TASK);
        acc0 += d * glm53_task_dot(w, xt);
        if (m > 1u) acc1 += d * glm53_task_dot(w, xt + 4u * uint64_t(x_row_stride));
        if (m > 2u) acc2 += d * glm53_task_dot(w, xt + 8u * uint64_t(x_row_stride));
        if (m > 3u) acc3 += d * glm53_task_dot(w, xt + 12u * uint64_t(x_row_stride));
#ifdef GEMV_WIDE
        if (m > 4u) acc4 += d * glm53_task_dot(w, xt + 16u * uint64_t(x_row_stride));
        if (m > 5u) acc5 += d * glm53_task_dot(w, xt + 20u * uint64_t(x_row_stride));
        if (m > 6u) acc6 += d * glm53_task_dot(w, xt + 24u * uint64_t(x_row_stride));
        if (m > 7u) acc7 += d * glm53_task_dot(w, xt + 28u * uint64_t(x_row_stride));
#endif
    }
#elif defined(GEMV_Q5_K)
    // Q5_K (Gemma 4's attention and dense FFN): a sub-block's scale and min
    // multiply its row sums of code times x and of x, not every weight, and
    // the block is read in 16-byte loads (d, dmin and the scales in one;
    // 176-byte blocks are 16-byte aligned in Gemma's rows): the kernel is
    // bound by its loads, one at a time per thread. With one row of x the
    // x loads were 8 of a task's 13: for the LM head two weight rows a
    // subgroup share them (glm53_gemv_q5_k_m1_r2: 262144 x 2816 1253 ->
    // 1100 us; o 2816 x 4096 27.6 -> 32.0, 2026-11-15).
    for (uint t = sub; t < tasks; t += width) {
        float scale, minv;
        float q[32];
        glm53_q5_k_codes(row, t, scale, minv, q);
#ifdef GEMV_R2
        float scale_b, minv_b;
        float q_b[32];
        glm53_q5_k_codes(row_b, t, scale_b, minv_b, q_b);
#endif
        const uint64_t xt = X + 4u * (uint64_t(g) * K + t * GLM53_TASK);
#ifdef GEMV_R2
        const vec3 r2 = glm53_task_dot2_sum(q, q_b, xt);
        acc0 += scale * r2.x - minv * r2.z;
        acc_b += scale_b * r2.y - minv_b * r2.z;
#else
        vec2 r = glm53_task_dot_sum(q, xt);
        acc0 += scale * r.x - minv * r.y;
        if (m > 1u) {
            r = glm53_task_dot_sum(q, xt + 4u * uint64_t(x_row_stride));
            acc1 += scale * r.x - minv * r.y;
        }
        if (m > 2u) {
            r = glm53_task_dot_sum(q, xt + 8u * uint64_t(x_row_stride));
            acc2 += scale * r.x - minv * r.y;
        }
        if (m > 3u) {
            r = glm53_task_dot_sum(q, xt + 12u * uint64_t(x_row_stride));
            acc3 += scale * r.x - minv * r.y;
        }
#endif
    }
#elif defined(GEMV_R2)
    // Two weight rows per subgroup sharing the 8 vec4 activation loads.
    for (uint t = sub; t < tasks; t += width) {
        const uint64_t xt = X + 4u * (uint64_t(g) * K + t * GLM53_TASK);
        vec4 xv[8];
        [[unroll]] for (uint q = 0u; q < 8u; q++) xv[q] = F32x4(xt + 16u * q).v[0];
        float w[32];
        glm53_decode(GEMV_TYPE, row, t, w);
        [[unroll]] for (uint q = 0u; q < 8u; q++) {
            acc0 += dot(vec4(w[4u * q], w[4u * q + 1u], w[4u * q + 2u], w[4u * q + 3u]), xv[q]);
        }
        glm53_decode(GEMV_TYPE, row_b, t, w);
        [[unroll]] for (uint q = 0u; q < 8u; q++) {
            acc_b += dot(vec4(w[4u * q], w[4u * q + 1u], w[4u * q + 2u], w[4u * q + 3u]), xv[q]);
        }
    }
#else
    for (uint t = sub; t < tasks; t += width) {
        float w[32];
        glm53_decode(GEMV_TYPE, row, t, w);
        const uint64_t xt = X + 4u * (uint64_t(g) * K + t * GLM53_TASK);
        acc0 += glm53_task_dot(w, xt);
        if (m > 1u) acc1 += glm53_task_dot(w, xt + 4u * uint64_t(x_row_stride));
        if (m > 2u) acc2 += glm53_task_dot(w, xt + 8u * uint64_t(x_row_stride));
        if (m > 3u) acc3 += glm53_task_dot(w, xt + 12u * uint64_t(x_row_stride));
#ifdef GEMV_WIDE
        if (m > 4u) acc4 += glm53_task_dot(w, xt + 16u * uint64_t(x_row_stride));
        if (m > 5u) acc5 += glm53_task_dot(w, xt + 20u * uint64_t(x_row_stride));
        if (m > 6u) acc6 += glm53_task_dot(w, xt + 24u * uint64_t(x_row_stride));
        if (m > 7u) acc7 += glm53_task_dot(w, xt + 28u * uint64_t(x_row_stride));
#endif
    }
#endif
    acc0 = glm53_group_sum(acc0, width);
#ifdef GEMV_R2
    acc_b = glm53_group_sum(acc_b, width);
    if (n + 1u < N && sub == 0u) F32(Y).v[n + 1u] = acc_b;
#endif
    if (m > 1u) acc1 = glm53_group_sum(acc1, width);
    if (m > 2u) acc2 = glm53_group_sum(acc2, width);
    if (m > 3u) acc3 = glm53_group_sum(acc3, width);
#ifdef GEMV_WIDE
    if (m > 4u) acc4 = glm53_group_sum(acc4, width);
    if (m > 5u) acc5 = glm53_group_sum(acc5, width);
    if (m > 6u) acc6 = glm53_group_sum(acc6, width);
    if (m > 7u) acc7 = glm53_group_sum(acc7, width);
#endif
    if (live && sub == 0u) {
        F32(Y).v[n] = acc0;
        if (m > 1u) F32(Y).v[y_row_stride + n] = acc1;
        if (m > 2u) F32(Y).v[2u * y_row_stride + n] = acc2;
        if (m > 3u) F32(Y).v[3u * y_row_stride + n] = acc3;
#ifdef GEMV_WIDE
        if (m > 4u) F32(Y).v[4u * y_row_stride + n] = acc4;
        if (m > 5u) F32(Y).v[5u * y_row_stride + n] = acc5;
        if (m > 6u) F32(Y).v[6u * y_row_stride + n] = acc6;
        if (m > 7u) F32(Y).v[7u * y_row_stride + n] = acc7;
#endif
    }
}
#endif

// ---------------------------------------------------------------------------
// The Q8_0 GEMV of 1 to 8 activation rows with two weight rows a subgroup
// (DeepSeek V4's decode, verify and draft rows; one row too, so a row's
// values are the same whatever the run): each task's activations are loaded
// once for both weight rows, where glm53_gemv_q8_0_m* loads them once per
// weight row (at six rows the activations are ~24 bytes per weight byte).
// Each output is computed as glm53_gemv_q8_0_m*'s: block scale times the
// task's dot, tasks in the same order, then the subgroup sum (the compiler
// associates each dot differently: equal to rounding). Rows of 1 024 values
// (32 tasks: a lane one task); 16 rows a threadgroup.
// Buffers and params as the GEMV's.
// ---------------------------------------------------------------------------
#if defined(KERNEL_glm53_gemv_q8_0_r2_m1)
#define R2_M 1u
#elif defined(KERNEL_glm53_gemv_q8_0_r2_m2)
#define R2_M 2u
#elif defined(KERNEL_glm53_gemv_q8_0_r2_m3)
#define R2_M 3u
#elif defined(KERNEL_glm53_gemv_q8_0_r2_m4)
#define R2_M 4u
#elif defined(KERNEL_glm53_gemv_q8_0_r2_m5)
#define R2_M 5u
#elif defined(KERNEL_glm53_gemv_q8_0_r2_m6)
#define R2_M 6u
#elif defined(KERNEL_glm53_gemv_q8_0_r2_m7)
#define R2_M 7u
#elif defined(KERNEL_glm53_gemv_q8_0_r2_m8)
#define R2_M 8u
#endif
#ifdef R2_M
void main() {
    const uint64_t X = arg(0);
    const uint K = arg_u32(9);
    const uint row_bytes = arg_u32(11);
    const uint x_group = arg_u32(16);
    const uint x_row_stride = arg_u32(17);
    const uint y_stride_param = arg_u32(18);
    const uint tasks = K / GLM53_TASK;
    uint tg = gl_WorkGroupID.x;
    uint set = 0u;
    uint N = arg_u32(12);
    [[unroll]] for (uint s = 0u; s < 3u; s++) {
        const uint tgs = (N + 15u) / 16u;
        if (set == s && tg >= tgs) {
            tg -= tgs;
            set = s + 1u;
            N = arg_u32(13u + s);
        }
    }
    const uint64_t W = arg(1u + set);
    const uint64_t Y = arg(5u + set);
    const uint y_row_stride = y_stride_param != 0u ? y_stride_param : N;
    const uint lane = gl_SubgroupInvocationID;
    const uint n0 = (tg * 8u + gl_SubgroupID) * 2u;
    if (n0 >= N) return;
    const bool live1 = n0 + 1u < N;
    const uint64_t row0 = W + uint64_t(n0) * row_bytes;
    const uint64_t row1 = W + uint64_t(live1 ? n0 + 1u : n0) * row_bytes;
    const uint g = n0 / x_group;
    float a0[R2_M], a1[R2_M];
    [[unroll]] for (uint r = 0u; r < R2_M; r++) {
        a0[r] = 0.0;
        a1[r] = 0.0;
    }
    for (uint t = lane; t < tasks; t += 32u) {
        const uint64_t b0 = row0 + uint64_t(t) * 34u, b1 = row1 + uint64_t(t) * 34u;
        const float d0 = glm53_h2f(uint(U16(b0).v[0])), d1 = glm53_h2f(uint(U16(b1).v[0]));
        float w0[32], w1[32];
        [[unroll]] for (uint i = 0u; i < 16u; i++) {
            const uint p0 = uint(U16(b0 + 2u).v[i]), p1 = uint(U16(b1 + 2u).v[i]);
            w0[2u * i] = float(int(p0 << 24) >> 24);
            w0[2u * i + 1u] = float(int(p0 << 16) >> 24);
            w1[2u * i] = float(int(p1 << 24) >> 24);
            w1[2u * i + 1u] = float(int(p1 << 16) >> 24);
        }
        const uint64_t xt = X + 4u * (uint64_t(g) * K + t * GLM53_TASK);
        [[unroll]] for (uint r = 0u; r < R2_M; r++) {
            const uint64_t xr = xt + 4u * uint64_t(r) * x_row_stride;
            float s0 = 0.0, s1 = 0.0;
            [[unroll]] for (uint q = 0u; q < 8u; q++) {
                const vec4 v = F32x4(xr + 16u * q).v[0];
                s0 += w0[4u * q] * v.x + w0[4u * q + 1u] * v.y + w0[4u * q + 2u] * v.z + w0[4u * q + 3u] * v.w;
                s1 += w1[4u * q] * v.x + w1[4u * q + 1u] * v.y + w1[4u * q + 2u] * v.z + w1[4u * q + 3u] * v.w;
            }
            a0[r] += d0 * s0;
            a1[r] += d1 * s1;
        }
    }
    [[unroll]] for (uint r = 0u; r < R2_M; r++) {
        a0[r] = subgroupAdd(a0[r]);
        a1[r] = subgroupAdd(a1[r]);
    }
    if (lane == 0u) {
        [[unroll]] for (uint r = 0u; r < R2_M; r++) {
            F32(Y).v[r * y_row_stride + n0] = a0[r];
            if (live1) F32(Y).v[r * y_row_stride + n0 + 1u] = a1[r];
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// Routed experts, gate and up with the clamped SwiGLU: for slot s of row i
// (expert sel[i][s], weight w[i][s]), mid[i * used + s][r] = w * silu(min(g,
// L)) * clamp(u, -L, L), g and u rows r of the expert's gate and up. One
// subgroup per row r. Grid (ceil(F / 8), m * used), 256 threads.
// Buffers: 0 gate experts, 1 up experts, 2 x [m][K], 3 sel u32 [m][used],
// 4 weights f32 [m][used], 5 mid [m * used][F]. Params: 6 K, 7 F,
// 8 row_bytes, 9 used, 10 limit.
// ---------------------------------------------------------------------------
// The routed expert's weighted clamped SwiGLU in one pinned order, the
// prefill path's (glm53_moe_swiglu in glm53_gemm.comp): w ((g u) / (1 +
// 2^(-g log2 e))). Left to the compiler, the same expression was
// reassociated differently in different kernels.
float glm53_moe_act(float g, float u, float limit, float we) {
    if (limit > 1e-6) {
        g = min(g, limit);
        u = clamp(u, -limit, limit);
    }
    precise float gu = g * u;
    precise float e = exp2(-(g * uintBitsToFloat(0x3fb8aa3bu)));
    precise float sv = we * (gu * (1.0 / (1.0 + e)));
    return sv;
}

#if defined(KERNEL_glm53_moe_gate_up_q4_k) || defined(KERNEL_glm53_moe_gate_up_q2_k) || \
    defined(KERNEL_glm53_moe_gate_up_q8_0)
#if defined(KERNEL_glm53_moe_gate_up_q4_k)
#define MOE_TYPE GLM53_Q4_K
#elif defined(KERNEL_glm53_moe_gate_up_q8_0)
#define MOE_TYPE GLM53_Q8_0
#else
#define MOE_TYPE GLM53_Q2_K
#endif
void main() {
    const uint K = arg_u32(6);
    const uint F = arg_u32(7);
    const uint row_bytes = arg_u32(8);
    const uint used = arg_u32(9);
    const float limit = arg_f32(10);
    const uint slot = gl_WorkGroupID.y;
    const uint i = slot / used;
    const uint r = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    if (r >= F) return;
    const uint e = U32(arg(3)).v[slot];
    const float we = F32(arg(4)).v[slot];
    const uint64_t off = (uint64_t(e) * F + r) * row_bytes;
    const uint64_t gate = arg(0) + off;
    const uint64_t up = arg(1) + off;
    const uint64_t X = arg(2) + 4u * uint64_t(i) * K;
    const uint tasks = K / GLM53_TASK;
    float ag = 0.0, au = 0.0;
    for (uint t = gl_SubgroupInvocationID; t < tasks; t += 32u) {
        float w[32];
        glm53_decode(MOE_TYPE, gate, t, w);
        ag += glm53_task_dot(w, X + 128u * t);
        glm53_decode(MOE_TYPE, up, t, w);
        au += glm53_task_dot(w, X + 128u * t);
    }
    ag = subgroupAdd(ag);
    au = subgroupAdd(au);
    if (gl_SubgroupInvocationID == 0u) {
        F32(arg(5)).v[slot * F + r] = glm53_moe_act(ag, au, limit, we);
    }
}
#endif

// The IQ2_XXS form (the model's experts) dots straight from the blocks
// (glm53_dot_iq2_xxs), gate and up sharing each activation load: 163 -> 108
// us a layer on the M5 Max (2026-11-14). Two rows a subgroup (113-121 us)
// and the sign masks computed instead of looked up (112) were slower.
#ifdef KERNEL_glm53_moe_gate_up_iq2_xxs
void main() {
    const uint K = arg_u32(6);
    const uint F = arg_u32(7);
    const uint row_bytes = arg_u32(8);
    const uint used = arg_u32(9);
    const float limit = arg_f32(10);
    const uint slot = gl_WorkGroupID.y;
    const uint i = slot / used;
    const uint r = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    if (r >= F) return;
    const uint e = U32(arg(3)).v[slot];
    const float we = F32(arg(4)).v[slot];
    const uint64_t off = (uint64_t(e) * F + r) * row_bytes;
    const uint64_t gate = arg(0) + off;
    const uint64_t up = arg(1) + off;
    const uint64_t X = arg(2) + 4u * uint64_t(i) * K;
    const uint tasks = K / GLM53_TASK;
    float ag = 0.0, au = 0.0;
    for (uint t = gl_SubgroupInvocationID; t < tasks; t += 32u) {
        vec4 xv[8];
        [[unroll]] for (uint q = 0u; q < 8u; q++) xv[q] = F32x4(X).v[8u * t + q];
        ag += glm53_dot_iq2_xxs(gate, t, xv);
        au += glm53_dot_iq2_xxs(up, t, xv);
    }
    ag = subgroupAdd(ag);
    au = subgroupAdd(au);
    if (gl_SubgroupInvocationID == 0u) {
        F32(arg(5)).v[slot * F + r] = glm53_moe_act(ag, au, limit, we);
    }
}
#endif

// The IQ2_XXS gate/up over activations given as f16 in the dot's pairing
// (DeepSeek V4's decode and verify rows; ds4_x_f16_iq2): of each 8 values,
// word p holds values p and p + 4, so a task's 32 activations are four
// 16-byte loads where f32 takes eight; products and sums as
// glm53_dot_iq2_xxs's, in its order. moe_timing at GLM's shape (8 of 288
// experts, 2048 x 4096): 108.3 -> 91.2 us a layer (2026-11-15); the same
// for the Q2_K down kernel's activations gained nothing (74.4 -> 73.7).
#ifdef KERNEL_glm53_moe_gate_up_iq2_xxs_xh
float glm53_dot_iq2_xxs_xh(uint64_t row, uint t, in uvec4 xh[4]) {
    const uint bw = (t >> 3u) * 33u;
    const uint qw = bw + 1u + 4u * (t & 7u);
    const float d = glm53_h2f(uint(U16(row).v[bw]));
    const uint aux0 = uint(U16(row).v[qw]) | (uint(U16(row).v[qw + 1u]) << 16u);
    const uint aux1 = uint(U16(row).v[qw + 2u]) | (uint(U16(row).v[qw + 3u]) << 16u);
    precise float s = 0.0;
    [[unroll]] for (uint l = 0u; l < 4u; l++) {
        const uint gi = (aux0 >> (8u * l)) & 0xffu;
        const uint si = (aux1 >> (7u * l)) & 127u;
        const uvec4 g = glm53_iq2xxs_grid_h[gi] ^ glm53_iq2xxs_signs_h[si];
        const vec2 p0 = unpackHalf2x16(g.x), p1 = unpackHalf2x16(g.y);
        const vec2 p2 = unpackHalf2x16(g.z), p3 = unpackHalf2x16(g.w);
        const vec2 a0 = unpackHalf2x16(xh[l].x), a1 = unpackHalf2x16(xh[l].y);
        const vec2 a2 = unpackHalf2x16(xh[l].z), a3 = unpackHalf2x16(xh[l].w);
        precise float e = ((p0.x * a0.x + p0.y * a0.y) + (p1.x * a1.x + p1.y * a1.y))
                        + ((p2.x * a2.x + p2.y * a2.y) + (p3.x * a3.x + p3.y * a3.y));
        s += e;
    }
    precise float k = 0.125 * d * float(2u * (aux1 >> 28u) + 1u);
    precise float v = k * s;
    return v;
}
void main() {
    const uint K = arg_u32(6);
    const uint F = arg_u32(7);
    const uint row_bytes = arg_u32(8);
    const uint used = arg_u32(9);
    const float limit = arg_f32(10);
    const uint slot = gl_WorkGroupID.y;
    const uint i = slot / used;
    const uint r = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    if (r >= F) return;
    const uint e = U32(arg(3)).v[slot];
    const float we = F32(arg(4)).v[slot];
    const uint64_t off = (uint64_t(e) * F + r) * row_bytes;
    const uint64_t gate = arg(0) + off;
    const uint64_t up = arg(1) + off;
    U32x4 X = U32x4(arg(2) + 2u * uint64_t(i) * K);
    const uint tasks = K / GLM53_TASK;
    float ag = 0.0, au = 0.0;
    for (uint t = gl_SubgroupInvocationID; t < tasks; t += 32u) {
        uvec4 xh[4];
        [[unroll]] for (uint q = 0u; q < 4u; q++) xh[q] = X.v[4u * t + q];
        ag += glm53_dot_iq2_xxs_xh(gate, t, xh);
        au += glm53_dot_iq2_xxs_xh(up, t, xh);
    }
    ag = subgroupAdd(ag);
    au = subgroupAdd(au);
    if (gl_SubgroupInvocationID == 0u) {
        F32(arg(5)).v[slot * F + r] = glm53_moe_act(ag, au, limit, we);
    }
}
#endif

// Two rows (a verify pass) whose selections share experts: the slot of the
// first row that picked a shared expert computes both rows' values from one
// decode of its weights, the second row's slot of that expert does nothing.
// Each row's value is computed exactly as for that row alone. Consecutive
// tokens share 2 to 3 of their 8 experts on average; a shared expert's
// task costs ~1.85 single ones (the per-row activation loads and products
// dominate, not the weight decode): 200 us a layer with no expert shared,
// 183 with all 8 (moe_rows_timing, 2026-11-14).
#ifdef KERNEL_glm53_moe_gate_up_iq2_xxs_m2
void main() {
    const uint K = arg_u32(6);
    const uint F = arg_u32(7);
    const uint row_bytes = arg_u32(8);
    const uint used = arg_u32(9);
    const float limit = arg_f32(10);
    const uint slot = gl_WorkGroupID.y;
    const uint i = slot / used;
    const uint e = U32(arg(3)).v[slot];
    // The other row's slot of the same expert, if any.
    const uint other = (1u - i) * used;
    uint pair = ~0u;
    for (uint s = 0u; s < used; s++) {
        if (U32(arg(3)).v[other + s] == e) pair = other + s;
    }
    if (i == 1u && pair != ~0u) return;
    const uint r = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    if (r >= F) return;
    const uint64_t off = (uint64_t(e) * F + r) * row_bytes;
    const uint64_t gate = arg(0) + off;
    const uint64_t up = arg(1) + off;
    const uint64_t X = arg(2) + 4u * uint64_t(i) * K;
    const uint tasks = K / GLM53_TASK;
    const uint64_t mid = arg(5);
    if (pair == ~0u) {
        float ag = 0.0, au = 0.0;
        for (uint t = gl_SubgroupInvocationID; t < tasks; t += 32u) {
            vec4 xv[8];
            [[unroll]] for (uint q = 0u; q < 8u; q++) xv[q] = F32x4(X).v[8u * t + q];
            ag += glm53_dot_iq2_xxs(gate, t, xv);
            au += glm53_dot_iq2_xxs(up, t, xv);
        }
        ag = subgroupAdd(ag);
        au = subgroupAdd(au);
        if (gl_SubgroupInvocationID == 0u) {
            F32(mid).v[slot * F + r] =
                glm53_moe_act(ag, au, limit, F32(arg(4)).v[slot]);
        }
        return;
    }
    // Row 0's slot with row 1's slot `pair` of the same expert.
    const uint64_t X1 = X + 4u * uint64_t(K);
    float ag0 = 0.0, au0 = 0.0, ag1 = 0.0, au1 = 0.0;
    for (uint t = gl_SubgroupInvocationID; t < tasks; t += 32u) {
        vec4 xv0[8], xv1[8];
        [[unroll]] for (uint q = 0u; q < 8u; q++) xv0[q] = F32x4(X).v[8u * t + q];
        [[unroll]] for (uint q = 0u; q < 8u; q++) xv1[q] = F32x4(X1).v[8u * t + q];
        vec2 g = glm53_dot2_iq2_xxs(gate, t, xv0, xv1);
        vec2 u = glm53_dot2_iq2_xxs(up, t, xv0, xv1);
        ag0 += g.x;
        ag1 += g.y;
        au0 += u.x;
        au1 += u.y;
    }
    ag0 = subgroupAdd(ag0);
    au0 = subgroupAdd(au0);
    ag1 = subgroupAdd(ag1);
    au1 = subgroupAdd(au1);
    if (gl_SubgroupInvocationID == 0u) {
        F32(mid).v[slot * F + r] = glm53_moe_act(ag0, au0, limit, F32(arg(4)).v[slot]);
        F32(mid).v[pair * F + r] = glm53_moe_act(ag1, au1, limit, F32(arg(4)).v[pair]);
    }
}
#endif

// ---------------------------------------------------------------------------
// Routed experts, down and combine: out[i][r] = sum over the row's slots of
// down[sel[i][s]][r] . mid[i * used + s]. One subgroup per output row.
// Grid (ceil(H / 8), m), 256 threads.
// Buffers: 0 down experts, 1 mid, 2 sel, 3 out [m][H], 4 add [m][H] (read
// when has_add; may be out). Params: 5 F (the down rows' length), 6 H,
// 7 row_bytes, 8 used, 9 has_add.
// ---------------------------------------------------------------------------
#if defined(KERNEL_glm53_moe_down_q4_k) || defined(KERNEL_glm53_moe_down_iq2_xxs) || \
    defined(KERNEL_glm53_moe_down_q8_0)
#if defined(KERNEL_glm53_moe_down_q4_k)
#define MOE_TYPE GLM53_Q4_K
#elif defined(KERNEL_glm53_moe_down_q8_0)
#define MOE_TYPE GLM53_Q8_0
#else
#define MOE_TYPE GLM53_IQ2_XXS
#endif
void main() {
    const uint F = arg_u32(5);
    const uint H = arg_u32(6);
    const uint row_bytes = arg_u32(7);
    const uint used = arg_u32(8);
    const bool has_add = arg_u32(9) != 0u;
    const uint i = gl_WorkGroupID.y;
    const uint r = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    if (r >= H) return;
    const uint tasks = F / GLM53_TASK;
    float acc = 0.0;
    for (uint s = 0u; s < used; s++) {
        const uint slot = i * used + s;
        const uint e = U32(arg(2)).v[slot];
        const uint64_t row = arg(0) + (uint64_t(e) * H + r) * row_bytes;
        const uint64_t X = arg(1) + 4u * uint64_t(slot) * F;
        for (uint t = gl_SubgroupInvocationID; t < tasks; t += 32u) {
            float w[32];
            glm53_decode(MOE_TYPE, row, t, w);
            acc += glm53_task_dot(w, X + 128u * t);
        }
    }
    acc = subgroupAdd(acc);
    if (gl_SubgroupInvocationID == 0u) {
        // The shared expert's output, added after the routed sum as ds4
        // adds them (moe + shared).
        if (has_add) acc = acc + F32(arg(4)).v[i * H + r];
        F32(arg(3)).v[i * H + r] = acc;
    }
}
#endif

// The Q2_K form (the model's experts) dots straight from the blocks. A lane
// takes a unit of 64 values of the row: block u / 4, half h = (u / 2) % 2,
// code bytes 16 c.. of the half (c = u % 2) at their four shifts j, which
// are the 16-value groups 8 h + 2 j + c; the mins multiply the groups'
// activation sums. Codes are extracted and converted in the ALU: a byte
// table of f16 codes was slower (88 us against 72 a layer, 2026-11-14), as
// were two or four rows a subgroup sharing the activation loads (74, 79).
// The Q2_K form (the model's experts) dots straight from the blocks. A lane
// takes a unit of 64 values of the row: block u / 4, half h = (u / 2) % 2,
// code bytes 16 c.. of the half (c = u % 2) at their four shifts j, which
// are the 16-value groups 8 h + 2 j + c; the mins multiply the groups'
// activation sums. Codes are extracted and converted in the ALU: a byte
// table of f16 codes was slower (88 us against 72 a layer, 2026-11-14), as
// were two or four rows a subgroup sharing the activation loads (74, 79).
#ifdef KERNEL_glm53_moe_down_q2_k
void main() {
    const uint F = arg_u32(5);
    const uint H = arg_u32(6);
    const uint row_bytes = arg_u32(7);
    const uint used = arg_u32(8);
    const bool has_add = arg_u32(9) != 0u;
    const uint i = gl_WorkGroupID.y;
    const uint r = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    if (r >= H) return;
    float acc = 0.0;
    for (uint s = 0u; s < used; s++) {
        const uint slot = i * used + s;
        const uint e = U32(arg(2)).v[slot];
        const uint64_t X = arg(1) + 4u * uint64_t(slot) * F;
        const uint64_t row = arg(0) + (uint64_t(e) * H + r) * row_bytes;
        for (uint u = gl_SubgroupInvocationID; u < F / 64u; u += 32u) {
            const uint b = u >> 2u, h = (u >> 1u) & 1u, c = u & 1u;
            const uint xi = 64u * b + 32u * h + 4u * c;
            const uint64_t blk = row + 84u * b;
            const uvec4 qw = U32x4(blk).v[1u + 2u * h + c];
            float sq[4] = float[4](0.0, 0.0, 0.0, 0.0);
            vec4 xs = vec4(0.0);
            [[unroll]] for (uint w = 0u; w < 4u; w++) {
                vec4 xj[4];
                [[unroll]] for (uint j = 0u; j < 4u; j++) xj[j] = F32x4(X).v[xi + 8u * j + w];
                [[unroll]] for (uint j = 0u; j < 4u; j++) {
                    xs[j] += (xj[j].x + xj[j].y) + (xj[j].z + xj[j].w);
                    [[unroll]] for (uint n = 0u; n < 4u; n++)
                        sq[j] += float((qw[w] >> (8u * n + 2u * j)) & 3u) * xj[j][n];
                }
            }
            const uint dd = U32(blk).v[20];
            const float d = glm53_h2f(dd & 0xffffu), dmin = glm53_h2f(dd >> 16u);
            // Scale bytes 8 h + 2 j + c: bytes c and c + 2 of the two words
            // at 8 h.
            const uvec2 sw = U32x2(blk).v[h];
            [[unroll]] for (uint j = 0u; j < 4u; j++) {
                const uint sc = (sw[j >> 1u] >> (8u * (c + 2u * (j & 1u)))) & 0xffu;
                acc += d * float(sc & 0xfu) * sq[j] - dmin * float(sc >> 4u) * xs[j];
            }
        }
    }
    acc = subgroupAdd(acc);
    if (gl_SubgroupInvocationID == 0u) {
        // The shared expert's output, added after the routed sum as ds4 adds
        // them (moe + shared).
        if (has_add) acc = acc + F32(arg(4)).v[i * H + r];
        F32(arg(3)).v[i * H + r] = acc;
    }
}
#endif

// ---------------------------------------------------------------------------
// The router (ds4 layer_glm_router_selected_experts): p = sigmoid(logit),
// select the k largest p + bias (ties to the lower id), weights p / max(sum,
// 2^-14) * scale. One subgroup per row; n_expert <= 384.
// Buffers: 0 logits [m][E], 1 bias [E], 2 sel u32 [m][k], 3 weights [m][k].
// Params: 4 E, 5 k, 6 scale.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_router_topk
void main() {
    const uint E = arg_u32(4);
    const uint k = arg_u32(5);
    const float scale = arg_f32(6);
    const uint i = gl_WorkGroupID.x;
    const uint lane = gl_SubgroupInvocationID;
    const uint64_t L = arg(0) + 4u * uint64_t(i) * E;
    float score[12];
    float prob[12];
    [[unroll]] for (uint j = 0u; j < 12u; j++) {
        const uint e = lane + 32u * j;
        prob[j] = e < E ? 1.0 / (1.0 + exp(-F32(L).v[e])) : 0.0;
        score[j] = e < E ? prob[j] + F32(arg(1)).v[e] : -1.0 / 0.0;
    }
    float sum = 0.0;
    float my_p = 0.0;
    uint my_e = 0u;
    for (uint r = 0u; r < k; r++) {
        float best = -1.0 / 0.0;
        uint best_e = 0xffffffffu;
        [[unroll]] for (uint j = 0u; j < 12u; j++) {
            if (score[j] > best) { best = score[j]; best_e = lane + 32u * j; }
        }
        const float top = subgroupMax(best);
        const uint e = subgroupMin(best == top ? best_e : 0xffffffffu);
        float p = 0.0;
        [[unroll]] for (uint j = 0u; j < 12u; j++) {
            if (lane + 32u * j == e) { p = prob[j]; score[j] = -1.0 / 0.0; }
        }
        p = subgroupMax(p);
        sum += p;
        if (lane == r) { my_p = p; my_e = e; }
    }
    sum = max(sum, 6.103515625e-5);
    if (lane < k) {
        U32(arg(2)).v[i * k + lane] = my_e;
        F32(arg(3)).v[i * k + lane] = my_p / sum * scale;
    }
}
#endif

// ---------------------------------------------------------------------------
// RMSNorm of rows of n f32 values, times w when has_w: out may alias x.
// Grid m, 256 threads. Buffers: 0 x, 1 w, 2 out. Params: 3 n, 4 eps,
// 5 has_w.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_rmsnorm
shared float red[8];
void main() {
    const uint n = arg_u32(3);
    const float eps = arg_f32(4);
    const bool has_w = arg_u32(5) != 0u;
    const uint i = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint64_t X = arg(0) + 4u * uint64_t(i) * n;
    const uint64_t O = arg(2) + 4u * uint64_t(i) * n;
    float ss = 0.0;
    for (uint d = tid; d < n; d += 256u) {
        const float v = F32(X).v[d];
        ss += v * v;
    }
    ss = subgroupAdd(ss);
    if (gl_SubgroupInvocationID == 0u) red[gl_SubgroupID] = ss;
    barrier();
    float total = gl_SubgroupInvocationID < 8u ? red[gl_SubgroupInvocationID] : 0.0;
    total = subgroupAdd(total);
    const float scale = inversesqrt(total / float(n) + eps);
    for (uint d = tid; d < n; d += 256u) {
        const float v = F32(X).v[d] * scale;
        F32(O).v[d] = has_w ? v * F32(arg(1)).v[d] : v;
    }
}
#endif

// ---------------------------------------------------------------------------
// HC pre, after the control projection: the Sinkhorn split of mix (ds4
// hc_split_sinkhorn_one), the weighted sum of the streams and its RMSNorm.
// Grid m, 256 threads. Buffers: 0 mix [m][24], 1 scale [3], 2 base [24],
// 3 H [m][4][hidden], 4 norm w, 5 split out [m][24] (pre, post, comb),
// 6 xn out [m][hidden]. Params: 7 hidden, 8 iters, 9 hc_eps, 10 rms_eps.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_hc_pre
shared float sp[24];
shared float red[8];
void main() {
    const uint hidden = arg_u32(7);
    const uint iters = arg_u32(8);
    const float eps = arg_f32(9);
    const float rms_eps = arg_f32(10);
    const uint i = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    if (tid == 0u) {
        const uint64_t M = arg(0) + 96u * uint64_t(i);
        const float s0 = F32(arg(1)).v[0], s1 = F32(arg(1)).v[1], s2 = F32(arg(1)).v[2];
        float c[16];
        [[unroll]] for (uint h = 0u; h < 4u; h++) {
            sp[h] = 1.0 / (1.0 + exp(-(F32(M).v[h] * s0 + F32(arg(2)).v[h]))) + eps;
            sp[4u + h] = 2.0 / (1.0 + exp(-(F32(M).v[4u + h] * s1 + F32(arg(2)).v[4u + h])));
        }
        [[unroll]] for (uint dst = 0u; dst < 4u; dst++) {
            float row_max = -1.0 / 0.0;
            [[unroll]] for (uint src = 0u; src < 4u; src++) {
                const uint idx = src + 4u * dst;
                c[idx] = F32(M).v[8u + idx] * s2 + F32(arg(2)).v[8u + idx];
                row_max = max(row_max, c[idx]);
            }
            float sum = 0.0;
            [[unroll]] for (uint src = 0u; src < 4u; src++) {
                const uint idx = src + 4u * dst;
                c[idx] = exp(c[idx] - row_max);
                sum += c[idx];
            }
            const float inv = 1.0 / sum;
            [[unroll]] for (uint src = 0u; src < 4u; src++) c[src + 4u * dst] = c[src + 4u * dst] * inv + eps;
        }
        for (uint it = 0u; it < iters; it++) {
            if (it > 0u) {
                [[unroll]] for (uint dst = 0u; dst < 4u; dst++) {
                    const float inv = 1.0 / (c[4u * dst] + c[4u * dst + 1u] + c[4u * dst + 2u] + c[4u * dst + 3u] + eps);
                    [[unroll]] for (uint src = 0u; src < 4u; src++) c[src + 4u * dst] *= inv;
                }
            }
            [[unroll]] for (uint src = 0u; src < 4u; src++) {
                const float inv = 1.0 / (c[src] + c[src + 4u] + c[src + 8u] + c[src + 12u] + eps);
                [[unroll]] for (uint dst = 0u; dst < 4u; dst++) c[src + 4u * dst] *= inv;
            }
        }
        [[unroll]] for (uint j = 0u; j < 16u; j++) sp[8u + j] = c[j];
    }
    barrier();
    if (tid < 24u) F32(arg(5)).v[24u * i + tid] = sp[tid];
    const uint64_t Hs = arg(3) + 16u * uint64_t(i) * hidden;
    const uint64_t O = arg(6) + 4u * uint64_t(i) * hidden;
    const float p0 = sp[0], p1 = sp[1], p2 = sp[2], p3 = sp[3];
    float ss = 0.0;
    for (uint d = tid; d < hidden; d += 256u) {
        const float x = F32(Hs).v[d] * p0 + F32(Hs).v[hidden + d] * p1 +
                        F32(Hs).v[2u * hidden + d] * p2 + F32(Hs).v[3u * hidden + d] * p3;
        F32(O).v[d] = x;
        ss += x * x;
    }
    ss = subgroupAdd(ss);
    if (gl_SubgroupInvocationID == 0u) red[gl_SubgroupID] = ss;
    barrier();
    float total = gl_SubgroupInvocationID < 8u ? red[gl_SubgroupInvocationID] : 0.0;
    total = subgroupAdd(total);
    const float scale = inversesqrt(total / float(hidden) + rms_eps);
    for (uint d = tid; d < hidden; d += 256u) {
        F32(O).v[d] = F32(O).v[d] * scale * F32(arg(4)).v[d];
    }
}
#endif

// ---------------------------------------------------------------------------
// HC post: out[dst][d] = block[d] * post[dst] + sum_src comb[dst + 4 src] *
// H[src][d]. One thread per (d, row); out may alias H.
// Grid::Threads (hidden, m). Buffers: 0 H, 1 block [m][hidden], 2 split
// [m][24], 3 out. Params: 4 hidden.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_hc_post
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint hidden = arg_u32(4);
    const uint d = gl_GlobalInvocationID.x;
    const uint i = gl_GlobalInvocationID.y;
    const uint64_t Hs = arg(0) + 16u * uint64_t(i) * hidden;
    const uint64_t O = arg(3) + 16u * uint64_t(i) * hidden;
    const uint64_t S = arg(2) + 96u * uint64_t(i);
    const float b = F32(arg(1)).v[i * hidden + d];
    const float h0 = F32(Hs).v[d], h1 = F32(Hs).v[hidden + d];
    const float h2 = F32(Hs).v[2u * hidden + d], h3 = F32(Hs).v[3u * hidden + d];
    [[unroll]] for (uint dst = 0u; dst < 4u; dst++) {
        float acc = b * F32(S).v[4u + dst];
        acc += F32(S).v[8u + dst] * h0;
        acc += F32(S).v[8u + dst + 4u] * h1;
        acc += F32(S).v[8u + dst + 8u] * h2;
        acc += F32(S).v[8u + dst + 12u] * h3;
        F32(O).v[dst * hidden + d] = acc;
    }
}
#endif

// ---------------------------------------------------------------------------
// The largest softmax probability of n logits: 1 / sum exp(l - max). One
// threadgroup of 1024 threads (the MTP draft's confidence, read by the host
// to decide whether proposing the draft pays).
// Buffers: 0 logits [n], 1 out f32 [1]. Params: 2 n.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_top_prob
shared float glm53_red[32];
void main() {
    const uint n = arg_u32(2);
    const uint tid = gl_LocalInvocationIndex;
    const uint64_t L = arg(0);
    float mx = -1.0 / 0.0;
    for (uint i = tid; i < n; i += 1024u) mx = max(mx, F32(L).v[i]);
    mx = subgroupMax(mx);
    if (gl_SubgroupInvocationID == 0u) glm53_red[gl_SubgroupID] = mx;
    barrier();
    mx = subgroupMax(glm53_red[gl_SubgroupInvocationID]);
    barrier();
    float sum = 0.0;
    for (uint i = tid; i < n; i += 1024u) sum += exp(F32(L).v[i] - mx);
    sum = subgroupAdd(sum);
    if (gl_SubgroupInvocationID == 0u) glm53_red[gl_SubgroupID] = sum;
    barrier();
    if (gl_SubgroupID == 0u) {
        sum = subgroupAdd(glm53_red[gl_SubgroupInvocationID]);
        if (gl_SubgroupInvocationID == 0u) F32(arg(1)).v[0] = 1.0 / sum;
    }
}
#endif

// ---------------------------------------------------------------------------
// The mean of the four streams (ds4: hc_weighted_sum with weights 1/4).
// Grid::Threads (hidden, m). Buffers: 0 H, 1 out [m][hidden]. Params: 2 hidden.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_hc_mean
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint hidden = arg_u32(2);
    const uint d = gl_GlobalInvocationID.x;
    const uint i = gl_GlobalInvocationID.y;
    const uint64_t Hs = arg(0) + 16u * uint64_t(i) * hidden;
    float acc = 0.0;
    [[unroll]] for (uint h = 0u; h < 4u; h++) acc += F32(Hs).v[h * hidden + d] * 0.25;
    F32(arg(1)).v[i * hidden + d] = acc;
}
#endif

// ---------------------------------------------------------------------------
// Token embedding from a Q8_0 table into all four streams.
// Grid::Threads (hidden, m). Buffers: 0 table, 1 tokens u32 [m], 2 H out.
// Params: 3 hidden, 4 row_bytes.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_embed_q8_0
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint hidden = arg_u32(3);
    const uint row_bytes = arg_u32(4);
    const uint d = gl_GlobalInvocationID.x;
    const uint i = gl_GlobalInvocationID.y;
    const uint tok = U32(arg(1)).v[i];
    const uint64_t b = arg(0) + uint64_t(tok) * row_bytes + 34u * (d / 32u);
    const float v = glm53_h2f(uint(U16(b).v[0])) * float(I8(b + 2u).v[d % 32u]);
    const uint64_t O = arg(2) + 16u * uint64_t(i) * hidden;
    [[unroll]] for (uint h = 0u; h < 4u; h++) F32(O).v[h * hidden + d] = v;
}
#endif

// ---------------------------------------------------------------------------
// Elementwise SwiGLU with GLM's clamp: out[j] = silu(min(g, L)) * clamp(u,
// -L, L). Grid::Threads (n). Buffers: 0 g, 1 u, 2 out. Params: 3 limit.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_swiglu
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const float limit = arg_f32(3);
    const uint j = gl_GlobalInvocationID.x;
    float g = F32(arg(0)).v[j], u = F32(arg(1)).v[j];
    if (limit > 1e-6) {
        g = min(g, limit);
        u = clamp(u, -limit, limit);
    }
    F32(arg(2)).v[j] = g / (1.0 + exp(-g)) * u;
}
#endif

// ---------------------------------------------------------------------------
// out[j] = a[j] + b[j]. Grid::Threads (n). Buffers: 0 a, 1 b, 2 out.
// ---------------------------------------------------------------------------
// Zeroes buffer 0's first 16 * n bytes. Grid::Threads (n). Params: 1 n.
#ifdef KERNEL_glm53_zero
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    U32x4(arg(0)).v[gl_GlobalInvocationID.x] = uvec4(0u);
}
#endif

#ifdef KERNEL_glm53_add
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint j = gl_GlobalInvocationID.x;
    F32(arg(2)).v[j] = F32(arg(0)).v[j] + F32(arg(1)).v[j];
}
#endif

// ---------------------------------------------------------------------------
// KDA, one token per sequence row (port of ds4 kernel_glm53_kda_decode).
// One threadgroup of 128 threads per (row, head): four subgroups update
// four value rows at a time, each lane owning four adjacent key columns.
// Grid (rows, heads). Buffers: 0 q, 1 k, 2 v, 3 raw_gate, 4 raw_beta,
// 5 out_gate, 6 q_conv, 7 k_conv, 8 v_conv, 9 a_log, 10 dt_bias,
// 11 o_norm, 12 conv_state, 13 state, 14 out. Params: 15 n_heads,
// 16 lower_bound, 17 norm_eps.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_kda_decode
shared float sq[128];
shared float sk[128];
shared float sd[128];
shared float sv[128];
shared float so[128];
shared float reduce_q[4];
shared float reduce_k[4];
shared float reduce_o[4];
shared float beta_shared;
void main() {
    const uint D = 128u;
    const uint HISTORY = 3u;
    const uint n_heads = arg_u32(15);
    const float lower_bound = arg_f32(16);
    const float norm_eps = arg_f32(17);
    const uint row = gl_WorkGroupID.x;
    const uint head = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint lane = gl_SubgroupInvocationID;
    const uint sg = gl_SubgroupID;
    const uint projection = n_heads * D;
    const uint channel = head * D + tid;
    const uint64_t input_base = uint64_t(row) * projection + head * D;
    const uint64_t conv_row = arg(12) + 4u * uint64_t(row) * 3u * HISTORY * projection;
    {
        const uint64_t qs = conv_row;
        const uint64_t ks = qs + 4u * HISTORY * projection;
        const uint64_t vs = ks + 4u * HISTORY * projection;
        float q_acc = 0.0, k_acc = 0.0, v_acc = 0.0;
        [[unroll]] for (uint w = 0u; w < HISTORY; w++) {
            q_acc = fma(F32(qs).v[w * projection + channel], F32(arg(6)).v[channel * 4u + w], q_acc);
            k_acc = fma(F32(ks).v[w * projection + channel], F32(arg(7)).v[channel * 4u + w], k_acc);
            v_acc = fma(F32(vs).v[w * projection + channel], F32(arg(8)).v[channel * 4u + w], v_acc);
        }
        const float q_new = F32(arg(0) + 4u * input_base).v[tid];
        const float k_new = F32(arg(1) + 4u * input_base).v[tid];
        const float v_new = F32(arg(2) + 4u * input_base).v[tid];
        q_acc = fma(q_new, F32(arg(6)).v[channel * 4u + 3u], q_acc);
        k_acc = fma(k_new, F32(arg(7)).v[channel * 4u + 3u], k_acc);
        v_acc = fma(v_new, F32(arg(8)).v[channel * 4u + 3u], v_acc);
        F32(qs).v[channel] = F32(qs).v[projection + channel];
        F32(qs).v[projection + channel] = F32(qs).v[2u * projection + channel];
        F32(qs).v[2u * projection + channel] = q_new;
        F32(ks).v[channel] = F32(ks).v[projection + channel];
        F32(ks).v[projection + channel] = F32(ks).v[2u * projection + channel];
        F32(ks).v[2u * projection + channel] = k_new;
        F32(vs).v[channel] = F32(vs).v[projection + channel];
        F32(vs).v[projection + channel] = F32(vs).v[2u * projection + channel];
        F32(vs).v[2u * projection + channel] = v_new;
        sq[tid] = q_acc / (1.0 + exp(-q_acc));
        sk[tid] = k_acc / (1.0 + exp(-k_acc));
        sv[tid] = v_acc / (1.0 + exp(-v_acc));
        const float gate = F32(arg(3) + 4u * input_base).v[tid] + F32(arg(10)).v[channel];
        sd[tid] = exp(lower_bound * (1.0 / (1.0 + exp(-exp(F32(arg(9)).v[head]) * gate))));
    }
    if (tid == 0u) {
        beta_shared = 1.0 / (1.0 + exp(-F32(arg(4)).v[row * n_heads + head]));
    }
    barrier();
    float q_sumsq = subgroupAdd(sq[tid] * sq[tid]);
    float k_sumsq = subgroupAdd(sk[tid] * sk[tid]);
    if (lane == 0u) {
        reduce_q[sg] = q_sumsq;
        reduce_k[sg] = k_sumsq;
    }
    barrier();
    const float q_total = subgroupAdd(lane < 4u ? reduce_q[lane] : 0.0);
    const float k_total = subgroupAdd(lane < 4u ? reduce_k[lane] : 0.0);
    const float q_scale = inversesqrt(q_total + 1.0e-6) * 0.08838834764831845;
    const float k_scale = inversesqrt(k_total + 1.0e-6);
    sq[tid] *= q_scale;
    sk[tid] *= k_scale;
    barrier();
    const uint k0 = lane * 4u;
    const vec4 q4 = vec4(sq[k0], sq[k0 + 1u], sq[k0 + 2u], sq[k0 + 3u]);
    const vec4 k4 = vec4(sk[k0], sk[k0 + 1u], sk[k0 + 2u], sk[k0 + 3u]);
    const vec4 decay4 = vec4(sd[k0], sd[k0 + 1u], sd[k0 + 2u], sd[k0 + 3u]);
    const uint64_t state_head = arg(13) + 4u * ((uint64_t(row) * n_heads + head) * D * D);
    const float beta = beta_shared;
    for (uint value = sg; value < D; value += 4u) {
        const uint64_t hp = state_head + 4u * (uint64_t(value) * D + k0);
        vec4 h = F32x4(hp).v[0] * decay4;
        const float hk = subgroupAdd(dot(h, k4));
        const float delta_v = (sv[value] - hk) * beta;
        h = fma(k4, vec4(delta_v), h);
        F32x4(hp).v[0] = h;
        const float hq = subgroupAdd(dot(h, q4));
        if (lane == 0u) so[value] = hq;
    }
    barrier();
    const float o_sumsq = subgroupAdd(so[tid] * so[tid]);
    if (lane == 0u) reduce_o[sg] = o_sumsq;
    barrier();
    const float o_total = subgroupAdd(lane < 4u ? reduce_o[lane] : 0.0);
    const float o_scale = inversesqrt(o_total / float(D) + norm_eps);
    const float gate = 1.0 / (1.0 + exp(-F32(arg(5) + 4u * input_base).v[tid]));
    F32(arg(14) + 4u * input_base).v[tid] = so[tid] * o_scale * F32(arg(11)).v[tid] * gate;
}
#endif

// ---------------------------------------------------------------------------
// KDA over n_rows consecutive tokens of one sequence (ports of ds4's
// kernel_glm53_kda_prefill_prepare / _recurrence / _output). Prepare runs
// the convolution token by token (one threadgroup of 128 per head), leaving
// silu'd, normalized q and k, silu'd v and the decay in place; the
// recurrence walks the tokens for four value rows per threadgroup; output
// normalizes and gates.
// prepare: Grid (heads, chunks of `chunk` tokens): each threadgroup walks
// its chunk with the conv window in registers (one threadgroup a head
// walking the whole run took 2.0 ms at 1 024 rows; 2026-11-14). Buffers:
// 0 q, 1 k, 2 v, 3 raw_gate (-> decay), 4 q_conv, 5 k_conv, 6 v_conv,
// 7 a_log, 8 dt_bias, 9 conv_state, 10 conv snapshot, 11 edges (chunks
// past the first). Params: 12 n_heads, 13 n_rows, 14 lower_bound,
// 15 snap_row: after that token the conv window is also copied to the
// snapshot (speculative decoding's rollback; ~0u for none), 16 chunk,
// 17 edges used. glm53_kda_chunk_prepare, the same compiled with
// CUMULATIVE, leaves the chunk's cumulative log decay in buffer 3 (the sum
// of lower_bound * sigmoid(..) from the chunk's first token through this
// one) instead of the decay, for glm53_kda_chunk_wy.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_kda_chunk_prepare
#define KERNEL_glm53_kda_prefill_prepare
#define CUMULATIVE
#endif
#ifdef KERNEL_glm53_kda_prefill_prepare
shared float sq[128];
shared float sk[128];
shared float reduce_q[4];
shared float reduce_k[4];
void main() {
    const uint D = 128u;
    const uint HISTORY = 3u;
    const uint n_heads = arg_u32(12);
    const uint n_rows = arg_u32(13);
    const float lower_bound = arg_f32(14);
    const uint snap_row = arg_u32(15);
    const uint chunk = arg_u32(16);
    const bool use_edges = arg_u32(17) != 0u;
    const uint head = gl_WorkGroupID.x;
    const uint c = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint lane = gl_SubgroupInvocationID;
    const uint sg = gl_SubgroupID;
    const uint projection = n_heads * D;
    const uint channel = head * D + tid;
    // The window before the chunk: the conv state for a single chunk, else
    // the edge copy (glm53_kda_prefill_edges; the last chunk rewrites the
    // conv state while the first may still read it).
    const uint64_t win = use_edges ? arg(11) + 4u * uint64_t(c) * 9u * projection : arg(9);
    float wq[3], wk[3], wv[3];
    [[unroll]] for (uint w = 0u; w < HISTORY; w++) {
        wq[w] = F32(win).v[w * projection + channel];
        wk[w] = F32(win).v[(HISTORY + w) * projection + channel];
        wv[w] = F32(win).v[(2u * HISTORY + w) * projection + channel];
    }
    float cq[4], ck[4], cv[4];
    [[unroll]] for (uint w = 0u; w < 4u; w++) {
        cq[w] = F32(arg(4)).v[channel * 4u + w];
        ck[w] = F32(arg(5)).v[channel * 4u + w];
        cv[w] = F32(arg(6)).v[channel * 4u + w];
    }
    const float dt = F32(arg(8)).v[channel];
    const float a = exp(F32(arg(7)).v[head]);
    const uint first = c * chunk;
    const uint last = min(first + chunk, n_rows);
#ifdef CUMULATIVE
    float log_decay = 0.0;
#endif
    for (uint token = first; token < last; token++) {
        const uint64_t index = uint64_t(token) * projection + channel;
        const float q_new = F32(arg(0) + 4u * index).v[0];
        const float k_new = F32(arg(1) + 4u * index).v[0];
        const float v_new = F32(arg(2) + 4u * index).v[0];
        const float raw_gate = F32(arg(3) + 4u * index).v[0];
        float q_acc = 0.0, k_acc = 0.0, v_acc = 0.0;
        [[unroll]] for (uint w = 0u; w < HISTORY; w++) {
            q_acc = fma(wq[w], cq[w], q_acc);
            k_acc = fma(wk[w], ck[w], k_acc);
            v_acc = fma(wv[w], cv[w], v_acc);
        }
        q_acc = fma(q_new, cq[3], q_acc);
        k_acc = fma(k_new, ck[3], k_acc);
        v_acc = fma(v_new, cv[3], v_acc);
        wq[0] = wq[1]; wq[1] = wq[2]; wq[2] = q_new;
        wk[0] = wk[1]; wk[1] = wk[2]; wk[2] = k_new;
        wv[0] = wv[1]; wv[1] = wv[2]; wv[2] = v_new;
        if (token == snap_row) {
            [[unroll]] for (uint w = 0u; w < HISTORY; w++) {
                F32(arg(10)).v[w * projection + channel] = wq[w];
                F32(arg(10)).v[(HISTORY + w) * projection + channel] = wk[w];
                F32(arg(10)).v[(2u * HISTORY + w) * projection + channel] = wv[w];
            }
        }
        sq[tid] = q_acc / (1.0 + exp(-q_acc));
        sk[tid] = k_acc / (1.0 + exp(-k_acc));
        F32(arg(2) + 4u * index).v[0] = v_acc / (1.0 + exp(-v_acc));
        const float gate = raw_gate + dt;
#ifdef CUMULATIVE
        log_decay += lower_bound * (1.0 / (1.0 + exp(-a * gate)));
        F32(arg(3) + 4u * index).v[0] = log_decay;
#else
        F32(arg(3) + 4u * index).v[0] = exp(lower_bound * (1.0 / (1.0 + exp(-a * gate))));
#endif
        barrier();
        const float q_sumsq = subgroupAdd(sq[tid] * sq[tid]);
        const float k_sumsq = subgroupAdd(sk[tid] * sk[tid]);
        if (lane == 0u) {
            reduce_q[sg] = q_sumsq;
            reduce_k[sg] = k_sumsq;
        }
        barrier();
        const float q_total = subgroupAdd(lane < 4u ? reduce_q[lane] : 0.0);
        const float k_total = subgroupAdd(lane < 4u ? reduce_k[lane] : 0.0);
        F32(arg(0) + 4u * index).v[0] = sq[tid] * inversesqrt(q_total + 1.0e-6) * 0.08838834764831845;
        F32(arg(1) + 4u * index).v[0] = sk[tid] * inversesqrt(k_total + 1.0e-6);
        barrier();
    }
    // The run's last chunk leaves the window after its last token.
    if (last == n_rows) {
        [[unroll]] for (uint w = 0u; w < HISTORY; w++) {
            F32(arg(9)).v[w * projection + channel] = wq[w];
            F32(arg(9)).v[(HISTORY + w) * projection + channel] = wk[w];
            F32(arg(9)).v[(2u * HISTORY + w) * projection + channel] = wv[w];
        }
    }
}
#endif

// The conv window before each chunk of glm53_kda_prefill_prepare (which
// overwrites its rows in place), in the conv state's layout: edges[0] is
// the conv state, edges[c][x][w] = x row c * chunk - 3 + w. Grid
// (ceil(9 * projection / 256), chunks), 256 threads. Buffers: 0 q, 1 k, 2 v,
// 3 conv state, 4 edges. Params: 5 projection, 6 chunk. Grid x rounds up.
#ifdef KERNEL_glm53_kda_prefill_edges
void main() {
    const uint projection = arg_u32(5);
    const uint chunk = arg_u32(6);
    const uint c = gl_WorkGroupID.y;
    const uint o = gl_GlobalInvocationID.x; // [x][w][channel]
    if (o >= 9u * projection) return;
    const uint x = o / (3u * projection);
    const uint w = (o / projection) % 3u;
    const uint ch = o % projection;
    const uint64_t src = x == 0u ? arg(0) : x == 1u ? arg(1) : arg(2);
    F32(arg(4)).v[c * 9u * projection + o] =
        c == 0u ? F32(arg(3)).v[o] : F32(src).v[(c * chunk - 3u + w) * projection + ch];
}
#endif

// recurrence: Grid (heads, 32), 128 threads. Buffers: 0 q, 1 k, 2 v,
// 3 decay, 4 raw_beta, 5 state, 6 out, 7 state snapshot (written after
// token snap_row). Params: 8 n_heads, 9 n_rows, 10 snap_row.
#ifdef KERNEL_glm53_kda_prefill_recurrence
void main() {
    const uint D = 128u;
    const uint n_heads = arg_u32(8);
    const uint n_rows = arg_u32(9);
    const uint snap_row = arg_u32(10);
    const uint head = gl_WorkGroupID.x;
    const uint value = gl_WorkGroupID.y * 4u + gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint projection = n_heads * D;
    const uint k0 = lane * 4u;
    const uint64_t sp = arg(5) + 4u * ((uint64_t(head) * D + value) * D + k0);
    vec4 h = F32x4(sp).v[0];
    // Blocks of eight tokens, each block's inputs loaded before its first
    // token is used (a token a loop step waited for its loads every step:
    // 5.5 ms a call at 1 024 rows; 2026-11-14). Rows past n_rows load the
    // last row and are skipped.
    for (uint t0 = 0u; t0 < n_rows; t0 += 8u) {
        vec4 qb[8], kb[8], db[8];
        float vb[8], bb[8];
        [[unroll]] for (uint u = 0u; u < 8u; u++) {
            const uint token = min(t0 + u, n_rows - 1u);
            const uint64_t base = uint64_t(token) * projection + head * D;
            qb[u] = F32x4(arg(0) + 4u * (base + k0)).v[0];
            kb[u] = F32x4(arg(1) + 4u * (base + k0)).v[0];
            db[u] = F32x4(arg(3) + 4u * (base + k0)).v[0];
            vb[u] = F32(arg(2) + 4u * base).v[value];
            bb[u] = F32(arg(4)).v[token * n_heads + head];
        }
        [[unroll]] for (uint u = 0u; u < 8u; u++) {
            const uint token = t0 + u;
            if (token >= n_rows) break;
            const uint64_t base = uint64_t(token) * projection + head * D;
            h *= db[u];
            const float hk = subgroupAdd(dot(h, kb[u]));
            const float beta = 1.0 / (1.0 + exp(-bb[u]));
            const float delta_v = (vb[u] - hk) * beta;
            h = fma(kb[u], vec4(delta_v), h);
            const float result = subgroupAdd(dot(h, qb[u]));
            if (lane == 0u) F32(arg(6) + 4u * base).v[value] = result;
            if (token == snap_row) {
                F32x4(arg(7) + 4u * ((uint64_t(head) * D + value) * D + k0)).v[0] = h;
            }
        }
    }
    F32x4(sp).v[0] = h;
}
#endif

// ---------------------------------------------------------------------------
// KDA over a prompt run in chunks of 32 tokens: the delta rule's chunked
// (WY) form, as Qwen's gdn_chunk_* kernels, with KDA's decay per key and in
// f32 on the ALU. In a chunk (tokens t = 0..31, g_t the chunk's cumulative
// log decay, a vector over keys; S_0 the state [key][value] before it):
//   M[t][s] = sum_k x_t,k k_s,k exp(g_t,k - g_s,k), x = k (s < t), q (s <= t)
//   T = (I + diag(beta) M_kk)^-1,  T' = T diag(beta)
//   Wb = T' (k * exp(g)),  Uv = T' v,  U = Uv - Wb S_0
//   o_t = (q_t * exp(g_t)) S_0 + sum_{s <= t} M_qk[t][s] u_s
//   S_32 = diag(exp(g_31)) S_0 + sum_s (k_s * exp(g_31 - g_s)) u_s^T
// (the recurrence's h_t = d_t h_{t-1} + beta_t k_t (v_t - k_t.d_t h_{t-1})
// unrolled over the chunk). M's sums run as k or q times exp(g - g_r) by
// k times exp(g_r - g), r = token 16: with the decay's log above -5 a token
// no factor passes e^80 (f32 ends at e^88; glm53.rs keeps the bound), and
// each pair's product is the decay between its tokens.
// The prepare stage (cumulative) leaves g in the decay buffer; tokens past
// the run are padded with g's last value and zero q, k, v, beta.
//
// glm53_kda_chunk_wy: Grid (chunks, heads), 128 threads, one chunk of one
// head, in place: q -> q * exp(g), k -> k * exp(g_31 - g), v -> Uv,
// g -> Wb; the scratch gets M_qk (s <= t, else 0) [32][32] and exp(g_31)
// [128] per (chunk, head). Buffers: 0 q, 1 k, 2 v, 3 g, 4 raw beta,
// 5 scratch. Params: 6 n_heads, 7 n_rows.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_kda_chunk_wy
#define KC 32u
// A slice of 32 keys: wy_a[key][p] = (k_t, q_t, k_t+1, q_t+1) exp(g - g_r)
// of tokens t = 2 p, wy_b[key][p] = k_s exp(g_r - g_s) of s = 4 p ..
shared vec4 wy_a[32u * KC / 2u];
shared vec4 wy_b[32u * KC / 4u];
shared vec4 wy_lt[KC * KC / 4u];  // [s][t]: beta_t M_kk[t][s] (s < t), then T'[t][s]
shared float wy_beta[KC];
void main() {
    const uint D = 128u;
    const uint n_heads = arg_u32(6);
    const uint n_rows = arg_u32(7);
    const uint c = gl_WorkGroupID.x, head = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint projection = n_heads * D;
    const uint t0 = c * KC;
    const uint nt = min(KC, n_rows - t0);
    const uint ref = min(16u, nt - 1u);
    // Element (t, key) of the chunk's head block is base + t * projection + key.
    const uint base = t0 * projection + head * D;
    const uint scratch = (c * n_heads + head) * (KC * KC + D);
    if (tid < KC) {
        wy_beta[tid] = tid < nt ? 1.0 / (1.0 + exp(-F32(arg(4)).v[(t0 + tid) * n_heads + head])) : 0.0;
    }
    // M_kk and M_qk over slices of 32 keys: thread (key kl, tokens 8 tq ..)
    // stages a slice's factors, thread (rows 2 pt, 2 pt + 1; columns 4 ps ..)
    // accumulates its block unless the block is wholly above the diagonal.
    // A slice's loads are issued while the one before it multiplies.
    const uint kl = tid & 31u, tq = tid >> 5u;
    const uint pt = tid >> 3u, ps = tid & 7u;
    const bool below = 4u * ps <= 2u * pt + 1u;
    vec4 mk0 = vec4(0.0), mk1 = vec4(0.0), mq0 = vec4(0.0), mq1 = vec4(0.0);
    float gr, gs[8], ks[8], qs[8];
#define WY_LOAD_SLICE(slice)                                                          \
    {                                                                                 \
        const uint key = (slice) + kl;                                                \
        gr = F32(arg(3)).v[base + ref * projection + key];                            \
        [[unroll]] for (uint i = 0u; i < 8u; i++) {                                   \
            const uint at = base + min(8u * tq + i, nt - 1u) * projection + key;      \
            gs[i] = F32(arg(3)).v[at];                                                \
            ks[i] = F32(arg(1)).v[at];                                                \
            qs[i] = F32(arg(0)).v[at];                                                \
        }                                                                             \
    }
    WY_LOAD_SLICE(0u)
    for (uint slice = 0u; slice < D; slice += 32u) {
        {
            float up[8], down[8], kv[8], qv[8];
            [[unroll]] for (uint i = 0u; i < 8u; i++) {
                const bool real = 8u * tq + i < nt;
                kv[i] = real ? ks[i] : 0.0;
                qv[i] = real ? qs[i] : 0.0;
                up[i] = exp(gs[i] - gr);
                down[i] = exp(gr - gs[i]);
            }
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                wy_a[kl * (KC / 2u) + 4u * tq + i] =
                    vec4(kv[2u * i], qv[2u * i], kv[2u * i + 1u], qv[2u * i + 1u])
                    * vec4(up[2u * i], up[2u * i], up[2u * i + 1u], up[2u * i + 1u]);
            }
            [[unroll]] for (uint i = 0u; i < 2u; i++) {
                wy_b[kl * (KC / 4u) + 2u * tq + i] =
                    vec4(kv[4u * i], kv[4u * i + 1u], kv[4u * i + 2u], kv[4u * i + 3u])
                    * vec4(down[4u * i], down[4u * i + 1u], down[4u * i + 2u], down[4u * i + 3u]);
            }
        }
        barrier();
        if (slice + 32u < D) WY_LOAD_SLICE(slice + 32u)
        if (below) {
            for (uint j = 0u; j < 32u; j += 4u) {
                vec4 a[4], b[4];
                [[unroll]] for (uint u = 0u; u < 4u; u++) {
                    a[u] = wy_a[(j + u) * (KC / 2u) + pt];
                    b[u] = wy_b[(j + u) * (KC / 4u) + ps];
                }
                [[unroll]] for (uint u = 0u; u < 4u; u++) {
                    mk0 = fma(vec4(a[u].x), b[u], mk0);
                    mq0 = fma(vec4(a[u].y), b[u], mq0);
                    mk1 = fma(vec4(a[u].z), b[u], mk1);
                    mq1 = fma(vec4(a[u].w), b[u], mq1);
                }
            }
        }
        barrier();
    }
#undef WY_LOAD_SLICE
    [[unroll]] for (uint h = 0u; h < 2u; h++) {
        const uint t = 2u * pt + h;
        const vec4 mk = h == 0u ? mk0 : mk1, mq = h == 0u ? mq0 : mq1;
        vec4 pq;
        [[unroll]] for (uint j = 0u; j < 4u; j++) {
            const uint s = 4u * ps + j;
            // L transposed: column s of L is row s of wy_lt.
            const float l = s < t ? wy_beta[t] * mk[j] : 0.0;
            wy_lt[s * (KC / 4u) + t / 4u][t & 3u] = l;
            pq[j] = s <= t ? mq[j] : 0.0;
        }
        F32x4(arg(5)).v[(scratch + t * KC + 4u * ps) / 4u] = pq;
    }
    barrier();
    // T = (I + L)^-1 by forward substitution, a column a thread, each solved
    // row's multiple of its column of L added to the rows below it.
    float x[KC];
    if (tid < KC) {
        float acc[KC];
        [[unroll]] for (uint i = 0u; i < KC; i++) acc[i] = 0.0;
        [[unroll]] for (uint j = 0u; j < KC; j++) {
            x[j] = j == tid ? 1.0 : (j < tid ? 0.0 : -acc[j]);
            [[unroll]] for (uint q = (j + 1u) / 4u; q < KC / 4u; q++) {
                const vec4 l = wy_lt[j * (KC / 4u) + q];
                [[unroll]] for (uint e = 0u; e < 4u; e++) {
                    if (4u * q + e > j) acc[4u * q + e] = fma(l[e], x[j], acc[4u * q + e]);
                }
            }
        }
    }
    barrier();
    if (tid < KC) {
        // Row s = tid of wy_lt becomes column s of T' = T diag(beta).
        const float bc = wy_beta[tid];
        [[unroll]] for (uint q = 0u; q < KC / 4u; q++) {
            wy_lt[tid * (KC / 4u) + q] = vec4(x[4u * q], x[4u * q + 1u], x[4u * q + 2u], x[4u * q + 3u]) * bc;
        }
    }
    barrier();
    // Wb = T' (k exp(g)) and Uv = T' v: thread (keys 4 kq .., rows 8 tq ..),
    // T' lower triangular (its rows above s are 0 in wy_lt's row s). Then,
    // once every thread has read the chunk, each writes its rows in place:
    // Wb over g, Uv over v, q exp(g) over q, k exp(g_31 - g) over k.
    {
        const uint kq = tid & 31u;
        const uint col = base + 4u * kq;
        vec4 aw[8], au[8];
        [[unroll]] for (uint r = 0u; r < 8u; r++) {
            aw[r] = vec4(0.0);
            au[r] = vec4(0.0);
        }
        const vec4 glast = F32x4(arg(3)).v[(col + (nt - 1u) * projection) / 4u];
        for (uint s = 0u; s < KC; s++) {
            const uint at = (col + min(s, nt - 1u) * projection) / 4u;
            const vec4 g = F32x4(arg(3)).v[at], k = F32x4(arg(1)).v[at], v = F32x4(arg(2)).v[at];
            const vec4 t0 = wy_lt[s * (KC / 4u) + 2u * tq], t1 = wy_lt[s * (KC / 4u) + 2u * tq + 1u];
            const vec4 b = s < nt ? k * exp(g) : vec4(0.0);
            const vec4 vv = s < nt ? v : vec4(0.0);
            [[unroll]] for (uint r = 0u; r < 4u; r++) {
                aw[r] = fma(vec4(t0[r]), b, aw[r]);
                au[r] = fma(vec4(t0[r]), vv, au[r]);
                aw[4u + r] = fma(vec4(t1[r]), b, aw[4u + r]);
                au[4u + r] = fma(vec4(t1[r]), vv, au[4u + r]);
            }
        }
        barrier();
        [[unroll]] for (uint r = 0u; r < 8u; r++) {
            const uint t = 8u * tq + r;
            if (t < nt) {
                const uint at = (col + t * projection) / 4u;
                const vec4 g = F32x4(arg(3)).v[at], q = F32x4(arg(0)).v[at], k = F32x4(arg(1)).v[at];
                F32x4(arg(3)).v[at] = aw[r];
                F32x4(arg(2)).v[at] = au[r];
                F32x4(arg(0)).v[at] = q * exp(g);
                F32x4(arg(1)).v[at] = k * exp(glast - g);
            }
        }
        if (tq == 0u) F32x4(arg(5)).v[(scratch + KC * KC) / 4u + kq] = exp(glast);
    }
}
#endif

// glm53_kda_chunk_scan: Grid (128 / 32 value blocks, heads), 128 threads:
// the chunks in order for 32 value columns of one head, the f32 state block
// [128 keys][32 values] in registers (thread: keys 8 kq .., values 4 vq ..)
// and its copy in threadgroup memory. Buffers: 0 q (q exp(g)), 1 k
// (k exp(g_31 - g)), 2 Uv, 3 Wb, 4 scratch, 5 state [heads][value][key],
// 6 out (pre-norm o). Params: 7 n_heads, 8 n_rows.
#ifdef KERNEL_glm53_kda_chunk_scan
#define KC 32u
#define NB 32u
shared vec4 sc_s[128u * NB / 4u];  // S_0 [key][value]
shared vec4 sc_u[KC * NB / 4u];    // U [t][value]
void main() {
    const uint D = 128u;
    const uint n_heads = arg_u32(7);
    const uint n_rows = arg_u32(8);
    const uint v0 = gl_WorkGroupID.x * NB, head = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint projection = n_heads * D;
    const uint kq = tid >> 3u, vq = tid & 7u;
    // The chunk products: thread (rows 2 kq, 2 kq + 1; values 4 vq ..).
    const uint ta = 2u * kq, tb = 2u * kq + 1u;
    const uint64_t st = arg(5) + 4u * (uint64_t(head) * D * D);
    vec4 s_reg[8];
    [[unroll]] for (uint j = 0u; j < 4u; j++) {
        const uint value = v0 + 4u * vq + j;
        const vec4 a = F32x4(st).v[(value * D + 8u * kq) / 4u];
        const vec4 b = F32x4(st).v[(value * D + 8u * kq) / 4u + 1u];
        [[unroll]] for (uint i = 0u; i < 4u; i++) {
            s_reg[i][j] = a[i];
            s_reg[4u + i][j] = b[i];
        }
    }
    [[unroll]] for (uint i = 0u; i < 8u; i++) sc_s[(8u * kq + i) * (NB / 4u) + vq] = s_reg[i];
    barrier();
    for (uint t0 = 0u; t0 < n_rows; t0 += KC) {
        const uint nt = min(KC, n_rows - t0);
        const uint base = t0 * projection + head * D;
        const uint scratch = ((t0 / KC) * n_heads + head) * (KC * KC + D);
        const uint ra = base + min(ta, nt - 1u) * projection;
        const uint rb = base + min(tb, nt - 1u) * projection;
        // Wb S_0 and (q exp(g)) S_0.
        vec4 ua = vec4(0.0), ub = vec4(0.0), oa = vec4(0.0), ob = vec4(0.0);
        for (uint k = 0u; k < D; k += 4u) {
            const vec4 wa = F32x4(arg(3)).v[(ra + k) / 4u], wb = F32x4(arg(3)).v[(rb + k) / 4u];
            const vec4 qa = F32x4(arg(0)).v[(ra + k) / 4u], qb = F32x4(arg(0)).v[(rb + k) / 4u];
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                const vec4 s = sc_s[(k + i) * (NB / 4u) + vq];
                ua = fma(vec4(wa[i]), s, ua);
                ub = fma(vec4(wb[i]), s, ub);
                oa = fma(vec4(qa[i]), s, oa);
                ob = fma(vec4(qb[i]), s, ob);
            }
        }
        const vec4 uva = F32x4(arg(2)).v[(ra + v0) / 4u + vq];
        const vec4 uvb = F32x4(arg(2)).v[(rb + v0) / 4u + vq];
        sc_u[ta * (NB / 4u) + vq] = ta < nt ? uva - ua : vec4(0.0);
        sc_u[tb * (NB / 4u) + vq] = tb < nt ? uvb - ub : vec4(0.0);
        barrier();
        // o += M_qk U.
        for (uint s = 0u; s < KC; s += 4u) {
            const vec4 pa = F32x4(arg(4)).v[(scratch + ta * KC + s) / 4u];
            const vec4 pb = F32x4(arg(4)).v[(scratch + tb * KC + s) / 4u];
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                const vec4 u = sc_u[(s + i) * (NB / 4u) + vq];
                oa = fma(vec4(pa[i]), u, oa);
                ob = fma(vec4(pb[i]), u, ob);
            }
        }
        if (ta < nt) F32x4(arg(6)).v[(ra + v0) / 4u + vq] = oa;
        if (tb < nt) F32x4(arg(6)).v[(rb + v0) / 4u + vq] = ob;
        // S = diag(exp(g_31)) S_0 + (k exp(g_31 - g))^T U.
        const vec4 ga = F32x4(arg(4)).v[(scratch + KC * KC + 8u * kq) / 4u];
        const vec4 gb = F32x4(arg(4)).v[(scratch + KC * KC + 8u * kq) / 4u + 1u];
        [[unroll]] for (uint i = 0u; i < 4u; i++) {
            s_reg[i] *= ga[i];
            s_reg[4u + i] *= gb[i];
        }
        for (uint s = 0u; s < KC; s++) {
            const uint rs = (base + min(s, nt - 1u) * projection + 8u * kq) / 4u;
            const vec4 ka = F32x4(arg(1)).v[rs], kb = F32x4(arg(1)).v[rs + 1u];
            const vec4 u = sc_u[s * (NB / 4u) + vq];
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                s_reg[i] = fma(vec4(ka[i]), u, s_reg[i]);
                s_reg[4u + i] = fma(vec4(kb[i]), u, s_reg[4u + i]);
            }
        }
        [[unroll]] for (uint i = 0u; i < 8u; i++) sc_s[(8u * kq + i) * (NB / 4u) + vq] = s_reg[i];
        barrier();
    }
    [[unroll]] for (uint j = 0u; j < 4u; j++) {
        const uint value = v0 + 4u * vq + j;
        vec4 a, b;
        [[unroll]] for (uint i = 0u; i < 4u; i++) {
            a[i] = s_reg[i][j];
            b[i] = s_reg[4u + i][j];
        }
        F32x4(st).v[(value * D + 8u * kq) / 4u] = a;
        F32x4(st).v[(value * D + 8u * kq) / 4u + 1u] = b;
    }
}
#endif

// output: Grid (n_rows, heads), 128 threads. Buffers: 0 out (in place),
// 1 out_gate, 2 o_norm. Params: 3 n_heads, 4 norm_eps.
#ifdef KERNEL_glm53_kda_prefill_output
shared float partial[4];
void main() {
    const uint D = 128u;
    const uint n_heads = arg_u32(3);
    const float norm_eps = arg_f32(4);
    const uint token = gl_WorkGroupID.x;
    const uint head = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint lane = gl_SubgroupInvocationID;
    const uint64_t base = uint64_t(token) * n_heads * D + head * D;
    const float raw = F32(arg(0) + 4u * base).v[tid];
    const float sumsq = subgroupAdd(raw * raw);
    if (lane == 0u) partial[gl_SubgroupID] = sumsq;
    barrier();
    const float total = subgroupAdd(lane < 4u ? partial[lane] : 0.0);
    const float scale = inversesqrt(total / float(D) + norm_eps);
    F32(arg(0) + 4u * base).v[tid] =
        raw * scale * F32(arg(2)).v[tid] / (1.0 + exp(-F32(arg(1) + 4u * base).v[tid]));
}
#endif

// ---------------------------------------------------------------------------
// DSA latent store: kv = rmsnorm(kv_raw, w) of each of m rows, stored as f16
// at cache rows pos0 + i. Grid m, 128 threads. Buffers: 0 kv_raw [m][512],
// 1 w, 2 cache f16 [cap][512]. Params: 3 pos0, 4 eps.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_kv_store
shared float red[4];
void main() {
    const uint pos0 = arg_u32(3);
    const float eps = arg_f32(4);
    const uint i = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint64_t X = arg(0) + 4u * 512u * uint64_t(i);
    const vec4 v = F32x4(X).v[tid];
    const float ss = subgroupAdd(dot(v, v));
    if (gl_SubgroupInvocationID == 0u) red[gl_SubgroupID] = ss;
    barrier();
    const float total = subgroupAdd(gl_SubgroupInvocationID < 4u ? red[gl_SubgroupInvocationID] : 0.0);
    const float scale = inversesqrt(total / 512.0 + eps);
    const vec4 w = F32x4(arg(1)).v[tid];
    const uint64_t C = arg(2) + 2u * 512u * uint64_t(pos0 + i);
    [[unroll]] for (uint c = 0u; c < 4u; c++) F16(C).v[4u * tid + c] = float16_t(v[c] * scale * w[c]);
}
#endif

// ---------------------------------------------------------------------------
// DSA softmax in place over a head's S scores (-inf entries weigh 0); the
// denominator (floored at 1e-20) goes to denom. Grid (64, m), 256 threads.
// Buffers: 0 scores, 1 denom [m][64]. Params: 2 S.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_dsa_softmax
shared float red[8];
void main() {
    const uint S = arg_u32(2);
    const uint h = gl_WorkGroupID.x;
    const uint i = gl_WorkGroupID.y;
    const uint tid = gl_LocalInvocationIndex;
    const uint64_t P = arg(0) + 4u * (uint64_t(i) * 64u + h) * S;
    float mx = -1.0 / 0.0;
    for (uint s = tid; s < S; s += 256u) mx = max(mx, F32(P).v[s]);
    mx = subgroupMax(mx);
    if (gl_SubgroupInvocationID == 0u) red[gl_SubgroupID] = mx;
    barrier();
    mx = subgroupMax(gl_SubgroupInvocationID < 8u ? red[gl_SubgroupInvocationID] : -1.0 / 0.0);
    barrier();
    float sum = 0.0;
    for (uint s = tid; s < S; s += 256u) {
        const float w = exp(F32(P).v[s] - mx);
        F32(P).v[s] = w;
        sum += w;
    }
    sum = subgroupAdd(sum);
    if (gl_SubgroupInvocationID == 0u) red[gl_SubgroupID] = sum;
    barrier();
    sum = subgroupAdd(gl_SubgroupInvocationID < 8u ? red[gl_SubgroupInvocationID] : 0.0);
    if (tid == 0u) F32(arg(1)).v[i * 64u + h] = max(sum, 1.0e-20);
}
#endif

// ---------------------------------------------------------------------------
// DSA scores over cache rows: scores[i][h][s] = qk_low[i][h] . cache[row]
// * scale for s < count_i, where row = sel ? sel[i][s] : s, count_i = sel ?
// n_sel : pos0 + i + 1 (causal dense), and -inf past count_i (or where
// row is 0xffffffff) up to S. A threadgroup computes 64 heads x 32 slots
// of one query row, the 512 latent values in steps of 32 through
// threadgroup memory (q as f32, the f16 latent rows widened), the next
// step's loads issued before the current step's products. Thread t: heads
// 2 (t / 8), + 1, slots 4 (t % 8) .. + 3. (One head a thread with eight
// rows staged waited for q at each of its 128 steps: 90 us a call at 256
// rows, 141 -> 47 us for the three DSA kernels; 2026-11-14.)
// Grid (S / 32, m), 256 threads. Buffers: 0 qk_low [m][64][512], 1 cache,
// 2 sel u32 [m][S] (ignored when has_sel is 0), 3 scores [m][64][S].
// Params: 4 S, 5 pos0, 6 has_sel, 7 n_sel, 8 scale.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_dsa_scores
shared vec4 qs[64 * 9];   // [head][8 vec4 of k] + 1 vec4 pad
shared vec4 ks[32 * 9];   // [slot][8 vec4 of k] + 1 vec4 pad
shared uint rows_sh[32];
void main() {
    const uint S = arg_u32(4);
    const uint pos0 = arg_u32(5);
    const bool has_sel = arg_u32(6) != 0u;
    const uint n_sel = arg_u32(7);
    const float scale = arg_f32(8);
    const uint i = gl_WorkGroupID.y;
    const uint s0 = gl_WorkGroupID.x * 32u;
    const uint tid = gl_LocalInvocationIndex;
    const uint count = min(S, has_sel ? n_sel : pos0 + i + 1u);
    if (tid < 32u) {
        const uint s = s0 + tid;
        uint row = 0xffffffffu;
        if (s < count) row = has_sel ? U32(arg(2)).v[i * S + s] : s;
        rows_sh[tid] = row;
    }
    barrier();
    // Loaders: q head t / 4, values 8 (t % 4) .. + 7; latent slot t / 8,
    // values 4 (t % 8) .. + 3.
    const uint qh = tid >> 2u, qp = tid & 3u;
    const uint ksl = tid >> 3u, kp = tid & 7u;
    const uint krow = rows_sh[ksl];
    const bool klive = krow != 0xffffffffu;
    const uint64_t Q = arg(0) + 4u * ((uint64_t(i) * 64u + qh) * 512u + 8u * qp);
    const uint64_t K = arg(1) + 1024u * uint64_t(klive ? krow : 0u) + 8u * kp;
    vec4 qa = F32x4(Q).v[0], qb = F32x4(Q + 16u).v[0];
    uvec2 kr = U32x2(K).v[0];
    const uint hp = tid >> 3u, sg = tid & 7u;
    vec4 acc0 = vec4(0.0), acc1 = vec4(0.0);
    for (uint kb = 0u; kb < 512u; kb += 32u) {
        barrier();
        qs[qh * 9u + 2u * qp] = qa;
        qs[qh * 9u + 2u * qp + 1u] = qb;
        ks[ksl * 9u + kp] = klive ? vec4(unpackHalf2x16(kr.x), unpackHalf2x16(kr.y)) : vec4(0.0);
        barrier();
        // The next step's loads (the last step reloads its own).
        const uint nb = min(kb + 32u, 480u);
        qa = F32x4(Q + 4u * nb).v[0];
        qb = F32x4(Q + 4u * nb + 16u).v[0];
        kr = U32x2(K + 2u * nb).v[0];
        [[unroll]] for (uint kq = 0u; kq < 8u; kq++) {
            const vec4 a0 = qs[(2u * hp) * 9u + kq], a1 = qs[(2u * hp + 1u) * 9u + kq];
            const vec4 b0 = ks[(4u * sg) * 9u + kq], b1 = ks[(4u * sg + 1u) * 9u + kq];
            const vec4 b2 = ks[(4u * sg + 2u) * 9u + kq], b3 = ks[(4u * sg + 3u) * 9u + kq];
            acc0 += vec4(dot(a0, b0), dot(a0, b1), dot(a0, b2), dot(a0, b3));
            acc1 += vec4(dot(a1, b0), dot(a1, b1), dot(a1, b2), dot(a1, b3));
        }
    }
    [[unroll]] for (uint u = 0u; u < 4u; u++) {
        const uint sl = 4u * sg + u;
        const uint s = s0 + sl;
        const bool live = rows_sh[sl] != 0xffffffffu;
        if (s < S) {
            F32(arg(3)).v[(i * 64u + 2u * hp) * S + s] = live ? acc0[u] * scale : -1.0 / 0.0;
            F32(arg(3)).v[(i * 64u + 2u * hp + 1u) * S + s] = live ? acc1[u] * scale : -1.0 / 0.0;
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// DSA latent mix: lat[i][h][j] = sum_s w[i][h][s] * cache[row(s)][j] /
// denom[i][h] for a threadgroup's 16 heads x 64 latent columns of one
// query row, the slots in steps of 32 through threadgroup memory (the row
// list staged once, so S is at most 2 056; the next step's loads issued
// before the current step's products). Thread t: head t / 16 of the tile,
// columns 4 (t % 16) .. + 3. With chunks > 1 the slots are split into
// chunks of `chunk` slots (z = i * chunks + c) whose sums go to `partial`
// [m][chunks][64][512] and glm53_dsa_lora_reduce adds them up. (One
// thread a column looping over every slot took 670 us a call at 2 048
// rows; tiled, 115 us; in 8 chunks 59 + 7.5 us; 2026-11-14.)
// Grid (4 head tiles, 8 column tiles, m * chunks), 256 threads. Buffers:
// 0 weights [m][64][S], 1 denom, 2 cache, 3 sel, 4 lat out [m][64][512],
// 5 partial. Params: 6 S, 7 pos0, 8 has_sel, 9 n_sel, 10 chunks, 11 chunk.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_dsa_lora
shared uint rows_sh[2056];
shared float ps[16 * 33];   // [head][slot] + pad
shared vec4 vs[32 * 16];    // [slot][16 vec4 of columns]
void main() {
    const uint S = arg_u32(6);
    const uint pos0 = arg_u32(7);
    const bool has_sel = arg_u32(8) != 0u;
    const uint n_sel = arg_u32(9);
    const uint chunks = arg_u32(10);
    const uint chunk = arg_u32(11);
    const uint h0 = gl_WorkGroupID.x * 16u;
    const uint j0 = gl_WorkGroupID.y * 64u;
    const uint i = gl_WorkGroupID.z / chunks;
    const uint ci = gl_WorkGroupID.z % chunks;
    const uint tid = gl_LocalInvocationIndex;
    // This chunk's slots [first, first + count).
    const uint first = ci * chunk;
    const uint all = min(S, has_sel ? n_sel : pos0 + i + 1u);
    const uint count = min(all, first + chunk) - min(all, first);
    for (uint s = tid; s < count; s += 256u) rows_sh[s] = has_sel ? U32(arg(3)).v[i * S + first + s] : first + s;
    barrier();
    // Loaders: P head t / 16, slots 2 (t % 16), + 1; latent slot t / 8,
    // columns 8 (t % 8) .. + 7.
    const uint ph = tid >> 4u, pp = tid & 15u;
    const uint vsl = tid >> 3u, vp = tid & 7u;
    const uint64_t P = arg(0) + 4u * ((uint64_t(i) * 64u + h0 + ph) * S + first);
    const uint steps = max((count + 31u) / 32u, 1u);
    vec2 pr;
    uvec4 vr;
    bool vlive;
    {
        const uint s = 2u * pp;
        pr = vec2(s < count ? F32(P).v[s] : 0.0, s + 1u < count ? F32(P).v[s + 1u] : 0.0);
        const uint row = vsl < count ? rows_sh[vsl] : 0xffffffffu;
        vlive = row != 0xffffffffu;
        vr = U32x4(arg(2) + 1024u * uint64_t(vlive ? row : 0u) + 2u * (j0 + 8u * vp)).v[0];
    }
    const uint hl = tid >> 4u, c = tid & 15u;
    vec4 acc = vec4(0.0);
    for (uint st = 0u; st < steps; st++) {
        barrier();
        ps[ph * 33u + 2u * pp] = pr.x;
        ps[ph * 33u + 2u * pp + 1u] = pr.y;
        vs[vsl * 16u + 2u * vp] = vlive ? vec4(unpackHalf2x16(vr.x), unpackHalf2x16(vr.y)) : vec4(0.0);
        vs[vsl * 16u + 2u * vp + 1u] = vlive ? vec4(unpackHalf2x16(vr.z), unpackHalf2x16(vr.w)) : vec4(0.0);
        barrier();
        {
            const uint base = 32u * min(st + 1u, steps - 1u);
            const uint s = base + 2u * pp;
            pr = vec2(s < count ? F32(P).v[s] : 0.0, s + 1u < count ? F32(P).v[s + 1u] : 0.0);
            const uint row = base + vsl < count ? rows_sh[base + vsl] : 0xffffffffu;
            vlive = row != 0xffffffffu;
            vr = U32x4(arg(2) + 1024u * uint64_t(vlive ? row : 0u) + 2u * (j0 + 8u * vp)).v[0];
        }
        [[unroll]] for (uint k = 0u; k < 32u; k++) acc += ps[hl * 33u + k] * vs[k * 16u + c];
    }
    if (chunks == 1u) {
        F32x4(arg(4) + 4u * ((uint64_t(i) * 64u + h0 + hl) * 512u + j0 + 4u * c)).v[0] = acc / F32(arg(1)).v[i * 64u + h0 + hl];
    } else {
        F32x4(arg(5) + 4u * (((uint64_t(i) * chunks + ci) * 64u + h0 + hl) * 512u + j0 + 4u * c)).v[0] = acc;
    }
}
#endif

// The chunks' sums of glm53_dsa_lora, divided by the denominators:
// lat[i][h][j] = sum_c partial[i][c][h][j] / denom[i][h], four values a
// thread. Grid (64 * 512 / 4 / 256, m), 256 threads. Buffers: 0 partial,
// 1 denom, 2 lat. Params: 3 chunks.
#ifdef KERNEL_glm53_dsa_lora_reduce
void main() {
    const uint chunks = arg_u32(3);
    const uint i = gl_WorkGroupID.y;
    const uint q = gl_WorkGroupID.x * 256u + gl_LocalInvocationIndex; // vec4 index in [64][512]
    vec4 acc = vec4(0.0);
    for (uint c = 0u; c < chunks; c++) acc += F32x4(arg(0) + 16u * ((uint64_t(i) * chunks + c) * 8192u + q)).v[0];
    F32x4(arg(2) + 16u * (uint64_t(i) * 8192u + q)).v[0] = acc / F32(arg(1)).v[i * 64u + q / 128u];
}
#endif

// ---------------------------------------------------------------------------
// Pooled indexer key update (port of ds4 kernel_glm53_indexer_pool_update):
// rows of raw keys and gates for tokens pos0.. ; every pool of four whose
// last token is among them is LayerNorm'd row by row, softmax-weighted per
// channel by gate + ape and stored as f16; rows of an incomplete pool wait
// in the tail buffers. Grid (number of pools touched), head_dim (128)
// threads. Buffers: 0 raw_k [n][128], 1 gate [n][128], 2 norm w, 3 norm b,
// 4 ape bf16 [4][128], 5 pool cache f16, 6 tail_k [4][128], 7 tail_gate.
// Params: 8 pos0, 9 n_tokens, 10 eps.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_indexer_pool_update
shared float rows[4 * 128];
shared float mean_sh[4];
shared float inv_sh[4];
void main() {
    const uint HD = 128u;
    const uint POOL = 4u;
    const uint pos0 = arg_u32(8);
    const uint n_tokens = arg_u32(9);
    const float eps = arg_f32(10);
    const uint tid = gl_LocalInvocationIndex;
    const uint pool = pos0 / POOL + gl_WorkGroupID.x;
    const uint pool_start = pool * POOL;
    const uint input_end = pos0 + n_tokens;
    const bool complete = pool_start + POOL <= input_end;
    // The pool of the last fed token keeps its rows in the tail buffers
    // even when it completes: a speculative row that completes it may be
    // rolled back and fed again. (Only it: the tail is one pool's rows.)
    const bool keeps_tail = pool == (input_end - 1u) / POOL;
    float gate_v[4];
    [[unroll]] for (uint r = 0u; r < POOL; r++) {
        const uint pos = pool_start + r;
        float k_value = 0.0, g_value = 0.0;
        if (pos >= pos0 && pos < input_end) {
            const uint src = pos - pos0;
            k_value = F32(arg(0)).v[src * HD + tid];
            g_value = F32(arg(1)).v[src * HD + tid];
            if (keeps_tail) {
                F32(arg(6)).v[r * HD + tid] = k_value;
                F32(arg(7)).v[r * HD + tid] = g_value;
            }
        } else if (pos < pos0) {
            k_value = F32(arg(6)).v[r * HD + tid];
            g_value = F32(arg(7)).v[r * HD + tid];
        }
        rows[r * HD + tid] = k_value;
        gate_v[r] = g_value;
    }
    barrier();
    if (!complete) return;
    if (tid < POOL) {
        float sum = 0.0;
        for (uint d = 0u; d < HD; d++) sum += rows[tid * HD + d];
        const float m = sum / float(HD);
        float ss = 0.0;
        for (uint d = 0u; d < HD; d++) {
            const float delta = rows[tid * HD + d] - m;
            ss += delta * delta;
        }
        mean_sh[tid] = m;
        inv_sh[tid] = inversesqrt(ss / float(HD) + eps);
    }
    barrier();
    float logits[4];
    float max_logit = -1.0 / 0.0;
    [[unroll]] for (uint r = 0u; r < POOL; r++) {
        logits[r] = gate_v[r] + float(BF16(arg(4)).v[r * HD + tid]);
        max_logit = max(max_logit, logits[r]);
    }
    float denom = 0.0;
    [[unroll]] for (uint r = 0u; r < POOL; r++) {
        logits[r] = exp(logits[r] - max_logit);
        denom += logits[r];
    }
    float pooled = 0.0;
    [[unroll]] for (uint r = 0u; r < POOL; r++) {
        const float nv = (rows[r * HD + tid] - mean_sh[r]) * inv_sh[r] * F32(arg(2)).v[tid] + F32(arg(3)).v[tid];
        pooled += (logits[r] / denom) * nv;
    }
    F16(arg(5) + 2u * uint64_t(pool) * HD).v[tid] = float16_t(pooled);
}
#endif

// ---------------------------------------------------------------------------
// Indexer pool scores (ds4 kernel_glm_indexer_score_one, pooled): for query
// row i, score[i][p] = sum_h max(iq[i][h] . pooled[p] * scale, 0) * w[i][h]
// over its complete pools p < (pos0 + i + 1) / 4. One subgroup per eight
// pools, lane h owning head h (32 heads of 128).
// Grid (ceil(P / 8), m), 32 threads. Buffers: 0 iq [m][32][128], 1 w
// [m][32], 2 pooled f16 [pools][128], 3 scores [m][P]. Params: 4 P (row
// stride), 5 pos0, 6 scale.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_indexer_scores
shared float16_t pool_sh[8 * 128];
void main() {
    const uint P = arg_u32(4);
    const uint pos0 = arg_u32(5);
    const float scale = arg_f32(6);
    const uint i = gl_WorkGroupID.y;
    const uint p0 = gl_WorkGroupID.x * 8u;
    const uint lane = gl_SubgroupInvocationID;
    const uint pools = (pos0 + i + 1u) / 4u;
    // Eight pools of 128 f16 (2 KB): four 16-byte loads a lane, all issued
    // before the stores (a load an iteration waited 32 times).
    uvec4 pv[4];
    [[unroll]] for (uint t = 0u; t < 4u; t++) {
        const uint o = 8u * (32u * t + lane); // f16 index in the 8 x 128 block
        const uint p = p0 + o / 128u;
        pv[t] = p < pools ? U32x4(arg(2) + 256u * uint64_t(p) + 2u * (o % 128u)).v[0] : uvec4(0u);
    }
    [[unroll]] for (uint t = 0u; t < 4u; t++) {
        const uint o = 8u * (32u * t + lane);
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            const vec2 v = unpackHalf2x16(pv[t][c]);
            pool_sh[o + 2u * c] = float16_t(v.x);
            pool_sh[o + 2u * c + 1u] = float16_t(v.y);
        }
    }
    barrier();
    const uint64_t Q = arg(0) + 4u * (uint64_t(i) * 32u + lane) * 128u;
    float acc[8];
    [[unroll]] for (uint r = 0u; r < 8u; r++) acc[r] = 0.0;
    for (uint j = 0u; j < 128u; j += 4u) {
        const vec4 q = F32x4(Q + 4u * j).v[0];
        [[unroll]] for (uint r = 0u; r < 8u; r++) {
            acc[r] += q.x * float(pool_sh[r * 128u + j]) + q.y * float(pool_sh[r * 128u + j + 1u]) +
                      q.z * float(pool_sh[r * 128u + j + 2u]) + q.w * float(pool_sh[r * 128u + j + 3u]);
        }
    }
    const float wh = F32(arg(1)).v[i * 32u + lane];
    [[unroll]] for (uint r = 0u; r < 8u; r++) {
        const float s = subgroupAdd(max(acc[r] * scale, 0.0) * wh);
        const uint p = p0 + r;
        if (lane == 0u && p < P) F32(arg(3)).v[i * P + p] = p < pools ? s : -1.0 / 0.0;
    }
}
#endif

// ---------------------------------------------------------------------------
// Top-k pools and their token rows (ds4 indexer top-k plus
// kernel_glm53_expand_pool_selection): for query row i with pools =
// (pos0 + i + 1) / 4 complete pools, keep the k highest scores (ties to the
// lower pool, all pools when there are at most k), in ascending pool order,
// and write their four token rows each, then the incomplete pool's tokens.
// The count of rows goes to count[i]. A radix select on the scores' order-
// preserving keys, four 8-bit digits, then an ordered compaction; the bin
// choice and the compaction's offsets are subgroup scans (thread 0 walking
// the 256 bins and the 1 024 offsets took 87 us a call at 4K context;
// 2026-11-14). Grid m, 1024 threads. Buffers: 0 scores [m][P], 1 sel u32 [m][S], 2 count
// u32 [m]. Params: 3 P, 4 S, 5 pos0, 6 k.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_indexer_topk
shared uint hist[256];
shared uint prefix_sh;
shared uint need_sh;
shared uint part_sh[2 * 32];
uint glm53_key(float f) {
    const uint u = floatBitsToUint(f);
    return (u & 0x80000000u) != 0u ? ~u : u | 0x80000000u;
}
void main() {
    const uint P = arg_u32(3);
    const uint S = arg_u32(4);
    const uint pos0 = arg_u32(5);
    const uint k = arg_u32(6);
    const uint i = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint visible = pos0 + i + 1u;
    const uint pools = visible / 4u;
    const uint64_t SC = arg(0) + 4u * uint64_t(i) * P;
    const uint64_t SEL = arg(1) + 4u * uint64_t(i) * S;
    // Threshold key: the k-th largest (0 when every pool is kept).
    uint thresh = 0u;
    if (pools > k) {
        if (tid == 0u) { prefix_sh = 0u; need_sh = k; }
        barrier();
        for (int digit = 3; digit >= 0; digit--) {
            if (tid < 256u) hist[tid] = 0u;
            barrier();
            const uint prefix = prefix_sh;
            const uint shift = uint(digit) * 8u;
            const uint hi_mask = digit == 3 ? 0u : (0xffffffffu << (shift + 8u));
            for (uint p = tid; p < pools; p += 1024u) {
                const uint key = glm53_key(F32(SC).v[p]);
                if ((key & hi_mask) == (prefix & hi_mask)) atomicAdd(hist[(key >> shift) & 0xffu], 1u);
            }
            barrier();
            // Bin b is chosen when the keys in bins >= b reach `need` and
            // those in bins > b do not (bin 0 when none does): suffix sums
            // from an inclusive scan over the 256 bins.
            const uint need = need_sh;
            const uint hb = tid < 256u ? hist[tid] : 0u;
            const uint incl = subgroupInclusiveAdd(hb);
            if (tid < 256u && gl_SubgroupInvocationID == 31u) part_sh[gl_SubgroupID] = incl;
            barrier();
            if (tid < 256u) {
                uint before = 0u, total = 0u;
                [[unroll]] for (uint g = 0u; g < 8u; g++) {
                    const uint v = part_sh[g];
                    before += g < gl_SubgroupID ? v : 0u;
                    total += v;
                }
                const uint upto = before + incl; // bins <= tid
                const uint at_or_above = total - upto + hb;
                const uint above = total - upto;
                if ((at_or_above >= need || tid == 0u) && (tid == 255u || above < need)) {
                    prefix_sh = prefix | (tid << shift);
                    need_sh = need - above;
                }
            }
            barrier();
        }
        thresh = prefix_sh;
    }
    // Ordered compaction: each thread a contiguous run of pools.
    const uint per = (pools + 1023u) / 1024u;
    const uint begin = min(tid * per, pools);
    const uint end = min(begin + per, pools);
    uint gt = 0u, eq = 0u;
    for (uint p = begin; p < end; p++) {
        const uint key = glm53_key(F32(SC).v[p]);
        gt += uint(key > thresh || pools <= k);
        eq += uint(key == thresh && pools > k);
    }
    // Exclusive offsets over the threads: subgroup scans, then the 32
    // subgroups' totals.
    const uint gx = subgroupExclusiveAdd(gt), ex = subgroupExclusiveAdd(eq);
    if (gl_SubgroupInvocationID == 31u) {
        part_sh[gl_SubgroupID] = gx + gt;
        part_sh[32u + gl_SubgroupID] = ex + eq;
    }
    barrier();
    uint gbase = 0u, ebase = 0u, total_gt = 0u;
    for (uint g = 0u; g < 32u; g++) {
        const uint a = part_sh[g], b = part_sh[32u + g];
        gbase += g < gl_SubgroupID ? a : 0u;
        ebase += g < gl_SubgroupID ? b : 0u;
        total_gt += a; // pools strictly above the threshold
    }

    const uint eq_take = min(k, pools) - min(total_gt, min(k, pools));
    uint g_at = gbase + gx, e_at = ebase + ex;
    // Slots are in pool order: a pool's slot is the count of kept pools
    // before it, so a thread needs the kept equal ones before it too.
    for (uint p = begin; p < end; p++) {
        const uint key = glm53_key(F32(SC).v[p]);
        bool keep;
        if (pools <= k) keep = true;
        else if (key > thresh) keep = true;
        else keep = key == thresh && e_at < eq_take;
        const uint slot = g_at + min(e_at, eq_take);
        if (key == thresh && pools > k) e_at++;
        else if (keep) g_at++;
        if (keep) {
            [[unroll]] for (uint r = 0u; r < 4u; r++) U32(SEL).v[4u * slot + r] = 4u * p + r;
        }
    }
    const uint kept = min(k, pools);
    const uint tail = visible % 4u;
    if (tid < tail) U32(SEL).v[4u * kept + tid] = visible - tail + tid;
    // Unused slots are marked (ds4 pads them with 0xffffffff too): the
    // attention kernels skip them.
    for (uint s = 4u * kept + tail + tid; s < S; s += 1024u) U32(SEL).v[s] = 0xffffffffu;
    if (tid == 0u) U32(arg(2)).v[i] = 4u * kept + tail;
}
#endif

// ---------------------------------------------------------------------------
// HC post fused with the next control projection's partial sums. Lane owns
// two hidden positions d of all four streams: when has_post it first
// applies the post mix of the previous sublayer (H[dst][d] = block[d] *
// post[dst] + sum_src comb[dst + 4 src] * H[src][d], in place: no other
// lane reads its d), then adds its eight values' share of the 24 rows of
// fn . H and of sum(H^2). Each threadgroup (one subgroup, 64 positions)
// writes 25 partial sums; glm53_hc_pre2 reduces them. fn rows are
// [24][4 * hidden] bf16 over the streams' flat order. Every load is issued
// before the first use: the scheduler leaves a row's loads next to their
// use, so a row at a time waited for memory 24 times (29 us a call; 2026-11-14).
// Grid (hidden / 64, m), 128 threads. Buffers: 0 H [m][4][hidden], 1 block
// [m][hidden], 2 split [m][24], 3 fn bf16, 4 partial [m][groups][25].
// Params: 5 hidden, 6 has_post. glm53_hc_post_mix_f16 reads fn as f16
// (DeepSeek V4's HC controls).
// ---------------------------------------------------------------------------
#if defined(KERNEL_glm53_hc_post_mix) || defined(KERNEL_glm53_hc_post_mix_f16)
void main() {
    const uint hidden = arg_u32(5);
    const bool has_post = arg_u32(6) != 0u;
    const uint i = gl_WorkGroupID.y;
    const uint g = gl_WorkGroupID.x;
    const uint groups = gl_NumWorkGroups.x;
    const uint lane = gl_SubgroupInvocationID;
    // Four subgroups share the threadgroup's 64 positions, each the fn rows
    // 6 sg .. 6 sg + 6: a quarter of the weight loads a lane, four times
    // the threads (one subgroup of 24 rows, 64 threadgroups of 32 threads,
    // left the GPU waiting on each lane's 96 loads). Each row's sum is the
    // same lanes' same products in the same order.
    const uint r0 = 6u * gl_SubgroupID;
    const uint d = g * 64u + 2u * lane;
    const uint64_t Hs = arg(0) + 16u * uint64_t(i) * hidden;
    vec2 h[4];
    [[unroll]] for (uint s = 0u; s < 4u; s++) h[s] = uintBitsToFloat(U32x2(Hs + 4u * (s * hidden + d)).v[0]);
    const uint64_t W = arg(3);
    const uint row_words = 2u * hidden; // 4 * hidden bf16 = 2 * hidden words
    uint w[6][4];
    [[unroll]] for (uint r = 0u; r < 6u; r++)
        [[unroll]] for (uint s = 0u; s < 4u; s++) w[r][s] = U32(W).v[(r0 + r) * row_words + (s * hidden + d) / 2u];
    if (has_post) {
        const uint64_t S = arg(2) + 96u * uint64_t(i);
        const vec2 b = uintBitsToFloat(U32x2(arg(1) + 4u * (i * hidden + d)).v[0]);
        vec2 o[4];
        [[unroll]] for (uint dst = 0u; dst < 4u; dst++) {
            vec2 acc = b * F32(S).v[4u + dst];
            acc += F32(S).v[8u + dst] * h[0];
            acc += F32(S).v[8u + dst + 4u] * h[1];
            acc += F32(S).v[8u + dst + 8u] * h[2];
            acc += F32(S).v[8u + dst + 12u] * h[3];
            o[dst] = acc;
        }
        [[unroll]] for (uint s = 0u; s < 4u; s++) h[s] = o[s];
    }
    // Every subgroup has read the old streams (its post mix used them)
    // before the first writes them back.
    barrier();
    if (has_post && gl_SubgroupID == 0u) {
        [[unroll]] for (uint s = 0u; s < 4u; s++) U32x2(Hs + 4u * (s * hidden + d)).v[0] = floatBitsToUint(h[s]);
    }
    float ss = 0.0;
    [[unroll]] for (uint s = 0u; s < 4u; s++) ss += dot(h[s], h[s]);
    float mine = subgroupAdd(ss);
    [[unroll]] for (uint r = 0u; r < 6u; r++) {
        float acc = 0.0;
        [[unroll]] for (uint s = 0u; s < 4u; s++) {
#ifdef KERNEL_glm53_hc_post_mix_f16
            const vec2 wf = unpackHalf2x16(w[r][s]);
            acc += wf.x * h[s].x + wf.y * h[s].y;
#else
            acc += uintBitsToFloat(w[r][s] << 16u) * h[s].x + uintBitsToFloat(w[r][s] & 0xffff0000u) * h[s].y;
#endif
        }
        acc = subgroupAdd(acc);
        mine = lane == r0 + r ? acc : mine;
    }
    const bool writes = (lane >= r0 && lane < r0 + 6u) || (gl_SubgroupID == 0u && lane == 24u);
    if (writes) F32(arg(4)).v[(i * groups + g) * 25u + lane] = mine;
}
#endif

// ---------------------------------------------------------------------------
// HC pre from the partial sums of glm53_hc_post_mix: mix = (fn . H) * rs
// with rs = 1 / sqrt(sum(H^2) / (4 hidden) + eps) (ds4 normalizes H first;
// the products differ only in rounding), the Sinkhorn split on sixteen
// lanes (lane j holds comb[j], src j % 4, dst j / 4), the weighted stream
// sum and its RMSNorm with `norm`. One threadgroup of 256 per row, each
// thread sixteen positions held in registers, loaded first. (The comb in
// every lane's registers instead of the shuffles was slower: 9.3 against
// 7.3 us a call; 2026-11-14.)
// Grid m, 256 threads. Buffers: 0 partial [m][groups][25], 1 scale [3],
// 2 base [24], 3 H, 4 norm, 5 split out [m][24], 6 xn out [m][hidden].
// Params: 7 hidden, 8 iters, 9 hc_eps, 10 rms_eps, 11 groups.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_hc_pre2
shared float mix_sh[25];
shared float sp[24];
shared float red[8];
void main() {
    const uint hidden = arg_u32(7);
    const uint iters = arg_u32(8);
    const float eps = arg_f32(9);
    const float rms_eps = arg_f32(10);
    const uint groups = arg_u32(11);
    const uint i = gl_WorkGroupID.x;
    const uint tid = gl_LocalInvocationIndex;
    const uint lane = gl_SubgroupInvocationID;
    // The streams and the norm weights first: their loads are in flight
    // through the reduction and the split.
    const uint64_t Hs = arg(3) + 16u * uint64_t(i) * hidden;
    vec4 hv[4][4], nw[4];
    [[unroll]] for (uint q = 0u; q < 4u; q++) {
        const uint d = 16u * tid + 4u * q;
        [[unroll]] for (uint s = 0u; s < 4u; s++) hv[q][s] = F32x4(Hs + 4u * (s * hidden + d)).v[0];
        nw[q] = F32x4(arg(4) + 4u * d).v[0];
    }
    // hidden is 4096 here: 64 groups. Thread (v = tid / 8, j = tid % 8)
    // sums groups j, j + 8, ... of value v, all loads in flight together,
    // then the eight lanes of v add up. (The groups' sum in order, 25
    // threads, costs 2.8 us more: 10.1 against 7.3 us; 2026-11-14.)
    {
        const uint v = tid >> 3u, j = tid & 7u;
        const uint64_t P = arg(0) + 4u * uint64_t(i) * groups * 25u;
        float acc = 0.0;
        if (v < 25u) {
            float part[8];
            [[unroll]] for (uint k = 0u; k < 8u; k++) part[k] = F32(P).v[(j + 8u * k) * 25u + v];
            [[unroll]] for (uint k = 0u; k < 8u; k++) acc += part[k];
        }
        acc += subgroupShuffleXor(acc, 1u);
        acc += subgroupShuffleXor(acc, 2u);
        acc += subgroupShuffleXor(acc, 4u);
        if (v < 25u && j == 0u) mix_sh[v] = acc;
    }
    barrier();
    if (gl_SubgroupID == 0u) {
        const float rs = inversesqrt(mix_sh[24] / float(4u * hidden) + rms_eps);
        const float s0 = F32(arg(1)).v[0], s1 = F32(arg(1)).v[1], s2 = F32(arg(1)).v[2];
        if (lane < 4u) {
            sp[lane] = 1.0 / (1.0 + exp(-(mix_sh[lane] * rs * s0 + F32(arg(2)).v[lane]))) + eps;
            sp[4u + lane] = 2.0 / (1.0 + exp(-(mix_sh[4u + lane] * rs * s1 + F32(arg(2)).v[4u + lane])));
        }
        const uint j = lane & 15u;
        float c = mix_sh[8u + j] * rs * s2 + F32(arg(2)).v[8u + j];
        // Row softmax over src (lanes j with the same j / 4), plus eps.
        float mx = max(c, subgroupShuffleXor(c, 1u));
        mx = max(mx, subgroupShuffleXor(mx, 2u));
        c = exp(c - mx);
        float sum = c + subgroupShuffleXor(c, 1u);
        sum += subgroupShuffleXor(sum, 2u);
        c = c * (1.0 / sum) + eps;
        // Column normalization (lanes with the same j % 4), then rows and
        // columns alternately.
        for (uint it = 0u; it < iters; it++) {
            if (it > 0u) {
                float rsum = c + subgroupShuffleXor(c, 1u);
                rsum += subgroupShuffleXor(rsum, 2u);
                c *= 1.0 / (rsum + eps);
            }
            float csum = c + subgroupShuffleXor(c, 4u);
            csum += subgroupShuffleXor(csum, 8u);
            c *= 1.0 / (csum + eps);
        }
        if (lane < 16u) sp[8u + lane] = c;
    }
    barrier();
    if (tid < 24u) F32(arg(5)).v[24u * i + tid] = sp[tid];
    const float p0 = sp[0], p1 = sp[1], p2 = sp[2], p3 = sp[3];
    vec4 x[4];
    float ss = 0.0;
    [[unroll]] for (uint q = 0u; q < 4u; q++) {
        x[q] = hv[q][0] * p0 + hv[q][1] * p1 + hv[q][2] * p2 + hv[q][3] * p3;
        ss += dot(x[q], x[q]);
    }
    ss = subgroupAdd(ss);
    if (lane == 0u) red[gl_SubgroupID] = ss;
    barrier();
    const float total = subgroupAdd(lane < 8u ? red[lane] : 0.0);
    const float scale = inversesqrt(total / float(hidden) + rms_eps);
    const uint64_t O = arg(6) + 4u * uint64_t(i) * hidden;
    [[unroll]] for (uint q = 0u; q < 4u; q++) {
        const uint d = 16u * tid + 4u * q;
        F32x4(O + 4u * d).v[0] = x[q] * scale * nw[q];
    }
}
#endif
