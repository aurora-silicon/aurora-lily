#ifdef GEMV_Q5_K
// Task t of a Q5_K row: its sub-block's scale and min and its 32 codes.
void glm53_q5_k_codes(uint64_t row, uint t, out float scale, out float minv, out float q[32]) {
    const uint64_t b = row + uint64_t(t >> 3u) * 176u;
    const uint j = t & 7u;
    const uvec4 hd = U32x4(b).v[0];
    const uvec3 sw = hd.yzw;
    #define K5_BYTE(i) ((sw[(i) >> 2u] >> (8u * ((i) & 3u))) & 0xffu)
    uint sc, mn;
    if (j < 4u) {
        sc = K5_BYTE(j) & 63u;
        mn = K5_BYTE(j + 4u) & 63u;
    } else {
        sc = (K5_BYTE(j + 4u) & 0xfu) | ((K5_BYTE(j - 4u) >> 6u) << 4u);
        mn = (K5_BYTE(j + 4u) >> 4u) | ((K5_BYTE(j) >> 6u) << 4u);
    }
    #undef K5_BYTE
    scale = glm53_h2f(hd.x & 0xffffu) * float(sc);
    minv = glm53_h2f(hd.x >> 16u) * float(mn);
    const uint shift = (j & 1u) * 4u;
    const uvec4 qa = U32x4(b + 48u + (j >> 1u) * 32u).v[0];
    const uvec4 qb = U32x4(b + 64u + (j >> 1u) * 32u).v[0];
    const uvec4 ha = U32x4(b + 16u).v[0];
    const uvec4 hb = U32x4(b + 32u).v[0];
    // The four codes of a word at once: its bytes' nibbles and high bits
    // under masks, then a byte extract and a convert each (one row's GEMV
    // spent a fifth of its time on per-code extracts, 2026-11-15).
    [[unroll]] for (uint c = 0u; c < 8u; c++) {
        const uint word = (c < 4u ? qa[c] : qb[c - 4u]) >> shift;
        const uint hw = (c < 4u ? ha[c] : hb[c - 4u]) >> j;
        const uint c4 = (word & 0x0f0f0f0fu) | ((hw & 0x01010101u) << 4u);
        [[unroll]] for (uint k = 0u; k < 4u; k++) q[4u * c + k] = float((c4 >> (8u * k)) & 0xffu);
    }
}

// glm53_task_dot_sum of two weight rows over one load of x: (w . x,
// wb . x, sum x).
vec3 glm53_task_dot2_sum(in float w[32], in float wb[32], uint64_t x) {
    float acc = 0.0, acc_b = 0.0, sx = 0.0;
    [[unroll]] for (uint q = 0u; q < 8u; q++) {
        const vec4 v = F32x4(x + 16u * q).v[0];
        acc += w[4u * q] * v.x + w[4u * q + 1u] * v.y + w[4u * q + 2u] * v.z + w[4u * q + 3u] * v.w;
        acc_b += wb[4u * q] * v.x + wb[4u * q + 1u] * v.y + wb[4u * q + 2u] * v.z + wb[4u * q + 3u] * v.w;
        sx += (v.x + v.y) + (v.z + v.w);
    }
    return vec3(acc, acc_b, sx);
}
