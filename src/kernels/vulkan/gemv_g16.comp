#version 460
// Decode GEMVs for Apple G16 GPUs (the M4: no matrix units, 32-wide
// subgroups), dispatched by src/kernels/glm53.rs in place of glm53.comp's
// on those GPUs only. Same bindings, params and results per row as the
// glm53_gemv kernels they replace; each row's sums run in one fixed order
// whatever the row count m, so a verify pass's rows equal plain decode's.
#define GLM53_EXT_TYPES
#include "common.glsl"
#include "glm53_quant.glsl"

// ---------------------------------------------------------------------------
// Q5_K GEMV (Gemma 4's attention, dense FFN and LM head): a subgroup takes
// G16_R rows; its four groups of eight lanes take blocks b, b + 4, .. of
// all of them, so a lane loads its activations once for G16_R rows. Lane p
// of a group takes values 16 h .. 16 h + 15 (h = p % 2) of sub-blocks 2 g
// and 2 g + 1 (g = p / 2): 16 code bytes (the low and high nibbles), 16
// high-bit bytes and the block header, each one 16-byte load, the code
// bytes of a group's lanes contiguous. A sub-block's scale and min multiply
// its sums of code times x and of x. K a multiple of 256, x_group a
// multiple of G16_R (a subgroup's rows share their input), x_row_stride a
// multiple of 4 (the step between rows is x_row_stride / 4 vec4s).
// Buffers: 0 x, 1-4 W, 5-8 y. Params: 9 K, 10 m, 11 row_bytes, 12-15 rows
// of each set (0: unused), 16 x_group, 17 x_row_stride, 18 y_row_stride.
// ---------------------------------------------------------------------------
#if defined(KERNEL_g16_gemv_q5_k_m1)
#define GEMV_M 1u
#define G16_R 4u
#elif defined(KERNEL_g16_gemv_q5_k_m2)
#define GEMV_M 2u
#define G16_R 1u
#elif defined(KERNEL_g16_gemv_q5_k_m3)
#define GEMV_M 3u
#define G16_R 1u
#elif defined(KERNEL_g16_gemv_q5_k_m4)
#define GEMV_M 4u
#define G16_R 1u
#endif
#ifdef GEMV_M
// One row's 32 values of the lane in block b: (scale s0 - min sxa) + (scale
// s1 - min sxb), the code bytes and high-bit bytes at 16-byte index q4 and
// the block header at hd4 of the weight at W.
float g16_q5k_lane(uint64_t W, uint hd4, uint q4, uint qh4, uint j0, uint ssh, bool hi_sc,
                   in vec4 xa[4], in vec4 xb[4], float sxa, float sxb) {
    const uvec4 hd = U32x4(W).v[hd4];
    const uvec4 qs = U32x4(W).v[q4];
    const uvec4 hb = U32x4(W).v[qh4] >> j0;
    const uvec4 lo = (qs & 0x0f0f0f0fu) | ((hb << 4u) & 0x10101010u);
    const uvec4 hi = ((qs >> 4u) & 0x0f0f0f0fu) | ((hb << 3u) & 0x10101010u);
    const uint a = hd.y >> ssh, bb = hd.z >> ssh, cc = hd.w >> ssh;
    // The two adjacent sub-blocks have the same layout in adjacent bytes.
    const uint scales = hi_sc ? (cc & 0x0f0fu) | ((a >> 2u) & 0x3030u) : a & 0x3f3fu;
    const uint mins = hi_sc ? ((cc >> 4u) & 0x0f0fu) | ((bb >> 2u) & 0x3030u) : bb & 0x3f3fu;
    const uint sc0 = scales & 63u, mn0 = mins & 63u;
    const uint sc1 = scales >> 8u, mn1 = mins >> 8u;
    precise float s0 = 0.0, s1 = 0.0;
    [[unroll]] for (uint c = 0u; c < 4u; c++) {
        // Codes 0, 2 and 1, 3 of the word as 16-bit halves.
        const u16vec2 l02 = unpack16(lo[c] & 0x00ff00ffu), l13 = unpack16((lo[c] >> 8u) & 0x00ff00ffu);
        const u16vec2 h02 = unpack16(hi[c] & 0x00ff00ffu), h13 = unpack16((hi[c] >> 8u) & 0x00ff00ffu);
        s0 = fma(float(l02.x), xa[c].x, s0);
        s1 = fma(float(h02.x), xb[c].x, s1);
        s0 = fma(float(l13.x), xa[c].y, s0);
        s1 = fma(float(h13.x), xb[c].y, s1);
        s0 = fma(float(l02.y), xa[c].z, s0);
        s1 = fma(float(h02.y), xb[c].z, s1);
        s0 = fma(float(l13.y), xa[c].w, s0);
        s1 = fma(float(h13.y), xb[c].w, s1);
    }
    const float d = glm53_h2f(hd.x & 0xffffu), dm = glm53_h2f(hd.x >> 16u);
    precise float v = (d * float(sc0) * s0 - dm * float(mn0) * sxa)
                    + (d * float(sc1) * s1 - dm * float(mn1) * sxb);
    return v;
}

void main() {
    const uint64_t X = arg(0);
    const uint K = arg_u32(9);
    const uint row_bytes = arg_u32(11);
    const uint x_group = arg_u32(16);
    const uint x_row_stride = arg_u32(17);
    const uint y_stride_param = arg_u32(18);
    const uint rows_per_tg = 8u * G16_R;
    uint tg = gl_WorkGroupID.x;
    uint set = 0u;
    uint N = arg_u32(12);
    [[unroll]] for (uint s = 0u; s < 3u; s++) {
        const uint tgs = (N + rows_per_tg - 1u) / rows_per_tg;
        if (set == s && tg >= tgs) {
            tg -= tgs;
            set = s + 1u;
            N = arg_u32(13u + s);
        }
    }
    const uint64_t W = arg(1u + set);
    const uint64_t Y = arg(5u + set);
    const uint y_row_stride = y_stride_param != 0u ? y_stride_param : N;
    const uint n0 = (tg * 8u + gl_SubgroupID) * G16_R;
    if (n0 >= N) return;
    const uint lane = gl_SubgroupInvocationID;
    const uint ix = lane >> 3u, pg = (lane >> 1u) & 3u, h = lane & 1u;
    const uint j0 = 2u * pg;
    const uint ssh = 16u * (pg & 1u);
    const bool hi_sc = pg >= 2u;
    // In 16-byte units: rows, blocks (11 a block), the lane's code and
    // high-bit bytes in a block; the activations' row, block and lane.
    const uint row16 = row_bytes / 16u;
    const uint x4 = (n0 / x_group) * (K / 4u) + 16u * pg + 4u * h;
    uint r16[G16_R];
    [[unroll]] for (uint r = 0u; r < G16_R; r++) r16[r] = min(n0 + r, N - 1u) * row16;
    float acc[G16_R][GEMV_M];
    [[unroll]] for (uint r = 0u; r < G16_R; r++)
        [[unroll]] for (uint i = 0u; i < GEMV_M; i++) acc[r][i] = 0.0;
    const uint nb = K / 256u;
    for (uint b = ix; b < nb; b += 4u) {
#if defined(KERNEL_g16_gemv_q5_k_m1)
        const uint xi = x4 + 64u * b;
        vec4 xa[4], xb[4];
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            xa[c] = F32x4(X).v[xi + c];
            xb[c] = F32x4(X).v[xi + 8u + c];
        }
        precise float sxa = 0.0, sxb = 0.0;
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            sxa += (xa[c].x + xa[c].y) + (xa[c].z + xa[c].w);
            sxb += (xb[c].x + xb[c].y) + (xb[c].z + xb[c].w);
        }
        [[unroll]] for (uint r = 0u; r < G16_R; r++) {
            const uint blk = r16[r] + 11u * b;
            acc[r][0] += g16_q5k_lane(W, blk, blk + 3u + 2u * pg + h, blk + 1u + h, j0,
                                      ssh, hi_sc, xa, xb, sxa, sxb);
        }
#else
        // For m > 1 (G16_R == 1): load & decode each Q5_K block ONCE for all GEMV_M rows!
        const uint x_stride4 = x_row_stride / 4u;
        const uint blk = r16[0] + 11u * b;
        const uvec4 hd = U32x4(W).v[blk];
        const uvec4 qs = U32x4(W).v[blk + 3u + 2u * pg + h];
        const uvec4 hb = U32x4(W).v[blk + 1u + h] >> j0;
        const uvec4 lo = (qs & 0x0f0f0f0fu) | ((hb << 4u) & 0x10101010u);
        const uvec4 hi = ((qs >> 4u) & 0x0f0f0f0fu) | ((hb << 3u) & 0x10101010u);
        const uint a = hd.y >> ssh, bb = hd.z >> ssh, cc = hd.w >> ssh;
        const uint scales = hi_sc ? (cc & 0x0f0fu) | ((a >> 2u) & 0x3030u) : a & 0x3f3fu;
        const uint mins = hi_sc ? ((cc >> 4u) & 0x0f0fu) | ((bb >> 2u) & 0x3030u) : bb & 0x3f3fu;
        const float d = glm53_h2f(hd.x & 0xffffu), dm = glm53_h2f(hd.x >> 16u);
        const float d_sc0 = d * float(scales & 63u), dm_mn0 = dm * float(mins & 63u);
        const float d_sc1 = d * float(scales >> 8u), dm_mn1 = dm * float(mins >> 8u);
        float s0[GEMV_M], s1[GEMV_M], sxa[GEMV_M], sxb[GEMV_M];
        [[unroll]] for (uint i = 0u; i < GEMV_M; i++) {
            s0[i] = 0.0; s1[i] = 0.0; sxa[i] = 0.0; sxb[i] = 0.0;
        }
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            const u16vec2 l02 = unpack16(lo[c] & 0x00ff00ffu), l13 = unpack16((lo[c] >> 8u) & 0x00ff00ffu);
            const u16vec2 h02 = unpack16(hi[c] & 0x00ff00ffu), h13 = unpack16((hi[c] >> 8u) & 0x00ff00ffu);
            const vec4 wl = vec4(float(l02.x), float(l13.x), float(l02.y), float(l13.y));
            const vec4 wh = vec4(float(h02.x), float(h13.x), float(h02.y), float(h13.y));
            [[unroll]] for (uint i = 0u; i < GEMV_M; i++) {
                const uint xi = x4 + i * x_stride4 + 64u * b;
                const vec4 xa = F32x4(X).v[xi + c];
                const vec4 xb = F32x4(X).v[xi + 8u + c];
                s0[i] += dot(wl, xa);
                s1[i] += dot(wh, xb);
                sxa[i] += (xa.x + xa.y) + (xa.z + xa.w);
                sxb[i] += (xb.x + xb.y) + (xb.z + xb.w);
            }
        }
        [[unroll]] for (uint i = 0u; i < GEMV_M; i++) {
            acc[0][i] += (d_sc0 * s0[i] - dm_mn0 * sxa[i]) + (d_sc1 * s1[i] - dm_mn1 * sxb[i]);
        }
#endif
    }
    [[unroll]] for (uint r = 0u; r < G16_R; r++) {
        [[unroll]] for (uint i = 0u; i < GEMV_M; i++) {
            const float v = subgroupAdd(acc[r][i]);
            if (lane == 0u && n0 + r < N) F32(Y).v[i * y_row_stride + n0 + r] = v;
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// Q4_K GEMV for Apple G16 (M4): identical to Q5_K without the high-bit load
// (9 x 16-byte blocks per 256 values instead of 11). Blasts Q4_K LM head and
// attention projections to ~90+ GB/s on M4.
// ---------------------------------------------------------------------------
#if defined(KERNEL_g16_gemv_q4_k_m1)
#define GEMV4_M 1u
#define G16_R4 4u
#elif defined(KERNEL_g16_gemv_q4_k_m2)
#define GEMV4_M 2u
#define G16_R4 1u
#elif defined(KERNEL_g16_gemv_q4_k_m3)
#define GEMV4_M 3u
#define G16_R4 1u
#elif defined(KERNEL_g16_gemv_q4_k_m4)
#define GEMV4_M 4u
#define G16_R4 1u
#endif
#ifdef GEMV4_M
float g16_q4k_lane(uint64_t W, uint hd4, uint q4, uint ssh, bool hi_sc,
                   in vec4 xa[4], in vec4 xb[4], float sxa, float sxb) {
    const uvec4 hd = U32x4(W).v[hd4];
    const uvec4 qs = U32x4(W).v[q4];
    const uvec4 lo = qs & 0x0f0f0f0fu;
    const uvec4 hi = (qs >> 4u) & 0x0f0f0f0fu;
    const uint a = hd.y >> ssh, bb = hd.z >> ssh, cc = hd.w >> ssh;
    const uint scales = hi_sc ? (cc & 0x0f0fu) | ((a >> 2u) & 0x3030u) : a & 0x3f3fu;
    const uint mins = hi_sc ? ((cc >> 4u) & 0x0f0fu) | ((bb >> 2u) & 0x3030u) : bb & 0x3f3fu;
    const uint sc0 = scales & 63u, mn0 = mins & 63u;
    const uint sc1 = scales >> 8u, mn1 = mins >> 8u;
    precise float s0 = 0.0, s1 = 0.0;
    [[unroll]] for (uint c = 0u; c < 4u; c++) {
        const u16vec2 l02 = unpack16(lo[c] & 0x00ff00ffu), l13 = unpack16((lo[c] >> 8u) & 0x00ff00ffu);
        const u16vec2 h02 = unpack16(hi[c] & 0x00ff00ffu), h13 = unpack16((hi[c] >> 8u) & 0x00ff00ffu);
        s0 = fma(float(l02.x), xa[c].x, s0);
        s1 = fma(float(h02.x), xb[c].x, s1);
        s0 = fma(float(l13.x), xa[c].y, s0);
        s1 = fma(float(h13.x), xb[c].y, s1);
        s0 = fma(float(l02.y), xa[c].z, s0);
        s1 = fma(float(h02.y), xb[c].z, s1);
        s0 = fma(float(l13.y), xa[c].w, s0);
        s1 = fma(float(h13.y), xb[c].w, s1);
    }
    const float d = glm53_h2f(hd.x & 0xffffu), dm = glm53_h2f(hd.x >> 16u);
    precise float v = (d * float(sc0) * s0 - dm * float(mn0) * sxa)
                    + (d * float(sc1) * s1 - dm * float(mn1) * sxb);
    return v;
}

void main() {
    const uint64_t X = arg(0);
    const uint K = arg_u32(9);
    const uint row_bytes = arg_u32(11);
    const uint x_group = arg_u32(16);
    const uint x_row_stride = arg_u32(17);
    const uint y_stride_param = arg_u32(18);
    const uint rows_per_tg = 8u * G16_R4;
    uint tg = gl_WorkGroupID.x;
    uint set = 0u;
    uint N = arg_u32(12);
    [[unroll]] for (uint s = 0u; s < 3u; s++) {
        const uint tgs = (N + rows_per_tg - 1u) / rows_per_tg;
        if (set == s && tg >= tgs) {
            tg -= tgs;
            set = s + 1u;
            N = arg_u32(13u + s);
        }
    }
    const uint64_t W = arg(1u + set);
    const uint64_t Y = arg(5u + set);
    const uint y_row_stride = y_stride_param != 0u ? y_stride_param : N;
    const uint n0 = (tg * 8u + gl_SubgroupID) * G16_R4;
    if (n0 >= N) return;
    const uint lane = gl_SubgroupInvocationID;
    const uint ix = lane >> 3u, pg = (lane >> 1u) & 3u, h = lane & 1u;
    const uint ssh = 16u * (pg & 1u);
    const bool hi_sc = pg >= 2u;
    const uint row16 = row_bytes / 16u;
    const uint x4 = (n0 / x_group) * (K / 4u) + 16u * pg + 4u * h;
    uint r16[G16_R4];
    [[unroll]] for (uint r = 0u; r < G16_R4; r++) r16[r] = min(n0 + r, N - 1u) * row16;
    float acc[G16_R4][GEMV4_M];
    [[unroll]] for (uint r = 0u; r < G16_R4; r++)
        [[unroll]] for (uint i = 0u; i < GEMV4_M; i++) acc[r][i] = 0.0;
    const uint nb = K / 256u;
    for (uint b = ix; b < nb; b += 4u) {
#if defined(KERNEL_g16_gemv_q4_k_m1)
        const uint xi = x4 + 64u * b;
        vec4 xa[4], xb[4];
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            xa[c] = F32x4(X).v[xi + c];
            xb[c] = F32x4(X).v[xi + 8u + c];
        }
        precise float sxa = 0.0, sxb = 0.0;
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            sxa += (xa[c].x + xa[c].y) + (xa[c].z + xa[c].w);
            sxb += (xb[c].x + xb[c].y) + (xb[c].z + xb[c].w);
        }
        [[unroll]] for (uint r = 0u; r < G16_R4; r++) {
            const uint blk = r16[r] + 9u * b;
            acc[r][0] += g16_q4k_lane(W, blk, blk + 1u + 2u * pg + h, ssh, hi_sc,
                                      xa, xb, sxa, sxb);
        }
#else
        // For m > 1 (G16_R4 == 1): load & decode each Q4_K block ONCE for all GEMV4_M rows!
        const uint x_stride4 = x_row_stride / 4u;
        const uint blk = r16[0] + 9u * b;
        const uvec4 hd = U32x4(W).v[blk];
        const uvec4 qs = U32x4(W).v[blk + 1u + 2u * pg + h];
        const uvec4 lo = qs & 0x0f0f0f0fu;
        const uvec4 hi = (qs >> 4u) & 0x0f0f0f0fu;
        const uint a = hd.y >> ssh, bb = hd.z >> ssh, cc = hd.w >> ssh;
        const uint scales = hi_sc ? (cc & 0x0f0fu) | ((a >> 2u) & 0x3030u) : a & 0x3f3fu;
        const uint mins = hi_sc ? ((cc >> 4u) & 0x0f0fu) | ((bb >> 2u) & 0x3030u) : bb & 0x3f3fu;
        const float d = glm53_h2f(hd.x & 0xffffu), dm = glm53_h2f(hd.x >> 16u);
        const float d_sc0 = d * float(scales & 63u), dm_mn0 = dm * float(mins & 63u);
        const float d_sc1 = d * float(scales >> 8u), dm_mn1 = dm * float(mins >> 8u);
        float s0[GEMV4_M], s1[GEMV4_M], sxa[GEMV4_M], sxb[GEMV4_M];
        [[unroll]] for (uint i = 0u; i < GEMV4_M; i++) {
            s0[i] = 0.0; s1[i] = 0.0; sxa[i] = 0.0; sxb[i] = 0.0;
        }
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            const u16vec2 l02 = unpack16(lo[c] & 0x00ff00ffu), l13 = unpack16((lo[c] >> 8u) & 0x00ff00ffu);
            const u16vec2 h02 = unpack16(hi[c] & 0x00ff00ffu), h13 = unpack16((hi[c] >> 8u) & 0x00ff00ffu);
            const vec4 wl = vec4(float(l02.x), float(l13.x), float(l02.y), float(l13.y));
            const vec4 wh = vec4(float(h02.x), float(h13.x), float(h02.y), float(h13.y));
            [[unroll]] for (uint i = 0u; i < GEMV4_M; i++) {
                const uint xi = x4 + i * x_stride4 + 64u * b;
                const vec4 xa = F32x4(X).v[xi + c];
                const vec4 xb = F32x4(X).v[xi + 8u + c];
                s0[i] += dot(wl, xa);
                s1[i] += dot(wh, xb);
                sxa[i] += (xa.x + xa.y) + (xa.z + xa.w);
                sxb[i] += (xb.x + xb.y) + (xb.z + xb.w);
            }
        }
        [[unroll]] for (uint i = 0u; i < GEMV4_M; i++) {
            acc[0][i] += (d_sc0 * s0[i] - dm_mn0 * sxa[i]) + (d_sc1 * s1[i] - dm_mn1 * sxb[i]);
        }
#endif
    }
    [[unroll]] for (uint r = 0u; r < G16_R4; r++) {
        [[unroll]] for (uint i = 0u; i < GEMV4_M; i++) {
            const float v = subgroupAdd(acc[r][i]);
            if (lane == 0u && n0 + r < N) F32(Y).v[i * y_row_stride + n0 + r] = v;
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// Q8_0 GEMV for Apple G16 (M4): 4 weight rows/subgroup for m=1 (4x X reuse),
// 1 weight row/subgroup for m=2..4 (m-way weight reuse), using 8-byte u16vec4
// loads (4 loads per 32-byte block instead of 16 scalar U16 loads).
// Same lane->block assignment (t = lane; t += 32) across m=1..4 for exact
// speculative verify parity. Requires K >= 1024, K % 32 == 0.
// ---------------------------------------------------------------------------
#if defined(KERNEL_g16_gemv_q8_0_m1)
#define GEMV8_M 1u
#define G16_R8 4u
#elif defined(KERNEL_g16_gemv_q8_0_m2)
#define GEMV8_M 2u
#define G16_R8 1u
#elif defined(KERNEL_g16_gemv_q8_0_m3)
#define GEMV8_M 3u
#define G16_R8 1u
#elif defined(KERNEL_g16_gemv_q8_0_m4)
#define GEMV8_M 4u
#define G16_R8 1u
#endif
#ifdef GEMV8_M
layout(buffer_reference, scalar, buffer_reference_align = 2) readonly buffer G16Q8Pairs { u16vec4 v[]; };

float g16_q8_dot_xv(uint64_t b, in vec4 xv[8], float acc) {
    const float d = glm53_h2f(uint(U16(b).v[0]));
    precise float s = 0.0;
    [[unroll]] for (uint g = 0u; g < 4u; g++) {
        const u16vec4 p = G16Q8Pairs(b + 2u).v[g];
        const vec4 w0 = vec4(
            float(int(uint(p.x) << 24) >> 24), float(int(uint(p.x) << 16) >> 24),
            float(int(uint(p.y) << 24) >> 24), float(int(uint(p.y) << 16) >> 24));
        const vec4 w1 = vec4(
            float(int(uint(p.z) << 24) >> 24), float(int(uint(p.z) << 16) >> 24),
            float(int(uint(p.w) << 24) >> 24), float(int(uint(p.w) << 16) >> 24));
        const vec4 x0 = xv[2u * g];
        const vec4 x1 = xv[2u * g + 1u];
        s = fma(w0.x, x0.x, s);
        s = fma(w0.y, x0.y, s);
        s = fma(w0.z, x0.z, s);
        s = fma(w0.w, x0.w, s);
        s = fma(w1.x, x1.x, s);
        s = fma(w1.y, x1.y, s);
        s = fma(w1.z, x1.z, s);
        s = fma(w1.w, x1.w, s);
    }
    precise float out_acc = fma(d, s, acc);
    return out_acc;
}

void main() {
    const uint64_t X = arg(0);
    const uint K = arg_u32(9);
    const uint row_bytes = arg_u32(11);
    const uint x_group = arg_u32(16);
    const uint x_row_stride = arg_u32(17);
    const uint y_stride_param = arg_u32(18);
    const uint rows_per_tg = 8u * G16_R8;
    uint tg = gl_WorkGroupID.x;
    uint set = 0u;
    uint N = arg_u32(12);
    [[unroll]] for (uint s = 0u; s < 3u; s++) {
        const uint tgs = (N + rows_per_tg - 1u) / rows_per_tg;
        if (set == s && tg >= tgs) {
            tg -= tgs;
            set = s + 1u;
            N = arg_u32(13u + s);
        }
    }
    const uint64_t W = arg(1u + set);
    const uint64_t Y = arg(5u + set);
    const uint y_row_stride = y_stride_param != 0u ? y_stride_param : N;
    const uint n0 = (tg * 8u + gl_SubgroupID) * G16_R8;
    if (n0 >= N) return;
    const uint lane = gl_SubgroupInvocationID;
    const uint64_t x_base = X + 4u * uint64_t(n0 / x_group) * uint64_t(K);
    const uint tasks = K >> 5u;
#if defined(KERNEL_g16_gemv_q8_0_m1)
    uint64_t w_rows[4];
    [[unroll]] for (uint r = 0u; r < 4u; r++) w_rows[r] = W + uint64_t(min(n0 + r, N - 1u)) * uint64_t(row_bytes);
