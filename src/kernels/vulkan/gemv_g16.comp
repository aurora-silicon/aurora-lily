    uint N = arg_u32(12);
    [[unroll]] for (uint s = 0u; s < 3u; s++) {
        const uint tgs = (N + rows_per_tg - 1u) / rows_per_tg;
        if (set == s && tg >= tgs) {
            tg -= tgs;
            set = s + 1u;
            N = arg_u32(13u + s);
        }
    }
    const uint64_t W = arg(1u + set);
    const uint64_t Y = arg(5u + set);
    const uint64_t y_row_stride = uint64_t(y_stride_param != 0u ? y_stride_param : N);
    const uint n0 = (tg * 8u + gl_SubgroupID) * 4u;
    if (n0 >= N) return;
    const uint lane = gl_SubgroupInvocationID;
    const uint grp = lane >> 3u;
    const uint l = lane & 7u;
    const uint n_half = l >> 2u, q_sub = l & 3u;
    const uint n = n0 + grp;
    const uint64_t w_row = W + uint64_t(min(n, N - 1u)) * uint64_t(row_bytes);
    const uint64_t x_base = X + 4u * (uint64_t(min(n, N - 1u) / x_group) * uint64_t(K) + uint64_t(l) * 32u);
    const uint64_t x_stride_b = 4u * uint64_t(x_row_stride);
    const uint lshift = 4u * (q_sub >> 1u), hshift = 2u * q_sub;
    const uint nb = K >> 8u;
    float acc[GEMV6_M];
    [[unroll]] for (uint i = 0u; i < GEMV6_M; i++) acc[i] = 0.0;
    for (uint b_idx = 0u; b_idx < nb; b_idx++) {
        const uint64_t b = w_row + uint64_t(b_idx) * 210u;
        const float d = glm53_h2f(uint(U16(b).v[104]));
        const uint sw = uint(U16(b + 192u).v[4u * n_half + q_sub]);
        const float s0 = g16_pmul(d, float(int(sw << 24) >> 24));
        const float s1 = g16_pmul(d, float(int(sw << 16) >> 24));
        const uint64_t ql = b + 64u * n_half + 32u * (q_sub & 1u);
        const uint64_t qh = b + 128u + 32u * n_half;
        const uint64_t xt = x_base + uint64_t(b_idx) * 1024u;
        float a0[GEMV6_M], a1[GEMV6_M];
        [[unroll]] for (uint i = 0u; i < GEMV6_M; i++) { a0[i] = 0.0; a1[i] = 0.0; }
        [[unroll]] for (uint g = 0u; g < 2u; g++) {
            const u16vec4 lo = G16Q6Pairs(ql).v[g];
            const u16vec4 hi = G16Q6Pairs(qh).v[g];
            const uint lw0 = pack32(lo.xy), lw1 = pack32(lo.zw);
            const uint hw0 = pack32(hi.xy), hw1 = pack32(hi.zw);
            const uint q0 = ((lw0 >> lshift) & 0x0f0f0f0fu) | (((hw0 >> hshift) & 0x03030303u) << 4u);
            const uint q1 = ((lw1 >> lshift) & 0x0f0f0f0fu) | (((hw1 >> hshift) & 0x03030303u) << 4u);
            const f16vec2 w02 = uint16BitsToFloat16(unpack16(0x64006400u | (q0 & 0x003f003fu))) - f16vec2(1056.0);
            const f16vec2 w13 = uint16BitsToFloat16(unpack16(0x64006400u | ((q0 >> 8u) & 0x003f003fu))) - f16vec2(1056.0);
            const f16vec2 w46 = uint16BitsToFloat16(unpack16(0x64006400u | (q1 & 0x003f003fu))) - f16vec2(1056.0);
            const f16vec2 w57 = uint16BitsToFloat16(unpack16(0x64006400u | ((q1 >> 8u) & 0x003f003fu))) - f16vec2(1056.0);
            [[unroll]] for (uint i = 0u; i < GEMV6_M; i++) {
                const uint64_t xp = xt + uint64_t(i) * x_stride_b + 32u * g;
                const vec4 x0 = F32x4(xp).v[0];
                const vec4 x1 = F32x4(xp + 16u).v[0];
                a0[i] = g16_pfma(float(w02.x), x0.x, a0[i]);
                a0[i] = g16_pfma(float(w13.x), x0.y, a0[i]);
                a0[i] = g16_pfma(float(w02.y), x0.z, a0[i]);
                a0[i] = g16_pfma(float(w13.y), x0.w, a0[i]);
                a0[i] = g16_pfma(float(w46.x), x1.x, a0[i]);
                a0[i] = g16_pfma(float(w57.x), x1.y, a0[i]);
                a0[i] = g16_pfma(float(w46.y), x1.z, a0[i]);
                a0[i] = g16_pfma(float(w57.y), x1.w, a0[i]);
            }
        }
        [[unroll]] for (uint g = 2u; g < 4u; g++) {
            const u16vec4 lo = G16Q6Pairs(ql).v[g];
            const u16vec4 hi = G16Q6Pairs(qh).v[g];
            const uint lw0 = pack32(lo.xy), lw1 = pack32(lo.zw);
            const uint hw0 = pack32(hi.xy), hw1 = pack32(hi.zw);
            const uint q0 = ((lw0 >> lshift) & 0x0f0f0f0fu) | (((hw0 >> hshift) & 0x03030303u) << 4u);
            const uint q1 = ((lw1 >> lshift) & 0x0f0f0f0fu) | (((hw1 >> hshift) & 0x03030303u) << 4u);
            const f16vec2 w02 = uint16BitsToFloat16(unpack16(0x64006400u | (q0 & 0x003f003fu))) - f16vec2(1056.0);
            const f16vec2 w13 = uint16BitsToFloat16(unpack16(0x64006400u | ((q0 >> 8u) & 0x003f003fu))) - f16vec2(1056.0);
            const f16vec2 w46 = uint16BitsToFloat16(unpack16(0x64006400u | (q1 & 0x003f003fu))) - f16vec2(1056.0);
            const f16vec2 w57 = uint16BitsToFloat16(unpack16(0x64006400u | ((q1 >> 8u) & 0x003f003fu))) - f16vec2(1056.0);
            [[unroll]] for (uint i = 0u; i < GEMV6_M; i++) {
                const uint64_t xp = xt + uint64_t(i) * x_stride_b + 32u * g;
                const vec4 x0 = F32x4(xp).v[0];
                const vec4 x1 = F32x4(xp + 16u).v[0];
                a1[i] = g16_pfma(float(w02.x), x0.x, a1[i]);
                a1[i] = g16_pfma(float(w13.x), x0.y, a1[i]);
                a1[i] = g16_pfma(float(w02.y), x0.z, a1[i]);
                a1[i] = g16_pfma(float(w13.y), x0.w, a1[i]);
                a1[i] = g16_pfma(float(w46.x), x1.x, a1[i]);
                a1[i] = g16_pfma(float(w57.x), x1.y, a1[i]);
                a1[i] = g16_pfma(float(w46.y), x1.z, a1[i]);
                a1[i] = g16_pfma(float(w57.y), x1.w, a1[i]);
            }
        }
        [[unroll]] for (uint i = 0u; i < GEMV6_M; i++) {
            const float blk_v = g16_padd(g16_pmul(s0, a0[i]), g16_pmul(s1, a1[i]));
            acc[i] = g16_padd(acc[i], blk_v);
        }
    }
    float out_v[GEMV6_M];
    [[unroll]] for (uint i = 0u; i < GEMV6_M; i++) out_v[i] = g16_reduce8(acc[i]);
    if (l == 0u && n < N) {
        [[unroll]] for (uint i = 0u; i < GEMV6_M; i++)
            F32(Y + 4u * (uint64_t(i) * y_row_stride + uint64_t(n))).v[0] = out_v[i];
    }
}
#endif
