#version 460
// Decode GEMVs for Apple G16 GPUs (the M4: no matrix units, 32-wide
// subgroups), dispatched by src/kernels/glm53.rs in place of glm53.comp's
// on those GPUs only. Same bindings, params and results per row as the
// glm53_gemv kernels they replace; each row's sums run in one fixed order
// whatever the row count m, so a verify pass's rows equal plain decode's.
//
// All four quant types (Q5_K, Q4_K, Q8_0, Q6_K) assign 8 lanes per output
// row (zero tail-wave waste on every model width that is a multiple of 256:
// K = 2304, 2560, 2816, 4096, 9216) and reduce with a 3-step
// subgroupShuffleXor before any lane-dependent store branch.
// - Q4_K & Q5_K: 4 rows per subgroup (256 threads/WG = 32 rows/WG) across
//   all m=1..4, streaming one vec4 of X per nibble word so register pressure
//   stays low and every row count shares one code path.
// - Q6_K & Q8_0: 4 rows per subgroup (256 threads/WG = 32 rows/WG) across
//   all m=1..4, using 8-byte u16vec4 loads.
// - Quant codes decode via exact normal FP16 biased integers (0x6400 | q -
//   bias, or 0x5400 | (hi<<4) - 64.0 for Q4_K high nibbles): zero FP16
//   subnormals (FTZ-safe) and zero delayed rescaling (no underflow on tiny
//   normal F32 activations).
#define LILY_PRECISE_ISOLATED
#define GLM53_EXT_TYPES
#include "common.glsl"
#include "glm53_quant.glsl"

// Parameter-only precise helpers (contained under LILY_PRECISE_ISOLATED) so
// every row count m=1..4 evaluates each row's dot in one exact order.
float g16_padd(float a, float b) {
    precise float r = a + b;
    return r;
}
float g16_pmul(float a, float b) {
    precise float r = a * b;
    return r;
}
float g16_pfma(float a, float b, float c) {
    precise float r = fma(a, b, c);
    return r;
}
float g16_sum4(vec4 v) {
    precise float r = (v.x + v.y) + (v.z + v.w);
    return r;
}
float g16_reduce8(float v) {
    v = g16_padd(v, subgroupShuffleXor(v, 4u));
    v = g16_padd(v, subgroupShuffleXor(v, 2u));
    v = g16_padd(v, subgroupShuffleXor(v, 1u));
    return v;
}

// ---------------------------------------------------------------------------
// Q5_K GEMV: 8 lanes/row (4 rows/subgroup, 256 threads/WG) across all m=1..4,
// exact normal FP16 decode (0x6400 | q - 1024.0) into F32 FMAs.
// Buffers: 0 x, 1-4 W, 5-8 y. Params: 9 K, 10 m, 11 row_bytes, 12-15 rows
// of each set (0: unused), 16 x_group, 17 x_row_stride, 18 y_row_stride.
// ---------------------------------------------------------------------------
#if defined(KERNEL_g16_gemv_q5_k_m1)
#define GEMV_M 1u
#elif defined(KERNEL_g16_gemv_q5_k_m2)
#define GEMV_M 2u
#elif defined(KERNEL_g16_gemv_q5_k_m3)
#define GEMV_M 3u
#elif defined(KERNEL_g16_gemv_q5_k_m4)
#define GEMV_M 4u
#endif
#ifdef GEMV_M
void main() {
    const uint64_t X = arg(0);
    const uint K = arg_u32(9);
    const uint row_bytes = arg_u32(11);
    const uint x_group = arg_u32(16);
    const uint x_row_stride = arg_u32(17);
    const uint y_stride_param = arg_u32(18);
    const uint rows_per_tg = 32u;
    uint tg = gl_WorkGroupID.x;
    uint set = 0u;
    uint N = arg_u32(12);
    [[unroll]] for (uint s = 0u; s < 3u; s++) {
        const uint tgs = (N + rows_per_tg - 1u) / rows_per_tg;
        if (set == s && tg >= tgs) {
            tg -= tgs;
            set = s + 1u;
            N = arg_u32(13u + s);
        }
    }
    const uint64_t W = arg(1u + set);
    const uint64_t Y = arg(5u + set);
    const uint64_t y_row_stride = uint64_t(y_stride_param != 0u ? y_stride_param : N);
    const uint lane = gl_SubgroupInvocationID;
    const uint grp = lane >> 3u;
    const uint l = lane & 7u;
    const uint pg = l >> 1u, h = l & 1u;
    const uint j0 = 2u * pg;
    const uint ssh = 16u * (pg & 1u);
    const bool hi_sc = pg >= 2u;
    const uint nb = K / 256u;
    const uint n0 = (tg * 8u + gl_SubgroupID) * 4u;
    if (n0 >= N) return;
    const uint n = n0 + grp;
    const uint64_t w_row = W + uint64_t(min(n, N - 1u)) * uint64_t(row_bytes);
    const uint64_t x_base = X
        + 4u * (uint64_t(min(n, N - 1u) / x_group) * uint64_t(K) + uint64_t(64u * pg + 16u * h));
    const uint64_t x_stride_b = 4u * uint64_t(x_row_stride);
    float acc[GEMV_M];
    [[unroll]] for (uint i = 0u; i < GEMV_M; i++) acc[i] = 0.0;
    for (uint b = 0u; b < nb; b++) {
        const uint blk = 11u * b;
        const uvec4 hd = U32x4(w_row).v[blk];
        const uvec4 qs = U32x4(w_row).v[blk + 3u + 2u * pg + h];
        const uvec4 hb = U32x4(w_row).v[blk + 1u + h] >> j0;
        const uvec4 lo = (qs & 0x0f0f0f0fu) | ((hb << 4u) & 0x10101010u);
        const uvec4 hi = ((qs >> 4u) & 0x0f0f0f0fu) | ((hb << 3u) & 0x10101010u);
        const uint a = hd.y >> ssh, bb = hd.z >> ssh, cc = hd.w >> ssh;
        const uint scales = hi_sc ? (cc & 0x0f0fu) | ((a >> 2u) & 0x3030u) : a & 0x3f3fu;
        const uint mins = hi_sc ? ((cc >> 4u) & 0x0f0fu) | ((bb >> 2u) & 0x3030u) : bb & 0x3f3fu;
        const float d = glm53_h2f(hd.x & 0xffffu);
        const float dm = glm53_h2f(hd.x >> 16u);
        const float d_sc0 = g16_pmul(d, float(scales & 63u));
        const float dm_mn0 = g16_pmul(dm, float(mins & 63u));
        const float d_sc1 = g16_pmul(d, float(scales >> 8u));
        const float dm_mn1 = g16_pmul(dm, float(mins >> 8u));
        const uint64_t xb_ptr = x_base + uint64_t(b) * 1024u;
        float s0[GEMV_M], s1[GEMV_M], sxa[GEMV_M], sxb[GEMV_M];
        [[unroll]] for (uint i = 0u; i < GEMV_M; i++) {
            s0[i] = 0.0; s1[i] = 0.0; sxa[i] = 0.0; sxb[i] = 0.0;
        }
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            const uint lw = lo[c], hw = hi[c];
            const f16vec2 l02 = uint16BitsToFloat16(unpack16(0x64006400u | (lw & 0x001f001fu))) - f16vec2(1024.0);
            const f16vec2 l13 = uint16BitsToFloat16(unpack16(0x64006400u | ((lw >> 8u) & 0x001f001fu))) - f16vec2(1024.0);
            const f16vec2 h02 = uint16BitsToFloat16(unpack16(0x64006400u | (hw & 0x001f001fu))) - f16vec2(1024.0);
            const f16vec2 h13 = uint16BitsToFloat16(unpack16(0x64006400u | ((hw >> 8u) & 0x001f001fu))) - f16vec2(1024.0);
            [[unroll]] for (uint i = 0u; i < GEMV_M; i++) {
                const uint64_t xi = xb_ptr + uint64_t(i) * x_stride_b;
                const vec4 xa = F32x4(xi).v[c];
                const vec4 xb = F32x4(xi).v[8u + c];
                s0[i] = g16_pfma(float(l02.x), xa.x, s0[i]);
                s1[i] = g16_pfma(float(h02.x), xb.x, s1[i]);
                s0[i] = g16_pfma(float(l13.x), xa.y, s0[i]);
                s1[i] = g16_pfma(float(h13.x), xb.y, s1[i]);
                s0[i] = g16_pfma(float(l02.y), xa.z, s0[i]);
                s1[i] = g16_pfma(float(h02.y), xb.z, s1[i]);
                s0[i] = g16_pfma(float(l13.y), xa.w, s0[i]);
                s1[i] = g16_pfma(float(h13.y), xb.w, s1[i]);
                sxa[i] = g16_padd(sxa[i], g16_sum4(xa));
                sxb[i] = g16_padd(sxb[i], g16_sum4(xb));
            }
        }
        [[unroll]] for (uint i = 0u; i < GEMV_M; i++) {
            const float b0 = g16_padd(g16_pmul(d_sc0, s0[i]), -g16_pmul(dm_mn0, sxa[i]));
            const float b1 = g16_padd(g16_pmul(d_sc1, s1[i]), -g16_pmul(dm_mn1, sxb[i]));
            acc[i] = g16_padd(acc[i], g16_padd(b0, b1));
        }
    }
    float out_v[GEMV_M];
    [[unroll]] for (uint i = 0u; i < GEMV_M; i++) out_v[i] = g16_reduce8(acc[i]);
    if (l == 0u && n < N) {
        [[unroll]] for (uint i = 0u; i < GEMV_M; i++)
            F32(Y + 4u * (uint64_t(i) * y_row_stride + uint64_t(n))).v[0] = out_v[i];
    }
}
#endif

// ---------------------------------------------------------------------------
// Q4_K GEMV: 8 lanes/row (4 rows/subgroup, 256 threads/WG) across all m=1..4,
// exact normal FP16 decode (low: 0x6400 | lo - 1024, high: 0x5400 | (hi << 4)
// - 64, saving the shift-by-4) into F32 FMAs.
// ---------------------------------------------------------------------------
#if defined(KERNEL_g16_gemv_q4_k_m1)
#define GEMV4_M 1u
#elif defined(KERNEL_g16_gemv_q4_k_m2)
#define GEMV4_M 2u
#elif defined(KERNEL_g16_gemv_q4_k_m3)
#define GEMV4_M 3u
#elif defined(KERNEL_g16_gemv_q4_k_m4)
#define GEMV4_M 4u
#endif
#ifdef GEMV4_M
void main() {
    const uint64_t X = arg(0);
    const uint K = arg_u32(9);
    const uint row_bytes = arg_u32(11);
    const uint x_group = arg_u32(16);
    const uint x_row_stride = arg_u32(17);
    const uint y_stride_param = arg_u32(18);
    const uint rows_per_tg = 32u;
    uint tg = gl_WorkGroupID.x;
    uint set = 0u;
    uint N = arg_u32(12);
    [[unroll]] for (uint s = 0u; s < 3u; s++) {
        const uint tgs = (N + rows_per_tg - 1u) / rows_per_tg;
        if (set == s && tg >= tgs) {
            tg -= tgs;
            set = s + 1u;
            N = arg_u32(13u + s);
        }
    }
    const uint64_t W = arg(1u + set);
    const uint64_t Y = arg(5u + set);
    const uint64_t y_row_stride = uint64_t(y_stride_param != 0u ? y_stride_param : N);
    const uint lane = gl_SubgroupInvocationID;
    const uint grp = lane >> 3u;
    const uint l = lane & 7u;
    const uint pg = l >> 1u, h = l & 1u;
    const uint ssh = 16u * (pg & 1u);
    const bool hi_sc = pg >= 2u;
    const uint nb = K / 256u;
    const uint n0 = (tg * 8u + gl_SubgroupID) * 4u;
    if (n0 >= N) return;
    const uint n = n0 + grp;
    const uint64_t w_row = W + uint64_t(min(n, N - 1u)) * uint64_t(row_bytes);
    const uint64_t x_base = X
        + 4u * (uint64_t(min(n, N - 1u) / x_group) * uint64_t(K) + uint64_t(64u * pg + 16u * h));
    const uint64_t x_stride_b = 4u * uint64_t(x_row_stride);
    float acc[GEMV4_M];
    [[unroll]] for (uint i = 0u; i < GEMV4_M; i++) acc[i] = 0.0;
    for (uint b = 0u; b < nb; b++) {
        const uint blk = 9u * b;
        const uvec4 hd = U32x4(w_row).v[blk];
        const uvec4 qs = U32x4(w_row).v[blk + 1u + 2u * pg + h];
        const uint a = hd.y >> ssh, bb = hd.z >> ssh, cc = hd.w >> ssh;
        const uint scales = hi_sc ? (cc & 0x0f0fu) | ((a >> 2u) & 0x3030u) : a & 0x3f3fu;
        const uint mins = hi_sc ? ((cc >> 4u) & 0x0f0fu) | ((bb >> 2u) & 0x3030u) : bb & 0x3f3fu;
        const float d = glm53_h2f(hd.x & 0xffffu), dm = glm53_h2f(hd.x >> 16u);
        const float d_sc0 = g16_pmul(d, float(scales & 63u));
        const float dm_mn0 = g16_pmul(dm, float(mins & 63u));
        const float d_sc1 = g16_pmul(d, float(scales >> 8u));
        const float dm_mn1 = g16_pmul(dm, float(mins >> 8u));
        const uint64_t xb_ptr = x_base + uint64_t(b) * 1024u;
        float s0[GEMV4_M], s1[GEMV4_M], sxa[GEMV4_M], sxb[GEMV4_M];
        [[unroll]] for (uint i = 0u; i < GEMV4_M; i++) {
            s0[i] = 0.0; s1[i] = 0.0; sxa[i] = 0.0; sxb[i] = 0.0;
        }
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            const uint w = qs[c];
            const uint w8 = w >> 8u;
            const f16vec2 l02 = uint16BitsToFloat16(unpack16(0x64006400u | (w & 0x000f000fu))) - f16vec2(1024.0);
            const f16vec2 l13 = uint16BitsToFloat16(unpack16(0x64006400u | (w8 & 0x000f000fu))) - f16vec2(1024.0);
            const f16vec2 h02 = uint16BitsToFloat16(unpack16(0x54005400u | (w & 0x00f000f0u))) - f16vec2(64.0);
            const f16vec2 h13 = uint16BitsToFloat16(unpack16(0x54005400u | (w8 & 0x00f000f0u))) - f16vec2(64.0);
            [[unroll]] for (uint i = 0u; i < GEMV4_M; i++) {
                const uint64_t xi = xb_ptr + uint64_t(i) * x_stride_b;
                const vec4 xa = F32x4(xi).v[c];
                const vec4 xb = F32x4(xi).v[8u + c];
                s0[i] = g16_pfma(float(l02.x), xa.x, s0[i]);
                s1[i] = g16_pfma(float(h02.x), xb.x, s1[i]);
                s0[i] = g16_pfma(float(l13.x), xa.y, s0[i]);
                s1[i] = g16_pfma(float(h13.x), xb.y, s1[i]);
                s0[i] = g16_pfma(float(l02.y), xa.z, s0[i]);
                s1[i] = g16_pfma(float(h02.y), xb.z, s1[i]);
                s0[i] = g16_pfma(float(l13.y), xa.w, s0[i]);
                s1[i] = g16_pfma(float(h13.y), xb.w, s1[i]);
                sxa[i] = g16_padd(sxa[i], g16_sum4(xa));
                sxb[i] = g16_padd(sxb[i], g16_sum4(xb));
            }
        }
        [[unroll]] for (uint i = 0u; i < GEMV4_M; i++) {
            const float b0 = g16_padd(g16_pmul(d_sc0, s0[i]), -g16_pmul(dm_mn0, sxa[i]));
            const float b1 = g16_padd(g16_pmul(d_sc1, s1[i]), -g16_pmul(dm_mn1, sxb[i]));
            acc[i] = g16_padd(acc[i], g16_padd(b0, b1));
        }
    }
    float out_v[GEMV4_M];
    [[unroll]] for (uint i = 0u; i < GEMV4_M; i++) out_v[i] = g16_reduce8(acc[i]);
    if (l == 0u && n < N) {
        [[unroll]] for (uint i = 0u; i < GEMV4_M; i++)
            F32(Y + 4u * (uint64_t(i) * y_row_stride + uint64_t(n))).v[0] = out_v[i];
    }
}
#endif

// ---------------------------------------------------------------------------
// Q8_0 GEMV: 8 lanes/row (4 rows/subgroup, 256 threads/WG) across all m=1..4.
// Uses 8-byte u16vec4 loads, exact normal FP16 biased-byte decoding
// ((0x6400 | (byte ^ 0x80)) - 1152.0 = exact int8), and a subgroup-uniform
// loop bound so partial tail blocks (K % 256 != 0) reconverge before reduce.
// Requires K >= 1024, K % 32 == 0.
// ---------------------------------------------------------------------------
#if defined(KERNEL_g16_gemv_q8_0_m1)
#define GEMV8_M 1u
#elif defined(KERNEL_g16_gemv_q8_0_m2)
#define GEMV8_M 2u
#elif defined(KERNEL_g16_gemv_q8_0_m3)
#define GEMV8_M 3u
#elif defined(KERNEL_g16_gemv_q8_0_m4)
#define GEMV8_M 4u
#endif
#ifdef GEMV8_M
layout(buffer_reference, scalar, buffer_reference_align = 2) readonly buffer G16Q8Pairs { u16vec4 v[]; };

void main() {
    const uint64_t X = arg(0);
    const uint K = arg_u32(9);
    const uint row_bytes = arg_u32(11);
    const uint x_group = arg_u32(16);
    const uint x_row_stride = arg_u32(17);
    const uint y_stride_param = arg_u32(18);
    const uint rows_per_tg = 32u;
    uint tg = gl_WorkGroupID.x;
    uint set = 0u;
    uint N = arg_u32(12);
    [[unroll]] for (uint s = 0u; s < 3u; s++) {
        const uint tgs = (N + rows_per_tg - 1u) / rows_per_tg;
        if (set == s && tg >= tgs) {
            tg -= tgs;
            set = s + 1u;
            N = arg_u32(13u + s);
        }
    }
    const uint64_t W = arg(1u + set);
    const uint64_t Y = arg(5u + set);
    const uint64_t y_row_stride = uint64_t(y_stride_param != 0u ? y_stride_param : N);
    const uint n0 = (tg * 8u + gl_SubgroupID) * 4u;
    if (n0 >= N) return;
    const uint lane = gl_SubgroupInvocationID;
    const uint grp = lane >> 3u;
    const uint l = lane & 7u;
    const uint n = n0 + grp;
    const uint64_t w_row = W + uint64_t(min(n, N - 1u)) * uint64_t(row_bytes);
    const uint64_t x_base = X + 4u * uint64_t(min(n, N - 1u) / x_group) * uint64_t(K);
    const uint64_t x_stride_b = 4u * uint64_t(x_row_stride);
    const uint tasks = K >> 5u;
    float acc[GEMV8_M];
    [[unroll]] for (uint i = 0u; i < GEMV8_M; i++) acc[i] = 0.0;
    for (uint t0 = 0u; t0 < tasks; t0 += 8u) {
        const uint t = t0 + l;
        if (t < tasks) {
            const uint64_t b = w_row + uint64_t(t) * 34u;
            const float d = glm53_h2f(uint(U16(b).v[0]));
            const uint64_t xt = x_base + uint64_t(t) * 128u;
            float s[GEMV8_M];
            [[unroll]] for (uint i = 0u; i < GEMV8_M; i++) s[i] = 0.0;
            [[unroll]] for (uint g = 0u; g < 4u; g++) {
                const u16vec4 p = G16Q8Pairs(b + 2u).v[g];
                const uint pw0 = pack32(p.xy) ^ 0x80808080u;
                const uint pw1 = pack32(p.zw) ^ 0x80808080u;
                const f16vec2 w02 = uint16BitsToFloat16(unpack16(0x64006400u | (pw0 & 0x00ff00ffu))) - f16vec2(1152.0);
                const f16vec2 w13 = uint16BitsToFloat16(unpack16(0x64006400u | ((pw0 >> 8u) & 0x00ff00ffu))) - f16vec2(1152.0);
                const f16vec2 w46 = uint16BitsToFloat16(unpack16(0x64006400u | (pw1 & 0x00ff00ffu))) - f16vec2(1152.0);
                const f16vec2 w57 = uint16BitsToFloat16(unpack16(0x64006400u | ((pw1 >> 8u) & 0x00ff00ffu))) - f16vec2(1152.0);
                [[unroll]] for (uint i = 0u; i < GEMV8_M; i++) {
                    const uint64_t xp = xt + uint64_t(i) * x_stride_b + 32u * g;
                    const vec4 x0 = F32x4(xp).v[0];
                    const vec4 x1 = F32x4(xp + 16u).v[0];
                    s[i] = g16_pfma(float(w02.x), x0.x, s[i]);
                    s[i] = g16_pfma(float(w13.x), x0.y, s[i]);
                    s[i] = g16_pfma(float(w02.y), x0.z, s[i]);
                    s[i] = g16_pfma(float(w13.y), x0.w, s[i]);
                    s[i] = g16_pfma(float(w46.x), x1.x, s[i]);
                    s[i] = g16_pfma(float(w57.x), x1.y, s[i]);
                    s[i] = g16_pfma(float(w46.y), x1.z, s[i]);
                    s[i] = g16_pfma(float(w57.y), x1.w, s[i]);
                }
            }
            [[unroll]] for (uint i = 0u; i < GEMV8_M; i++) acc[i] = g16_pfma(d, s[i], acc[i]);
        }
    }
    float out_v[GEMV8_M];
    [[unroll]] for (uint i = 0u; i < GEMV8_M; i++) out_v[i] = g16_reduce8(acc[i]);
    if (l == 0u && n < N) {
        [[unroll]] for (uint i = 0u; i < GEMV8_M; i++)
            F32(Y + 4u * (uint64_t(i) * y_row_stride + uint64_t(n))).v[0] = out_v[i];
    }
}
#endif

// ---------------------------------------------------------------------------
// Q6_K GEMV: 8 lanes/row (4 rows/subgroup, 256 threads/WG) across all m=1..4.
// Uses 8-byte u16vec4 loads and exact normal FP16 biased 6-bit decoding
// ((0x6400 | q) - 1056.0 = exact q - 32) into F32 FMAs.
// Requires K % 256 == 0.
// ---------------------------------------------------------------------------
#if defined(KERNEL_g16_gemv_q6_k_m1)
