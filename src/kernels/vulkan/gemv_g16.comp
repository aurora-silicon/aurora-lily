                float(int(uint(p.x) << 24) >> 24), float(int(uint(p.x) << 16) >> 24),
                float(int(uint(p.y) << 24) >> 24), float(int(uint(p.y) << 16) >> 24));
            const vec4 w1 = vec4(
                float(int(uint(p.z) << 24) >> 24), float(int(uint(p.z) << 16) >> 24),
                float(int(uint(p.w) << 24) >> 24), float(int(uint(p.w) << 16) >> 24));
            [[unroll]] for (uint i = 0u; i < GEMV8_M; i++) {
                const uint64_t xp = xt + uint64_t(i) * x_stride_b + 32u * g;
                const vec4 x0 = F32x4(xp).v[0];
                const vec4 x1 = F32x4(xp + 16u).v[0];
                s[i] = fma(w0.x, x0.x, s[i]);
                s[i] = fma(w0.y, x0.y, s[i]);
                s[i] = fma(w0.z, x0.z, s[i]);
                s[i] = fma(w0.w, x0.w, s[i]);
                s[i] = fma(w1.x, x1.x, s[i]);
                s[i] = fma(w1.y, x1.y, s[i]);
                s[i] = fma(w1.z, x1.z, s[i]);
                s[i] = fma(w1.w, x1.w, s[i]);
