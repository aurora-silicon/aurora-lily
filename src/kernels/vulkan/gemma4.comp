#version 460
// Gemma 4 kernels (src/kernels/gemma4.rs dispatches them). Activations are
// f32, weights GGUF blocks read in place (glm53_quant.glsl), the K/V
// caches f16. The graph is llama.cpp's (src/models/gemma4.cpp, MIT): the
// formulas below follow its ops (rms_norm, NEOX rope with frequency
// factors, softmax gating, GeGLU with the tanh GELU, final logit softcap).
#if defined(KERNEL_gemma4_embed_q5_k) || defined(KERNEL_gemma4_embed_q6_k) || \
    defined(KERNEL_gemma4_moe_gate_up_q5_k) || defined(KERNEL_gemma4_moe_gate_up_q6_k) || \
    defined(KERNEL_gemma4_moe_gate_up_iq2_s) || defined(KERNEL_gemma4_moe_down_iq4_nl) || \
    defined(KERNEL_gemma4_moe_down_q4_0)
#define GLM53_EXT_TYPES
#endif
#include "common.glsl"
#include "glm53_quant.glsl"

// tanh without the overflow of (e^2x - 1) / (e^2x + 1).
float gemma4_tanh(float x) {
    const float t = exp(-2.0 * abs(x));
    const float r = (1.0 - t) / (1.0 + t);
    return x < 0.0 ? -r : r;
}

// GELU, tanh approximation (gelu_pytorch_tanh, ggml_gelu_f32).
float gemma4_gelu(float x) {
    const float c = 0.79788456080286535587989211986876;
    return 0.5 * x * (1.0 + gemma4_tanh(c * x * (1.0 + 0.044715 * x * x)));
}

// Sum over a threadgroup of 256 threads (8 subgroups); every thread gets it.
shared float g4_red[8];
float gemma4_tg_sum(float v) {
    v = subgroupAdd(v);
    barrier();
    if (gl_SubgroupInvocationID == 0u) g4_red[gl_SubgroupID] = v;
    barrier();
    float t = gl_SubgroupInvocationID < 8u ? g4_red[gl_SubgroupInvocationID] : 0.0;
    return subgroupAdd(t);
}

// ---------------------------------------------------------------------------
// Embedding: out[i] = decode(table row tokens[i]) * scale. Grid
// (ceil(tasks / 64), m), 64 threads, a thread per 32-value task.
// Buffers: 0 table, 1 tokens u32 [m], 2 out [m][K]. Params: 3 K,
// 4 row_bytes, 5 scale.
// ---------------------------------------------------------------------------
#if defined(KERNEL_gemma4_embed_q8_0) || defined(KERNEL_gemma4_embed_q5_k) || \
    defined(KERNEL_gemma4_embed_q6_k) || defined(KERNEL_gemma4_embed_q4_k)
#if defined(KERNEL_gemma4_embed_q8_0)
#define EMBED_TYPE GLM53_Q8_0
#elif defined(KERNEL_gemma4_embed_q5_k)
#define EMBED_TYPE GLM53_Q5_K
#elif defined(KERNEL_gemma4_embed_q6_k)
#define EMBED_TYPE GLM53_Q6_K
#else
#define EMBED_TYPE GLM53_Q4_K
#endif
void main() {
    const uint K = arg_u32(3);
    const uint row_bytes = arg_u32(4);
    const float scale = arg_f32(5);
    const uint i = gl_WorkGroupID.y;
    const uint t = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
    if (t >= K / GLM53_TASK) return;
    const uint tok = U32(arg(1)).v[i];
    float w[32];
    glm53_decode(EMBED_TYPE, arg(0) + uint64_t(tok) * row_bytes, t, w);
    const uint64_t O = arg(2) + 4u * (uint64_t(i) * K + t * GLM53_TASK);
    [[unroll]] for (uint k = 0u; k < 32u; k++) F32(O).v[k] = w[k] * scale;
}
#endif

// ---------------------------------------------------------------------------
// Per-head RMSNorm, NEOX RoPE and the K/V store, for m rows at positions
// pos0 + i. Slots: q heads 0..H (norm with q_norm, rope, f32 to q_out), k
// heads (norm with k_norm, rope, f16 to the K cache), v heads (norm without
// a weight, f16 to the V cache). A subgroup a slot; lane l holds values
// l + 32 j, so a rotated pair (i, i + d/2) is in one lane. Cache rows are
// slot (pos % ring) of [ring][kvh][d]. Rope: pair i turns by pos *
// base^(-2 i / d) / ff[i]; a factor above 1e20 (Gemma's unrotated pairs,
// 1e30) leaves the pair as it is, which is what the tiny angle gives.
// Grid (ceil(slots / 8), m), 256 threads.
// Buffers: 0 q_raw [m][H d], 1 k_raw [m][kvh d] (row stride k_stride),
// 2 v_raw (same layout, may be k_raw), 3 q_norm [d], 4 k_norm [d],
// 5 q_out [m][H d], 6 K cache, 7 V cache, 8 freq factors [d / 2].
// Params: 9 d, 10 H, 11 kvh, 12 pos0, 13 ring, 14 base, 15 has_ff, 16 eps,
// 17 k_stride, 18 v_offset (elements of a row before the V part).
// ---------------------------------------------------------------------------
#if defined(KERNEL_gemma4_qkv_256) || defined(KERNEL_gemma4_qkv_512)
#ifdef KERNEL_gemma4_qkv_256
#define G4_D 256u
#else
#define G4_D 512u
#endif
void main() {
    const uint d = G4_D;
    const uint H = arg_u32(10);
    const uint kvh = arg_u32(11);
    const uint pos0 = arg_u32(12);
    const uint ring = arg_u32(13);
    const float base = arg_f32(14);
    const bool has_ff = arg_u32(15) != 0u;
    const float eps = arg_f32(16);
    const uint k_stride = arg_u32(17);
    const uint v_offset = arg_u32(18);
    const uint i = gl_WorkGroupID.y;
    const uint slot = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    if (slot >= H + 2u * kvh) return;
    const uint lane = gl_SubgroupInvocationID;
    const uint per = G4_D / 32u;
    const uint kind = slot < H ? 0u : (slot < H + kvh ? 1u : 2u);
    const uint head = kind == 0u ? slot : (kind == 1u ? slot - H : slot - H - kvh);
    uint64_t src;
    if (kind == 0u) src = arg(0) + 4u * (uint64_t(i) * H * d + head * d);
    else if (kind == 1u) src = arg(1) + 4u * (uint64_t(i) * k_stride + head * d);
    else src = arg(2) + 4u * (uint64_t(i) * k_stride + v_offset + head * d);
    float v[16];
    float ss = 0.0;
    [[unroll]] for (uint j = 0u; j < 16u; j++) {
        v[j] = j < per ? F32(src).v[lane + 32u * j] : 0.0;
        ss += v[j] * v[j];
    }
    ss = subgroupAdd(ss);
    const float scale = inversesqrt(ss / float(d) + eps);
    const uint64_t wn = kind == 0u ? arg(3) : arg(4);
    [[unroll]] for (uint j = 0u; j < 16u; j++) {
        if (j < per) {
            v[j] = v[j] * scale;
            if (kind != 2u) v[j] = v[j] * F32(wn).v[lane + 32u * j];
        }
    }
    const uint p = pos0 + i;
    if (kind != 2u) {
        const uint half_per = per / 2u;
        [[unroll]] for (uint j = 0u; j < half_per; j++) {
            {
                const uint pi = lane + 32u * j;
                bool turn = true;
                float inv_freq = pow(base, -2.0 * float(pi) / float(d));
                if (has_ff) {
                    const float ff = F32(arg(8)).v[pi];
                    turn = ff < 1e20;
                    inv_freq = inv_freq / ff;
                }
                if (turn) {
                    // The angle reduced to [-pi, pi] (2 pi in two parts)
                    // before the hardware sin and cos.
                    const float a0 = float(p) * inv_freq;
                    const float n2p = round(a0 * 0.15915494309189535);
                    precise float ang = (a0 - n2p * 6.28125) - n2p * 1.9353071795864769e-3;
                    const float c = cos(ang), s = sin(ang);
                    const float lo = v[j], hi = v[j + half_per];
                    precise float r_lo = lo * c - hi * s;
                    precise float r_hi = hi * c + lo * s;
                    v[j] = r_lo;
                    v[j + half_per] = r_hi;
                }
            }
        }
    }
    if (kind == 0u) {
        const uint64_t O = arg(5) + 4u * (uint64_t(i) * H * d + head * d);
        [[unroll]] for (uint j = 0u; j < 16u; j++) if (j < per) F32(O).v[lane + 32u * j] = v[j];
    } else {
        const uint64_t C = (kind == 1u ? arg(6) : arg(7))
                         + 2u * ((uint64_t(p % ring) * kvh + head) * d);
        [[unroll]] for (uint j = 0u; j < 16u; j++) {
            if (j < per) F16(C).v[lane + 32u * j] = float16_t(v[j]);
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// Attention, decode (a few rows): row i (position pos0 + i) attends keys
// [lo, pos] (lo = pos - window + 1 with a window, else 0), split in chunks
// of 256 keys: threadgroup (c, h, i) takes keys lo + 256 c .., subgroup s
// of them 32 in turn with an online softmax (scale 1), the eight subgroups
// merged; writes the chunk's (max, sum, weighted values[d]) for
// gemma4_attn_combine. Grid (chunks, H, m), 256 threads.
// Buffers: 0 q [m][H][d], 1 K cache, 2 V cache, 3 partial
// [m][H][chunks][d + 2]. Params: 4 d, 5 H, 6 kvh, 7 pos0, 8 ring,
// 9 window (0: none), 10 chunks.
// ---------------------------------------------------------------------------
#if defined(KERNEL_gemma4_attn_decode_256) || defined(KERNEL_gemma4_attn_prefill_256)
#define G4_D 256u
#elif defined(KERNEL_gemma4_attn_decode_512) || defined(KERNEL_gemma4_attn_prefill_512)
#define G4_D 512u
#endif
#ifdef G4_D
// The online-softmax step of one key for a subgroup: s the score (uniform).
#define G4_ATTN_STEP(s, vrow)                                                 \
    {                                                                       \
        const float mn = max(mx, s);                                        \
        const float a = exp(mx - mn), b = exp(s - mn);                      \
        sum = sum * a + b;                                                  \
        [[unroll]] for (uint j = 0u; j < 16u; j++) {                        \
            if (j < per) acc[j] = acc[j] * a + b * float(F16(vrow).v[lane + 32u * j]); \
        }                                                                   \
        mx = mn;                                                            \
    }
#endif

#if defined(KERNEL_gemma4_attn_decode_256) || defined(KERNEL_gemma4_attn_decode_512)
shared float g4_m[8], g4_l[8];
shared float g4_acc[8][512];
void main() {
    const uint d = G4_D;
    const uint H = arg_u32(5);
    const uint kvh = arg_u32(6);
    const uint pos0 = arg_u32(7);
    const uint ring = arg_u32(8);
    const uint window = arg_u32(9);
    const uint chunks = arg_u32(10);
    const uint c = gl_WorkGroupID.x, h = gl_WorkGroupID.y, i = gl_WorkGroupID.z;
    const uint kv = h / (H / kvh);
    const uint lane = gl_SubgroupInvocationID, sg = gl_SubgroupID;
    const uint per = G4_D / 32u;
    const uint pos = pos0 + i;
    const uint lo = (window != 0u && pos + 1u > window) ? pos + 1u - window : 0u;
    const uint64_t Q = arg(0) + 4u * ((uint64_t(i) * H + h) * d);
    float q[16];
    [[unroll]] for (uint j = 0u; j < 16u; j++) q[j] = j < per ? F32(Q).v[lane + 32u * j] : 0.0;
    float mx = -1.0 / 0.0, sum = 0.0;
    float acc[16];
    [[unroll]] for (uint j = 0u; j < 16u; j++) acc[j] = 0.0;
    const uint first = lo + 256u * c + 32u * sg;
    for (uint t = 0u; t < 32u; t++) {
        const uint key = first + t;
        if (key > pos) break;
        const uint64_t off = 2u * ((uint64_t(key % ring) * kvh + kv) * d);
        const uint64_t krow = arg(1) + off;
        float dot = 0.0;
        [[unroll]] for (uint j = 0u; j < 16u; j++) {
            if (j < per) dot += q[j] * float(F16(krow).v[lane + 32u * j]);
        }
        const float s = subgroupAdd(dot);
        const uint64_t vrow = arg(2) + off;
        G4_ATTN_STEP(s, vrow)
    }
    if (lane == 0u) {
        g4_m[sg] = mx;
        g4_l[sg] = sum;
    }
    [[unroll]] for (uint j = 0u; j < 16u; j++) if (j < per) g4_acc[sg][lane + 32u * j] = acc[j];
    barrier();
    float M = -1.0 / 0.0;
    [[unroll]] for (uint s = 0u; s < 8u; s++) M = max(M, g4_m[s]);
    const uint64_t P = arg(3) + 4u * (((uint64_t(i) * H + h) * chunks + c) * (d + 2u));
    float L = 0.0;
    float f[8];
    [[unroll]] for (uint s = 0u; s < 8u; s++) {
        f[s] = g4_m[s] == -1.0 / 0.0 ? 0.0 : exp(g4_m[s] - M);
        L += g4_l[s] * f[s];
    }
    for (uint e = gl_LocalInvocationIndex; e < d; e += 256u) {
        float a = 0.0;
        [[unroll]] for (uint s = 0u; s < 8u; s++) a += g4_acc[s][e] * f[s];
        F32(P).v[2u + e] = a;
    }
    if (gl_LocalInvocationIndex == 0u) {
        F32(P).v[0] = M;
        F32(P).v[1] = L;
    }
}
#endif

// ---------------------------------------------------------------------------
// The chunks' merge: heads[i][h][e] = sum_c acc_c[e] e^(m_c - M) / sum_c
// l_c e^(m_c - M). Grid (H, m), 256 threads.
// Buffers: 0 partial, 1 heads [m][H][d]. Params: 2 d, 3 H, 4 chunks.
// ---------------------------------------------------------------------------
#ifdef KERNEL_gemma4_attn_combine
void main() {
    const uint d = arg_u32(2);
    const uint H = arg_u32(3);
    const uint chunks = arg_u32(4);
    const uint h = gl_WorkGroupID.x, i = gl_WorkGroupID.y;
    const uint64_t P = arg(0) + 4u * ((uint64_t(i) * H + h) * chunks * (d + 2u));
    float M = -1.0 / 0.0;
    for (uint c = 0u; c < chunks; c++) M = max(M, F32(P).v[c * (d + 2u)]);
    float L = 0.0;
    for (uint c = 0u; c < chunks; c++) {
        const float m = F32(P).v[c * (d + 2u)];
        if (m != -1.0 / 0.0) L += F32(P).v[c * (d + 2u) + 1u] * exp(m - M);
    }
    const uint64_t O = arg(1) + 4u * ((uint64_t(i) * H + h) * d);
    for (uint e = gl_LocalInvocationIndex; e < d; e += 256u) {
        float a = 0.0;
        for (uint c = 0u; c < chunks; c++) {
            const float m = F32(P).v[c * (d + 2u)];
            if (m != -1.0 / 0.0) a += F32(P).v[c * (d + 2u) + 2u + e] * exp(m - M);
        }
        F32(O).v[e] = a / L;
    }
}
#endif

// ---------------------------------------------------------------------------
// Attention, prompt runs: a subgroup a row (eight rows a threadgroup, one
// head), every key of the row's range in turn, online softmax.
// Grid (ceil(m / 8), H), 256 threads.
// Buffers: 0 q [m][H][d], 1 K cache, 2 V cache, 3 heads [m][H][d].
// Params: 4 d, 5 H, 6 kvh, 7 pos0, 8 ring, 9 window, 10 m.
// ---------------------------------------------------------------------------
#if defined(KERNEL_gemma4_attn_prefill_256) || defined(KERNEL_gemma4_attn_prefill_512)
void main() {
    const uint d = G4_D;
    const uint H = arg_u32(5);
    const uint kvh = arg_u32(6);
    const uint pos0 = arg_u32(7);
    const uint ring = arg_u32(8);
    const uint window = arg_u32(9);
    const uint m = arg_u32(10);
    const uint h = gl_WorkGroupID.y;
    const uint i = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    if (i >= m) return;
    const uint kv = h / (H / kvh);
    const uint lane = gl_SubgroupInvocationID;
    const uint per = G4_D / 32u;
    const uint pos = pos0 + i;
    const uint lo = (window != 0u && pos + 1u > window) ? pos + 1u - window : 0u;
    const uint64_t Q = arg(0) + 4u * ((uint64_t(i) * H + h) * d);
    float q[16];
    [[unroll]] for (uint j = 0u; j < 16u; j++) q[j] = j < per ? F32(Q).v[lane + 32u * j] : 0.0;
    float mx = -1.0 / 0.0, sum = 0.0;
    float acc[16];
    [[unroll]] for (uint j = 0u; j < 16u; j++) acc[j] = 0.0;
    for (uint key = lo; key <= pos; key++) {
        const uint64_t off = 2u * ((uint64_t(key % ring) * kvh + kv) * d);
        const uint64_t krow = arg(1) + off;
        float dot = 0.0;
        [[unroll]] for (uint j = 0u; j < 16u; j++) {
            if (j < per) dot += q[j] * float(F16(krow).v[lane + 32u * j]);
        }
        const float s = subgroupAdd(dot);
        const uint64_t vrow = arg(2) + off;
        G4_ATTN_STEP(s, vrow)
    }
    const uint64_t O = arg(3) + 4u * ((uint64_t(i) * H + h) * d);
    [[unroll]] for (uint j = 0u; j < 16u; j++) if (j < per) F32(O).v[lane + 32u * j] = acc[j] / sum;
}
#endif

// ---------------------------------------------------------------------------
// GeGLU: out[e] = gelu(g[e]) * u[e]. Grid::Threads (n).
// Buffers: 0 g, 1 u, 2 out. Params: 3 n.
// ---------------------------------------------------------------------------
#ifdef KERNEL_gemma4_geglu
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint e = gl_GlobalInvocationID.x;
    F32(arg(2)).v[e] = gemma4_gelu(F32(arg(0)).v[e]) * F32(arg(1)).v[e];
}
#endif

// ---------------------------------------------------------------------------
// The router (llama.cpp build_moe_ffn, softmax gating, weights normalized):
// p = softmax(logits); the k largest p (ties to the lower id); weight
// p_e / max(sum of the k, 2^-14) * down_scale[e] (Gemma's per-expert scale
// of the down projection's output, folded in). A subgroup a row.
// Buffers: 0 logits [m][E], 1 down_scale [E], 2 sel u32 [m][k],
// 3 weights [m][k]. Params: 4 E (<= 256), 5 k.
// ---------------------------------------------------------------------------
#ifdef KERNEL_gemma4_router
void main() {
    const uint E = arg_u32(4);
    const uint K = arg_u32(5);
    const uint i = gl_WorkGroupID.x;
    const uint lane = gl_SubgroupInvocationID;
    const uint64_t L = arg(0) + 4u * uint64_t(i) * E;
    float v[8];
    float mx = -1.0 / 0.0;
    [[unroll]] for (uint j = 0u; j < 8u; j++) {
        const uint e = lane + 32u * j;
        v[j] = e < E ? F32(L).v[e] : -1.0 / 0.0;
        mx = max(mx, v[j]);
    }
    mx = subgroupMax(mx);
    float s = 0.0;
    [[unroll]] for (uint j = 0u; j < 8u; j++) {
        v[j] = lane + 32u * j < E ? exp(v[j] - mx) : 0.0;
        s += v[j];
    }
    s = subgroupAdd(s);
    [[unroll]] for (uint j = 0u; j < 8u; j++) v[j] = v[j] / s;
    // Selection by k rounds of an argmax; taken entries become -1.
    float wsel = 0.0, chosen_sum = 0.0;
    uint my_e = 0u;
    for (uint r = 0u; r < K; r++) {
        float best = -1.0;
        uint best_e = 0xffffffffu;
        [[unroll]] for (uint j = 0u; j < 8u; j++) {
            if (v[j] > best) {
                best = v[j];
                best_e = lane + 32u * j;
            }
        }
        const float top = subgroupMax(best);
        const uint e = subgroupMin(best == top ? best_e : 0xffffffffu);
        chosen_sum += top;
        if (lane == r) {
            my_e = e;
            wsel = top;
        }
        [[unroll]] for (uint j = 0u; j < 8u; j++) if (lane + 32u * j == e) v[j] = -1.0;
    }
    if (lane < K) {
        const float w = wsel / max(chosen_sum, 6.103515625e-5);
        U32(arg(2)).v[i * K + lane] = my_e;
        F32(arg(3)).v[i * K + lane] = w * F32(arg(1)).v[my_e];
    }
}
#endif

// ---------------------------------------------------------------------------
// Routed experts, gate and up (one tensor: expert e's rows 2 F e .. are the
// gate's F rows, then the up's) with GeGLU: mid[i * used + s][r] =
// gelu(gate_e x[i]) * up_e x[i] for the `used` experts sel[i]. A subgroup a
// row r. Grid (ceil(F / 8), m * used), 256 threads.
// Buffers: 0 gate_up experts, 1 x [m][K], 2 sel, 3 mid [m * used][F].
// Params: 4 K, 5 F, 6 row_bytes, 7 used.
// ---------------------------------------------------------------------------
#if defined(KERNEL_gemma4_moe_gate_up_q8_0) || defined(KERNEL_gemma4_moe_gate_up_q5_k) || \
    defined(KERNEL_gemma4_moe_gate_up_q6_k) || defined(KERNEL_gemma4_moe_gate_up_iq2_xxs) || \
    defined(KERNEL_gemma4_moe_gate_up_iq2_s) || defined(KERNEL_gemma4_moe_gate_up_q4_k)
#if defined(KERNEL_gemma4_moe_gate_up_q8_0)
#define MOE_TYPE GLM53_Q8_0
#elif defined(KERNEL_gemma4_moe_gate_up_q5_k)
#define MOE_TYPE GLM53_Q5_K
#elif defined(KERNEL_gemma4_moe_gate_up_q6_k)
#define MOE_TYPE GLM53_Q6_K
#elif defined(KERNEL_gemma4_moe_gate_up_iq2_xxs)
#define MOE_TYPE GLM53_IQ2_XXS
#elif defined(KERNEL_gemma4_moe_gate_up_iq2_s)
#define MOE_TYPE GLM53_IQ2_S
#else
#define MOE_TYPE GLM53_Q4_K
#endif
void main() {
    const uint K = arg_u32(4);
    const uint F = arg_u32(5);
    const uint row_bytes = arg_u32(6);
    const uint used = arg_u32(7);
    const uint slot = gl_WorkGroupID.y;
    const uint i = slot / used;
    const uint r = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    if (r >= F) return;
    const uint e = U32(arg(2)).v[slot];
    const uint64_t gate = arg(0) + (uint64_t(e) * 2u * F + r) * row_bytes;
    const uint64_t up = gate + uint64_t(F) * row_bytes;
    const uint64_t X = arg(1) + 4u * uint64_t(i) * K;
    const uint tasks = K / GLM53_TASK;
    float ag = 0.0, au = 0.0;
    for (uint t = gl_SubgroupInvocationID; t < tasks; t += 32u) {
#ifdef KERNEL_gemma4_moe_gate_up_iq2_xxs
        vec4 xv[8];
        [[unroll]] for (uint q = 0u; q < 8u; q++) xv[q] = F32x4(X).v[8u * t + q];
        ag += glm53_dot_iq2_xxs(gate, t, xv);
        au += glm53_dot_iq2_xxs(up, t, xv);
#else
        float w[32];
        glm53_decode(MOE_TYPE, gate, t, w);
        ag += glm53_task_dot(w, X + 128u * t);
        glm53_decode(MOE_TYPE, up, t, w);
        au += glm53_task_dot(w, X + 128u * t);
#endif
    }
    ag = subgroupAdd(ag);
    au = subgroupAdd(au);
    if (gl_SubgroupInvocationID == 0u) F32(arg(3)).v[slot * F + r] = gemma4_gelu(ag) * au;
}
#endif

// ---------------------------------------------------------------------------
// Routed experts, down and the weighted sum: out[i][r] = sum_s w[i][s] *
// down_{sel[i][s]}[r] . mid[i * used + s]. Down rows are F values (Gemma:
// 704 = 22 tasks): a subgroup an output row, its lanes over the (slot,
// task) pairs. Grid (ceil(H / 8), m), 256 threads.
// Buffers: 0 down experts, 1 mid, 2 sel, 3 weights, 4 out [m][H].
// Params: 5 F, 6 H, 7 row_bytes, 8 used.
// ---------------------------------------------------------------------------
#if defined(KERNEL_gemma4_moe_down_q8_0) || defined(KERNEL_gemma4_moe_down_iq4_nl) || \
    defined(KERNEL_gemma4_moe_down_q4_0)
#if defined(KERNEL_gemma4_moe_down_q8_0)
#define MOE_TYPE GLM53_Q8_0
#elif defined(KERNEL_gemma4_moe_down_iq4_nl)
#define MOE_TYPE GLM53_IQ4_NL
#else
#define MOE_TYPE GLM53_Q4_0
#endif
void main() {
    const uint F = arg_u32(5);
    const uint H = arg_u32(6);
    const uint row_bytes = arg_u32(7);
    const uint used = arg_u32(8);
    const uint i = gl_WorkGroupID.y;
    const uint r = gl_WorkGroupID.x * 8u + gl_SubgroupID;
    if (r >= H) return;
    const uint tasks = F / GLM53_TASK;
    float acc = 0.0;
    for (uint u = gl_SubgroupInvocationID; u < used * tasks; u += 32u) {
        const uint s = u / tasks, t = u - s * tasks;
        const uint slot = i * used + s;
        const uint e = U32(arg(2)).v[slot];
        const uint64_t row = arg(0) + (uint64_t(e) * H + r) * row_bytes;
        float w[32];
        glm53_decode(MOE_TYPE, row, t, w);
        acc += F32(arg(3)).v[slot] * glm53_task_dot(w, arg(1) + 4u * (uint64_t(slot) * F + t * GLM53_TASK));
    }
    acc = subgroupAdd(acc);
    if (gl_SubgroupInvocationID == 0u) F32(arg(4)).v[i * H + r] = acc;
}
#endif

// ---------------------------------------------------------------------------
// Three RMSNorms of one input: o_j = rmsnorm(x) * w_j. Grid (m), 256
// threads. Buffers: 0 x, 1-3 w, 4-6 o. Params: 7 n, 8 eps.
// ---------------------------------------------------------------------------
#ifdef KERNEL_gemma4_norm3
void main() {
    const uint n = arg_u32(7);
    const float eps = arg_f32(8);
    const uint i = gl_WorkGroupID.x;
    const uint64_t X = arg(0) + 4u * uint64_t(i) * n;
    float ss = 0.0;
    for (uint e = gl_LocalInvocationIndex; e < n; e += 256u) {
        const float v = F32(X).v[e];
        ss += v * v;
    }
    const float scale = inversesqrt(gemma4_tg_sum(ss) / float(n) + eps);
    for (uint e = gl_LocalInvocationIndex; e < n; e += 256u) {
        const float v = F32(X).v[e] * scale;
        [[unroll]] for (uint j = 0u; j < 3u; j++) {
            F32(arg(4u + j) + 4u * uint64_t(i) * n).v[e] = v * F32(arg(1u + j)).v[e];
        }
    }
}
#endif

// ---------------------------------------------------------------------------
// out = rmsnorm(x) * w + add. Grid (m), 256 threads.
// Buffers: 0 x, 1 w, 2 add, 3 out. Params: 4 n, 5 eps.
// ---------------------------------------------------------------------------
#ifdef KERNEL_gemma4_norm_add
void main() {
    const uint n = arg_u32(4);
    const float eps = arg_f32(5);
    const uint i = gl_WorkGroupID.x;
    const uint64_t X = arg(0) + 4u * uint64_t(i) * n;
    float ss = 0.0;
    for (uint e = gl_LocalInvocationIndex; e < n; e += 256u) {
        const float v = F32(X).v[e];
        ss += v * v;
    }
    const float scale = inversesqrt(gemma4_tg_sum(ss) / float(n) + eps);
    const uint64_t A = arg(2) + 4u * uint64_t(i) * n;
    const uint64_t O = arg(3) + 4u * uint64_t(i) * n;
    for (uint e = gl_LocalInvocationIndex; e < n; e += 256u) {
        F32(O).v[e] = F32(X).v[e] * scale * F32(arg(1)).v[e] + F32(A).v[e];
    }
}
#endif

// ---------------------------------------------------------------------------
// The FFN's end: s = rmsnorm(m1) * w1 + rmsnorm(m2) * w2; out =
// (rmsnorm(s) * w + r) * layer_scale. Grid (m), 256 threads; n <= 4096.
// Buffers: 0 m1, 1 m2, 2 w1, 3 w2, 4 w, 5 r, 6 layer_scale [1], 7 out.
// Params: 8 n, 9 eps.
// ---------------------------------------------------------------------------
#ifdef KERNEL_gemma4_ffn_out
shared float g4_s[4096];
void main() {
    const uint n = arg_u32(8);
    const float eps = arg_f32(9);
    const uint i = gl_WorkGroupID.x;
    const uint64_t M1 = arg(0) + 4u * uint64_t(i) * n;
    const uint64_t M2 = arg(1) + 4u * uint64_t(i) * n;
    float s1 = 0.0, s2 = 0.0;
    for (uint e = gl_LocalInvocationIndex; e < n; e += 256u) {
        const float a = F32(M1).v[e], b = F32(M2).v[e];
        s1 += a * a;
        s2 += b * b;
    }
    const float k1 = inversesqrt(gemma4_tg_sum(s1) / float(n) + eps);
    const float k2 = inversesqrt(gemma4_tg_sum(s2) / float(n) + eps);
    float ss = 0.0;
    for (uint e = gl_LocalInvocationIndex; e < n; e += 256u) {
        const float v = F32(M1).v[e] * k1 * F32(arg(2)).v[e] + F32(M2).v[e] * k2 * F32(arg(3)).v[e];
        g4_s[e] = v;
        ss += v * v;
    }
    const float k = inversesqrt(gemma4_tg_sum(ss) / float(n) + eps);
    const float ls = F32(arg(6)).v[0];
    const uint64_t R = arg(5) + 4u * uint64_t(i) * n;
    const uint64_t O = arg(7) + 4u * uint64_t(i) * n;
    for (uint e = gl_LocalInvocationIndex; e < n; e += 256u) {
        F32(O).v[e] = (g4_s[e] * k * F32(arg(4)).v[e] + F32(R).v[e]) * ls;
    }
}
#endif

// ---------------------------------------------------------------------------
// Final logit softcap in place: x = c tanh(x / c). Grid::Threads (n).
// Buffers: 0 x. Params: 1 c.
// ---------------------------------------------------------------------------
#ifdef KERNEL_gemma4_softcap
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint e = gl_GlobalInvocationID.x;
    const float c = arg_f32(1);
    F32(arg(0)).v[e] = c * gemma4_tanh(F32(arg(0)).v[e] / c);
}
#endif
