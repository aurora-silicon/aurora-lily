// Weights k .. k + 8 (k a multiple of 8) of `row`, as glm53_decode gives
// them.
void gd_decode8(uint64_t row, uint k, out float w[8]) {
#ifdef KERNEL_glm53_gemm_q5_k
    // Q5_K values k .. k + 8 of their 32-value sub-block j: nibbles of
    // bytes 32 (j / 2) + l .., high bit j of bytes l .. (l = k % 32).
    const uint64_t b = row + uint64_t(k >> 8u) * 176u;
    const uint j = (k >> 5u) & 7u, l = k & 31u;
    uint sc, mn;
    glm53_k4_scale_min(b, j, sc, mn);
    const uint dd = U32(b).v[0];
    const float scale = glm53_h2f(dd & 0xffffu) * float(sc);
    const float minv = glm53_h2f(dd >> 16u) * float(mn);
    const uvec2 q = U32x2(b + 48u + (j >> 1u) * 32u + l).v[0] >> ((j & 1u) * 4u);
    const uvec2 h = U32x2(b + 16u + l).v[0] >> j;
    [[unroll]] for (uint i = 0u; i < 8u; i++) {
        const uint c = ((q[i >> 2u] >> (8u * (i & 3u))) & 0xfu) | (((h[i >> 2u] >> (8u * (i & 3u))) & 1u) << 4u);
        w[i] = scale * float(c) - minv;
    }
    return;
#endif
#ifdef KERNEL_glm53_gemm_q6_k
    // Q6_K values 8 o .. 8 o + 8 of task t (o = k / 8 % 4), as
    // glm53_decode_q6_k computes them: low nibbles of bytes ql + 8 o ..,
    // two high bits of bytes qh + 8 o .., the scale of their 16-value half.
    const uint ts = k >> 5u, o = (k >> 3u) & 3u;
    const uint64_t b = row + uint64_t(ts >> 3u) * 210u;
    const uint n = (ts >> 2u) & 1u, q = ts & 3u;
    const float d = glm53_h2f(uint(U16(b).v[104]));
    const uint sw = uint(U16(b + 192u).v[4u * n + q]);
    precise float s = d * float(int(sw << (o < 2u ? 24u : 16u)) >> 24);
    const uint64_t ql = b + 64u * n + 32u * (q & 1u) + 8u * o;
    const uint64_t qh = b + 128u + 32u * n + 8u * o;
    const uint lshift = 4u * (q >> 1u), hshift = 2u * q;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const uint lo = uint(U16(ql).v[i]) >> lshift;
        const uint hi = uint(U16(qh).v[i]) >> hshift;
        [[unroll]] for (uint c2 = 0u; c2 < 2u; c2++) {
            const uint c = ((lo >> (8u * c2)) & 0xfu) | (((hi >> (8u * c2)) & 3u) << 4u);
            precise float v = s * float(int(c) - 32);
            w[2u * i + c2] = v;
        }
    }
    return;
#endif
#ifdef GEMM_GENERIC
    float t[32];
    glm53_decode(GEMM_TYPE, row, k >> 5u, t);
    [[unroll]] for (uint i = 0u; i < 8u; i++) w[i] = t[(k & 24u) + i];
    return;
#endif
    if (GEMM_TYPE == GLM53_Q8_0) {
        const uint64_t b = row + uint64_t(k >> 5u) * 34u;
        const float d = glm53_h2f(uint(U16(b).v[0]));
        [[unroll]] for (uint i = 0u; i < 4u; i++) {
            const uint pair = uint(U16(b + 2u).v[((k & 31u) >> 1u) + i]);
            w[2u * i] = d * float(int(pair << 24) >> 24);
            w[2u * i + 1u] = d * float(int(pair << 16) >> 24);
        }
    } else if (GEMM_TYPE == GLM53_Q4_K) {
        const uint64_t b = row + uint64_t(k >> 8u) * 144u;
        const uint j = (k >> 5u) & 7u;
        const uint dd = U32(b).v[0];
        const float d = glm53_h2f(dd & 0xffffu);
        const float dmin = glm53_h2f(dd >> 16u);
        const uvec3 sw = uvec3(U32(b + 4u).v[0], U32(b + 8u).v[0], U32(b + 12u).v[0]);
        #define Q4K_BYTE(i) ((sw[(i) >> 2u] >> (8u * ((i) & 3u))) & 0xffu)
        uint sc, m;
        if (j < 4u) {
            sc = Q4K_BYTE(j) & 63u;
            m = Q4K_BYTE(j + 4u) & 63u;
        } else {
            sc = (Q4K_BYTE(j + 4u) & 0xfu) | ((Q4K_BYTE(j - 4u) >> 6u) << 4u);
            m = (Q4K_BYTE(j + 4u) >> 4u) | ((Q4K_BYTE(j) >> 6u) << 4u);
        }
        #undef Q4K_BYTE
        const float scale = d * float(sc);
        const float minv = dmin * float(m);
        const uvec2 q = U32x2(b + 16u + (j >> 1u) * 32u + (k & 31u)).v[0] >> ((j & 1u) * 4u);
        [[unroll]] for (uint i = 0u; i < 8u; i++) {
            w[i] = scale * float((q[i >> 2u] >> (8u * (i & 3u))) & 0xfu) - minv;
        }
    } else if (GEMM_TYPE == GLM53_BF16) {
        const uvec4 v = U32x4(row + 2u * k).v[0];
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            w[2u * c] = uintBitsToFloat(v[c] << 16u);
            w[2u * c + 1u] = uintBitsToFloat(v[c] & 0xffff0000u);
        }
    } else if (GEMM_TYPE == GLM53_F16) {
        const uvec4 v = U32x4(row + 2u * k).v[0];
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            const vec2 h = unpackHalf2x16(v[c]);
            w[2u * c] = h.x;
            w[2u * c + 1u] = h.y;
        }
    } else {
        const vec4 v0 = F32x4(row + 4u * k).v[0], v1 = F32x4(row + 4u * k + 16u).v[0];
        [[unroll]] for (uint c = 0u; c < 4u; c++) {
            w[c] = v0[c];
            w[4u + c] = v1[c];
        }
    }
}


#ifdef GEMM_BX
// The bfloat-input form: X's rows as bfloat words (two uvec4 an A operand,
// as the expert GEMM), the tile and its decode as below, but a tile serves
// GM_BX_SG subgroups of GM_BX_SUB rows each, so each weight is decoded
// once for 256 rows. gemm_timing, kda_v 8192 x 4096 at 1 024 rows
// (2026-11-14): f32 input 2.68 ms; bfloat input with 64-row tiles 2.09,
// 4 x 32 rows 1.60, 8 x 32 rows 1.58 (43.6 TFLOP/s); 4 x 64 rows spills
// (7.5). GEMM_BX_ROWS in glm53.rs is GM_BX_SG * GM_BX_SUB.
#define GM_BX_SUB 32u
// Subgroups a threadgroup: 4 (a thread decodes 8 values of 4 weight rows a
// step) or 8 (of 2 rows).
#ifndef GM_BX_SG
#define GM_BX_SG 8
#endif
void main() {
    const uint M = arg_u32(3);
    const uint N = arg_u32(4);
    const uint K = arg_u32(5);
    const uint row_bytes = arg_u32(6);
    const uint ldx = arg_u32(7);
    const uint ldy = arg_u32(8);
    const uint batch = gl_WorkGroupID.z;
    const uint64_t X = arg(0) + 2u * uint64_t(batch) * arg_u32(9);
    const uint64_t W = arg(1) + uint64_t(batch) * arg_u32(10) * row_bytes;
    const uint64_t Y = arg(2) + 4u * uint64_t(batch) * arg_u32(11);
    const uint m0 = gl_WorkGroupID.y * (GM_BX_SG * GM_BX_SUB);
    const uint n0 = gl_WorkGroupID.x * 64u;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
#define GM_WR (16u / GM_BX_SG)
    // This thread's weight rows GM_WR q .. of the tile, values 8 k8 .. of a step.
    const uint q = tid & (64u / GM_WR - 1u), k8 = tid / (64u / GM_WR);
    uint64_t wr[GM_WR];
    [[unroll]] for (uint r = 0u; r < GM_WR; r++) wr[r] = W + uint64_t(min(n0 + GM_WR * q + r, N - 1u)) * row_bytes;
    const uint rows = min(GM_BX_SG * GM_BX_SUB, M - m0);
    const uint row0 = GM_BX_SUB * sg;
    const bool working = row0 < rows;
    const uint lane_row = mat_lane_row(), a_half = mat_a_half(), odd16 = 16u * mat_a_odd();
    // The lanes' rows of X (two per 16), in vectors of eight bfloats.
    uint xi[GM_BX_SUB / 8u];
    [[unroll]] for (uint h = 0u; h < GM_BX_SUB / 8u; h++) {
        xi[h] = (m0 + min(row0 + 8u * (h >> 1u) * 2u + lane_row + (h & 1u), rows - 1u)) * (ldx / 8u) + a_half;
    }
    U32x4 xa = U32x4(X);
    const uint lane_at = lane_row * 8u + mat_lane_col() / 4u;
    MatC acc[GM_BX_SUB / 16u][4];
    [[unroll]] for (uint i = 0u; i < GM_BX_SUB / 16u; i++) {
        [[unroll]] for (uint c = 0u; c < 4u; c++) acc[i][c] = MatC(0.0);
    }
    for (uint k0 = 0u; k0 < K; k0 += GM_STEP) {
        const uint tile_at = ((k0 / GM_STEP) & 1u) * (GM_STEP * 8u);
        {
            float w[GM_WR][8];
            [[unroll]] for (uint r = 0u; r < GM_WR; r++) gd_decode8(wr[r], k0 + 8u * k8, w[r]);
#if GM_BX_SG == 4
            GM_STORE_TILE(tile_at + 64u * k8 + q, w)
#else
            // Rows 2 q, 2 q + 1: words (q & 1) and 2 + (q & 1) of vector
            // q / 2 of each pair of values.
            [[unroll]] for (uint i = 0u; i < 4u; i++) {
                const uint at = tile_at + 64u * k8 + 16u * i + q / 2u;
                gm_tile[at][q & 1u] = gm_pair(gm_round_w(w[0][2u * i]), gm_round_w(w[1][2u * i]));
                gm_tile[at][2u + (q & 1u)] = gm_pair(gm_round_w(w[0][2u * i + 1u]), gm_round_w(w[1][2u * i + 1u]));
            }
#endif
        }
        barrier();
        if (working) {
            [[unroll]] for (uint kk = 0u; kk < GM_STEP; kk += 16u) {
                const uint at = (k0 + kk) / 8u;
                uvec4 v[GM_BX_SUB / 8u];
                [[unroll]] for (uint h = 0u; h < GM_BX_SUB / 8u; h++) v[h] = xa.v[xi[h] + at];
                const uint b_at = tile_at + lane_at + kk * 8u;
                const uvec4 b0 = gm_tile[b_at], b1 = gm_tile[b_at + 4u];
                const uvec4 b2 = gm_tile[b_at + 8u], b3 = gm_tile[b_at + 12u];
                [[unroll]] for (uint i = 0u; i < GM_BX_SUB / 16u; i++) {
                    MatA ma;
                    MatB mb;
                    MAT_A_OF_ROWS(ma, v[2u * i], v[2u * i + 1u], odd16)
                    MAT_OF_WORDS(mb, b0)
                    acc[i][0] = coopMatMulAdd(ma, mb, acc[i][0]);
                    MAT_OF_WORDS(mb, b1)
                    acc[i][1] = coopMatMulAdd(ma, mb, acc[i][1]);
                    MAT_OF_WORDS(mb, b2)
                    acc[i][2] = coopMatMulAdd(ma, mb, acc[i][2]);
                    MAT_OF_WORDS(mb, b3)
                    acc[i][3] = coopMatMulAdd(ma, mb, acc[i][3]);
                }
            }
        }
    }
    if (!working) return;
    const uint col = n0 + mat_lane_col();
    [[unroll]] for (uint i = 0u; i < GM_BX_SUB / 16u; i++) {
        [[unroll]] for (uint h = 0u; h < 2u; h++) {
            const uint r = row0 + 16u * i + lane_row + h;
            if (r < rows) {
                const uint64_t y = Y + 4u * uint64_t(m0 + r) * ldy;
                [[unroll]] for (uint c = 0u; c < 4u; c++) {
                    [[unroll]] for (uint j = 0u; j < 4u; j++) {
                        if (col + 16u * c + j < N) F32(y).v[col + 16u * c + j] = acc[i][c][4u * h + j];
                    }
                }
            }
        }
    }
}
#else
// The dense GEMM in the expert GEMM's layout (below): every thread decodes
// 8 values of 4 weight rows of a 64-deep step into the tile in the lanes'
// order, and a subgroup multiplies its 16 rows of X against all 64 columns,
// reading X straight from device memory as floats and rounding to bfloat
// only the elements its lanes hold (a lane of an A operand uses every other
// value of eight). K must be a multiple of 64 (gemm_with checks it).
void main() {
    const uint M = arg_u32(3);
    const uint N = arg_u32(4);
    const uint K = arg_u32(5);
    const uint row_bytes = arg_u32(6);
    const uint ldx = arg_u32(7);
    const uint ldy = arg_u32(8);
    const uint batch = gl_WorkGroupID.z;
    const uint64_t X = arg(0) + 4u * uint64_t(batch) * arg_u32(9);
    const uint64_t W = arg(1) + uint64_t(batch) * arg_u32(10) * row_bytes;
    const uint64_t Y = arg(2) + 4u * uint64_t(batch) * arg_u32(11);
    const uint m0 = gl_WorkGroupID.y * 64u;
    const uint n0 = gl_WorkGroupID.x * 64u;
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    const uint quad = tid & 15u, k8 = tid >> 4u;
    uint64_t wr[4];
    [[unroll]] for (uint r = 0u; r < 4u; r++) wr[r] = W + uint64_t(min(n0 + 4u * quad + r, N - 1u)) * row_bytes;
    const uint rows = min(64u, M - m0);
    const uint row0 = 16u * sg;
    const bool working = row0 < rows;
    const uint lane_row = mat_lane_row(), a_half = mat_a_half();
    const bool odd = mat_a_odd() != 0u;
    // The lanes' two rows of X, in vec4 units (ldx is a multiple of 4).
    const uint xi0 = (m0 + min(row0 + lane_row, rows - 1u)) * (ldx / 4u) + 2u * a_half;
    const uint xi1 = (m0 + min(row0 + lane_row + 1u, rows - 1u)) * (ldx / 4u) + 2u * a_half;
    F32x4 xa = F32x4(X);
    const uint lane_at = lane_row * 8u + mat_lane_col() / 4u;
    MatC acc0 = MatC(0.0), acc1 = MatC(0.0), acc2 = MatC(0.0), acc3 = MatC(0.0);
    for (uint k0 = 0u; k0 < K; k0 += GM_STEP) {
        const uint tile_at = ((k0 / GM_STEP) & 1u) * (GM_STEP * 8u);
        {
            float w[4][8];
            [[unroll]] for (uint r = 0u; r < 4u; r++) gd_decode8(wr[r], k0 + 8u * k8, w[r]);
            GM_STORE_TILE(tile_at + 64u * k8 + quad, w)
        }
        barrier();
        if (working) {
            [[unroll]] for (uint kk = 0u; kk < GM_STEP; kk += 16u) {
                const uint at = (k0 + kk) / 4u;
                const vec4 p0 = xa.v[xi0 + at], p1 = xa.v[xi0 + at + 1u];
                const vec4 q0 = xa.v[xi1 + at], q1 = xa.v[xi1 + at + 1u];
                const uint b_at = tile_at + lane_at + kk * 8u;
                const uvec4 b0 = gm_tile[b_at], b1 = gm_tile[b_at + 4u];
                const uvec4 b2 = gm_tile[b_at + 8u], b3 = gm_tile[b_at + 12u];
                MatA ma;
                MatB mb;
                // Element e of the lane's row is value 2 e + odd of the eight.
                ma[0] = MAT_HI(gm_round(odd ? p0.y : p0.x));
                ma[1] = MAT_HI(gm_round(odd ? p0.w : p0.z));
                ma[2] = MAT_HI(gm_round(odd ? p1.y : p1.x));
                ma[3] = MAT_HI(gm_round(odd ? p1.w : p1.z));
                ma[4] = MAT_HI(gm_round(odd ? q0.y : q0.x));
                ma[5] = MAT_HI(gm_round(odd ? q0.w : q0.z));
                ma[6] = MAT_HI(gm_round(odd ? q1.y : q1.x));
                ma[7] = MAT_HI(gm_round(odd ? q1.w : q1.z));
                MAT_OF_WORDS(mb, b0)
                acc0 = coopMatMulAdd(ma, mb, acc0);
                MAT_OF_WORDS(mb, b1)
                acc1 = coopMatMulAdd(ma, mb, acc1);
                MAT_OF_WORDS(mb, b2)
                acc2 = coopMatMulAdd(ma, mb, acc2);
                MAT_OF_WORDS(mb, b3)
                acc3 = coopMatMulAdd(ma, mb, acc3);
            }
        }
    }
    if (!working) return;
    const uint col = n0 + mat_lane_col();
    [[unroll]] for (uint h = 0u; h < 2u; h++) {
        const uint r = row0 + lane_row + h;
        if (r < rows) {
            const uint64_t y = Y + 4u * uint64_t(m0 + r) * ldy;
            [[unroll]] for (uint c = 0u; c < 4u; c++) {
                if (col + c < N) F32(y).v[col + c] = acc0[4u * h + c];
                if (col + 16u + c < N) F32(y).v[col + 16u + c] = acc1[4u * h + c];
                if (col + 32u + c < N) F32(y).v[col + 32u + c] = acc2[4u * h + c];
                if (col + 48u + c < N) F32(y).v[col + 48u + c] = acc3[4u * h + c];
            }
        }
    }
}
#endif // GEMM_BX
#endif

// ---------------------------------------------------------------------------
// Routed experts over a run of rows, grouped by expert (the layout of
// quant_grouped.glsl, Qwen's grouped GEMM): tile y is tiles[y] = (expert,
// first, count) of the expert-sorted pair list `pairs` (glm53_moe_group);
// its rows are pairs[first ..], X row pairs[k] >> x_shift (the token for
// gate/up, the pair for down; x_shift with bit 31 set divides by its low
// bits instead, for a slot count that is not a power of two), Y row pairs[k]. X is bfloat (glm53_to_bf16,
// glm53_moe_swiglu), read by each subgroup straight from device memory
// (MAT_A_OF_ROWS). A threadgroup of four subgroups computes 64 rows x 64
// columns (128 rows, 32 a subgroup, in the _r128 variants); a subgroup
// owns 16 rows (none past the tile's: no multiplies) and all 64 columns,
// and every thread dequantizes 8 weights of 4 weight rows a 64-deep K step
// into the tile in the lanes' order (one load per B operand), two tiles in
// turn so one barrier a step. The decoded values are glm53_decode's,
// rounded to bfloat as before.
// Buffers: 0 X (bfloat), 1 W (the expert stack), 2 Y f32, 3 pairs u32,
// 4 tiles u32 [3 per tile], 5 tile count u32. Params: 6 N (rows per
// expert), 7 K (a multiple of 256), 8 row_bytes, 9 x_shift.
// glm53_gemm_moe_gate_up_iq2_xxs computes gate (W) and up (buffer 6) of
// 32 columns a tile, grid (N / 32, tiles), and writes the weighted clamped
// SwiGLU of each pair (weights f32 at buffer 7) to Y as bfloat, the down
// GEMM's operand; its params are 8 N, 9 K, 10 row_bytes, 11 x_shift,
// 12 limit.
// The last param (10, or 13 for the fused gate/up) is the most rows a tile
// takes the register path with (at most GM_DOT_ROWS; 0: none).
// ---------------------------------------------------------------------------
#if defined(KERNEL_glm53_gemm_moe_iq2_xxs) || defined(KERNEL_glm53_gemm_moe_q2_k) || \
    defined(KERNEL_glm53_gemm_moe_gate_up_iq2_xxs) || defined(KERNEL_glm53_gemm_moe_q4_k) || \
    defined(KERNEL_glm53_gemm_moe_q8_0) || defined(GM_GATE_UP_Q)
#if defined(KERNEL_glm53_gemm_moe_gate_up_iq2_xxs) || defined(GM_GATE_UP_Q)
#define GM_GATE_UP 1
#define GM_P 8u
#define GM_DOT_ARG 13u
#else
#define GM_P 6u
#define GM_DOT_ARG 10u
#endif

// Weights k .. k + 8 (k a multiple of 8) of `row`.
void gm_decode8(uint64_t row, uint k, out float w[8]) {
#if defined(KERNEL_glm53_gemm_moe_iq2_xxs) || defined(KERNEL_glm53_gemm_moe_gate_up_iq2_xxs)
    const uint t = k >> 5u, l = (k >> 3u) & 3u;
    const uint bw = (t >> 3u) * 33u;
    const uint qw = bw + 1u + 4u * (t & 7u);
    const float d = glm53_h2f(uint(U16(row).v[bw]));
    const uint aux0 = uint(U16(row).v[qw]) | (uint(U16(row).v[qw + 1u]) << 16u);
    const uint aux1 = uint(U16(row).v[qw + 2u]) | (uint(U16(row).v[qw + 3u]) << 16u);
    const float scale = 0.125 * d * float(2u * (aux1 >> 28u) + 1u);
    const uvec4 g = glm53_iq2xxs_grid_h[(aux0 >> (8u * l)) & 0xffu]
                  ^ glm53_iq2xxs_signs_h[(aux1 >> (7u * l)) & 127u];
    // Word p holds values p and p + 4.
    [[unroll]] for (uint p = 0u; p < 4u; p++) {
        const vec2 v = unpackHalf2x16(g[p]);
        w[p] = scale * v.x;
        w[p + 4u] = scale * v.y;
    }
#elif defined(KERNEL_glm53_gemm_moe_q4_k) || defined(KERNEL_glm53_gemm_moe_gate_up_q4_k)
    // Qwen3.6's experts. Block k / 256, sub-block j: its 6-bit scale and
    // min, the low (even j) or high nibbles of bytes l .. l + 8 of the
    // pair's 32 (glm53_decode_q4_k's values).
    const uint v = k & 255u, j = v >> 5u, l = v & 31u;
    const uint64_t b = row + uint64_t(k >> 8u) * 144u;
    const uint dd = U32(b).v[0];
    const float d = glm53_h2f(dd & 0xffffu);
    const float dmin = glm53_h2f(dd >> 16u);
    const uvec3 sw = uvec3(U32(b + 4u).v[0], U32(b + 8u).v[0], U32(b + 12u).v[0]);
    #define Q4K_BYTE(i) ((sw[(i) >> 2u] >> (8u * ((i) & 3u))) & 0xffu)
    uint sc, mn;
    if (j < 4u) {
        sc = Q4K_BYTE(j) & 63u;
        mn = Q4K_BYTE(j + 4u) & 63u;
    } else {
        sc = (Q4K_BYTE(j + 4u) & 0xfu) | ((Q4K_BYTE(j - 4u) >> 6u) << 4u);
        mn = (Q4K_BYTE(j + 4u) >> 4u) | ((Q4K_BYTE(j) >> 6u) << 4u);
    }
    #undef Q4K_BYTE
    const float scale = d * float(sc);
    const float minv = dmin * float(mn);
    const uint shift = (j & 1u) * 4u;
    const uvec2 q = U32x2(b + 16u + (j >> 1u) * 32u + l).v[0];
    [[unroll]] for (uint i = 0u; i < 8u; i++) {
        w[i] = scale * float((q[i >> 2u] >> (8u * (i & 3u) + shift)) & 0xfu) - minv;
    }
#elif defined(KERNEL_glm53_gemm_moe_q8_0) || defined(KERNEL_glm53_gemm_moe_gate_up_q8_0)
    // Block k / 32 (34 bytes, 2-byte aligned), bytes k % 32 .. + 8.
    const uint64_t b = row + uint64_t(k >> 5u) * 34u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint64_t q = b + 2u + (k & 31u);
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const uint pair = uint(U16(q).v[i]);
        w[2u * i] = d * float(int(pair << 24) >> 24);
        w[2u * i + 1u] = d * float(int(pair << 16) >> 24);
    }
#else
    // Block k / 256, half h, shift j, bytes l .. l + 8 of the half's 32;
    // group 8 h + 2 j + l / 16.
    const uint v = k & 255u, h = v >> 7u, j = (v >> 5u) & 3u, l = v & 31u;
    const uint64_t b = row + uint64_t(k >> 8u) * 84u;
    const uint dd = U32(b + 80u).v[0];
    const float d = glm53_h2f(dd & 0xffffu);
    const float dmin = glm53_h2f(dd >> 16u);
    const uint sc = uint(U8(b).v[8u * h + 2u * j + (l >> 4u)]);
    const float scale = d * float(sc & 0xfu);
    const float minv = dmin * float(sc >> 4u);
    const uvec2 q = U32x2(b + 16u + 32u * h + l).v[0];
    [[unroll]] for (uint i = 0u; i < 8u; i++) {
        w[i] = scale * float((q[i >> 2u] >> (8u * (i & 3u) + 2u * j)) & 3u) - minv;
    }
#endif
}

void main() {
    if (gl_WorkGroupID.y >= U32(arg(5)).v[0]) return;
    const uint N = arg_u32(GM_P);
    const uint K = arg_u32(GM_P + 1u);
    const uint row_bytes = arg_u32(GM_P + 2u);
    const uint x_shift = arg_u32(GM_P + 3u);
    const uint expert = U32(arg(4)).v[3u * gl_WorkGroupID.y];
    const uint first = U32(arg(4)).v[3u * gl_WorkGroupID.y + 1u];
    const uint rows = U32(arg(4)).v[3u * gl_WorkGroupID.y + 2u];
    const uint tid = gl_LocalInvocationIndex;
    const uint sg = gl_SubgroupID;
    // This thread's dequantization: weight rows 4 quad .. + 4 of the tile,
    // values 8 k8 .. + 8 of each step.
    const uint quad = tid & 15u, k8 = tid >> 4u;
    uint64_t wr[4];
#ifdef GM_GATE_UP
    // The tile's 64 weight rows are rows n0 .. n0 + 32 of gate (column
    // blocks 0 and 1) and the same rows of up (blocks 2 and 3).
    const uint n0 = gl_WorkGroupID.x * 32u;
    const uint64_t W = (quad < 8u ? arg(1) : arg(6)) + (uint64_t(expert) * N + n0) * row_bytes;
    [[unroll]] for (uint r = 0u; r < 4u; r++) wr[r] = W + uint64_t(min(4u * (quad & 7u) + r, N - 1u - n0)) * row_bytes;
#else
    const uint n0 = gl_WorkGroupID.x * 64u;
    const uint64_t W = arg(1) + (uint64_t(expert) * N + n0) * row_bytes;
    [[unroll]] for (uint r = 0u; r < 4u; r++) wr[r] = W + uint64_t(min(4u * quad + r, N - 1u - n0)) * row_bytes;
#endif
    // An expert of at most GM_DOT_ROWS rows (a short prompt's experts: one
    // to four rows each) skips the shared tile and the matrix units
    // (glm53_moe_dot.glsl, a variant per row count); the products are the
    // f32 weights' (the tile path rounds them to bfloat first).
    // Only an expert's one tile: the pairs of an expert with more than a
    // tile of them are split in an arbitrary order (glm53_moe_group), so the
    // rows of a small last tile would vary from run to run.
    const bool alone =
        gl_WorkGroupID.y == 0u || U32(arg(4)).v[3u * (gl_WorkGroupID.y - 1u)] != expert;
    if (alone && rows <= arg_u32(GM_DOT_ARG)) {
        // Lanes of a subgroup: four quads by eight k8, so each of a decode's
        // loads touches four weight rows, not sixteen (moe_grouped_timing,
        // 24-token density: 1.56 -> 1.33 ms a layer; the tile path's own
        // layout does not gain from it).
        const uint dq = tid >> 3u, dk8 = tid & 7u;
        uint64_t dwr[4];
#ifdef GM_GATE_UP
        const uint64_t DW = (dq < 8u ? arg(1) : arg(6)) + (uint64_t(expert) * N + n0) * row_bytes;
        [[unroll]] for (uint r = 0u; r < 4u; r++) dwr[r] = DW + uint64_t(min(4u * (dq & 7u) + r, N - 1u - n0)) * row_bytes;
#else
        const uint64_t DW = arg(1) + (uint64_t(expert) * N + n0) * row_bytes;
        [[unroll]] for (uint r = 0u; r < 4u; r++) dwr[r] = DW + uint64_t(min(4u * dq + r, N - 1u - n0)) * row_bytes;
#endif
        if (rows == 1u) {
#define GM_DR 1u
#include "glm53_moe_dot.glsl"
#undef GM_DR
        } else if (rows == 2u) {
#define GM_DR 2u
#include "glm53_moe_dot.glsl"
#undef GM_DR
        } else if (rows == 3u) {
#define GM_DR 3u
#include "glm53_moe_dot.glsl"
#undef GM_DR
        } else {
#define GM_DR 4u
#include "glm53_moe_dot.glsl"
#undef GM_DR
        }
        return;
    }
    // The subgroup's rows, and its lanes' rows of X, two per 16 (a row
    // past the tile's reads the tile's last and is not stored).
    const uint row0 = GM_SUB * sg;
    const bool working = row0 < rows;
    const uint lane_row = mat_lane_row(), a_half = mat_a_half(), odd16 = 16u * mat_a_odd();
    const uint words = K / 8u;
    uint a_at[GM_SUB / 8u];
    [[unroll]] for (uint h = 0u; h < GM_SUB / 8u; h++) {
        const uint r = row0 + 16u * (h >> 1u) + lane_row + (h & 1u);
        const uint pr = U32(arg(3)).v[first + min(r, rows - 1u)];
        a_at[h] = (x_shift >= 0x80000000u ? pr / (x_shift & 0x7fffffffu) : pr >> x_shift) * words;
    }
    U32x4 xa = U32x4(arg(0));
    const uint lane_at = lane_row * 8u + mat_lane_col() / 4u;
    MatC acc[GM_SUB / 16u][4];
    [[unroll]] for (uint i = 0u; i < GM_SUB / 16u; i++) {
        [[unroll]] for (uint c = 0u; c < 4u; c++) acc[i][c] = MatC(0.0);
    }
    for (uint k0 = 0u; k0 < K; k0 += GM_STEP) {
        const uint tile_at = ((k0 / GM_STEP) & 1u) * (GM_STEP * 8u);
        {
            float w[4][8];
            [[unroll]] for (uint r = 0u; r < 4u; r++) gm_decode8(wr[r], k0 + 8u * k8, w[r]);
            GM_STORE_TILE(tile_at + 64u * k8 + quad, w)
        }
        barrier();
        if (working) {
            [[unroll]] for (uint kk = 0u; kk < GM_STEP; kk += 16u) {
                const uint at = (k0 + kk) / 8u + a_half;
                const uint b_at = tile_at + lane_at + kk * 8u;
                uvec4 v[GM_SUB / 8u];
                [[unroll]] for (uint h = 0u; h < GM_SUB / 8u; h++) v[h] = xa.v[a_at[h] + at];
                const uvec4 b0 = gm_tile[b_at], b1 = gm_tile[b_at + 4u];
                const uvec4 b2 = gm_tile[b_at + 8u], b3 = gm_tile[b_at + 12u];
                [[unroll]] for (uint i = 0u; i < GM_SUB / 16u; i++) {
                    MatA ma;
                    MatB mb;
                    MAT_A_OF_ROWS(ma, v[2u * i], v[2u * i + 1u], odd16)
                    MAT_OF_WORDS(mb, b0)
                    acc[i][0] = coopMatMulAdd(ma, mb, acc[i][0]);
                    MAT_OF_WORDS(mb, b1)
                    acc[i][1] = coopMatMulAdd(ma, mb, acc[i][1]);
                    MAT_OF_WORDS(mb, b2)
                    acc[i][2] = coopMatMulAdd(ma, mb, acc[i][2]);
                    MAT_OF_WORDS(mb, b3)
                    acc[i][3] = coopMatMulAdd(ma, mb, acc[i][3]);
                }
            }
        }
    }
    if (!working) return;
    const uint col = n0 + mat_lane_col();
#ifdef GM_GATE_UP
    // mid[p][j] = w[p] * silu(min(g, L)) * clamp(u, -L, L) as bfloat (the
    // SwiGLU of glm53_moe_swiglu, from the same sums).
    const float limit = arg_f32(12);
    [[unroll]] for (uint i = 0u; i < GM_SUB / 16u; i++)
    [[unroll]] for (uint h = 0u; h < 2u; h++) {
        const uint r = row0 + 16u * i + lane_row + h;
        if (r < rows) {
            const uint p = U32(arg(3)).v[first + r];
            const float we = F32(arg(7)).v[p];
            [[unroll]] for (uint half_ = 0u; half_ < 2u; half_++) {
                uint b[4];
                [[unroll]] for (uint c = 0u; c < 4u; c++) {
                    float g = acc[i][half_][4u * h + c];
                    float u = acc[i][2u + half_][4u * h + c];
                    if (limit > 1e-6) {
                        g = min(g, limit);
                        u = clamp(u, -limit, limit);
                    }
                    // glm53_moe_swiglu's value in its order:
                    // w ((g u) / (1 + 2^(-g log2 e))).
                    precise float gu = g * u;
                    precise float e = exp2(-(g * uintBitsToFloat(0x3fb8aa3bu)));
                    precise float sv = we * (gu * (1.0 / (1.0 + e)));
                    b[c] = glm53_bf16_bits(sv);
                }
                const uint64_t at = arg(2) + 2u * (uint64_t(p) * N + col + 16u * half_);
                U32x2(at).v[0] = uvec2(b[0] | (b[1] << 16u), b[2] | (b[3] << 16u));
            }
        }
    }
#else
    [[unroll]] for (uint i = 0u; i < GM_SUB / 16u; i++)
    [[unroll]] for (uint h = 0u; h < 2u; h++) {
        const uint r = row0 + 16u * i + lane_row + h;
        if (r < rows) {
            const uint64_t y = arg(2) + 4u * uint64_t(U32(arg(3)).v[first + r]) * N;
            [[unroll]] for (uint c = 0u; c < 4u; c++) {
                F32x4(y).v[(col + 16u * c) / 4u] =
                    vec4(acc[i][c][4u * h], acc[i][c][4u * h + 1u], acc[i][c][4u * h + 2u], acc[i][c][4u * h + 3u]);
            }
        }
    }
#endif
}
#endif

// ---------------------------------------------------------------------------
// x as bfloat bits (glm53_bf16_bits), two values a word: the expert GEMM's
// operand. Grid::Threads (n / 2). Buffers: 0 x f32, 1 out (bfloat).
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_to_bf16
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint i = gl_GlobalInvocationID.x;
    const vec2 v = vec2(F32(arg(0)).v[2u * i], F32(arg(0)).v[2u * i + 1u]);
    U32(arg(1)).v[i] = glm53_bf16_bits(v.x) | (glm53_bf16_bits(v.y) << 16u);
}
#endif

// ---------------------------------------------------------------------------
// Groups a run's routed pairs (row i, slot s: pair i * used + s) by expert:
// pairs sorted by expert (order inside an expert arbitrary: each pair's
// result goes to its own row), and a tile list of (expert, first, count)
// with at most `cap` pairs a tile. One threadgroup of 1024.
// Buffers: 0 sel u32 [pairs], 1 pairs out, 2 tiles out [3 per tile], 3 tile
// count out. Params: 4 number of pairs, 5 experts (<= 512), 6 cap.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_moe_group
shared uint counts[512];
shared uint offsets[512];
void main() {
    const uint n = arg_u32(4);
    const uint E = arg_u32(5);
    const uint cap = arg_u32(6);
    const uint tid = gl_LocalInvocationIndex;
    for (uint e = tid; e < E; e += 1024u) counts[e] = 0u;
    barrier();
    for (uint p = tid; p < n; p += 1024u) atomicAdd(counts[U32(arg(0)).v[p]], 1u);
    barrier();
    if (tid == 0u) {
        uint at = 0u, tiles = 0u;
        for (uint e = 0u; e < E; e++) {
            const uint c = counts[e];
            offsets[e] = at;
            for (uint s = 0u; s < c; s += cap) {
                U32(arg(2)).v[3u * tiles] = e;
                U32(arg(2)).v[3u * tiles + 1u] = at + s;
                U32(arg(2)).v[3u * tiles + 2u] = min(cap, c - s);
                tiles++;
            }
            at += c;
        }
        U32(arg(3)).v[0] = tiles;
    }
    barrier();
    for (uint p = tid; p < n; p += 1024u) {
        const uint e = U32(arg(0)).v[p];
        const uint k = atomicAdd(offsets[e], 1u);
        U32(arg(1)).v[k] = p;
    }
}
#endif

// ---------------------------------------------------------------------------
// mid[p][j] = w[p] * silu(min(g, L)) * clamp(u, -L, L) for every routed pair.
// Grid::Threads (F, pairs). Buffers: 0 g [pairs][F], 1 u, 2 weights
// [pairs], 3 mid (bfloat: the down GEMM's operand). Params: 4 F, 5 limit.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_moe_swiglu
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint F = arg_u32(4);
    const float limit = arg_f32(5);
    const uint j = gl_GlobalInvocationID.x;
    const uint p = gl_GlobalInvocationID.y;
    const uint64_t at = uint64_t(p) * F + j;
    float g = F32(arg(0) + 4u * at).v[0], u = F32(arg(1) + 4u * at).v[0];
    if (limit > 1e-6) {
        g = min(g, limit);
        u = clamp(u, -limit, limit);
    }
    // In this order (glm53_gemm_moe_gate_up_iq2_xxs computes the same).
    precise float gu = g * u;
    precise float e = exp2(-(g * uintBitsToFloat(0x3fb8aa3bu)));
    precise float sv = F32(arg(2)).v[p] * (gu * (1.0 / (1.0 + e)));
    BF16(arg(3) + 2u * at).v[0] = uintBitsToBFloat16EXT(uint16_t(glm53_bf16_bits(sv)));
}
#endif

// ---------------------------------------------------------------------------
// out[i][r] = sum over the row's slots of down[i * used + s][r], plus
// shared[i][r] (moe + shared, as ds4). out may be shared.
// Grid::Threads (H, rows). Buffers: 0 down [pairs][H], 1 shared, 2 out.
// Params: 3 H, 4 used.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_moe_combine
void main() {
    if (!LILY_THREAD_IN_GRID) return;
    const uint H = arg_u32(3);
    const uint used = arg_u32(4);
    const uint r = gl_GlobalInvocationID.x;
    const uint i = gl_GlobalInvocationID.y;
    float acc = 0.0;
    for (uint s = 0u; s < used; s++) acc += F32(arg(0) + 4u * (uint64_t(i * used + s) * H)).v[r];
    const uint64_t at = uint64_t(i) * H + r;
    F32(arg(2) + 4u * at).v[0] = acc + F32(arg(1) + 4u * at).v[0];
}
#endif

// ---------------------------------------------------------------------------
// Direct-load MAT_K64 cooperative-matrix BF16 GEMV/small-batch GEMM (M <= 16,
// K % 64 == 0, 1..=8 weight sets across up to 3 F32 X inputs) with optional
// workgroup Split-K (`CMAT_SK = 1, 2, 4, 8`) for full GPU occupancy.
// Bit-exact across M in 1..=16.
// Grid: (sum_s ceil(N_s / (16 * CMAT_NB)), 1, 1), 32 * CMAT_SK threads.
// Buffers: 0..2 X0..X2 (F32 [M, K]), 3..10 W0..W7 (BF16 [N_s, K]),
//          11..18 Y0..Y7 (F32 [M, N_s]).
// Params: 19 K, 20 M, 21 x_mask (2 bits/set), 22..29 N0..N7.
// ---------------------------------------------------------------------------
#if defined(KERNEL_glm53_cmat_bf16_n16_sk8)
#define CMAT_NB 1
#define CMAT_SK 8
#define CMAT_SG_N 1
#elif defined(KERNEL_glm53_cmat_bf16_n16_sk4)
#define CMAT_NB 1
#define CMAT_SK 4
#define CMAT_SG_N 1
#elif defined(KERNEL_glm53_cmat_bf16_n32_sg4)
#define CMAT_NB 2
#define CMAT_SK 1
#define CMAT_SG_N 4
#elif defined(KERNEL_glm53_cmat_bf16_n64_sk2)
#define CMAT_NB 4
#define CMAT_SK 2
#define CMAT_SG_N 1
#elif defined(KERNEL_glm53_cmat_bf16_bx_n16_sk8)
#define CMAT_NB 1
#define CMAT_SK 8
#define CMAT_SG_N 1
#define CMAT_BX
#elif defined(KERNEL_glm53_cmat_bf16_bx_n16_sk4)
#define CMAT_NB 1
#define CMAT_SK 4
#define CMAT_SG_N 1
#define CMAT_BX
#elif defined(KERNEL_glm53_cmat_bf16_bx_n64_sk2)
#define CMAT_NB 4
#define CMAT_SK 2
#define CMAT_SG_N 1
#define CMAT_BX
#elif defined(KERNEL_glm53_cmat_bf16_bx_n32_sg4)
#define CMAT_NB 2
#define CMAT_SK 1
#define CMAT_SG_N 4
#define CMAT_BX
#endif

#ifdef CMAT_NB
#define CMAT_ROWS (16u * uint(CMAT_NB))
#define CMAT_WG_ROWS (CMAT_ROWS * uint(CMAT_SG_N))

#if CMAT_SK > 1
shared float cmat_red[CMAT_SK][16][CMAT_ROWS];
#endif

// Branchless F32->BF16 (round-to-nearest-even, finite inputs — avoids common.glsl's NaN branch).
bfloat16_t cmat_f2bf(float f) {
    return uintBitsToBFloat16EXT(uint16_t(glm53_bf16_bits(f)));
}

#define CMAT_B_LOAD(bb, at)                                                                   \
    uvec4 w##bb##0 = bw.v[at(bb, 0u)], w##bb##1 = bw.v[at(bb, 1u)],                           \
          w##bb##2 = bw.v[at(bb, 2u)], w##bb##3 = bw.v[at(bb, 3u)];

#define CMAT_B_STEP(bb, t)                                                                    \
    MAT_K64_B(mb, t, w##bb##0, w##bb##1, w##bb##2, w##bb##3)                                  \
    acc##bb = coopMatMulAdd(ma##t, mb, acc##bb);

#define CMAT_B_BLOCK(bb)                                                                      \
    CMAT_B_STEP(bb, 0) CMAT_B_STEP(bb, 1) CMAT_B_STEP(bb, 2) CMAT_B_STEP(bb, 3)

#define CMAT_B_INSIDE(bb, j) (b_at + g + (16u * (bb) + (j)) * K8)
#define CMAT_B_CLAMPED(bb, j) (min(b_col + (16u * (bb) + (j)), N - 1u) * K8 + b_vec + g)

#ifdef CMAT_BX
// Pre-converted BF16 activation input: zero `cmat_f2bf` ALU, half the X loads,
// and `r0 == r1` skip halves X loads for M <= 6 (75% of lanes clamp to M - 1)!
#define CMAT_LOAD_A(g)                                                                        \
    MatA ma0, ma1, ma2, ma3;                                                                  \
    {                                                                                         \
        const uvec4 v00 = xa_b.v[a0_base + (g) + 0u], v01 = xa_b.v[a0_base + (g) + 1u];       \
        const uvec4 v02 = xa_b.v[a0_base + (g) + 2u], v03 = xa_b.v[a0_base + (g) + 3u];       \
        if (r0 == r1) {                                                                       \
            MAT_K64_A(ma0, ma1, ma2, ma3, v00, v01, v02, v03, v00, v01, v02, v03, odd16)      \
        } else {                                                                              \
            const uvec4 v10 = xa_b.v[a1_base + (g) + 0u], v11 = xa_b.v[a1_base + (g) + 1u];   \
            const uvec4 v12 = xa_b.v[a1_base + (g) + 2u], v13 = xa_b.v[a1_base + (g) + 3u];   \
            MAT_K64_A(ma0, ma1, ma2, ma3, v00, v01, v02, v03, v10, v11, v12, v13, odd16)      \
        }                                                                                     \
    }

#if CMAT_NB == 1
#define CMAT_GROUP(at)                                                                        \
    {                                                                                         \
        CMAT_B_LOAD(0, at)                                                                    \
        CMAT_LOAD_A(g)                                                                        \
        MatB mb;                                                                              \
        CMAT_B_BLOCK(0)                                                                       \
    }
#elif CMAT_NB == 2
#define CMAT_GROUP(at)                                                                        \
    {                                                                                         \
        CMAT_B_LOAD(0, at)                                                                    \
        CMAT_LOAD_A(g)                                                                        \
        MatB mb;                                                                              \
        CMAT_B_LOAD(1, at) CMAT_B_BLOCK(0)                                                    \
        CMAT_B_BLOCK(1)                                                                       \
    }
#else
#define CMAT_GROUP(at)                                                                        \
    {                                                                                         \
        CMAT_B_LOAD(0, at)                                                                    \
        CMAT_LOAD_A(g)                                                                        \
        MatB mb;                                                                              \
        CMAT_B_LOAD(1, at) CMAT_B_BLOCK(0)                                                    \
        CMAT_B_LOAD(2, at) CMAT_B_BLOCK(1)                                                    \
        CMAT_B_LOAD(3, at) CMAT_B_BLOCK(2)                                                    \
        CMAT_B_BLOCK(3)                                                                       \
    }
#endif
#else
#define CMAT_LOAD_A(g4)                                                                       \
    MatA ma0, ma1, ma2, ma3;                                                                  \
    {                                                                                         \
        const vec4 f00 = xa.v[a0_base + (g4) + 0u], f01 = xa.v[a0_base + (g4) + 1u];          \
        const vec4 f02 = xa.v[a0_base + (g4) + 2u], f03 = xa.v[a0_base + (g4) + 3u];          \
        const vec4 f04 = xa.v[a0_base + (g4) + 4u], f05 = xa.v[a0_base + (g4) + 5u];          \
        const vec4 f06 = xa.v[a0_base + (g4) + 6u], f07 = xa.v[a0_base + (g4) + 7u];          \
        const vec2 p00 = a_odd != 0u ? f00.yw : f00.xz;                                       \
        const vec2 p01 = a_odd != 0u ? f01.yw : f01.xz;                                       \
        const vec2 p02 = a_odd != 0u ? f02.yw : f02.xz;                                       \
        const vec2 p03 = a_odd != 0u ? f03.yw : f03.xz;                                       \
        const vec2 p04 = a_odd != 0u ? f04.yw : f04.xz;                                       \
        const vec2 p05 = a_odd != 0u ? f05.yw : f05.xz;                                       \
        const vec2 p06 = a_odd != 0u ? f06.yw : f06.xz;                                       \
        const vec2 p07 = a_odd != 0u ? f07.yw : f07.xz;                                       \
        ma0[0] = cmat_f2bf(p00.x); ma1[0] = cmat_f2bf(p00.y);                                 \
        ma2[0] = cmat_f2bf(p01.x); ma3[0] = cmat_f2bf(p01.y);                                 \
        ma0[1] = cmat_f2bf(p02.x); ma1[1] = cmat_f2bf(p02.y);                                 \
        ma2[1] = cmat_f2bf(p03.x); ma3[1] = cmat_f2bf(p03.y);                                 \
        ma0[2] = cmat_f2bf(p04.x); ma1[2] = cmat_f2bf(p04.y);                                 \
        ma2[2] = cmat_f2bf(p05.x); ma3[2] = cmat_f2bf(p05.y);                                 \
        ma0[3] = cmat_f2bf(p06.x); ma1[3] = cmat_f2bf(p06.y);                                 \
        ma2[3] = cmat_f2bf(p07.x); ma3[3] = cmat_f2bf(p07.y);                                 \
        if (r0 == r1) {                                                                       \
            ma0[4] = ma0[0]; ma1[4] = ma1[0]; ma2[4] = ma2[0]; ma3[4] = ma3[0];               \
            ma0[5] = ma0[1]; ma1[5] = ma1[1]; ma2[5] = ma2[1]; ma3[5] = ma3[1];               \
            ma0[6] = ma0[2]; ma1[6] = ma1[2]; ma2[6] = ma2[2]; ma3[6] = ma3[2];               \
            ma0[7] = ma0[3]; ma1[7] = ma1[3]; ma2[7] = ma2[3]; ma3[7] = ma3[3];               \
        } else {                                                                              \
            const vec4 f10 = xa.v[a1_base + (g4) + 0u], f11 = xa.v[a1_base + (g4) + 1u];      \
            const vec4 f12 = xa.v[a1_base + (g4) + 2u], f13 = xa.v[a1_base + (g4) + 3u];      \
            const vec4 f14 = xa.v[a1_base + (g4) + 4u], f15 = xa.v[a1_base + (g4) + 5u];      \
            const vec4 f16 = xa.v[a1_base + (g4) + 6u], f17 = xa.v[a1_base + (g4) + 7u];      \
            const vec2 p10 = a_odd != 0u ? f10.yw : f10.xz;                                   \
            const vec2 p11 = a_odd != 0u ? f11.yw : f11.xz;                                   \
            const vec2 p12 = a_odd != 0u ? f12.yw : f12.xz;                                   \
            const vec2 p13 = a_odd != 0u ? f13.yw : f13.xz;                                   \
            const vec2 p14 = a_odd != 0u ? f14.yw : f14.xz;                                   \
            const vec2 p15 = a_odd != 0u ? f15.yw : f15.xz;                                   \
            const vec2 p16 = a_odd != 0u ? f16.yw : f16.xz;                                   \
            const vec2 p17 = a_odd != 0u ? f17.yw : f17.xz;                                   \
            ma0[4] = cmat_f2bf(p10.x); ma1[4] = cmat_f2bf(p10.y);                             \
            ma2[4] = cmat_f2bf(p11.x); ma3[4] = cmat_f2bf(p11.y);                             \
            ma0[5] = cmat_f2bf(p12.x); ma1[5] = cmat_f2bf(p12.y);                             \
            ma2[5] = cmat_f2bf(p13.x); ma3[5] = cmat_f2bf(p13.y);                             \
            ma0[6] = cmat_f2bf(p14.x); ma1[6] = cmat_f2bf(p14.y);                             \
            ma2[6] = cmat_f2bf(p15.x); ma3[6] = cmat_f2bf(p15.y);                             \
            ma0[7] = cmat_f2bf(p16.x); ma1[7] = cmat_f2bf(p16.y);                             \
            ma2[7] = cmat_f2bf(p17.x); ma3[7] = cmat_f2bf(p17.y);                             \
        }                                                                                     \
    }

#if CMAT_NB == 1
#define CMAT_GROUP(at)                                                                        \
    {                                                                                         \
        CMAT_LOAD_A(g * 2u)                                                                   \
        CMAT_B_LOAD(0, at)                                                                    \
        MatB mb;                                                                              \
        CMAT_B_BLOCK(0)                                                                       \
    }
#elif CMAT_NB == 2
#define CMAT_GROUP(at)                                                                        \
    {                                                                                         \
        CMAT_LOAD_A(g * 2u)                                                                   \
        CMAT_B_LOAD(0, at)                                                                    \
        MatB mb;                                                                              \
        CMAT_B_LOAD(1, at) CMAT_B_BLOCK(0)                                                    \
        CMAT_B_BLOCK(1)                                                                       \
    }
#else
#define CMAT_GROUP(at)                                                                        \
    {                                                                                         \
        CMAT_LOAD_A(g * 2u)                                                                   \
        CMAT_B_LOAD(0, at)                                                                    \
        MatB mb;                                                                              \
        CMAT_B_LOAD(1, at) CMAT_B_BLOCK(0)                                                    \
        CMAT_B_LOAD(2, at) CMAT_B_BLOCK(1)                                                    \
        CMAT_B_LOAD(3, at) CMAT_B_BLOCK(2)                                                    \
        CMAT_B_BLOCK(3)                                                                       \
    }
#endif
#endif

#if CMAT_SK == 1
#define CMAT_STORE(acc, bb)                                                                   \
    [[unroll]] for (uint h = 0u; h < 2u; h++) {                                               \
        const uint row = lane_row + h;                                                        \
        const uint col = col0 + 16u * (bb) + lane_col;                                        \
        if (row < M && col < N) {                                                             \
            const uint64_t y_row = Y_addr + 4u * uint64_t(row) * uint64_t(N);                 \
            [[unroll]] for (uint j = 0u; j < 4u; j++) {                                       \
                if (col + j < N) F32(y_row).v[col + j] = acc[4u * h + j];                     \
            }                                                                                 \
        }                                                                                     \
    }
#else
#define CMAT_STASH(acc, bb)                                                                   \
    [[unroll]] for (uint h = 0u; h < 2u; h++) {                                               \
        const uint row = lane_row + h;                                                        \
        if (row < M) {                                                                        \
            const uint lc = 16u * (bb) + lane_col;                                            \
            [[unroll]] for (uint j = 0u; j < 4u; j++) {                                       \
                cmat_red[sg][row][lc + j] = acc[4u * h + j];                                  \
            }                                                                                 \
        }                                                                                     \
    }
#endif

void main() {
    uint wg = gl_WorkGroupID.x;
    uint set = 0u;
    uint N = arg_u32(22);
    [[unroll]] for (uint s = 0u; s < 7u; s++) {
        const uint g = (N + CMAT_WG_ROWS - 1u) / CMAT_WG_ROWS;
        if (set == s && wg >= g) {
            wg -= g;
            set = s + 1u;
            N = arg_u32(23u + s);
        }
    }
    const uint sg = gl_SubgroupID;
#if CMAT_SG_N > 1
    const uint col0 = wg * CMAT_WG_ROWS + sg * CMAT_ROWS;
#else
    const uint col0 = wg * CMAT_ROWS;
#endif
    if (col0 >= N) return;

    const uint64_t W_addr = arg(3u + set);
    const uint64_t Y_addr = arg(11u + set);
    const uint x_idx = (arg_u32(21) >> (2u * set)) & 3u;
    const uint64_t X_addr = arg(x_idx);

    const uint K = arg_u32(19);
    const uint M = arg_u32(20);
    const uint K8 = K >> 3u;
    const uint K4 = K >> 2u;
    const uint lane_row = mat_lane_row();
    const uint lane_col = mat_lane_col();
    const uint a_half = mat_a_half();
    const uint a_odd = mat_a_odd();

    const uint r0 = min(lane_row, M - 1u);
    const uint r1 = min(lane_row + 1u, M - 1u);
#ifdef CMAT_BX
    const uint a0_base = r0 * K8 + 4u * a_half;
    const uint a1_base = r1 * K8 + 4u * a_half;
    const uint odd16 = 16u * a_odd;
    U32x4 xa_b = U32x4(X_addr);
#else
    const uint a0_base = r0 * K4 + 8u * a_half;
    const uint a1_base = r1 * K4 + 8u * a_half;
    F32x4 xa = F32x4(X_addr);
#endif
    const uint b_col = col0 + lane_col;
    const uint b_vec = lane_row >> 1u;
    const uint b_at = b_col * K8 + b_vec;

    U32x4 bw = U32x4(W_addr);

    MatC acc0 = MatC(0.0);
#if CMAT_NB >= 2
    MatC acc1 = MatC(0.0);
#endif
#if CMAT_NB >= 4
    MatC acc2 = MatC(0.0);
    MatC acc3 = MatC(0.0);
#endif

#if CMAT_SK > 1
    const uint g_start = sg * 8u;
    const uint g_step = uint(CMAT_SK) * 8u;
#else
    const uint g_start = 0u;
    const uint g_step = 8u;
#endif
    if (col0 + CMAT_ROWS <= N) {
        for (uint g = g_start; g < K8; g += g_step) CMAT_GROUP(CMAT_B_INSIDE)
    } else {
        for (uint g = g_start; g < K8; g += g_step) CMAT_GROUP(CMAT_B_CLAMPED)
    }

#if CMAT_SK == 1
    CMAT_STORE(acc0, 0u)
#if CMAT_NB >= 2
    CMAT_STORE(acc1, 1u)
#endif
#if CMAT_NB >= 4
    CMAT_STORE(acc2, 2u)
    CMAT_STORE(acc3, 3u)
#endif
#else
    CMAT_STASH(acc0, 0u)
#if CMAT_NB >= 2
    CMAT_STASH(acc1, 1u)
#endif
#if CMAT_NB >= 4
    CMAT_STASH(acc2, 2u)
    CMAT_STASH(acc3, 3u)
#endif
    barrier();
    const uint total_out = M * CMAT_ROWS;
    for (uint idx = gl_LocalInvocationIndex; idx < total_out; idx += uint(CMAT_SK) * 32u) {
        const uint row = idx / CMAT_ROWS;
        const uint lc = idx % CMAT_ROWS;
        const uint col = col0 + lc;
        if (col < N) {
            float sum = 0.0;
            [[unroll]] for (uint s = 0u; s < uint(CMAT_SK); s++) sum += cmat_red[s][row][lc];
            F32(Y_addr + 4u * uint64_t(row) * uint64_t(N)).v[col] = sum;
        }
    }
#endif
}
#endif

// ---------------------------------------------------------------------------
// High-occupancy Split-K BF16 GEMV for narrow N (e.g. router N=128, M <= 8):
// 2 output rows per WG, 4 subgroups (128 threads) splitting K per row ->
// 64 WGs x 8 subgroups = 512 subgroups across all GPU cores, [[unroll]] SSA
// accumulators (zero scratch spills!) + M==1 fast path.
// Grid: (ceil(N / 2), 1, 1), 256 threads (8 subgroups).
// Buffers: 0 X (F32 [M, K]), 1 W (BF16 [N, K]), 2 Y (F32 [M, N]).
// Params: 3 K, 4 M, 5 N.
// ---------------------------------------------------------------------------
#ifdef KERNEL_glm53_gemv_bf16_narrow
// Per-row SK=3 (96 threads = 3 subgroups/WG, grid = (N, M, 1)):
// For L2-resident narrow BF16 matrices (e.g. MoE router 128x2304 = 590 KB),
// dispatching M rows in parallel across gl_WorkGroupID.y gives 128*M WGs
// (384*M subgroups) at ~25 GPRs with full L2 broadcast and zero multi-row pressure!
shared float bfn_red[3];

void main() {
    const uint sk = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint n = gl_WorkGroupID.x;
    const uint r = gl_WorkGroupID.y;
    const uint K = arg_u32(3);
    const uint N = arg_u32(5);
    const uint K8 = K >> 3u;
    const uint K4 = K >> 2u;
    if (n >= N) return;

    U32x4 wbuf = U32x4(arg(1) + uint64_t(n) * uint64_t(K) * 2u);
    F32x4 xbuf = F32x4(arg(0) + uint64_t(r) * uint64_t(K) * 4u);

    float a0 = 0.0;
    for (uint q = sk * 32u + lane; q < K8; q += 96u) {
        const uvec4 v = wbuf.v[q];
        const vec4 w0 = vec4(
            uintBitsToFloat(v.x << 16u), uintBitsToFloat(v.x & 0xffff0000u),
            uintBitsToFloat(v.y << 16u), uintBitsToFloat(v.y & 0xffff0000u)
        );
        const vec4 w1 = vec4(
            uintBitsToFloat(v.z << 16u), uintBitsToFloat(v.z & 0xffff0000u),
            uintBitsToFloat(v.w << 16u), uintBitsToFloat(v.w & 0xffff0000u)
        );
        const uint xq = 2u * q;
        a0 += dot(w0, xbuf.v[xq]) + dot(w1, xbuf.v[xq + 1u]);
    }
    const float s0 = subgroupAdd(a0);
    if (lane == 0u) bfn_red[sk] = s0;
    barrier();
    if (sk == 0u && lane == 0u) {
        F32(arg(2) + 4u * uint64_t(r) * uint64_t(N)).v[n] = bfn_red[0] + bfn_red[1] + bfn_red[2];
    }
}
#endif

// ---------------------------------------------------------------------------
// Direct-load zero-shared-mem cooperative-matrix Q4_0 GEMV/small-batch GEMM
// (M <= 16, K % 32 == 0, 1..=4 weight sets sharing F32 X) with workgroup Split-K.
// Every lane loads ONE 16-bit word per weight row (bytes 2 + lane_row..+1):
// low nibbles supply K-block t=0 (0..15) and high nibbles supply t=1 (16..31),
// 100% coalesced across the 8 lane_rows, reusing X across 16 or 32 weight rows!
// Same binding/param layout as glm53_gemv_q4_0_r2_m*.
// ---------------------------------------------------------------------------
#if defined(KERNEL_glm53_cmat_q4_0_n16_sk8_f16)
#define CQ4_NB 1
#define CQ4_SK 8
#endif
#ifdef CQ4_NB
#define CQ4_ROWS (16u * uint(CQ4_NB))
#define CQ4_MAT_A coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define CQ4_MAT_B coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
shared float cq4_red[CQ4_SK][16][CQ4_ROWS];

void main() {
    const uint64_t X_addr = arg(0);
    const uint K = arg_u32(9);
    const uint M = arg_u32(10);
    const uint row_bytes = arg_u32(11);
    const uint x_row_stride = arg_u32(17);
    const uint y_stride_param = arg_u32(18);
    uint wg = gl_WorkGroupID.x;
    uint set = 0u;
    uint N = arg_u32(12);
    [[unroll]] for (uint s = 0u; s < 3u; s++) {
        const uint g = (N + CQ4_ROWS - 1u) / CQ4_ROWS;
        if (set == s && wg >= g) {
            wg -= g;
            set = s + 1u;
            N = arg_u32(13u + s);
        }
    }
    const uint col0 = wg * CQ4_ROWS;
    if (col0 >= N) return;

    const uint64_t W_addr = arg(1u + set);
    const uint64_t Y_addr = arg(5u + set);
    const uint y_row_stride = y_stride_param != 0u ? y_stride_param : N;
    const uint sg = gl_SubgroupID;
    const uint lane = gl_SubgroupInvocationID;
    const uint lane_row = mat_lane_row();
    const uint lane_col = mat_lane_col();
    const uint a_half = mat_a_half();
    const uint a_odd = mat_a_odd();
    const uint r0 = min(lane_row, M - 1u);
    const uint r1 = min(lane_row + 1u, M - 1u);
    const uint x4_stride = x_row_stride >> 2u;
    const uint a0_base = r0 * x4_stride + 2u * a_half;
    const uint a1_base = r1 * x4_stride + 2u * a_half;
    F32x4 xa = F32x4(X_addr);
    U16 w16 = U16(W_addr);

    // 32-bit U16 row offsets (saves 4 live GPRs & 12 64-bit address ops/block).
    const uint row_u16 = row_bytes >> 1u;
    const uint q_lane_u16 = 1u + (lane_row >> 1u);
    uint wrow0[4];
    [[unroll]] for (uint j = 0u; j < 4u; j++) {
        wrow0[j] = min(col0 + lane_col + j, N - 1u) * row_u16;
    }

    MatC acc0 = MatC(0.0);
    const uint n_blocks = K >> 5u;
    // Strided K across subgroups so all 8 subgroups of a WG share cache lines in L1!
    for (uint blk = sg; blk < n_blocks; blk += uint(CQ4_SK)) {
        const uint boff = blk * 9u;
        const uint qoff = boff + q_lane_u16;
        uint dh0[4], pq0[4];
        [[unroll]] for (uint j = 0u; j < 4u; j++) {
            dh0[j] = uint(w16.v[wrow0[j] + boff]);
            pq0[j] = uint(w16.v[wrow0[j] + qoff]);
        }

        const uint k4 = blk * 8u;
        CQ4_MAT_A ma0, ma1;
        {
            const vec4 f00 = xa.v[a0_base + k4 + 0u];
            const vec4 f01 = xa.v[a0_base + k4 + 1u];
            const vec4 f02 = xa.v[a0_base + k4 + 4u];
            const vec4 f03 = xa.v[a0_base + k4 + 5u];
            const vec2 p00 = a_odd != 0u ? f00.yw : f00.xz;
            const vec2 p01 = a_odd != 0u ? f01.yw : f01.xz;
            const vec2 p02 = a_odd != 0u ? f02.yw : f02.xz;
            const vec2 p03 = a_odd != 0u ? f03.yw : f03.xz;
            ma0[0] = float16_t(p00.x); ma0[1] = float16_t(p00.y);
            ma0[2] = float16_t(p01.x); ma0[3] = float16_t(p01.y);
            ma1[0] = float16_t(p02.x); ma1[1] = float16_t(p02.y);
            ma1[2] = float16_t(p03.x); ma1[3] = float16_t(p03.y);
            if (r0 == r1) {
                ma0[4] = ma0[0]; ma0[5] = ma0[1]; ma0[6] = ma0[2]; ma0[7] = ma0[3];
                ma1[4] = ma1[0]; ma1[5] = ma1[1]; ma1[6] = ma1[2]; ma1[7] = ma1[3];
            } else {
                const vec4 f10 = xa.v[a1_base + k4 + 0u];
                const vec4 f11 = xa.v[a1_base + k4 + 1u];
                const vec4 f12 = xa.v[a1_base + k4 + 4u];
                const vec4 f13 = xa.v[a1_base + k4 + 5u];
                const vec2 p10 = a_odd != 0u ? f10.yw : f10.xz;
                const vec2 p11 = a_odd != 0u ? f11.yw : f11.xz;
                const vec2 p12 = a_odd != 0u ? f12.yw : f12.xz;
                const vec2 p13 = a_odd != 0u ? f13.yw : f13.xz;
                ma0[4] = float16_t(p10.x); ma0[5] = float16_t(p10.y);
                ma0[6] = float16_t(p11.x); ma0[7] = float16_t(p11.y);
                ma1[4] = float16_t(p12.x); ma1[5] = float16_t(p12.y);
                ma1[6] = float16_t(p13.x); ma1[7] = float16_t(p13.y);
            }
        }

        CQ4_MAT_B mb0, mb1;
        [[unroll]] for (uint j = 0u; j < 4u; j++) {
            const uint p = pq0[j];
            const float16_t d = uint16BitsToHalf(uint16_t(dh0[j]));
            mb0[j]      = d * float16_t(int(p & 15u) - 8);
            mb0[4u + j] = d * float16_t(int((p >> 8u) & 15u) - 8);
            mb1[j]      = d * float16_t(int((p >> 4u) & 15u) - 8);
            mb1[4u + j] = d * float16_t(int(p >> 12u) - 8);
        }
        acc0 = coopMatMulAdd(ma0, mb0, acc0);
        acc0 = coopMatMulAdd(ma1, mb1, acc0);
    }

    [[unroll]] for (uint h = 0u; h < 2u; h++) {
        const uint row = lane_row + h;
        if (row < M) {
            [[unroll]] for (uint j = 0u; j < 4u; j++) {
                cq4_red[sg][row][lane_col + j] = acc0[4u * h + j];
            }
        }
    }
    barrier();
    const uint total_out = M * CQ4_ROWS;
    for (uint idx = gl_LocalInvocationIndex; idx < total_out; idx += uint(CQ4_SK) * 32u) {
        const uint row = idx / CQ4_ROWS;
        const uint lc = idx % CQ4_ROWS;
        const uint col = col0 + lc;
        if (col < N) {
            float sum = 0.0;
            [[unroll]] for (uint s = 0u; s < uint(CQ4_SK); s++) sum += cq4_red[s][row][lc];
            F32(Y_addr).v[row * y_row_stride + col] = sum;
        }
    }
}
#endif
