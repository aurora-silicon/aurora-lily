#if defined(KERNEL_sgemm_iq4_nl) || defined(KERNEL_sgemm_moe_iq4_nl)
// IQ4_NL's value of code c: its 16 values as signed bytes, 4 a word (the
// table of glm53_iq4nl_value, in fewer operations).
float sg_iq4nl(uint c) {
    const uint lo = c < 4u ? 0xBFAD9881u : 0xF6EADDCFu;
    const uint hi = c < 12u ? 0x26190D01u : 0x71594535u;
    return float(bitfieldExtract(int(c < 8u ? lo : hi), int(8u * (c & 3u)), 8));
}
#endif

// Weights k .. k + 8 (k a multiple of 8) of `row`, as glm53_decode gives
// them: direct 8-value decoders for every hot type so no block is decoded 4x.
void sg_decode8(uint64_t row, uint k, out float w[8]) {
#if defined(KERNEL_sgemm_iq2_xxs) || defined(KERNEL_sgemm_moe_iq2_xxs)
    const uint t = k >> 5u, l = (k >> 3u) & 3u;
    const uint bw = (t >> 3u) * 33u;
    const uint qw = bw + 1u + 4u * (t & 7u);
    const float d = glm53_h2f(uint(U16(row).v[bw]));
    const uint aux0 = uint(U16(row).v[qw]) | (uint(U16(row).v[qw + 1u]) << 16u);
    const uint aux1 = uint(U16(row).v[qw + 2u]) | (uint(U16(row).v[qw + 3u]) << 16u);
    const float scale = 0.125 * d * float(2u * (aux1 >> 28u) + 1u);
    const uvec4 g = glm53_iq2xxs_grid_h[(aux0 >> (8u * l)) & 0xffu]
                  ^ glm53_iq2xxs_signs_h[(aux1 >> (7u * l)) & 127u];
    [[unroll]] for (uint p = 0u; p < 4u; p++) {
        const vec2 v = unpackHalf2x16(g[p]);
        w[p] = scale * v.x;
        w[p + 4u] = scale * v.y;
    }
#elif defined(KERNEL_sgemm_iq2_s) || defined(KERNEL_sgemm_moe_iq2_s)
    const uint t = k >> 5u, l = (k >> 3u) & 3u;
    const uint64_t b = row + uint64_t(t >> 3u) * 82u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint qs = uint(U16(b + 2u).v[2u * ib + (l >> 1u)]);
    const uint sg = uint(U16(b + 34u).v[2u * ib + (l >> 1u)]);
    const uint hs = (uint(U16(b + 66u).v[ib >> 1u]) >> (8u * (ib & 1u))) & 0xffu;
    const uint scb = uint(U16(b + 74u).v[ib >> 1u]) >> (8u * (ib & 1u));
    const float dl = d * (0.5 + float(l < 2u ? (scb & 0xfu) : ((scb >> 4u) & 0xfu))) * 0.25;
    const uint g = ((qs >> (8u * (l & 1u))) & 0xffu) | ((hs << (8u - 2u * l)) & 0x300u);
    const uint lo = glm53_iq2s_grid[2u * g];
    const uint hi = glm53_iq2s_grid[2u * g + 1u];
    const uint signs = (sg >> (8u * (l & 1u))) & 0xffu;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const float v0 = dl * float((lo >> (8u * i)) & 0xffu);
        const float v1 = dl * float((hi >> (8u * i)) & 0xffu);
        w[i] = ((signs >> i) & 1u) != 0u ? -v0 : v0;
        w[i + 4u] = ((signs >> (i + 4u)) & 1u) != 0u ? -v1 : v1;
    }
#elif defined(KERNEL_sgemm_iq2_xs) || defined(KERNEL_sgemm_moe_iq2_xs)
    const uint t = k >> 5u, l = (k >> 3u) & 3u;
    const uint64_t b = row + uint64_t(t >> 3u) * 74u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint scb = (uint(U16(b + 66u).v[ib >> 1u]) >> (8u * (ib & 1u))) & 0xffu;
    const float dl = d * (0.5 + float(l < 2u ? (scb & 0xfu) : (scb >> 4u))) * 0.25;
    const uint q = uint(U16(b + 2u).v[4u * ib + l]);
    const uint g = q & 511u;
    const uint s7 = q >> 9u;
    const uint signs = s7 | ((bitCount(s7) & 1u) << 7u);
    const uint lo = glm53_iq2xs_grid[2u * g];
    const uint hi = glm53_iq2xs_grid[2u * g + 1u];
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const float v0 = dl * float((lo >> (8u * i)) & 0xffu);
        const float v1 = dl * float((hi >> (8u * i)) & 0xffu);
        w[i] = ((signs >> i) & 1u) != 0u ? -v0 : v0;
        w[i + 4u] = ((signs >> (i + 4u)) & 1u) != 0u ? -v1 : v1;
    }
#elif defined(KERNEL_sgemm_iq1_s) || defined(KERNEL_sgemm_moe_iq1_s)
    const uint t = k >> 5u, l = (k >> 3u) & 3u;
    const uint64_t b = row + uint64_t(t >> 3u) * 50u;
    const uint ib = t & 7u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint qh = uint(U16(b + 34u).v[ib]);
    const float dl = d * float(2u * ((qh >> 12u) & 7u) + 1u);
    const float delta = (qh & 0x8000u) != 0u ? -0.125 : 0.125;
    const uint qs = uint(U16(b + 2u).v[2u * ib + (l >> 1u)]);
    const uint idx = ((qs >> (8u * (l & 1u))) & 0xffu) | (((qh >> (3u * l)) & 7u) << 8u);
    const uint lo = glm53_iq1s_grid[2u * idx];
    const uint hi = glm53_iq1s_grid[2u * idx + 1u];
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        w[i] = dl * (float(bitfieldExtract(int(lo), int(8u * i), 8)) + delta);
        w[i + 4u] = dl * (float(bitfieldExtract(int(hi), int(8u * i), 8)) + delta);
    }
#elif defined(KERNEL_sgemm_q2_0) || defined(KERNEL_sgemm_moe_q2_0)
    const uint t = k >> 5u, l = (k >> 3u) & 3u;
    const uint64_t b = row + uint64_t(t >> 1u) * 18u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint pair = uint(U16(b + 2u + 8u * (t & 1u)).v[l]);
    [[unroll]] for (uint i = 0u; i < 8u; i++) {
        w[i] = float(int((pair >> (2u * i)) & 3u) - 1) * d;
    }
#elif defined(KERNEL_sgemm_nvfp4) || defined(KERNEL_sgemm_moe_nvfp4)
    const uint64_t b = row + uint64_t(k >> 6u) * 36u;
    const uint s = (k >> 4u) & 3u;
    const uint hi_half = (k >> 3u) & 1u;
    const uint shift = 4u * hi_half;
    const float d = glm53_ue4m3_to_f32((U32(b).v[0] >> (8u * s)) & 0xffu);
    const uvec2 qs = U32x2(b + 4u + 8u * s).v[0];
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        w[i] = glm53_fp4_value((qs.x >> (8u * i + shift)) & 0xfu) * d;
        w[i + 4u] = glm53_fp4_value((qs.y >> (8u * i + shift)) & 0xfu) * d;
    }
#elif defined(KERNEL_sgemm_q8_0) || defined(KERNEL_sgemm_moe_q8_0)
    const uint64_t b = row + uint64_t(k >> 5u) * 34u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const uint pair = uint(U16(b + 2u).v[((k & 31u) >> 1u) + i]);
        w[2u * i] = d * float(int(pair << 24) >> 24);
        w[2u * i + 1u] = d * float(int(pair << 16) >> 24);
    }
#elif defined(KERNEL_sgemm_iq4_nl) || defined(KERNEL_sgemm_moe_iq4_nl)
    const uint64_t b = row + uint64_t(k >> 5u) * 18u;
    const float d = glm53_h2f(uint(U16(b).v[0]));
    const uint j = k & 31u, at = j & 15u, shift = j < 16u ? 0u : 4u;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const uint pair = uint(U16(b + 2u + at).v[i]);
        w[2u * i] = d * sg_iq4nl((pair >> shift) & 0xfu);
        w[2u * i + 1u] = d * sg_iq4nl((pair >> (8u + shift)) & 0xfu);
    }
#elif defined(KERNEL_sgemm_q4_k) || defined(KERNEL_sgemm_moe_q4_k)
    const uint64_t b = row + uint64_t(k >> 8u) * 144u;
    const uint j = (k >> 5u) & 7u;
    const vec2 factors = glm53_q4k_factors(b, j);
    const uvec2 q = U32x2(b + 16u + 32u * (j >> 1u) + (k & 31u)).v[0] >> (4u * (j & 1u));
    [[unroll]] for (uint i = 0u; i < 8u; i++)
        w[i] = factors.x * float((q[i >> 2u] >> (8u * (i & 3u))) & 15u) - factors.y;
#elif defined(KERNEL_sgemm_q5_k) || defined(KERNEL_sgemm_moe_q5_k)
    const uint64_t b = row + uint64_t(k >> 8u) * 176u;
    const uint j = (k >> 5u) & 7u, l = k & 31u;
    uint sc, mn;
    glm53_k4_scale_min(b, j, sc, mn);
    const uint dd = U32(b).v[0];
    const float scale = glm53_h2f(dd & 0xffffu) * float(sc);
    const float minv = glm53_h2f(dd >> 16u) * float(mn);
    const uvec2 q = U32x2(b + 48u + (j >> 1u) * 32u + l).v[0] >> ((j & 1u) * 4u);
    const uvec2 h = U32x2(b + 16u + l).v[0] >> j;
    [[unroll]] for (uint i = 0u; i < 8u; i++) {
        const uint c = ((q[i >> 2u] >> (8u * (i & 3u))) & 0xfu) | (((h[i >> 2u] >> (8u * (i & 3u))) & 1u) << 4u);
        w[i] = scale * float(c) - minv;
    }
#elif defined(KERNEL_sgemm_q6_k) || defined(KERNEL_sgemm_moe_q6_k)
    const uint64_t b = row + uint64_t(k >> 8u) * 210u;
    const uint t = (k >> 5u) & 7u;
    const uint n = t >> 2u, q = t & 3u;
    const uint l = k & 31u;
    const float d = glm53_h2f(uint(U16(b).v[104]));
    const uint sw = uint(U16(b + 192u).v[4u * n + q]);
    const float s = d * float(int(sw << (l < 16u ? 24u : 16u)) >> 24);
    const uint64_t ql = b + 64u * n + 32u * (q & 1u) + l;
    const uint64_t qh = b + 128u + 32u * n + l;
    const uint lshift = 4u * (q >> 1u), hshift = 2u * q;
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const uint lo = uint(U16(ql).v[i]) >> lshift;
        const uint hi = uint(U16(qh).v[i]) >> hshift;
        const uint c0 = (lo & 0xfu) | ((hi & 3u) << 4u);
        const uint c1 = ((lo >> 8u) & 0xfu) | (((hi >> 8u) & 3u) << 4u);
        w[2u * i] = s * float(int(c0) - 32);
        w[2u * i + 1u] = s * float(int(c1) - 32);
    }
#elif defined(KERNEL_sgemm_bf16) || defined(KERNEL_sgemm_moe_bf16)
    const uvec4 v = U32x4(row + 2u * uint64_t(k)).v[0];
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        w[2u * i] = uintBitsToFloat(v[i] << 16u);
        w[2u * i + 1u] = uintBitsToFloat(v[i] & 0xffff0000u);
    }
#elif defined(KERNEL_sgemm_f16)
    const uvec4 v = U32x4(row + 2u * uint64_t(k)).v[0];
    [[unroll]] for (uint i = 0u; i < 4u; i++) {
        const vec2 p = unpackHalf2x16(v[i]);
        w[2u * i] = p.x;
        w[2u * i + 1u] = p.y;
    }
#elif defined(KERNEL_sgemm_f32)
    const vec4 v0 = F32x4(row + 4u * uint64_t(k)).v[0];
    const vec4 v1 = F32x4(row + 4u * uint64_t(k + 4u)).v[0];
    w[0] = v0.x; w[1] = v0.y; w[2] = v0.z; w[3] = v0.w;
    w[4] = v1.x; w[5] = v1.y; w[6] = v1.z; w[7] = v1.w;
#else
    float t[32];
    glm53_decode(SG_TYPE, row, k >> 5u, t);
    [[unroll]] for (uint q = 0u; q < 4u; q++) {
        if ((k & 24u) == 8u * q) {
            [[unroll]] for (uint i = 0u; i < 8u; i++) w[i] = t[8u * q + i];
        }
    }
#endif
}

// Shared memory for tile weights (up to 32 x 33 u16vec4 = 8.4 KB, also
// reused for small-expert quant LUTs with zero extra shared memory) and
// activations (up to 32 x 17 f16vec4 = 4.35 KB): 12.8 KB total.
shared u16vec4 sg_w[32 * 33];
shared f16vec4 sg_x[32 * 17];

#ifdef SG_MOE
// Grid (N / 128, max tiles), tile y = tiles[y] = (expert e, first, count):
// the pairs pairs[first ..] of expert e; activation row pairs[..] >>
// x_shift of K values, Y row pairs[..] of N.
// Buffers: 0 X f32, 1 W (the expert stack, expert e's N rows from row
// e N), 2 Y f32, 3 pairs u32, 4 tiles u32 [3 a tile], 5 tile count.
// Params: 6 N, 7 K, 8 row_bytes, 9 x_shift.
#define SG_N arg_u32(6)
#define SG_KK arg_u32(7)
#define SG_ROW_BYTES arg_u32(8)
uint sg_first, sg_shift;
uint64_t sg_x_row(uint i) { return uint64_t(U32(arg(3)).v[sg_first + i] >> sg_shift) * SG_KK; }
uint64_t sg_y_row(uint i) { return uint64_t(U32(arg(3)).v[sg_first + i]) * SG_N; }
#else
// Y[b][m][n] = W[b][n] . X[b][m] for m < M, n < N: grid (N / 128, M / 64,
// batches). Buffers: 0 X f32, 1 W, 2 Y f32. Params: 3 M, 4 N, 5 K,
// 6 row_bytes, 7 ldx, 8 ldy, 9 x_batch, 10 w_batch, 11 y_batch (elements,
// weight rows).
#define SG_N arg_u32(4)
#define SG_KK arg_u32(5)
#define SG_ROW_BYTES arg_u32(6)
uint sg_m0;
uint64_t sg_x_row(uint i) {
    return uint64_t(gl_WorkGroupID.z) * arg_u32(9) + uint64_t(sg_m0 + i) * arg_u32(7);
}
uint64_t sg_y_row(uint i) {
    return uint64_t(gl_WorkGroupID.z) * arg_u32(11) + uint64_t(sg_m0 + i) * arg_u32(8);
}
#endif

