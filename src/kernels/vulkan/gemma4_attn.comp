#version 460
// Gemma 4's attention for prompt runs on the matrix units
// (src/kernels/gemma4.rs `attention` with more than MAX_ROWS rows; the
// decode kernels are in gemma4.comp). Flash attention over the f16 K/V
// caches with f16 operands and f32 accumulators: S = Q K^T a tile of 128
// keys at a time, the online softmax in threadgroup memory, P rounded to
// f16, acc = acc * alpha + P V.
//
// A threadgroup of four subgroups takes 16 tile rows of one KV head: tile
// row P is query row P / G, head kv G + P % G (G = H / kvh query heads a KV
// head), so the heads that share a KV head share one read of its keys.
// Subgroup s computes the scores of key blocks 2 s and 2 s + 1 of a tile
// over the whole head and P V for head dims D / 4 s .. D / 4 (s + 1) over
// all eight blocks.
//
// Q K^T walks the head dim 64 at a time in MAT_K64's order (matmul.glsl):
// a lane loads one 16-byte vector of a key row for four multiplies; the
// query tile is built once in that order in threadgroup memory, a lane's
// operand of a step one 16-byte load.
//
// Positions live at slot pos % ring of a cache (a ring for the
// sliding-window layers, the whole context for the global ones); row i
// (position pos0 + i) attends keys [lo, pos], lo = pos + 1 - window with a
// window. Keys past the tile's last are clamped to it and masked.
#include "common.glsl"
#include "matmul.glsl"
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// ---------------------------------------------------------------------------
// The K cache keeps a head's first k_rot RoPE pairs' keys ([ring][kvh]
// [2 k_rot], gemma4.comp qkv); a 64-value step past them takes its keys
// from the V cache with the query times k_norm.
// Grid (ceil(m G / 16), kvh), 128 threads.
// Buffers: 0 q f32 [m][H][D] (normed and rotated), 1 K cache, 2 V cache
// (f16 [ring][kvh][D]), 3 heads f32 [m][H][D], 4 k_norm [D].
// Params: 5 H, 6 kvh, 7 pos0, 8 ring, 9 window (0: none), 10 m, 11 k_rot.
// ---------------------------------------------------------------------------
#if defined(KERNEL_gemma4_attn_mu_256) || defined(KERNEL_gemma4_attn_mu_512)
#ifdef KERNEL_gemma4_attn_mu_256
#define AD 256u
#else
#define AD 512u
#endif
#define MatAh coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA>
#define MatBh coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB>
#define MatCf coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>
#define BQ 16u
#define BK 128u
// Head-dim blocks of 16 a subgroup's P V covers.
#define NB (AD / 64u)
#define NEG_INF (-1.0 / 0.0)
#define H_LO(w) uint16BitsToHalf(uint16_t(w))
#define H_HI(w) uint16BitsToHalf(uint16_t((w) >> 16))

// The query tile in the lanes' order: vector 32 s + lane holds the lane's
// eight elements of the A operand of multiply s (MAT_K64 order).
shared uvec4 q_tile[AD / 16u * 32u];
// The scores, row-major, four keys to a vector.
shared vec4 s_tile[BQ * BK / 4u];
// The probabilities: vector (16 b + row) 4 + 2 half + odd holds keys
// 8 half + odd + 2 j, j in 0..4, of key block b (a lane's four elements of
// a row of the P operand, matmul.glsl).
shared f16vec4 p_tile[BQ * BK / 4u];
shared float row_max[BQ], row_sum[BQ], row_alpha[BQ];

void main() {
    const uint H = arg_u32(5);
    const uint kvh = arg_u32(6);
    const uint pos0 = arg_u32(7);
    const uint ring = arg_u32(8);
    const uint window = arg_u32(9);
    const uint m = arg_u32(10);
    const uint k_rot = arg_u32(11);
    const uint G = H / kvh;
    const uint kv = gl_WorkGroupID.y;
    const uint P0 = gl_WorkGroupID.x * BQ;
    const uint rows = m * G;
    const uint tid = gl_LocalInvocationIndex, sg = gl_SubgroupID, lane = gl_SubgroupInvocationID;
    const uint rstride = kvh * AD;

    // The query tile. Element e of a lane's operand of multiply s = 4 g + t
    // is row mat_lane_row() + (e >> 2), head dim
    // 64 g + 32 half + 8 (e & 3) + 2 t + odd. A row past the run reads the
    // last (its outputs are not stored).
    for (uint idx = tid; idx < AD * 2u; idx += 128u) {
        const uint s = idx >> 5u, l = idx & 31u;
        const uint g = s >> 2u, t = s & 3u;
        const uint r0 = (l & 6u) | ((l >> 1u) & 8u);
        const uint half_ = l & 1u, odd = (l >> 3u) & 1u;
        const uint d0 = 64u * g + 32u * half_ + 2u * t + odd;
        // A step past the K cache's pairs scores V with the query times k_norm.
        const bool turned = ((64u * g) & (AD / 2u - 1u)) < k_rot;
        F32 kn = F32(arg(4));
        vec4 f = turned ? vec4(1.0) : vec4(kn.v[d0], kn.v[d0 + 8u], kn.v[d0 + 16u], kn.v[d0 + 24u]);
        uint w[4];
        [[unroll]] for (uint h = 0u; h < 2u; h++) {
            const uint P = min(P0 + r0 + h, rows - 1u);
            const uint row = P / G, head = kv * G + P % G;
            const uint64_t Q = arg(0) + 4u * ((uint64_t(row) * H + head) * AD);
            F32 q = F32(Q);
            w[2u * h] = packHalf2x16(vec2(q.v[d0], q.v[d0 + 8u]) * f.xy);
            w[2u * h + 1u] = packHalf2x16(vec2(q.v[d0 + 16u], q.v[d0 + 24u]) * f.zw);
        }
        q_tile[idx] = uvec4(w[0], w[1], w[2], w[3]);
    }
    if (tid < BQ) {
        row_max[tid] = NEG_INF;
        row_sum[tid] = 0.0;
    }
    // Key range of the tile: from the first row's window start to the last
    // row's position.
    const uint first_pos = pos0 + P0 / G;
    const uint last_pos = pos0 + (min(P0 + BQ, rows) - 1u) / G;
    const uint k_lo = (window != 0u && first_pos + 1u > window) ? first_pos + 1u - window : 0u;
    const uint k_end = last_pos + 1u;
    barrier();

    const uint lane_row = mat_lane_row(), lane_col = mat_lane_col();
    const uint p_at = lane_row * 4u + 2u * mat_a_half() + mat_a_odd();
    U32x4 kc = U32x4(arg(1) + 2u * uint64_t(kv) * 2u * k_rot);
    U32x4 vk = U32x4(arg(2) + 2u * uint64_t(kv) * AD);
    U32x2 vc = U32x2(arg(2) + 2u * uint64_t(kv) * AD);
    const uint kstride = kvh * 2u * k_rot;

    MatCf acc[NB];
    [[unroll]] for (uint i = 0u; i < NB; i++) acc[i] = MatCf(0.0);

    // The softmax's row and keys: thread tid takes row tid / 8, key block
    // tid % 8 of the tile.
    const uint srow = tid >> 3u, sblk = tid & 7u;
    int s_pos, s_lo;
    {
        const uint P = P0 + srow;
        s_pos = P < rows ? int(pos0 + P / G) : -1;
        s_lo = (window != 0u && s_pos + 1 > int(window)) ? s_pos + 1 - int(window) : 0;
    }

    for (uint k0 = k_lo; k0 < k_end; k0 += BK) {
        const uint slot0 = k0 % ring;
        // S = Q K^T for key blocks 2 sg, 2 sg + 1.
        const uint kb = k0 + 32u * sg;
        if (kb < k_end) {
            uint slots[8];
            [[unroll]] for (uint j = 0u; j < 8u; j++) {
                const uint off = 32u * sg + 16u * (j >> 2u) + lane_col + (j & 3u);
                uint slot = slot0 + min(off, k_end - 1u - k0);
                slot -= slot >= ring ? ring : 0u;
                slots[j] = slot;
            }
            MatCf s0 = MatCf(0.0), s1 = MatCf(0.0);
            [[unroll]] for (uint g = 0u; g < AD / 64u; g++) {
                // Step g's keys: the K cache's (value r of a row) or V's.
                const uint e = 64u * g;
                const bool turned = (e & (AD / 2u - 1u)) < k_rot;
                const uint r = e < AD / 2u ? e : k_rot + e - AD / 2u;
                U32x4 src = turned ? kc : vk;
                const uint row8 = turned ? kstride / 8u : rstride / 8u;
                const uint at = (turned ? r : e) / 8u + (lane_row >> 1u);
                uvec4 kw[8];
                [[unroll]] for (uint j = 0u; j < 8u; j++) kw[j] = src.v[slots[j] * row8 + at];
                uvec4 qw[4];
                [[unroll]] for (uint t = 0u; t < 4u; t++) qw[t] = q_tile[32u * (4u * g + t) + lane];
                [[unroll]] for (uint t = 0u; t < 4u; t++) {
                    MatAh a;
                    MatBh b;
                    a[0] = H_LO(qw[t][0]); a[1] = H_HI(qw[t][0]); a[2] = H_LO(qw[t][1]); a[3] = H_HI(qw[t][1]);
                    a[4] = H_LO(qw[t][2]); a[5] = H_HI(qw[t][2]); a[6] = H_LO(qw[t][3]); a[7] = H_HI(qw[t][3]);
                    b[0] = H_LO(kw[0][t]); b[1] = H_LO(kw[1][t]); b[2] = H_LO(kw[2][t]); b[3] = H_LO(kw[3][t]);
                    b[4] = H_HI(kw[0][t]); b[5] = H_HI(kw[1][t]); b[6] = H_HI(kw[2][t]); b[7] = H_HI(kw[3][t]);
                    s0 = coopMatMulAdd(a, b, s0);
                    b[0] = H_LO(kw[4][t]); b[1] = H_LO(kw[5][t]); b[2] = H_LO(kw[6][t]); b[3] = H_LO(kw[7][t]);
                    b[4] = H_HI(kw[4][t]); b[5] = H_HI(kw[5][t]); b[6] = H_HI(kw[6][t]); b[7] = H_HI(kw[7][t]);
                    s1 = coopMatMulAdd(a, b, s1);
                }
            }
            coopMatStore(s0, s_tile, 8u * sg, BK / 4u, gl_CooperativeMatrixLayoutRowMajor);
            coopMatStore(s1, s_tile, 8u * sg + 4u, BK / 4u, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();

        // The online softmax: eight threads a row, sixteen keys each.
        {
            const float prev = row_max[srow];
            const int kfirst = int(k0 + 16u * sblk);
            vec4 sv[4];
            [[unroll]] for (uint j = 0u; j < 4u; j++) sv[j] = s_tile[srow * (BK / 4u) + 4u * sblk + j];
            float mx = prev;
            [[unroll]] for (uint j = 0u; j < 16u; j++) {
                const int kp = kfirst + int(j);
                if (kp >= s_lo && kp <= s_pos) mx = max(mx, sv[j / 4u][j % 4u]);
            }
            [[unroll]] for (uint off = 1u; off < 8u; off <<= 1u) mx = max(mx, subgroupShuffleXor(mx, off));
            float p[16];
            float psum = 0.0;
            [[unroll]] for (uint j = 0u; j < 16u; j++) {
                const int kp = kfirst + int(j);
                p[j] = (kp >= s_lo && kp <= s_pos) ? exp(sv[j / 4u][j % 4u] - mx) : 0.0;
                psum += p[j];
            }
            [[unroll]] for (uint j = 0u; j < 4u; j++) {
                const uint c = 8u * (j / 2u) + (j % 2u);
                p_tile[(16u * sblk + srow) * 4u + j] = f16vec4(vec4(p[c], p[c + 2u], p[c + 4u], p[c + 6u]));
            }
            [[unroll]] for (uint off = 1u; off < 8u; off <<= 1u) psum += subgroupShuffleXor(psum, off);
            if (sblk == 0u) {
                // A row with no key yet keeps max -inf and sums nothing.
                const float alpha = prev == NEG_INF ? 0.0 : exp(prev - mx);
                row_sum[srow] = row_sum[srow] * alpha + psum;
                row_max[srow] = mx;
                row_alpha[srow] = alpha;
            }
        }
        barrier();

        // acc = acc alpha + P V over the tile's key blocks.
        {
            const float alpha0 = row_alpha[lane_row], alpha1 = row_alpha[lane_row + 1u];
            [[unroll]] for (uint i = 0u; i < NB; i++) {
                [[unroll]] for (uint e = 0u; e < 4u; e++) acc[i][e] *= alpha0;
                [[unroll]] for (uint e = 4u; e < 8u; e++) acc[i][e] *= alpha1;
            }
        }
        const uint dcol = (AD / 4u) * sg + lane_col;
        for (uint b = 0u; b < BK / 16u; b++) {
            const uint key0 = 16u * b;
            if (k0 + key0 >= k_end) break;
            uint va[2];
            [[unroll]] for (uint h = 0u; h < 2u; h++) {
                uint slot = slot0 + min(key0 + lane_row + h, k_end - 1u - k0);
                slot -= slot >= ring ? ring : 0u;
                va[h] = (slot * rstride + dcol) / 4u;
            }
            uvec2 vw[NB][2];
            [[unroll]] for (uint i = 0u; i < NB; i++) {
                vw[i][0] = vc.v[va[0] + 4u * i];
                vw[i][1] = vc.v[va[1] + 4u * i];
            }
            const f16vec4 pe0 = p_tile[p_at + 64u * b], pe1 = p_tile[p_at + 64u * b + 4u];
            MatAh pa;
            pa[0] = pe0[0]; pa[1] = pe0[1]; pa[2] = pe0[2]; pa[3] = pe0[3];
            pa[4] = pe1[0]; pa[5] = pe1[1]; pa[6] = pe1[2]; pa[7] = pe1[3];
            [[unroll]] for (uint i = 0u; i < NB; i++) {
                MatBh vb;
                vb[0] = H_LO(vw[i][0].x); vb[1] = H_HI(vw[i][0].x); vb[2] = H_LO(vw[i][0].y); vb[3] = H_HI(vw[i][0].y);
                vb[4] = H_LO(vw[i][1].x); vb[5] = H_HI(vw[i][1].x); vb[6] = H_LO(vw[i][1].y); vb[7] = H_HI(vw[i][1].y);
                acc[i] = coopMatMulAdd(pa, vb, acc[i]);
            }
        }
    }
    barrier();

    // Store: the lane's two rows, four head dims of each block.
    [[unroll]] for (uint h = 0u; h < 2u; h++) {
        const uint r = lane_row + h, P = P0 + r;
        if (P >= rows) continue;
        const float inv = 1.0 / row_sum[r];
        const uint row = P / G, head = kv * G + P % G;
        F32x4 O = F32x4(arg(3) + 4u * ((uint64_t(row) * H + head) * AD));
        [[unroll]] for (uint i = 0u; i < NB; i++) {
            const uint d = (AD / 4u) * sg + 16u * i + lane_col;
            O.v[d / 4u] = vec4(acc[i][4u * h], acc[i][4u * h + 1u], acc[i][4u * h + 2u], acc[i][4u * h + 3u]) * inv;
        }
    }
}
#endif
